import React from 'react';
import { useParentState } from '../useIframeState';
import { ConnectedVideoStep } from '../../components/getting-started/steps-views/ConnectedVideoStep';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Create a new QueryClient instance
const queryClient = new QueryClient();

// Mock TRPC client
const mockTrpc = {
  viewer: {
    integrations: {
      useQuery: () => ({
        data: {
          items: [
            {
              name: "Zoom",
              slug: "zoom",
              logo: "zoom-logo.svg",
              type: "video",
              description: "Video conferencing solution",
              userCredentialIds: [],
              appData: {
                location: {
                  linkType: "dynamic"
                }
              },
              dependencyData: null
            },
            {
              name: "Google Meet",
              slug: "google-meet",
              logo: "google-meet-logo.svg",
              type: "video",
              description: "Google's video conferencing solution",
              userCredentialIds: [],
              appData: {
                location: {
                  linkType: "dynamic"
                }
              },
              dependencyData: null
            }
          ]
        },
        isPending: false
      })
    }
  }
};

// Mock the trpc context
const TRPCContext = React.createContext(mockTrpc);
export const useTRPC = () => React.useContext(TRPCContext);

// Mock useLocale hook
const mockUseLocale = () => ({
  t: (key: string) => key,
});

// Mock useMeQuery
const mockUseMeQuery = () => ({
  data: {
    metadata: {
      defaultConferencingApp: null
    }
  }
});

// Create mock providers
const MockProviders: React.FC<{ children: React.ReactNode }> = ({ children }) => (
  <QueryClientProvider client={queryClient}>
    <TRPCContext.Provider value={mockTrpc}>
      {children}
    </TRPCContext.Provider>
  </QueryClientProvider>
);

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    nextStep: {
      type: "boolean",
      value: false,
      label: "Trigger Next Step",
    },
  });

  const handleNextStep = () => {
    setState('nextStep', true);
    console.log('Next step triggered');
  };

  return (
    <MockProviders>
      <ConnectedVideoStep
        nextStep={handleNextStep}
      />
    </MockProviders>
  );
}

// Mock the required modules
(global as any).useLocale = mockUseLocale;
(global as any).useMeQuery = mockUseMeQuery;
