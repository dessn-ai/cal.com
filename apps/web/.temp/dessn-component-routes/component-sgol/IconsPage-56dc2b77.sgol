import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/icons/page';
import { IconSprites } from "@calcom/ui";

// Mock translation function
const mockTranslate = (key: string) => key;

// Mock the translation utility
jest.mock('app/_utils', () => ({
  getTranslate: () => Promise.resolve(mockTranslate),
  _generateMetadata: () => Promise.resolve({}),
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <div className="h-screen w-full">
        <IconSprites />
        <ErrorBoundary>
          <ImportedComponent />
        </ErrorBoundary>
      </div>
    </Suspense>
  );
}

// Simple error boundary component
function ErrorBoundary({ children }: { children: React.ReactNode }) {
  try {
    return <>{children}</>;
  } catch (error) {
    console.error('Error in IconsPage:', error);
    return <div>Error loading icons page</div>;
  }
}
