<description>Use basic React icons instead of Cal.com UI components</description>
<content>
import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';
import { 
  Calendar,
  Clock,
  User,
  Settings,
  Mail,
  Phone,
  Video,
  Link,
  Check,
  X,
  Plus,
  Trash,
  Search,
  Globe
} from 'lucide-react';

// Simple component that shows a grid of icons
function IconsPageContent() {
  const icons = [
    { Icon: Calendar, label: 'Calendar' },
    { Icon: Clock, label: 'Clock' },
    { Icon: User, label: 'User' },
    { Icon: Settings, label: 'Settings' },
    { Icon: Mail, label: 'Mail' },
    { Icon: Phone, label: 'Phone' },
    { Icon: Video, label: 'Video' },
    { Icon: Link, label: 'Link' },
    { Icon: Check, label: 'Check' },
    { Icon: X, label: 'X' },
    { Icon: Plus, label: 'Plus' },
    { Icon: Trash, label: 'Trash' },
    { Icon: Search, label: 'Search' },
    { Icon: Globe, label: 'Globe' }
  ];

  return (
    <div className="bg-subtle flex h-screen">
      <div className="bg-default m-auto min-w-full rounded-md p-10">
        <h1 className="text-emphasis font-cal text-2xl font-medium mb-8">Icons Showcase</h1>
        <div className="grid grid-cols-4 md:grid-cols-8 gap-4">
          {icons.map(({ Icon, label }) => (
            <div key={label} className="flex flex-col items-center justify-center p-4 border rounded">
              <Icon className="h-8 w-8 mb-2" />
              <span className="text-sm text-gray-600">{label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  return (
    <div className="h-screen w-full">
      <Suspense fallback={<div>Loading icons...</div>}>
        <ErrorBoundary>
          <IconsPageContent />
        </ErrorBoundary>
      </Suspense>
    </div>
  );
}

function ErrorBoundary({ children }: { children: React.ReactNode }) {
  try {
    return <>{children}</>;
  } catch (error) {
    console.error('Error in IconsPage:', error);
    return <div>Error loading icons page</div>;
  }
}
</content>
</change>
</file>

