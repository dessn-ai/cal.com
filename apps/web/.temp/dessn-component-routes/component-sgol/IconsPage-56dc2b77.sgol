import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';
import { IconSprites, Icon } from "@calcom/ui";

// Simple component that shows a grid of icons
function IconsPageContent() {
  const commonIcons = [
    "calendar",
    "clock",
    "user",
    "globe",
    "settings",
    "mail",
    "phone",
    "video",
    "link",
    "check",
    "x",
    "plus",
    "trash",
    "search"
  ];
  
  return (
    <div className="bg-subtle flex h-screen">
      <div className="bg-default m-auto min-w-full rounded-md p-10">
        <h1 className="text-emphasis font-cal text-2xl font-medium mb-8">Icons Showcase</h1>
        <div className="grid grid-cols-4 md:grid-cols-8 gap-4">
          {commonIcons.map((iconName) => (
            <div key={iconName} className="flex flex-col items-center justify-center p-4 border rounded">
              <Icon.FiCalendar className="h-8 w-8 mb-2" />
              <span className="text-sm text-gray-600">{iconName}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  return (
    <div className="h-screen w-full">
      <IconSprites />
      <Suspense fallback={<div>Loading icons...</div>}>
        <ErrorBoundary>
          <IconsPageContent />
        </ErrorBoundary>
      </Suspense>
    </div>
  );
}

function ErrorBoundary({ children }: { children: React.ReactNode }) {
  try {
    return <>{children}</>;
  } catch (error) {
    console.error('Error in IconsPage:', error);
    return <div>Error loading icons page</div>;
  }
}
</content>
