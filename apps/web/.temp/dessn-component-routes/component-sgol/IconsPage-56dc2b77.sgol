      <Suspense fallback={<div>Loading icons...</div>}>
        <ErrorBoundary>
          <IconsPageContent />
        </ErrorBoundary>
      </Suspense>
    </div>
  );
}

function ErrorBoundary({ children }: { children: React.ReactNode }) {
  try {
    return <>{children}</>;
  } catch (error) {
    console.error('Error in IconsPage:', error);
    return <div>Error loading icons page</div>;
  }
}
