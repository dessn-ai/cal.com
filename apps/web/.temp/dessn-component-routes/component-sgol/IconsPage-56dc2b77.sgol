import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/icons/page';
import { IconSprites } from "@calcom/ui";
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { trpc } from '@calcom/trpc/react';
import { httpBatchLink } from '@trpc/client';
import { I18nextProvider } from 'react-i18next';
import i18next from 'i18next';
import { SessionProvider } from 'next-auth/react';
import { TooltipProvider } from '@radix-ui/react-tooltip';
import { FeatureProvider } from '@calcom/features/flags/context/provider';

// Initialize i18next
const i18n = i18next.createInstance();
i18n.init({
  lng: 'en',
  resources: {},
});

// Initialize QueryClient
const queryClient = new QueryClient();

// Initialize TRPC Client
const trpcClient = trpc.createClient({
  links: [
    httpBatchLink({
      url: '/api/trpc',
    }),
  ],
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  return (
    <SessionProvider session={null}>
      <I18nextProvider i18n={i18n}>
        <trpc.Provider client={trpcClient} queryClient={queryClient}>
          <QueryClientProvider client={queryClient}>
            <TooltipProvider>
              <FeatureProvider>
                <IconSprites />
                <ImportedComponent />
              </FeatureProvider>
            </TooltipProvider>
          </QueryClientProvider>
        </trpc.Provider>
      </I18nextProvider>
    </SessionProvider>
  );
}
</content>
  </change>
</file>

The changes made include:

1. Added all necessary providers that were in the error stack:
   - SessionProvider
   - I18nextProvider
   - TRPCProvider
   - QueryClientProvider
   - TooltipProvider
   - FeatureProvider

2. Added required imports for all providers

3. Initialized necessary clients and instances:
   - QueryClient for React Query
   - TRPC Client
   - i18next instance

4. Wrapped the component tree with providers in the correct order as shown in the error stack

This should resolve the error by providing all the necessary context providers that the component might be depending on. The providers are added in the same order as they appear in the error stack to maintain the correct context hierarchy.

