import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/not-found';

// Mock the translation function
const mockT = (key: string) => key;

// Mock headers object
class MockHeaders {
  private headers: Map<string, string>;

  constructor(initialHeaders: Map<string, string>) {
    this.headers = initialHeaders;
  }

  get(name: string): string | null {
    return this.headers.get(name) || null;
  }
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    pathname: {
      type: "string",
      value: "/example-path",
      label: "Pathname",
    },
    host: {
      type: "string",
      value: "example.com",
      label: "Host",
    },
    isInsights: {
      type: "boolean",
      value: false,
      label: "Is Insights Page",
    },
  });

  const mockHeaders = new MockHeaders(new Map([
    ['x-pathname', state.pathname.value],
    ['x-forwarded-host', state.host.value],
    ['x-nonce', 'mock-nonce']
  ]));

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <div className="bg-white">
        <ImportedComponent t={mockT} headers={mockHeaders} />
      </div>
    </Suspense>
  );
}
</content>
</change>
</file>

