          useMutation: () => ({
            mutate: () => {},
          }),
        },
      },
    },
  };

  return (
    <TRPCProvider>
      <I18nLanguageHandler>
        <ImportedComponent />
      </I18nLanguageHandler>
    </TRPCProvider>
  );
}
