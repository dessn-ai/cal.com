import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/app-store/basecamp3/components/EventTypeAppCardInterface';
import { AppFeaturesProvider } from '@calcom/features/apps/context/appContext';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    eventType: {
      type: "object",
      value: {
        id: 1,
        title: "Sample Event",
        description: "This is a sample event description",
        teamId: null,
        length: 30,
        recurringEvent: null,
        seatsPerTimeSlot: null,
        team: null,
        schedulingType: "COLLECTIVE",
        URL: "https://example.com/event"
      },
      label: "Event Type"
    },
    app: {
      type: "object",
      value: {
        name: "Basecamp 3",
        slug: "basecamp3",
        logo: "https://example.com/basecamp3-logo.png",
        credentialOwner: {
          name: "John Doe",
          avatar: "https://example.com/avatar.png"
        },
        credentialIds: [1, 2, 3],
        categories: ["calendar"],
        enabled: true,
        dirName: "basecamp3",
        features: ["scheduling"]
      },
      label: "App"
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled"
    }
  });

  // Mock data for AppFeaturesProvider
  const features = {
    apps: {
      appCategoryList: ["calendar", "messaging", "other"],
      installedApps: [state.app.value],
      basecamp3: {
        enabled: true,
        features: ["scheduling"]
      }
    }
  };

  return (
    <AppFeaturesProvider features={features}>
      <ImportedComponent
        eventType={state.eventType.value}
        app={state.app.value}
        disabled={state.disabled.value}
      />
    </AppFeaturesProvider>
  );
}
</content>
