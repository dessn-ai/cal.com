import React from 'react';
import { useParentState } from '../useIframeState';
import PageWrapper from "@components/PageWrapper";

// Create a mock font object that matches the expected interface
const mockFont = {
  className: 'font-sans',
  style: {
    fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif'
  }
};

// Create a mock for any components that might use next/font
const MockFontProvider = ({ children }: { children: React.ReactNode }) => (
  <div className={mockFont.className} style={mockFont.style}>
    {children}
  </div>
);

// Basic loading and error components
const LoadingState = () => <div>Loading...</div>;
const ErrorState = () => <div>Error loading component</div>;

const TeamEmbedPreview = ({ 
  isEmbed = false,
  slug = "default-team",
  type = "default-type"
}: { 
  isEmbed?: boolean;
  slug?: string;
  type?: string;
}) => {
  return (
    <MockFontProvider>
      <div className="min-h-screen bg-white">
        <div className="max-w-4xl mx-auto p-8">
          <div className="space-y-6">
            <div className="border rounded-lg p-6 bg-gray-50">
              <h1 className="text-2xl font-semibold mb-4">Team Embed Component</h1>
              
              <div className="space-y-4">
                <div className="flex items-center">
                  <span className="font-medium w-24">Status:</span>
                  <span className="px-3 py-1 rounded-full text-sm bg-green-100 text-green-800">
                    Preview Mode
                  </span>
                </div>
                
                <div className="flex items-center">
                  <span className="font-medium w-24">Team Slug:</span>
                  <span>{slug}</span>
                </div>
                
                <div className="flex items-center">
                  <span className="font-medium w-24">Type:</span>
                  <span>{type}</span>
                </div>
                
                <div className="flex items-center">
                  <span className="font-medium w-24">Embed Mode:</span>
                  <span className={isEmbed ? "text-blue-600" : "text-gray-600"}>
                    {isEmbed ? "Enabled" : "Disabled"}
                  </span>
                </div>
              </div>
            </div>
            
            <div className="text-sm text-gray-500">
              This is a preview version of the team embed component.
              Some features might be limited in preview mode.
            </div>
          </div>
        </div>
      </div>
    </MockFontProvider>
  );
};

export default function ComponentPreview() {
  const [state] = useParentState({
    isEmbed: {
      type: "boolean",
      value: false,
      label: "Is Embed",
    },
  });

  return (
    <PageWrapper>
      <React.Suspense fallback={<LoadingState />}>
        <TeamEmbedPreview
          slug="preview-team"
          type="preview-type"
          isEmbed={state.isEmbed.value}
        />
      </React.Suspense>
    </PageWrapper>
  );
}
