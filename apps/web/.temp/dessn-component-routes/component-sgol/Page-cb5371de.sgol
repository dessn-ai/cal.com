<file path="apps/web/.temp/dessn-component-routes/Page-cb5371de.tsx">
  <change>
    <description>Implement module mocking and simplify component loading</description>
    <content>
import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';
import PageWrapper from "@components/PageWrapper";

// Mock the next/font/google module
const mockNextFontGoogle = {
  Inter: () => ({
    className: 'mock-inter-font',
    style: { fontFamily: 'Inter, sans-serif' }
  })
};

// Add this to global window object to handle potential imports
if (typeof window !== 'undefined') {
  (window as any).__next_font_google__ = mockNextFontGoogle;
}

// Simple component to render while loading
const LoadingComponent = () => <div>Loading...</div>;

// Simple component to render on error
const ErrorComponent = () => <div>Failed to load component</div>;

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    isEmbed: {
      type: "boolean",
      value: false,
      label: "Is Embed",
    },
  });

  const [Component, setComponent] = React.useState<React.ComponentType<any> | null>(null);
  const [error, setError] = React.useState<boolean>(false);

  React.useEffect(() => {
    const loadComponent = async () => {
      try {
        // Mock the font module before importing the component
        (window as any).nextFontGoogle = mockNextFontGoogle;
        
        const module = await import('../../pages/team/[slug]/[type]/embed');
        setComponent(() => module.default);
      } catch (err) {
        console.error('Failed to load component:', err);
        setError(true);
      }
    };

    loadComponent();
  }, []);

  if (error) {
    return <ErrorComponent />;
  }

  // Mock props that would normally come from getServerSideProps
  const mockSSRProps = {
    slug: "team-slug",
    type: "event-type",
    user: null,
    profile: null,
    eventType: null,
    team: null,
  };

  return (
    <PageWrapper>
      <Suspense fallback={<LoadingComponent />}>
        <ErrorBoundary>
          {Component ? (
            <Component 
              {...mockSSRProps}
              isEmbed={state.isEmbed.value}
            />
          ) : (
            <LoadingComponent />
          )}
        </ErrorBoundary>
      </Suspense>
    </PageWrapper>
  );
}

// Error Boundary Component
class ErrorBoundary extends React.Component<
  { children: React.ReactNode },
  { hasError: boolean }
> {
  constructor(props: { children: React.ReactNode }) {
    super(props);
    this.state = { hasError: false };
  }

  static getDerivedStateFromError(error: any) {
    return { hasError: true };
  }

  componentDidCatch(error: Error, errorInfo: React.ErrorInfo) {
    console.error('Error caught by boundary:', error, errorInfo);
  }

  render() {
    if (this.state.hasError) {
      return <ErrorComponent />;
    }

    return this.props.children;
  }
}
</content>
  </change>
</file>

