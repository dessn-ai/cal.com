import React, { Suspense, ErrorBoundary } from 'react';
import { useParentState } from '../useIframeState';

// Create a simple error boundary component
const ErrorFallback = ({ error }) => {
  return (
    <div role="alert">
      <p>Something went wrong:</p>
      <pre>{error.message}</pre>
    </div>
  );
};

const LoadingFallback = () => <div>Loading...</div>;

// Wrap the actual component import in a try-catch
const ImportedComponentWrapper = () => {
  try {
    // Using dynamic import to handle potential failures more gracefully
    const Component = React.lazy(() => import('../../app/(use-page-wrapper)/settings/(settings-layout)/organizations/attributes/create/page'));
    
    return (
      <Suspense fallback={<LoadingFallback />}>
        <Component />
      </Suspense>
    );
  } catch (error) {
    console.error('Failed to load component:', error);
    return <ErrorFallback error={error} />;
  }
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  return (
    <ErrorBoundary FallbackComponent={ErrorFallback}>
      <ImportedComponentWrapper />
    </ErrorBoundary>
  );
}
</content>
  </change>
</file>

