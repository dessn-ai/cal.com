import React from 'react';
import { useParentState } from '../useIframeState';
import { RadioGroup } from '@radix-ui/react-radio-group';

// Create a simplified RadioField component
const RadioField = ({
  value,
  disabled,
  id,
  label,
  withPadding
}: {
  value: string;
  disabled?: boolean;
  id: string;
  label: string;
  withPadding?: boolean;
}) => {
  return (
    <div style={{ padding: withPadding ? '16px' : '0' }}>
      <label
        htmlFor={id}
        style={{
          display: 'flex',
          alignItems: 'center',
          gap: '8px',
          cursor: disabled ? 'not-allowed' : 'pointer',
          opacity: disabled ? 0.5 : 1,
        }}
      >
        <input
          type="radio"
          id={id}
          value={value}
          disabled={disabled}
          name={id}
        />
        {label}
      </label>
    </div>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    value: {
      type: "string",
      value: "option1",
      label: "Selected Value",
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled",
    },
    id: {
      type: "string",
      value: "radio-example",
      label: "ID",
    },
    label: {
      type: "string",
      value: "Example Radio",
      label: "Label",
    },
    withPadding: {
      type: "boolean",
      value: true,
      label: "With Padding",
    },
  });

  return (
    <RadioGroup value={state.value.value}>
      <RadioField
        value={state.value.value}
        disabled={state.disabled.value}
        id={state.id.value}
        label={state.label.value}
        withPadding={state.withPadding.value}
      />
    </RadioGroup>
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Removed the import of `RadioField` from `@calcom/ui` since it's not available
2. Created a simplified `RadioField` component directly in the file
3. Maintained all the props and functionality but with a basic HTML radio input implementation
4. Kept the RadioGroup from @radix-ui/react-radio-group for consistency
5. Added basic styling to match common radio input patterns

This should resolve the import error while maintaining the core functionality of the radio component. The component will now use native HTML radio inputs with basic styling, and still work with the state management system in place.

