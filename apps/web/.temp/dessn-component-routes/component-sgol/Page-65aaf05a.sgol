import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/(use-page-wrapper)/settings/(settings-layout)/teams/page';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { SessionProvider } from 'next-auth/react';
import { I18nextProvider } from 'react-i18next';
import { TooltipProvider } from '@radix-ui/react-tooltip';
import i18next from 'i18next';

// Mock FeatureProvider
const FeatureProvider = ({ children }) => {
  return children;
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({});
  
  // Create a new QueryClient instance
  const queryClient = new QueryClient({
    defaultOptions: {
      queries: {
        retry: false,
        refetchOnWindowFocus: false,
      },
    },
  });

  // Initialize i18next
  const i18n = i18next.createInstance();
  i18n.init({
    fallbackLng: 'en',
    debug: false,
    resources: {
      en: {
        translation: {},
      },
    },
  });

  // Mock session
  const mockSession = {
    user: {
      id: 1,
      name: 'Test User',
      email: 'test@example.com',
    },
    expires: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString(),
  };

  // Mock the getTranslate function
  const mockGetTranslate = async () => (key: string) => key;

  try {
    return (
      <React.Suspense fallback={<div>Loading...</div>}>
        <SessionProvider session={mockSession}>
          <I18nextProvider i18n={i18n}>
            <QueryClientProvider client={queryClient}>
              <FeatureProvider>
                <TooltipProvider>
                  <ImportedComponent getTranslate={mockGetTranslate} />
                </TooltipProvider>
              </FeatureProvider>
            </QueryClientProvider>
          </I18nextProvider>
        </SessionProvider>
      </React.Suspense>
    );
  } catch (error) {
    console.error('Preview render error:', error);
    return <div>Error loading preview</div>;
  }
}
</content>
</change>
</file>

