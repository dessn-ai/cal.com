import React from 'react';
import { useParentState } from '../useIframeState';
import { EventTypeAppCard } from '../../../../packages/app-store/_components/EventTypeAppCardInterface';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    app: {
      type: "object",
      value: {
        name: "Sample App",
        slug: "sample-app",
      },
      label: "App",
    },
    eventType: {
      type: "object",
      value: {
        title: "Sample Event Type",
        description: "This is a sample event type",
        id: 1,
        length: 30,
        URL: "sample-event-type",
      },
      label: "Event Type",
    },
    LockedIcon: {
      type: "boolean",
      value: false,
      label: "Locked Icon",
    },
    eventTypeFormMetadata: {
      type: "object",
      value: {},
      label: "Event Type Form Metadata",
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled",
    },
  });

  // Define the functions locally instead of trying to pass them through state
  const getAppData = React.useCallback((key: string) => {
    console.log('getAppData called with:', key);
    return null;
  }, []);

  const setAppData = React.useCallback((key: string, value: unknown) => {
    console.log('setAppData called with:', key, value);
  }, []);

  return (
    <EventTypeAppCard
      app={state.app.value}
      eventType={state.eventType.value}
      getAppData={getAppData}
      setAppData={setAppData}
      LockedIcon={state.LockedIcon.value}
      eventTypeFormMetadata={state.eventTypeFormMetadata.value}
      disabled={state.disabled.value}
    />
  );
}
</content>
</change>
</file>

The changes made:

1. Removed the function definitions from the state object since they can't be serialized through postMessage
2. Created local function implementations using React.useCallback
3. Passed these local functions directly to the EventTypeAppCard component
4. Added basic console.log statements to track function calls
5. Made getAppData return null as a safe default value

This should resolve the DataCloneError as we're no longer trying to pass functions through the iframe communication channel. The functions are now defined locally within the component and don't need to be serialized.

