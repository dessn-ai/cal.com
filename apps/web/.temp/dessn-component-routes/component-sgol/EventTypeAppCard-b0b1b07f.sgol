import React from 'react';
import { EventTypeAppCard } from '../../../../packages/app-store/_components/EventTypeAppCardInterface';

export default function ComponentPreview() {
  // Mock data without any state management
  const mockApp = {
    name: "Sample App",
    slug: "sample-app",
  };

  const mockEventType = {
    title: "Sample Event Type",
    description: "This is a sample event type",
    id: 1,
    length: 30,
    URL: "sample-event-type",
  };

  // Simple mock functions
  function mockGetAppData() {
    return null;
  }

  function mockSetAppData() {
    return;
  }

  return (
    <EventTypeAppCard
      app={mockApp}
      eventType={mockEventType}
      getAppData={mockGetAppData}
      setAppData={mockSetAppData}
      LockedIcon={false}
      eventTypeFormMetadata={{}}
      disabled={false}
    />
  );
}
</content>
</change>
</file>

Key changes made:
1. Removed useParentState completely to avoid iframe communication issues
2. Defined static mock data directly in the component
3. Created simple function declarations instead of using useCallback
4. Simplified the overall component structure
5. Removed all state management that could trigger postMessage
6. Used direct values instead of accessing through state objects

This simplified version should avoid the DataCloneError since we're not trying to pass any functions through postMessage or state management. All the data is static and the functions are defined directly in the component scope.

