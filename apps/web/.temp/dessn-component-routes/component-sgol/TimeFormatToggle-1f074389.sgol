import React from 'react';
import { useParentState } from '../useIframeState';
import { TimeFormatToggle } from '../../../../packages/features/bookings/components/TimeFormatToggle';
import { TimeFormat } from '@calcom/lib/timeFormat';
import { useTimePreferences } from '../../../../packages/features/bookings/lib';
import { useLocale } from '@calcom/lib/hooks/useLocale';

// Mock the modules at the top level
jest.mock('../../../../packages/features/bookings/lib', () => ({
  useTimePreferences: () => ({
    timeFormat: TimeFormat.TWELVE_HOUR,
    setTimeFormat: () => {},
  }),
}));

jest.mock('@calcom/lib/hooks/useLocale', () => ({
  useLocale: () => ({
    t: (key: string) => key,
  }),
}));

// Create a wrapper component that provides the necessary context
const TimeFormatToggleWrapper = ({ customClassName }: { customClassName: string }) => {
  // Use React.useState directly in the component
  const [timeFormat, setTimeFormat] = React.useState(TimeFormat.TWELVE_HOUR);
  
  return (
    <TimeFormatToggle customClassName={customClassName} />
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    customClassName: {
      type: "string",
      value: "custom-class",
      label: "Custom Class Name",
    },
  });

  return <TimeFormatToggleWrapper customClassName={state.customClassName.value} />;
}
</content>
  </change>
</file>

The changes I made:

1. Removed the direct reassignment of React.useState which was causing the error
2. Properly mocked the modules using jest.mock at the top level
3. Created a wrapper component that properly uses React.useState
4. Kept the original component structure but wrapped the TimeFormatToggle in our new wrapper component
5. Maintained all the necessary imports and types

This should resolve the "Assignment to constant variable" error while still providing the necessary mocked functionality for the preview component.

The error occurred because we were trying to reassign React.useState directly, which isn't allowed in JavaScript/TypeScript. Instead, we're now mocking the modules properly using jest.mock and using React.useState correctly within a component context.

