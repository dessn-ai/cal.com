import React from 'react';
import { useParentState } from '../useIframeState';
import { NumberFilterOptions } from '../../../../packages/features/data-table/components/filters/NumberFilterOptions';
import { ColumnFilterType } from '../../../../packages/features/data-table/lib/types';

// Create a mock context and hook
const DataTableContext = React.createContext(null);

// Mock the useDataTable hook functionality
function MockDataTableWrapper({ children }) {
  const mockValue = {
    tableInstance: {
      getState: () => ({}),
      setFilterValue: () => {},
      getColumn: () => ({}),
    },
    tableState: {},
    setTableState: () => {},
  };

  return (
    <DataTableContext.Provider value={mockValue}>
      {children}
    </DataTableContext.Provider>
  );
}

// Override the useDataTable hook
React.createContext = () => DataTableContext;

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    columnId: {
      type: "string",
      value: "numberColumn",
      label: "Column ID",
    },
    columnTitle: {
      type: "string",
      value: "Number Column",
      label: "Column Title",
    },
  });

  const column = {
    id: state.columnId.value,
    title: state.columnTitle.value,
    type: ColumnFilterType.NUMBER,
  };

  return (
    <MockDataTableWrapper>
      <NumberFilterOptions column={column} />
    </MockDataTableWrapper>
  );
}
