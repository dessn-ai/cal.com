import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';

// Create mock components
const MockLegacyPage = () => <div>Mock LegacyPage</div>;
const MockSettingsHeader = ({ children, title, description }) => (
  <div>
    <h1>{title}</h1>
    <p>{description}</p>
    {children}
  </div>
);

// Mock modules before importing the component
jest.mock('@calcom/features/ee/teams/pages/team-appearance-view', () => ({
  __esModule: true,
  default: MockLegacyPage
}));

jest.mock('@calcom/features/settings/appDir/SettingsHeader', () => ({
  __esModule: true,
  default: MockSettingsHeader
}));

jest.mock('app/_utils', () => ({
  __esModule: true,
  _generateMetadata: () => ({}),
  getTranslate: () => Promise.resolve((key) => key),
}));

// Lazy load the component to handle dynamic imports better
const ImportedComponent = React.lazy(() => import('../../app/(use-page-wrapper)/settings/(settings-layout)/organizations/teams/other/[id]/appearance/page'));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // Add any required state here if needed
  });

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <ImportedComponent />
    </Suspense>
  );
}
</content>
  </change>
</file>

I've made several improvements to fix the error:

1. Added `Suspense` to handle the dynamic import loading
2. Improved the mocking structure by using `__esModule: true` to properly handle ES modules
3. Created the mock components outside the mock declarations for better clarity
4. Wrapped the imported component with `React.lazy()` and `Suspense` to handle the dynamic import more gracefully
5. Added a loading fallback for better user experience

The main changes address the "Failed to fetch dynamically imported module" error by:
- Using proper module mocking syntax
- Implementing React.lazy() for dynamic imports
- Adding Suspense wrapper to handle the loading state
- Ensuring all mocks are properly structured as ES modules

This should resolve the dynamic import error while maintaining the component's functionality.

