              translate: (key: string) => key,
              locale: 'en',
            },
          },
        ],
        paymentInfo: {
          link: 'https://example.com/payment',
          paymentOption: 'HOLD',
        },
      }),
      label: 'Calendar Event',
    },
    attendee: {
      type: 'string',
      value: JSON.stringify({
        name: 'John Doe',
        email: 'john@example.com',
        timeZone: 'America/Los_Angeles',
        language: {
          translate: (key: string) => key,
          locale: 'en',
        },
      }),
      label: 'Attendee',
