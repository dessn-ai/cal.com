    <description>Create a mock wrapper component with context simulation</description>
    <content>
import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/platform/atoms/event-types/wrappers/EventSetupTabWebWrapper';
import { SessionProvider } from 'next-auth/react';

// Create a mock context with the same shape as OrgBrandingProvider
const MockOrgBrandingContext = createContext({
  theme: null,
  orgSlug: 'default-org',
  hideBranding: false,
  orgFullDomain: 'default-org.cal.com',
  fullDomain: 'default-org.cal.com',
});

// Create a mock component that provides the context
const MockEventSetupTab = (props) => {
  return (
    <MockOrgBrandingContext.Provider
      value={{
        theme: null,
        orgSlug: 'default-org',
        hideBranding: false,
        orgFullDomain: 'default-org.cal.com',
        fullDomain: 'default-org.cal.com',
      }}
    >
      <ImportedComponent {...props} />
    </MockOrgBrandingContext.Provider>
  );
};

// Override the useOrgBranding hook
const useOrgBranding = () => useContext(MockOrgBrandingContext);

// Make the mock hook available globally
if (typeof window !== 'undefined') {
  window.useOrgBranding = useOrgBranding;
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    eventType: {
      type: 'string',
      value: '{"id": 1, "title": "Default Event"}',
      label: 'Event Type',
    },
    locationOptions: {
      type: 'string',
      value: '[]',
      label: 'Location Options',
    },
    team: {
      type: 'string',
      value: '{}',
      label: 'Team',
    },
    teamMembers: {
      type: 'string',
      value: '[]',
      label: 'Team Members',
    },
    destinationCalendar: {
      type: 'string',
      value: '{}',
      label: 'Destination Calendar',
    },
  });

  const mockSession = {
    data: {
      user: {
        org: {
          id: 1,
        },
      },
    },
    status: 'authenticated',
  };

  try {
    return (
      <SessionProvider session={mockSession as any}>
        <MockEventSetupTab
          eventType={JSON.parse(state.eventType.value)}
          locationOptions={JSON.parse(state.locationOptions.value)}
          team={JSON.parse(state.team.value)}
          teamMembers={JSON.parse(state.teamMembers.value)}
          destinationCalendar={JSON.parse(state.destinationCalendar.value)}
        />
      </SessionProvider>
    );
  } catch (error) {
    console.error('Error parsing JSON:', error);
    return <div>Error: Failed to parse component data</div>;
  }
}
</content>
  </change>
</file>

I made the following changes:

1. Created a MockOrgBrandingContext using React's createContext
2. Created a MockEventSetupTab component that provides the context
3. Defined a useOrgBranding hook that uses the mock context
4. Made the hook available globally only if window exists
5. Used the MockEventSetupTab instead of the direct ImportedComponent

This approach should work better because:
1. We're using React's built-in context system
2. We're not relying on require or module manipulation
3. The mock context is provided properly through React's context API
4. The hook is made available globally in a safe way
5. We maintain the proper React component hierarchy

The key difference in this approach is that we're creating our own context system that mimics the original one, rather than trying to override or modify the existing module. This should provide the necessary context while avoiding the "outside provider" error.

