// Create mock context and provider
const MockOrgBrandingContext = createContext({
  theme: null,
  orgSlug: 'default-org',
  hideBranding: false,
});

const MockOrgBrandingProvider = ({ children }) => {
  const value = {
    theme: null,
    orgSlug: 'default-org',
    hideBranding: false,
  };
  return (
    <MockOrgBrandingContext.Provider value={value}>
      {children}
    </MockOrgBrandingContext.Provider>
  );
};

// Override the original useOrgBranding hook
const useOrgBranding = () => useContext(MockOrgBrandingContext);

// Mock the module
window.useOrgBranding = useOrgBranding;

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    eventType: {
      type: 'string',
      value: '{"id": 1, "title": "Default Event"}',
