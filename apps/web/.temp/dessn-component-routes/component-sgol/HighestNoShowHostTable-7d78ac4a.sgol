import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { HighestNoShowHostTable } from '../../../../packages/features/insights/components/HighestNoShowHostTable';
import { trpc } from '@calcom/trpc';

// Mock contexts
const InsightsContext = createContext({
  teamId: 1,
  startDate: '',
  endDate: '',
  eventTypeId: 1,
  isAll: false,
});

const DataTableContext = createContext({
  data: [],
  isLoading: false,
  tableContainerRef: { current: null },
});

// Create HOC to inject mock hooks
const withMockHooks = (WrappedComponent) => {
  return function WithMockHooksComponent(props) {
    // Mock the useInsightsOrgTeams hook
    const mockInsightsOrgTeams = {
      selectedTeamId: 1,
      teams: [{ id: 1, name: 'Team 1' }],
      setSelectedTeamId: () => {},
    };

    // Mock the useInsightsParameters hook
    const mockInsightsParameters = {
      teamId: 1,
      startDate: new Date().toISOString(),
      endDate: new Date().toISOString(),
      eventTypeId: 1,
      isAll: false,
    };

    // Override the hooks in the component's scope
    window.useInsightsOrgTeams = () => mockInsightsOrgTeams;
    window.useInsightsParameters = () => mockInsightsParameters;

    return <WrappedComponent {...props} />;
  };
};

// Create wrapped version of HighestNoShowHostTable
const WrappedHighestNoShowHostTable = withMockHooks(HighestNoShowHostTable);

// Mock DataTableProvider
const DataTableProvider = ({ children }) => {
  return (
    <DataTableContext.Provider 
      value={{
        data: [],
        isLoading: false,
        tableContainerRef: { current: null },
      }}
    >
      {children}
    </DataTableContext.Provider>
  );
};

// Mock InsightsProvider
const InsightsProvider = ({ 
  children, 
  teamId, 
  startDate, 
  endDate, 
  eventTypeId, 
  isAll 
}) => {
  const value = {
    teamId,
    startDate,
    endDate,
    eventTypeId,
    isAll,
  };

  return (
    <InsightsContext.Provider value={value}>
      {children}
    </InsightsContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
    startDate: {
      type: "string",
      value: new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
      label: "Start Date",
    },
    endDate: {
      type: "string",
      value: new Date().toISOString().split('T')[0],
      label: "End Date",
    },
    eventTypeId: {
      type: "number",
      value: 1,
      label: "Event Type ID",
    },
    isAll: {
      type: "boolean",
      value: false,
      label: "Is All",
    },
  });

  return (
    <DataTableProvider>
      <InsightsProvider
        teamId={state.teamId.value}
        startDate={state.startDate.value}
        endDate={state.endDate.value}
        eventTypeId={state.eventTypeId.value}
        isAll={state.isAll.value}
      >
        <WrappedHighestNoShowHostTable />
      </InsightsProvider>
    </DataTableProvider>
  );
}
