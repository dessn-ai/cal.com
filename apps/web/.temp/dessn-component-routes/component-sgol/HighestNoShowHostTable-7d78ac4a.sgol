import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { HighestNoShowHostTable } from '../../../../packages/features/insights/components/HighestNoShowHostTable';
import { trpc } from '@calcom/trpc';

// Mock InsightsContext
const InsightsContext = createContext({
  teamId: 0,
  startDate: '',
  endDate: '',
  eventTypeId: 0,
  isAll: false,
});

// Mock DataTableContext
const DataTableContext = createContext({
  data: [],
  isLoading: false,
  tableContainerRef: { current: null },
});

// Mock InsightsOrgTeamsContext
const InsightsOrgTeamsContext = createContext({
  selectedTeamId: null,
  teams: [],
  setSelectedTeamId: () => {},
});

// Mock InsightsOrgTeamsProvider
const InsightsOrgTeamsProvider = ({ children }) => {
  return (
    <InsightsOrgTeamsContext.Provider
      value={{
        selectedTeamId: null,
        teams: [{ id: 1, name: 'Team 1' }],
        setSelectedTeamId: () => {},
      }}
    >
      {children}
    </InsightsOrgTeamsContext.Provider>
  );
};

// Mock DataTableProvider
const DataTableProvider = ({ children }) => {
  return (
    <DataTableContext.Provider 
      value={{
        data: [],
        isLoading: false,
        tableContainerRef: { current: null },
      }}
    >
      {children}
    </DataTableContext.Provider>
  );
};

// Mock InsightsProvider
const InsightsProvider = ({ 
  children, 
  teamId, 
  startDate, 
  endDate, 
  eventTypeId, 
  isAll 
}) => {
  const value = {
    teamId,
    startDate,
    endDate,
    eventTypeId,
    isAll,
  };

  return (
    <InsightsContext.Provider value={value}>
      {children}
    </InsightsContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
    startDate: {
      type: "string",
      value: new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
      label: "Start Date",
    },
    endDate: {
      type: "string",
      value: new Date().toISOString().split('T')[0],
      label: "End Date",
    },
    eventTypeId: {
      type: "number",
      value: 1,
      label: "Event Type ID",
    },
    isAll: {
      type: "boolean",
      value: false,
      label: "Is All",
    },
  });

  const queryClient = trpc.useContext();

  return (
    <InsightsOrgTeamsProvider>
      <DataTableProvider>
        <InsightsProvider
          teamId={state.teamId.value}
          startDate={state.startDate.value}
          endDate={state.endDate.value}
          eventTypeId={state.eventTypeId.value}
          isAll={state.isAll.value}
        >
          <HighestNoShowHostTable />
        </InsightsProvider>
      </DataTableProvider>
    </InsightsOrgTeamsProvider>
  );
