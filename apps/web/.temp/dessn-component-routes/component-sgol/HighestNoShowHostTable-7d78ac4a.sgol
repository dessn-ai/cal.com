  const mockTeams = [
    { id: 1, name: 'Team 1' },
    { id: 2, name: 'Team 2' },
  ];

  const contextValue = {
    teams: mockTeams,
    loading: false,
    error: null,
    selectedTeamId: 1,
    setSelectedTeamId: () => {},
  };

  return (
    <InsightsOrgTeamsContext.Provider value={contextValue}>
      {children}
