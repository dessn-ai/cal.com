<file path="apps/web/.temp/dessn-component-routes/HighestNoShowHostTable-7d78ac4a.tsx">
  <change>
    <description>Create HOC with mock hooks and simplify provider structure</description>
    <content>
import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { HighestNoShowHostTable } from '../../../../packages/features/insights/components/HighestNoShowHostTable';
import { trpc } from '@calcom/trpc';

// Mock contexts
const InsightsContext = createContext({
  teamId: 1,
  startDate: '',
  endDate: '',
  eventTypeId: 1,
  isAll: false,
});

const DataTableContext = createContext({
  data: [],
  isLoading: false,
  tableContainerRef: { current: null },
});

// Create HOC to inject mock hooks
const withMockHooks = (WrappedComponent) => {
  return function WithMockHooksComponent(props) {
    // Mock the useInsightsOrgTeams hook
    const mockInsightsOrgTeams = {
      selectedTeamId: 1,
      teams: [{ id: 1, name: 'Team 1' }],
      setSelectedTeamId: () => {},
    };

    // Mock the useInsightsParameters hook
    const mockInsightsParameters = {
      teamId: 1,
      startDate: new Date().toISOString(),
      endDate: new Date().toISOString(),
      eventTypeId: 1,
      isAll: false,
    };

    // Override the hooks in the component's scope
    window.useInsightsOrgTeams = () => mockInsightsOrgTeams;
    window.useInsightsParameters = () => mockInsightsParameters;

    return <WrappedComponent {...props} />;
  };
};

// Create wrapped version of HighestNoShowHostTable
const WrappedHighestNoShowHostTable = withMockHooks(HighestNoShowHostTable);

// Mock DataTableProvider
const DataTableProvider = ({ children }) => {
  return (
    <DataTableContext.Provider 
      value={{
        data: [],
        isLoading: false,
        tableContainerRef: { current: null },
      }}
    >
      {children}
    </DataTableContext.Provider>
  );
};

// Mock InsightsProvider
const InsightsProvider = ({ 
  children, 
  teamId, 
  startDate, 
  endDate, 
  eventTypeId, 
  isAll 
}) => {
  const value = {
    teamId,
    startDate,
    endDate,
    eventTypeId,
    isAll,
  };

  return (
    <InsightsContext.Provider value={value}>
      {children}
    </InsightsContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
    startDate: {
      type: "string",
      value: new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
      label: "Start Date",
    },
    endDate: {
      type: "string",
      value: new Date().toISOString().split('T')[0],
      label: "End Date",
    },
    eventTypeId: {
      type: "number",
      value: 1,
      label: "Event Type ID",
    },
    isAll: {
      type: "boolean",
      value: false,
      label: "Is All",
    },
  });

  return (
    <DataTableProvider>
      <InsightsProvider
        teamId={state.teamId.value}
        startDate={state.startDate.value}
        endDate={state.endDate.value}
        eventTypeId={state.eventTypeId.value}
        isAll={state.isAll.value}
      >
        <WrappedHighestNoShowHostTable />
      </InsightsProvider>
    </DataTableProvider>
  );
}
</content>
  </change>
</file>

I've made the following significant changes:
1. Created a HOC (withMockHooks) to inject mock hooks
2. Removed the problematic context-based approach
3. Directly mocked both useInsightsOrgTeams and useInsightsParameters hooks
4. Simplified the provider structure
5. Created a wrapped version of HighestNoShowHostTable with mock hooks

Key improvements:
1. More direct hook mocking approach
2. Removed unnecessary provider complexity
3. Hooks are available before component rendering
4. Simpler component hierarchy
5. All required data is mocked

The component hierarchy is now:
```
DataTableProvider
  └─ InsightsProvider
      └─ WrappedHighestNoShowHostTable (with mock hooks)
          └─ HighestNoShowHostTable
```

This approach should work better because:
1. It injects the mocks directly where they're needed
2. It doesn't rely on context propagation
3. It provides all necessary mock data
4. It's simpler and more maintainable
5. It ensures hooks are available when the component needs them

