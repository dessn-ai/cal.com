import React from 'react';
import { useParentState } from '../useIframeState';
import { UserListTable } from "../../../../packages/features/users/components/UserTable/UserListTable";
import { DataTableProvider } from "@calcom/features/data-table";
import { TooltipProvider } from "@radix-ui/react-tooltip";
import { QueryClient, QueryClientProvider } from "@tanstack/react-query";

export default function ComponentPreview() {
  const queryClient = new QueryClient({
    defaultOptions: {
      queries: {
        retry: false,
        refetchOnWindowFocus: false,
      },
    },
  });

  const [state, setState] = useParentState({
    users: {
      type: "array",
      value: [
        {
          id: 1,
          name: "John Doe",
          email: "john@example.com",
          username: "johndoe",
          role: "ADMIN",
          createdAt: new Date().toISOString(),
        },
        {
          id: 2,
          name: "Jane Smith",
          email: "jane@example.com",
          username: "janesmith",
          role: "USER",
          createdAt: new Date().toISOString(),
        },
      ],
      label: "Users",
    },
  });

  return (
    <QueryClientProvider client={queryClient}>
      <TooltipProvider>
        <DataTableProvider>
          <UserListTable users={state.users.value} />
        </DataTableProvider>
      </TooltipProvider>
    </QueryClientProvider>
  );
}
</content>
  </change>
</file>

I've made the following changes to the UserListTable preview file:
1. Removed the JotaiProvider import and usage
2. Kept the necessary providers: QueryClientProvider, TooltipProvider, and DataTableProvider
3. Set up a QueryClient instance with default options
4. Added mock user data for the UserListTable component
5. Properly nested the providers in the correct order

The ConnectedCalendarItem preview file looks correct as is, so we don't need to modify it.

The changes should resolve the jotai dependency error while maintaining the functionality of the UserListTable component with the necessary context providers.

