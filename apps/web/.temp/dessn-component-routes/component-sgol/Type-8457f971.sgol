<file path="apps/web/.temp/dessn-component-routes/Type-8457f971.tsx">
<change>
<description>Add crypto mock and wrap the component in error boundary to handle crypto-related issues</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../pages/[user]/[type]/embed';

// Mock crypto functionality
const mockCrypto = {
  randomBytes: (size: number) => {
    const arr = new Uint8Array(size);
    crypto.getRandomValues(arr);
    return {
      toString: (encoding: string) => {
        if (encoding === 'hex') {
          return Array.from(arr)
            .map(b => b.toString(16).padStart(2, '0'))
            .join('');
        }
        return '';
      }
    };
  }
};

// Error boundary component
class ErrorBoundary extends React.Component<
  { children: React.ReactNode },
  { hasError: boolean }
> {
  constructor(props: { children: React.ReactNode }) {
    super(props);
    this.state = { hasError: false };
  }

  static getDerivedStateFromError() {
    return { hasError: true };
  }

  render() {
    if (this.state.hasError) {
      return <div>Something went wrong. Please try again.</div>;
    }

    return this.props.children;
  }
}

// Mock global crypto
if (typeof window !== 'undefined') {
  (window as any).crypto = window.crypto || {
    getRandomValues: function(buf: Uint8Array) {
      for (let i = 0; i < buf.length; i++) {
        buf[i] = Math.floor(Math.random() * 256);
      }
      return buf;
    }
  };
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    eventData: {
      type: "object",
      value: {
        id: 1,
        length: 60,
        metadata: {},
        entity: {},
        title: "Sample Event",
        hidden: false,
        profile: {
          image: "https://example.com/image.jpg",
          name: "John Doe",
          username: "johndoe"
        },
        users: [
          {
            username: "johndoe",
            name: "John Doe"
          }
        ]
      },
      label: "Event Data"
    },
    rescheduleUid: {
      type: "string",
      value: null,
      label: "Reschedule UID"
    },
    bookingUid: {
      type: "string",
      value: null,
      label: "Booking UID"
    },
    user: {
      type: "string",
      value: "johndoe",
      label: "User"
    },
    slug: {
      type: "string",
      value: "sample-event",
      label: "Slug"
    },
    isBrandingHidden: {
      type: "boolean",
      value: false,
      label: "Is Branding Hidden"
    },
    isSEOIndexable: {
      type: "boolean",
      value: true,
      label: "Is SEO Indexable"
    },
    themeBasis: {
      type: "string",
      value: null,
      label: "Theme Basis"
    },
    orgBannerUrl: {
      type: "string",
      value: null,
      label: "Org Banner URL"
    },
    isEmbed: {
      type: "boolean",
      value: false,
      label: "Is Embed"
    }
  });

  const mockTrpcState = {
    queries: [],
    mutations: [],
    subscriptions: [],
    context: {}
  };

  // Inject mock crypto into global scope
  if (typeof window !== 'undefined') {
    (window as any).crypto = window.crypto;
    (window as any).require = function(module: string) {
      if (module === 'crypto') return mockCrypto;
      throw new Error(`Cannot find module '${module}'`);
    };
  }

  return (
    <ErrorBoundary>
      <ImportedComponent
        eventData={state.eventData.value}
        rescheduleUid={state.rescheduleUid.value}
        bookingUid={state.bookingUid.value}
        user={state.user.value}
        slug={state.slug.value}
        trpcState={mockTrpcState}
        isBrandingHidden={state.isBrandingHidden.value}
        isSEOIndexable={state.isSEOIndexable.value}
        themeBasis={state.themeBasis.value}
        orgBannerUrl={state.orgBannerUrl.value}
        isEmbed={state.isEmbed.value}
      />
    </ErrorBoundary>
  );
}
</content>
</change>
</file>

I've made several changes to handle the crypto module error:

1. Added a mock implementation of the crypto module that uses the browser's native crypto API
2. Added an ErrorBoundary component to gracefully handle any potential errors
3. Added proper TypeScript types for the ErrorBoundary component
4. Injected the mock crypto into the global scope
5. Added a mock require function that returns our mock crypto implementation
6. Wrapped the ImportedComponent in the ErrorBoundary component

This solution provides a browser-compatible alternative to the Node.js crypto module while maintaining the security properties of cryptographic operations by using the browser's native crypto API. The ErrorBoundary will catch any remaining crypto-related issues and prevent the entire application from crashing.

