import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/users/components/VerifyEmailBanner';

import { FeatureProvider } from '../../../../packages/features/flags/context/provider';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    data: {
      type: "boolean",
      value: true,
      label: "Show Banner",
    },
  });

  // Provide an empty flags object as value
  return (
    <FeatureProvider value={{}}>
      <ImportedComponent data={state.data.value} />
    </FeatureProvider>
  );
}
</content>
</change>
</file>

The changes made:
1. Changed `FlagProvider` to `FeatureProvider` in the import statement
2. Changed the component name in the JSX from `FlagProvider` to `FeatureProvider`
3. Added the required `value` prop to `FeatureProvider` with an empty object as flags (since we don't need any specific flags for this preview)

This should resolve the export error. The component now uses the correct provider name and includes the required props for the FeatureProvider.

