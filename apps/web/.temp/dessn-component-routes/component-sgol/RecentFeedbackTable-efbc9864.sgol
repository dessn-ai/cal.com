import React from 'react';
import { useParentState } from '../useIframeState';
import { RecentFeedbackTable } from '../../../../packages/features/insights/components/RecentFeedbackTable';

// Mock InsightsProvider context
const InsightsContext = React.createContext({});

// Mock InsightsOrgTeams Context
const InsightsOrgTeamsContext = React.createContext({});

// Mock TRPC Context
const TRPCContext = React.createContext({});

const MockTRPCProvider = ({ children }) => {
  const mockValue = {
    client: {},
    queryClient: {
      getQueryData: () => null,
      setQueryData: () => null,
    },
  };

  return (
    <TRPCContext.Provider value={mockValue}>
      {children}
    </TRPCContext.Provider>
  );
};

const MockInsightsOrgTeamsProvider = ({ children }) => {
  const mockValue = {
    selectedTeamId: -1,
    setSelectedTeamId: () => {},
    teams: [],
    isLoading: false,
    orgMembers: [],
    currentOrg: { id: 1, name: 'Mock Org' },
    currentTeam: { id: -1, name: 'All Teams' },
  };

  return (
    <InsightsOrgTeamsContext.Provider value={mockValue}>
      {children}
    </InsightsOrgTeamsContext.Provider>
  );
};

const MockInsightsProvider = ({ children }) => {
  const mockValue = {
    insights: [],
    isLoading: false,
    error: null,
    dateRange: { startDate: new Date(), endDate: new Date() },
    setDateRange: () => {},
    selectedFilter: 'all',
    setSelectedFilter: () => {},
    selectedUserId: null,
    setSelectedUserId: () => {},
  };

  return (
    <InsightsContext.Provider value={mockValue}>
      {children}
    </InsightsContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to set for this component
  });

  return (
    <MockTRPCProvider>
      <MockInsightsOrgTeamsProvider>
        <MockInsightsProvider>
          <RecentFeedbackTable />
        </MockInsightsProvider>
      </MockInsightsOrgTeamsProvider>
    </MockTRPCProvider>
  );
}
</content>
</change>
</file>

