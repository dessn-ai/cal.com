<content>
import React, { createContext, useContext, useState } from 'react';
import { useParentState } from '../useIframeState';
import { RecentFeedbackTable } from '../../../../packages/features/insights/components/RecentFeedbackTable';

// Create the context with the same shape as the original
const InsightsOrgTeamsContext = createContext<{
  orgTeamsType: 'org' | 'team' | 'yours';
  selectedTeamId: number | null;
  setOrgTeamsType: (type: 'org' | 'team' | 'yours') => void;
  setSelectedTeamId: (id: number | null) => void;
} | null>(null);

// Mock InsightsOrgTeamsProvider
const MockInsightsOrgTeamsProvider = ({ children }: { children: React.ReactNode }) => {
  const [orgTeamsType, setOrgTeamsType] = useState<'org' | 'team' | 'yours'>('org');
  const [selectedTeamId, setSelectedTeamId] = useState<number | null>(null);

  return (
    <InsightsOrgTeamsContext.Provider
      value={{
        orgTeamsType,
        selectedTeamId,
        setOrgTeamsType,
        setSelectedTeamId,
      }}>
      {children}
    </InsightsOrgTeamsContext.Provider>
  );
};

// Mock session provider
const MockSessionProvider = ({ children }: { children: React.ReactNode }) => {
  const mockSession = {
    data: {
      user: {
        id: 1,
        org: {
          id: 1
        }
      }
    }
  };
  return <>{children}</>;
};

// Mock TRPCProvider
const MockTRPCProvider = ({ children }: { children: React.ReactNode }) => {
  return <>{children}</>;
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to set for this component
  });

  return (
    <MockSessionProvider>
      <MockTRPCProvider>
        <MockInsightsOrgTeamsProvider>
          <RecentFeedbackTable />
        </MockInsightsOrgTeamsProvider>
      </MockTRPCProvider>
    </MockSessionProvider>
  );
}
</content>
</change>
</file>

