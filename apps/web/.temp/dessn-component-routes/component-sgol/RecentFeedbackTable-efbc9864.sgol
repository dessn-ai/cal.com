import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { RecentFeedbackTable } from '../../../../packages/features/insights/components/RecentFeedbackTable';

// Create the exact context that the original code is looking for
export const InsightsOrgTeamsContext = createContext({
  selectedTeamId: -1,
  setSelectedTeamId: () => {},
  teams: [],
  isLoading: false,
  orgMembers: [],
  currentOrg: { id: 1, name: 'Mock Org' },
  currentTeam: { id: -1, name: 'All Teams' },
});

// Create the exact hook that the component is trying to use
export const useInsightsOrgTeams = () => {
  const context = useContext(InsightsOrgTeamsContext);
  if (!context) {
    throw new Error('useInsightsOrgTeams must be used within a InsightsOrgTeamsProvider');
  }
  return context;
};

const InsightsContext = createContext({
  insights: [],
  isLoading: false,
  error: null,
  dateRange: { startDate: new Date(), endDate: new Date() },
  setDateRange: () => {},
  selectedFilter: 'all',
  setSelectedFilter: () => {},
  selectedUserId: null,
  setSelectedUserId: () => {},
  parameters: {
    selectedTeamId: -1,
    dateRange: { startDate: new Date(), endDate: new Date() },
    selectedFilter: 'all',
    selectedUserId: null,
  }
});

const TRPCContext = createContext({
  client: {},
  queryClient: {
    getQueryData: () => null,
    setQueryData: () => null,
  }
});

const MockTRPCProvider = ({ children }) => (
  <TRPCContext.Provider value={{
    client: {},
    queryClient: {
      getQueryData: () => null,
      setQueryData: () => null,
    }
  }}>
    {children}
  </TRPCContext.Provider>
);

const MockInsightsProvider = ({ children }) => (
  <InsightsContext.Provider value={{
    insights: [],
    isLoading: false,
    error: null,
    dateRange: { startDate: new Date(), endDate: new Date() },
    setDateRange: () => {},
    selectedFilter: 'all',
    setSelectedFilter: () => {},
    selectedUserId: null,
    setSelectedUserId: () => {},
    parameters: {
      selectedTeamId: -1,
      dateRange: { startDate: new Date(), endDate: new Date() },
      selectedFilter: 'all',
      selectedUserId: null,
    }
  }}>
    {children}
  </InsightsContext.Provider>
);

const InsightsOrgTeamsProvider = ({ children }) => {
  const value = {
    selectedTeamId: -1,
    setSelectedTeamId: () => {},
    teams: [],
    isLoading: false,
    orgMembers: [],
    currentOrg: { id: 1, name: 'Mock Org' },
    currentTeam: { id: -1, name: 'All Teams' },
  };

  return (
    <InsightsOrgTeamsContext.Provider value={value}>
      {children}
    </InsightsOrgTeamsContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  try {
    return (
      <MockTRPCProvider>
        <InsightsOrgTeamsProvider>
          <MockInsightsProvider>
            <RecentFeedbackTable />
          </MockInsightsProvider>
        </InsightsOrgTeamsProvider>
      </MockTRPCProvider>
    );
  } catch (error) {
    console.error('Error rendering RecentFeedbackTable:', error);
    return <div>Error loading feedback table</div>;
  }
}
