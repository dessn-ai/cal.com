import React from 'react';
import { useParentState } from '../useIframeState';
import { OrganizerAddGuestsEmail } from '../../../../packages/emails/src/templates/OrganizerAddGuestsEmail';

// Define TimeFormat enum locally instead of importing
enum TimeFormat {
  TWELVE_HOUR = '12h',
  TWENTY_FOUR_HOUR = '24h'
}

export default function ComponentPreview() {
  // Define translation function within the component
  const translate = React.useCallback((key: string, vars?: Record<string, unknown>) => {
    try {
      if (typeof key !== 'string') return '';
      return key;
    } catch (error) {
      return key;
    }
  }, []);

  const [state, setState] = useParentState({
    calEvent: {
      type: 'string',
      value: JSON.stringify({
        type: 'default',
        title: 'Meeting',
        startTime: '2023-06-01T10:00:00',
        endTime: '2023-06-01T11:00:00',
        organizer: {
          name: 'John Doe',
          email: 'john@example.com',
          timeZone: 'America/New_York',
          language: { locale: 'en' },
        },
        attendees: [
          {
            name: 'Jane Smith',
            email: 'jane@example.com',
            timeZone: 'America/Los_Angeles',
            language: { locale: 'en' },
          },
        ],
        description: null,
        location: null,
        uid: '123',
        additionalNotes: null,
        customInputs: {},
        responses: null,
        userFieldsResponses: {},
      }),
      label: 'Calendar Event',
    },
    attendee: {
      type: 'string',
      value: JSON.stringify({
        name: 'Jane Smith',
        email: 'jane@example.com',
        timeZone: 'America/Los_Angeles',
        language: { locale: 'en' },
      }),
      label: 'Attendee',
    },
    newSeat: {
      type: 'boolean',
      value: false,
      label: 'New Seat',
    },
    attendeeCancelled: {
      type: 'boolean',
      value: false,
      label: 'Attendee Cancelled',
    },
    timeZone: {
      type: 'string',
      value: 'America/New_York',
      label: 'Time Zone',
    },
    includeAppsStatus: {
      type: 'boolean',
      value: false,
      label: 'Include Apps Status',
    },
    locale: {
      type: 'string',
      value: 'en',
      label: 'Locale',
    },
    timeFormat: {
      type: 'dropdown',
      value: TimeFormat.TWELVE_HOUR,
      options: Object.values(TimeFormat),
      label: 'Time Format',
    },
    isOrganizer: {
      type: 'boolean',
      value: true,
      label: 'Is Organizer',
    },
  });

  const calEvent = React.useMemo(() => {
    const parsed = JSON.parse(state.calEvent.value);
    return {
      ...parsed,
      language: {
        translate,
        locale: 'en',
      },
    };
  }, [state.calEvent.value, translate]);

  const attendee = React.useMemo(() => {
    const parsed = JSON.parse(state.attendee.value);
    return {
      ...parsed,
      language: {
        translate,
        locale: 'en',
      },
    };
  }, [state.attendee.value, translate]);

  return (
    <OrganizerAddGuestsEmail
      calEvent={calEvent}
      attendee={attendee}
      newSeat={state.newSeat.value}
      attendeeCancelled={state.attendeeCancelled.value}
      timeZone={state.timeZone.value}
      includeAppsStatus={state.includeAppsStatus.value}
      t={translate}
      locale={state.locale.value}
      timeFormat={state.timeFormat.value as TimeFormat}
      isOrganizer={state.isOrganizer.value}
    />
  );
}
</content>
  </change>
</file>

I've made several important changes:

1. Removed the Context API approach and simplified the translation handling
2. Created a stable translation function using `useCallback`
3. Added error handling to the translation function
4. Enhanced the calEvent object with additional required fields
5. Added proper memoization for calEvent and attendee objects
6. Ensured the translation function is properly bound and stable across renders
7. Added proper language objects with translate function to both calEvent and attendee
8. Simplified the overall structure while maintaining necessary functionality

The key changes are:
- Using a simpler, more direct approach to translation
- Ensuring the translation function is properly typed and stable
- Adding proper error handling
- Including all necessary fields in the calEvent object
- Using proper memoization to prevent unnecessary rerenders
- Ensuring the translation function is available in all required places

This should resolve the "t is not a function" error by providing a stable, properly bound translation function that's available everywhere it's needed.

