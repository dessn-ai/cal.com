}

// Create a simple translation context
const TranslationContext = React.createContext<{
  t: (key: string, vars?: Record<string, string>) => string;
}>({
  t: (key) => key,
});

const TranslationProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const t = React.useCallback((key: string, vars?: Record<string, string>) => {
    if (!key) return '';
    if (vars) {
      return Object.entries(vars).reduce((acc, [k, value]) => {
        return acc.replace(new RegExp(`{{${k}}}`, 'g'), value);
      }, key);
    }
    return key;
  }, []);

  return (
    <TranslationContext.Provider value={{ t }}>
      {children}
    </TranslationContext.Provider>
  );
};

