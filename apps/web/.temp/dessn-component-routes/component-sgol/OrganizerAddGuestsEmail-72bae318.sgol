    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { OrganizerAddGuestsEmail } from '../../../../packages/emails/src/templates/OrganizerAddGuestsEmail';
import i18next from 'i18next';
import { I18nextProvider, initReactI18next } from 'react-i18next';

// Define TimeFormat enum locally instead of importing
enum TimeFormat {
  TWELVE_HOUR = '12h',
  TWENTY_FOUR_HOUR = '24h'
}

// Initialize i18next
i18next
  .use(initReactI18next)
  .init({
    resources: {},
    lng: 'en',
    fallbackLng: 'en',
    interpolation: {
      escapeValue: false,
    },
  });

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    calEvent: {
      type: 'string',
      value: JSON.stringify({
        type: 'default',
        title: 'Meeting',
        startTime: '2023-06-01T10:00:00',
        endTime: '2023-06-01T11:00:00',
        organizer: {
          name: 'John Doe',
          email: 'john@example.com',
          timeZone: 'America/New_York',
          language: { locale: 'en' },
        },
        attendees: [
          {
            name: 'Jane Smith',
            email: 'jane@example.com',
            timeZone: 'America/Los_Angeles',
            language: { locale: 'en' },
          },
        ],
      }),
      label: 'Calendar Event',
    },
    attendee: {
      type: 'string',
      value: JSON.stringify({
        name: 'Jane Smith',
        email: 'jane@example.com',
        timeZone: 'America/Los_Angeles',
        language: { locale: 'en' },
      }),
      label: 'Attendee',
    },
    newSeat: {
      type: 'boolean',
      value: false,
      label: 'New Seat',
    },
    attendeeCancelled: {
      type: 'boolean',
      value: false,
      label: 'Attendee Cancelled',
    },
    timeZone: {
      type: 'string',
      value: 'America/New_York',
      label: 'Time Zone',
    },
    includeAppsStatus: {
      type: 'boolean',
      value: false,
      label: 'Include Apps Status',
    },
    locale: {
      type: 'string',
      value: 'en',
      label: 'Locale',
    },
    timeFormat: {
      type: 'dropdown',
      value: TimeFormat.TWELVE_HOUR,
      options: Object.values(TimeFormat),
      label: 'Time Format',
    },
    isOrganizer: {
      type: 'boolean',
      value: true,
      label: 'Is Organizer',
    },
  });

  // Create a translation function that matches i18next's interface
  const t = React.useCallback((key: string, vars?: Record<string, any>) => {
    if (typeof key !== 'string') return '';
    if (vars && typeof vars === 'object') {
      return i18next.t(key, vars);
    }
    return key;
  }, []);

  // Add the required properties to the translation function
  Object.assign(t, {
    exists: (key: string) => true,
    locale: 'en'
  });

  return (
    <I18nextProvider i18n={i18next}>
      <OrganizerAddGuestsEmail
        calEvent={JSON.parse(state.calEvent.value)}
        attendee={JSON.parse(state.attendee.value)}
        newSeat={state.newSeat.value}
        attendeeCancelled={state.attendeeCancelled.value}
        timeZone={state.timeZone.value}
        includeAppsStatus={state.includeAppsStatus.value}
        t={t}
        locale={state.locale.value}
        timeFormat={state.timeFormat.value as TimeFormat}
        isOrganizer={state.isOrganizer.value}
      />
    </I18nextProvider>
  );
}
</content>
  </change>
</file>

I've made the following significant changes:
1. Added i18next and react-i18next imports
2. Initialized i18next with basic configuration
3. Wrapped the component with I18nextProvider
4. Created a translation function using React.useCallback that uses i18next
5. Simplified the calEvent and attendee language objects
6. Added proper type assignments to the translation function
7. Wrapped the component with I18nextProvider to provide translation context

The key changes are:
- Using actual i18next instance instead of a mock
- Providing proper i18next context through I18nextProvider
- Creating a more compatible translation function that uses i18next
- Simplifying the language objects in the state

This should resolve the "t is not a function" error by providing a proper i18next setup and translation function that matches what the email template component expects.

