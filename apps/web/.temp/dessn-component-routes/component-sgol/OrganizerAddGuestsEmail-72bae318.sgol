import React from 'react';
import { useParentState } from "../useIframeState";
import { DateRangeFilter } from "../../../../packages/features/data-table/components/filters/DateRangeFilter";

// Mock the necessary types and context
type ColumnFilterType = {
  type: string;
  value: any;
  isRange?: boolean;
};

// Create a mock DataTableProvider component
const DataTableProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  return (
    <div data-testid="mock-data-table-provider">
      {children}
    </div>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    columnFilter: {
      type: 'object',
      value: {
        type: 'date',
        value: {
          from: new Date().toISOString(),
          to: new Date().toISOString(),
        },
        isRange: true,
      } as ColumnFilterType,
      label: 'Column Filter',
    },
  });

  return (
    <DataTableProvider>
      <DateRangeFilter
        columnFilter={state.columnFilter.value}
        setColumnFilter={(filter) => {
          setState({
            ...state,
            columnFilter: {
              ...state.columnFilter,
              value: filter,
            },
          });
        }}
      />
    </DataTableProvider>
  );
}
