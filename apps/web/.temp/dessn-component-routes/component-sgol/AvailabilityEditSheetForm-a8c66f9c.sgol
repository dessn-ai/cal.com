import React from 'react';
import { useParentState } from '../useIframeState';
import { AvailabilityEditSheetForm } from '../../../../packages/features/timezone-buddy/components/AvailabilityEditSheet';
import { useForm } from 'react-hook-form';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    open: {
      type: "boolean",
      value: true,
      label: "Open",
    },
    selectedUser: {
      type: "dropdown",
      value: "user1",
      options: ["user1", "user2", "user3"],
      label: "Selected User",
    },
  });

  const mockUser = {
    id: 1,
    username: "johndoe",
    name: "John Doe",
    organizationId: 1,
    avatarUrl: "https://example.com/avatar.jpg",
    email: "john@example.com",
    timeZone: "America/New_York",
    role: "MEMBER",
    defaultScheduleId: null,
    dateRanges: [],
    profile: {
      id: 1,
      upId: "123",
      username: "johndoe",
      organizationId: null,
      organization: null,
    },
  };

  const mockData = {
    id: 1,
    name: "Default Schedule",
    availability: [
      {
        userId: 1,
        days: [0, 1, 2, 3, 4],
        startTime: 540, // 9:00 AM in minutes
        endTime: 1020,  // 5:00 PM in minutes
        scheduleId: 1
      }
    ],
    dateOverrides: [],
    timeZone: "America/New_York",
    workingHours: [
      {
        userId: 1,
        days: [0, 1, 2, 3, 4],
        startTime: 540,
        endTime: 1020,
        scheduleId: 1
      }
    ],
    isDefault: true,
    hasDefaultSchedule: true,
    isManaged: false,
    schedule: {
      id: 1,
      userId: 1,
      name: "Default Schedule",
      timeZone: "America/New_York",
      availability: [
        {
          userId: 1,
          days: [0, 1, 2, 3, 4],
          startTime: 540,
          endTime: 1020,
          scheduleId: 1
        }
      ]
    },
    isLastSchedule: false,
    readOnly: false,
  };

  return (
    <AvailabilityEditSheetForm
      open={state.open.value}
      onOpenChange={(open) => setState('open', open)}
      selectedUser={state.selectedUser.value === "user1" ? mockUser : null}
      data={mockData}
      isPending={false}
    />
  );
}
</content>
  </change>
</file>

I've made several important changes to the mock data:

1. Changed the time format to use minutes instead of time strings (540 = 9:00 AM, 1020 = 5:00 PM)
2. Flattened the availability array structure (removed the nested array)
3. Added required fields like `userId` and `scheduleId` to the availability objects
4. Changed the `schedule` property to be an object instead of an array
5. Made sure all availability objects have consistent structure
6. Removed the unused form variable since it wasn't being used
7. Made sure the availability objects match the expected format with proper fields

The error was likely occurring because the Schedule component expects availability data in a specific format with times in minutes and certain required fields. This new structure should better match what the component expects.

