        [{ start: new Date("2024-01-01T09:00:00"), end: new Date("2024-01-01T17:00:00") }],
        [{ start: new Date("2024-01-01T09:00:00"), end: new Date("2024-01-01T17:00:00") }],
        [{ start: new Date("2024-01-01T09:00:00"), end: new Date("2024-01-01T17:00:00") }],
        [{ start: new Date("2024-01-01T09:00:00"), end: new Date("2024-01-01T17:00:00") }],
        [], // Saturday
        [], // Sunday
      ],
    },
    isDefault: true,
    hasDefaultSchedule: true,
    isManaged: false,
    readOnly: false,
    isLastSchedule: false,
  };

  const mockSelectedUser = {
