import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { TextFilterOptions } from '../../../../packages/features/data-table/components/filters/TextFilterOptions';
import { ColumnFilterType } from '../../../../packages/features/data-table/lib/types';

// Create a mock DataTable context
const DataTableContext = createContext({
  data: [],
  columns: [],
  pageCount: 0,
  rowCount: 0,
  filterableColumns: [],
  searchableColumns: [],
  sortableColumns: [],
});

// Mock Provider component
const MockDataTableProvider = ({ children, ...props }) => {
  return (
    <DataTableContext.Provider value={props}>
      {children}
    </DataTableContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state] = useParentState({
    columnId: {
      type: "string",
      value: "exampleColumn",
      label: "Column ID",
    },
    columnTitle: {
      type: "string",
      value: "Example Column",
      label: "Column Title",
    },
  });

  const column = {
    id: state.columnId.value,
    title: state.columnTitle.value,
    type: ColumnFilterType.TEXT,
  };

  const mockTableData = {
    data: [],
    columns: [column],
    pageCount: 0,
    rowCount: 0,
    filterableColumns: [column],
    searchableColumns: [column],
    sortableColumns: [column],
  };

  return (
    <MockDataTableProvider {...mockTableData}>
      <TextFilterOptions column={column} />
    </MockDataTableProvider>
  );
}
</content>
</change>
</file>

