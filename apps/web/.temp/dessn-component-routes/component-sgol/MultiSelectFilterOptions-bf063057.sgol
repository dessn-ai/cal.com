Assistant: I see the issue. The component is still trying to use the original `useDataTable` hook from the package. Let's mock both `useDataTable` and `useFilterValue` hooks since they're being imported by the MultiSelectFilterOptions component.

<file path="apps/web/.temp/dessn-component-routes/MultiSelectFilterOptions-bf063057.tsx">
<change>
<description>Create mock hooks and provider with complete context implementation</description>
<content>
import React, { createContext, useContext, useState } from 'react';
import { useParentState } from '../useIframeState';
import { MultiSelectFilterOptions } from '../../../../packages/features/data-table/components/filters/MultiSelectFilterOptions';
import { ColumnFilterType } from '../../../../packages/features/data-table/lib/types';

// Mock the modules that the component is trying to import
jest.mock('../../../../packages/features/data-table/hooks/useDataTable', () => ({
  useDataTable: () => mockUseDataTable(),
}));

jest.mock('../../../../packages/features/data-table/hooks/useFilterValue', () => ({
  useFilterValue: () => mockUseFilterValue(),
}));

// Create mock context with full implementation
const DataTableContext = createContext({
  updateFilter: (columnId: string, filterValue: any) => {},
  removeFilter: (columnId: string) => {},
  state: {
    filters: {},
  },
});

// Mock hook implementations
const mockUseDataTable = () => {
  return {
    updateFilter: (columnId: string, filterValue: any) => {},
    removeFilter: (columnId: string) => {},
    state: {
      filters: {},
    },
  };
};

const mockUseFilterValue = () => {
  return {
    data: [],
    type: ColumnFilterType.MULTI_SELECT,
  };
};

// Mock provider component with state management
const MockDataTableProvider = ({ children }) => {
  const [filters, setFilters] = useState({});

  const value = {
    updateFilter: (columnId: string, filterValue: any) => {
      setFilters((prev) => ({
        ...prev,
        [columnId]: filterValue,
      }));
    },
    removeFilter: (columnId: string) => {
      setFilters((prev) => {
        const newFilters = { ...prev };
        delete newFilters[columnId];
        return newFilters;
      });
    },
    state: {
      filters,
    },
  };
  
  return (
    <DataTableContext.Provider value={value}>
      {children}
    </DataTableContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    column: {
      type: "dropdown",
      value: "multi_select",
      options: ["multi_select"],
      label: "Column Type",
    },
    columnId: {
      type: "string",
      value: "example_column",
      label: "Column ID",
    },
    columnTitle: {
      type: "string",
      value: "Example Column",
      label: "Column Title",
    },
    columnIcon: {
      type: "dropdown",
      value: "filter",
      options: ["filter", "search", "calendar", "user", "settings"],
      label: "Column Icon",
    },
  });

  const column = {
    id: state.columnId.value,
    title: state.columnTitle.value,
    icon: state.columnIcon.value,
    type: ColumnFilterType.MULTI_SELECT,
    options: [
      { label: "Option 1", value: "option1" },
      { label: "Option 2", value: "option2" },
      { label: "Option 3", value: "option3" },
    ],
  };

  return (
    <MockDataTableProvider>
      <div className="p-4">
        <MultiSelectFilterOptions column={column} />
      </div>
    </MockDataTableProvider>
  );
}
