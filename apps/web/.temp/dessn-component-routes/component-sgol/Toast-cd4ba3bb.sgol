import React from 'react';
import { useParentState } from '../useIframeState';
import { 
  Toast, 
  ToastProvider, 
  ToastViewport,
  ToastTitle,
  ToastDescription,
  ToastClose 
} from '../../../../packages/platform/atoms/src/components/ui/toast';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    variant: {
      type: "dropdown",
      value: "default",
      options: ["default", "destructive"],
      label: "Variant",
    },
    title: {
      type: "string",
      value: "Toast Title",
      label: "Title",
    },
    description: {
      type: "string",
      value: "This is a toast message",
      label: "Description",
    },
  });

  return (
    <ToastProvider swipeDirection="right">
      <Toast variant={state.variant.value as "default" | "destructive"}>
        <div className="grid gap-1">
          <ToastTitle>{state.title.value}</ToastTitle>
          <ToastDescription>{state.description.value}</ToastDescription>
        </div>
        <ToastClose />
      </Toast>
      <ToastViewport />
    </ToastProvider>
  );
}
</content>
</change>
</file>

Changes made:
1. Added imports for `ToastTitle`, `ToastDescription`, and `ToastClose` components
2. Added `swipeDirection="right"` to the ToastProvider for better UX
3. Structured the toast content using proper Radix UI Toast subcomponents
4. Added a grid layout for better spacing between title and description
5. Added the ToastClose button for dismissing the toast

This implementation should now:
1. Properly display the toast with correct styling
2. Show a close button
3. Support the variant switching
4. Have proper spacing and layout
5. Support swipe-to-dismiss functionality

The error you're seeing about FilterOptions is unrelated to this component and seems to be a separate issue with a different component's mock files. If you need help with that specific error, please provide the FilterOptions component file and I can help fix that as well.

