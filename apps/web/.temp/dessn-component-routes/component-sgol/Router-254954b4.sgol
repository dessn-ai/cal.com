<description>Add TRPCProvider and simplify the component structure</description>
<content>
import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../pages/router/index';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { I18nextProvider } from 'react-i18next';
import { SessionProvider } from 'next-auth/react';
import { TooltipProvider } from '@radix-ui/react-tooltip';
import { FeatureProvider } from '@calcom/features/flags/context/provider';
import { httpBatchLink } from '@trpc/client';
import { trpc } from '@calcom/trpc/react';
import i18next from 'i18next';

// Create a minimal i18n instance
const i18n = i18next.createInstance();
i18n.init({
  lng: 'en',
  fallbackLng: 'en',
  resources: {
    en: {
      translation: {
        common: {
          welcome: 'Welcome',
          save: 'Save',
          cancel: 'Cancel',
        },
      },
    },
  },
  interpolation: {
    escapeValue: false,
  },
});

// Create a client
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
      staleTime: Infinity,
    },
  },
});

// Create TRPC Client
const trpcClient = trpc.createClient({
  links: [
    httpBatchLink({
      url: '/api/trpc',
    }),
  ],
});

// Mock session data
const mockSession = {
  user: {
    id: 1,
    name: 'Test User',
    email: 'test@example.com',
  },
  expires: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString(),
};

function PreviewContent({ form, message, isEmbed }) {
  return (
    <ImportedComponent
      form={form}
      message={message}
      isEmbed={isEmbed}
    />
  );
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    formName: {
      type: "string",
      value: "Sample Form",
      label: "Form Name",
    },
    message: {
      type: "string",
      value: "Welcome to the router page",
      label: "Message",
    },
    isEmbed: {
      type: "boolean",
      value: false,
      label: "Is Embed",
    },
  });

  const mockForm = {
    name: state.formName.value,
  };

  return (
    <trpc.Provider client={trpcClient} queryClient={queryClient}>
      <QueryClientProvider client={queryClient}>
        <SessionProvider session={mockSession}>
          <I18nextProvider i18n={i18n}>
            <TooltipProvider>
              <FeatureProvider>
                <Suspense fallback={<div>Loading...</div>}>
                  <PreviewContent
                    form={mockForm}
                    message={state.message.value}
                    isEmbed={state.isEmbed.value}
                  />
                </Suspense>
              </FeatureProvider>
            </TooltipProvider>
          </I18nextProvider>
        </SessionProvider>
      </QueryClientProvider>
    </trpc.Provider>
  );
}
</content>
</change>
</file>

I've made several important changes to fix the error:

1. Added the missing TRPCProvider with a basic client configuration
2. Moved the Suspense boundary to wrap only the content component
3. Split the component into PreviewContent and ComponentPreview for better error isolation
4. Added proper TRPC client setup with httpBatchLink
5. Improved QueryClient configuration with staleTime setting
6. Maintained the provider order according to the component stack:
   - TRPCProvider (outermost)
   - QueryClientProvider
   - SessionProvider
   - I18nextProvider
   - TooltipProvider
   - FeatureProvider

The key changes are:
- Added proper TRPC setup which was missing before
- Restructured the component to better handle suspense and dynamic imports
- Improved error isolation with a separate PreviewContent component
- Kept all the necessary providers while ensuring correct nesting order

This should resolve the dynamic import error and provide all the necessary context for the component to render properly. If you encounter any specific TRPC-related errors after this change, please let me know and we can adjust the TRPC configuration accordingly.

