import React from 'react';
import { useParentState } from '../useIframeState';
import { RoutingFormResponsesTable } from '../../../../packages/features/insights/components/RoutingFormResponsesTable';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { trpc } from '@calcom/trpc/react';
import { httpBatchLink } from '@trpc/client';

// Mock the trpc hooks that the component uses
const mockTrpcHooks = {
  viewer: {
    insights: {
      routingFormResponsesHeaders: {
        useQuery: () => ({
          data: [],
          isLoading: false,
          isSuccess: true
        })
      },
      routingFormResponses: {
        useInfiniteQuery: () => ({
          data: {
            pages: [
              {
                data: [],
                nextCursor: null
              }
            ]
          },
          fetchNextPage: () => {},
          isFetching: false,
          hasNextPage: false,
          isLoading: false
        })
      }
    }
  }
};

// Create a mock TRPC provider
const MockTRPCProvider = ({ children }) => {
  const [queryClient] = React.useState(() => new QueryClient({
    defaultOptions: {
      queries: {
        retry: false,
        refetchOnWindowFocus: false,
      },
    },
  }));

  const [trpcClient] = React.useState(() =>
    trpc.createClient({
      links: [
        httpBatchLink({
          url: '/api/trpc',
        }),
      ],
    })
  );

  // Override the trpc context with our mock data
  const mockTrpc = {
    ...trpc,
    ...mockTrpcHooks
  };

  return (
    <trpc.Provider client={trpcClient} queryClient={queryClient}>
      <QueryClientProvider client={queryClient}>
        {children}
      </QueryClientProvider>
    </trpc.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  return (
    <MockTRPCProvider>
      <div className="p-4">
        <ErrorBoundary>
          <React.Suspense fallback={<div>Loading...</div>}>
            <RoutingFormResponsesTable />
          </React.Suspense>
        </ErrorBoundary>
      </div>
    </MockTRPCProvider>
  );
}

function ErrorBoundary({ children }: { children: React.ReactNode }) {
  const [hasError, setHasError] = React.useState(false);

  React.useEffect(() => {
    if (hasError) {
      console.error('Error in RoutingFormResponsesTable');
    }
  }, [hasError]);

  if (hasError) {
    return (
      <div className="p-4 text-center">
        <p>Something went wrong. Please try again later.</p>
      </div>
    );
  }

  return <>{children}</>;
}
</content>
  </change>
</file>

