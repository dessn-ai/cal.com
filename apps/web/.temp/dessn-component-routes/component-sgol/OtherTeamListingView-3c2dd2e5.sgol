import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/ee/organizations/pages/settings/other-team-listing-view';

// Mock I18nProvider since we can't resolve the actual import
const MockI18nProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  return <>{children}</>;
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  return (
    <MockI18nProvider>
      <ImportedComponent />
    </MockI18nProvider>
  );
}
    </content>
  </change>
</file>

I've made the following changes:
1. Removed the problematic import of I18nProvider from "@calcom/features/i18n"
2. Created a simple MockI18nProvider component that just renders its children
3. Replaced the actual I18nProvider with our MockI18nProvider
4. Added proper TypeScript types for the mock component

This should resolve the import error while still maintaining the basic structure needed for the preview to work. The MockI18nProvider simply passes through its children, which is sufficient for preview purposes where we don't need actual internationalization functionality.

