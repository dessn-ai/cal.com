import React from 'react';
import { useParentState } from '../useIframeState';
import { TextFilterOptions } from '../../../../packages/features/data-table/components/filters/TextFilterOptions';
import { ColumnFilterType } from '../../../../packages/features/data-table/lib/types';
import { createContext, useContext } from 'react';

// Mock the DataTable context
const DataTableContext = createContext<any>(null);

// Mock the useLocale hook
const mockUseLocale = () => ({
  t: (key: string) => key,
});

// Mock the useTextFilterOperatorOptions hook
const mockTextFilterOperatorOptions = [
  { value: 'contains', label: 'Contains', requiresOperand: true },
  { value: 'equals', label: 'Equals', requiresOperand: true },
  { value: 'empty', label: 'Is empty', requiresOperand: false },
];

// Mock the required hooks
jest.mock('@calcom/lib/hooks/useLocale', () => mockUseLocale);
jest.mock('../../hooks/useTextFilterOperatorOptions', () => () => mockTextFilterOperatorOptions);

const DataTableProvider = ({ children }: { children: React.ReactNode }) => {
  const mockDataTableValue = {
    filterValue: null,
    setFilterValue: () => {},
    table: {
      getState: () => ({
        columnFilters: [],
      }),
      setColumnFilters: () => {},
    },
    updateFilter: () => {},
    removeFilter: () => {},
  };

  return (
    <DataTableContext.Provider value={mockDataTableValue}>
      {children}
    </DataTableContext.Provider>
  );
};

// Mock the hooks that TextFilterOptions uses
const useDataTable = () => {
  return {
    updateFilter: () => {},
    removeFilter: () => {},
  };
};

const useFilterValue = () => null;

// Override the hooks in the module
jest.mock('../../../../packages/features/data-table/hooks', () => ({
  useDataTable,
  useFilterValue,
}));

export default function ComponentPreview() {
  const [state] = useParentState({
    columnId: {
      type: "string",
      value: "exampleColumn",
      label: "Column ID",
    },
    columnTitle: {
      type: "string",
      value: "Example Column",
      label: "Column Title",
    },
  });

  const column = {
    id: state.columnId.value,
    title: state.columnTitle.value,
    type: ColumnFilterType.TEXT,
  };

  return (
    <div className="p-4">
      <DataTableProvider>
        <TextFilterOptions column={column} />
      </DataTableProvider>
    </div>
  );
}
