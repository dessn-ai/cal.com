import React from 'react';
import { useParentState } from '../useIframeState';
import { ToastTitle } from '@/components/ui/toast';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    title: {
      type: "string",
      value: "Sample Toast Title",
      label: "Title",
    },
    className: {
      type: "string",
      value: "",
      label: "Custom Class",
    },
  });

  try {
    return (
      <ToastTitle className={state.className.value}>
        {state.title.value}
      </ToastTitle>
    );
  } catch (error) {
    console.error('Error rendering ToastTitle:', error);
    return <div>Error loading ToastTitle component</div>;
  }
}
</content>
  </change>
</file>

I made the following changes:
1. Changed the import path for ToastTitle to use the alias `@/components/ui/toast` instead of the relative path. This is a more common pattern in React projects and should resolve correctly if the path aliases are set up in the project.
2. Added error handling with try-catch block to gracefully handle any rendering errors
3. Kept the core functionality the same but made it more resilient to failures

If the `@/components/ui/toast` path doesn't work, we might need to adjust it based on your project's actual structure. Please let me know if you need the import path adjusted further.

Also, make sure that your project's tsconfig.json or other configuration files have the proper path aliases set up for the `@` prefix to work correctly.

