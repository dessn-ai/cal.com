import React from 'react';
import { useParentState } from '../useIframeState';
import { Dialog } from '../../../../packages/ui/components/dialog/Dialog';
import * as DialogPrimitive from "@radix-ui/react-dialog";

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    name: {
      type: "string",
      value: "Example Dialog",
      label: "Dialog Name",
    },
    open: {
      type: "boolean",
      value: true,
      label: "Open",
    },
    clearQueryParamsOnClose: {
      type: "string",
      value: "param1,param2",
      label: "Clear Query Params on Close",
    },
  });

  return (
    <DialogPrimitive.Root>
      <Dialog
        name={state.name.value}
        open={state.open.value}
        clearQueryParamsOnClose={state.clearQueryParamsOnClose.value.split(',')}
      >
        <Dialog.Content>
          <Dialog.Header title="Example Dialog" />
          <div className="py-4">
            <p>Dialog Content</p>
          </div>
          <Dialog.Footer>
            <Dialog.Close>Close</Dialog.Close>
          </Dialog.Footer>
        </Dialog.Content>
      </Dialog>
    </DialogPrimitive.Root>
  );
}
</file>

