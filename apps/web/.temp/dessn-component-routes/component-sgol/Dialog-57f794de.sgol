    name: {
      type: "string",
      value: "Example Dialog",
      label: "Dialog Name",
    },
    open: {
      type: "boolean",
      value: true,
      label: "Open",
    },
    clearQueryParamsOnClose: {
      type: "string",
      value: "param1,param2",
      label: "Clear Query Params on Close",
