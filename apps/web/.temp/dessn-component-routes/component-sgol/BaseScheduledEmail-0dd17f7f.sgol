      options: [TimeFormat.TWELVE_HOUR, TimeFormat.TWENTY_FOUR_HOUR],
      label: "Time Format",
    },
    isOrganizer: {
      type: "boolean",
      value: false,
      label: "Is Organizer",
    },
  });

  // Simple translation function that always returns a function
  function t(key: string, ...args: any[]): string {
    // If the first argument is an object, it's the variables
    const variables = args.length > 0 && typeof args[0] === 'object' ? args[0] : undefined;
    
    if (variables) {
      return Object.entries(variables).reduce((text, [key, value]) => {
        return text.replace(new RegExp(`{{${key}}}`, 'g'), String(value));
      }, key);
    }
    
    return key;
  }

  const calEvent = JSON.parse(state.calEvent.value);
  const attendee = JSON.parse(state.attendee.value);

  return (
    <BaseScheduledEmail
      calEvent={calEvent}
      attendee={attendee}
      timeZone={state.timeZone.value}
      includeAppsStatus={state.includeAppsStatus.value}
      t={t}
      locale={state.locale.value}
      timeFormat={state.timeFormat.value as TimeFormat}
      isOrganizer={state.isOrganizer.value}
    />
  );
}
