<file path="apps/web/.temp/dessn-component-routes/SideBar-bdf69862.tsx">
  <change>
    <description>Replace Jest mock with a manual mock implementation</description>
    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { SideBar } from '../../../../packages/features/shell/SideBar';

// Create a mock context module
const mockOrgBranding = {
  theme: null,
  brandColor: '#292929',
  darkBrandColor: '#fafafa',
  logo: null,
  logoUrl: null,
};

// Mock the hook directly
const useOrgBranding = () => mockOrgBranding;

// Override the actual module
jest.mock('../../../../packages/features/ee/organizations/context/provider', () => ({
  useOrgBranding,
}));

// Create a wrapper component that provides the mock context
const WithMockOrgBranding = ({ children }) => {
  // Mock the context at the component level
  React.useEffect(() => {
    // Override the useOrgBranding implementation
    const originalModule = require('../../../../packages/features/ee/organizations/context/provider');
    originalModule.useOrgBranding = useOrgBranding;
  }, []);

  return children;
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    bannersHeight: {
      type: "number",
      value: 0,
      label: "Banners Height",
    },
    isPlatformUser: {
      type: "boolean",
      value: false,
      label: "Is Platform User",
    },
  });

  const mockUser = {
    id: '1',
    name: 'John Doe',
    email: 'john@example.com',
    username: 'johndoe',
    avatarUrl: 'https://example.com/avatar.jpg',
    role: 'USER',
  };

  return (
    <WithMockOrgBranding>
      <SideBar 
        bannersHeight={state.bannersHeight.value} 
        isPlatformUser={state.isPlatformUser.value}
        user={mockUser}
      />
    </WithMockOrgBranding>
  );
}
</content>
  </change>
</file>

Let me try another approach since the previous one still uses Jest. Here's a simpler solution:

<file path="apps/web/.temp/dessn-component-routes/SideBar-bdf69862.tsx">
  <change>
    <description>Use React Context to provide mock data</description>
    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { SideBar } from '../../../../packages/features/shell/SideBar';

// Create a context with the same shape as OrgBrandingContext
const MockOrgBrandingContext = React.createContext({
  theme: null,
  brandColor: '#292929',
  darkBrandColor: '#fafafa',
  logo: null,
  logoUrl: null,
});

// Override the useOrgBranding hook
const useOrgBranding = () => React.useContext(MockOrgBrandingContext);

// Make it available globally
window.useOrgBranding = useOrgBranding;

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    bannersHeight: {
      type: "number",
      value: 0,
      label: "Banners Height",
    },
    isPlatformUser: {
      type: "boolean",
      value: false,
      label: "Is Platform User",
    },
  });

  const mockUser = {
    id: '1',
    name: 'John Doe',
    email: 'john@example.com',
    username: 'johndoe',
    avatarUrl: 'https://example.com/avatar.jpg',
    role: 'USER',
  };

  return (
    <MockOrgBrandingContext.Provider 
      value={{
        theme: null,
        brandColor: '#292929',
        darkBrandColor: '#fafafa',
        logo: null,
        logoUrl: null,
      }}
    >
      <SideBar 
        bannersHeight={state.bannersHeight.value} 
        isPlatformUser={state.isPlatformUser.value}
        user={mockUser}
      />
    </MockOrgBrandingContext.Provider>
  );
}
</content>
  </change>
</file>

I've made the following changes:
1. Removed the Jest-related code
2. Created a MockOrgBrandingContext using React.createContext
3. Created a mock useOrgBranding hook that uses this context
4. Made the hook available globally
5. Wrapped the SideBar component with the MockOrgBrandingContext.Provider

This approach should work better as it:
1. Doesn't rely on Jest
2. Provides the necessary context data
3. Uses standard React patterns
4. Makes the mock hook available globally

The component should now render without the OrgBrandingProvider error.

