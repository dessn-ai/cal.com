import React from 'react';
import { useParentState } from '../useIframeState';
import { SideBar } from '../../../../packages/features/shell/SideBar';

// Create a mock context with the same shape as the original
const OrgBrandingContext = React.createContext({
  orgBranding: {
    theme: null,
    brandColor: '#292929',
    darkBrandColor: '#fafafa',
    logo: null,
    logoUrl: null,
  },
});

// Mock provider component
const MockOrgBrandingProvider = ({ children }) => {
  const value = {
    orgBranding: {
      theme: null,
      brandColor: '#292929',
      darkBrandColor: '#fafafa',
      logo: null,
      logoUrl: null,
    },
  };
  
  return (
    <OrgBrandingContext.Provider value={value}>
      {children}
    </OrgBrandingContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    bannersHeight: {
      type: "number",
      value: 0,
      label: "Banners Height",
    },
    isPlatformUser: {
      type: "boolean",
      value: false,
      label: "Is Platform User",
    },
  });

  const mockUser = {
    id: '1',
    name: 'John Doe',
    email: 'john@example.com',
    username: 'johndoe',
    avatarUrl: 'https://example.com/avatar.jpg',
    role: 'USER',
  };

  return (
    <MockOrgBrandingProvider>
      <SideBar 
        bannersHeight={state.bannersHeight.value} 
        isPlatformUser={state.isPlatformUser.value}
        user={mockUser}
      />
    </MockOrgBrandingProvider>
  );
}
</content>
  </change>
</file>

