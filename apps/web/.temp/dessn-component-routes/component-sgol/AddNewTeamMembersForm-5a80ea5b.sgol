import React from 'react';
import { useParentState } from '../useIframeState';
import { AddNewTeamMembersForm } from '../../../../packages/features/ee/teams/components/AddNewTeamMembers';
import { useForm } from 'react-hook-form';

// Create the context
const OrgBrandingContext = React.createContext<{
  orgBranding: {
    theme: null;
    brandColor: string;
    darkBrandColor: string;
    logo: string;
    name: string;
  };
} | null>(null);

// Create a custom hook that matches the original
const useOrgBranding = () => {
  const context = React.useContext(OrgBrandingContext);
  if (!context) {
    return {
      orgBranding: {
        theme: null,
        brandColor: "#292929",
        darkBrandColor: "#fafafa",
        logo: "",
        name: "Test Organization",
      }
    };
  }
  return context;
};

// Override the module's exports
// @ts-ignore
import.meta.hot?.accept(['../../../../packages/features/ee/organizations/context/provider'], () => {});
// @ts-ignore
window.__orgBrandingHook = useOrgBranding;

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
    isOrg: {
      type: "boolean",
      value: false,
      label: "Is Organization",
    },
  });

  const form = useForm();

  const mockOrgBranding = {
    orgBranding: {
      theme: null,
      brandColor: "#292929",
      darkBrandColor: "#fafafa",
      logo: "",
      name: "Test Organization",
    }
  };

  return (
    <OrgBrandingContext.Provider value={mockOrgBranding}>
      <AddNewTeamMembersForm
        teamId={state.teamId.value}
        isOrg={state.isOrg.value}
      />
    </OrgBrandingContext.Provider>
  );
}

// Ensure the hook is available globally
// @ts-ignore
if (typeof window !== 'undefined') {
  // @ts-ignore
  window.__orgBrandingHook = useOrgBranding;
}
</content>
</change>
</file>

