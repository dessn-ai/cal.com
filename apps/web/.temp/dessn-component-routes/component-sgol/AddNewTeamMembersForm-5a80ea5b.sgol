import React from 'react';
import { useParentState } from '../useIframeState';
import { AddNewTeamMembersForm } from '../../../../packages/features/ee/teams/components/AddNewTeamMembers';
import { OrgBrandingProvider } from '../../../../packages/features/ee/organizations/context/provider';
import { useForm } from 'react-hook-form';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
    isOrg: {
      type: "boolean",
      value: false,
      label: "Is Organization",
    },
  });

  const form = useForm();

  // Mock organization branding data
  const mockOrgBrand = {
    orgBrand: {
      id: 1,
      slug: 'test-org',
      fullDomain: 'test-org.cal.com',
      domainSuffix: 'cal.com',
      role: 'OWNER',
    }
  };

  return (
    <OrgBrandingProvider value={mockOrgBrand}>
      <AddNewTeamMembersForm
        teamId={state.teamId.value}
        isOrg={state.isOrg.value}
      />
    </OrgBrandingProvider>
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Imported the `OrgBrandingProvider` from the organizations context
2. Created a mock `orgBrand` object with the required properties based on the type definition from the provider file
3. Wrapped the `AddNewTeamMembersForm` component with `OrgBrandingProvider` and passed the mock data

This should resolve the error by providing the required context for the `useOrgBranding` hook. The mock data includes the minimum required fields based on the `OrganizationBranding` type defined in the provider file.

