import React from 'react';
import { useParentState } from '../useIframeState';
import { AddNewTeamMembersForm } from '../../../../packages/features/ee/teams/components/AddNewTeamMembers';
import { useForm } from 'react-hook-form';

// Create mock context and provider
const MockOrgBrandingContext = React.createContext({
  orgBranding: {
    theme: null,
    brandColor: "#292929",
    darkBrandColor: "#fafafa",
    logo: "",
    name: "Test Organization",
  }
});

// Mock the useOrgBranding hook
const mockUseOrgBranding = () => React.useContext(MockOrgBrandingContext);

// Override the actual hook with our mock
jest.mock('../../../../packages/features/ee/organizations/context/provider', () => ({
  useOrgBranding: mockUseOrgBranding,
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
    isOrg: {
      type: "boolean",
      value: false,
      label: "Is Organization",
    },
  });

  const form = useForm();

  return (
    <MockOrgBrandingContext.Provider 
      value={{
        orgBranding: {
          theme: null,
          brandColor: "#292929",
          darkBrandColor: "#fafafa",
          logo: "",
          name: "Test Organization",
        }
      }}
    >
      <AddNewTeamMembersForm
        teamId={state.teamId.value}
        isOrg={state.isOrg.value}
      />
    </MockOrgBrandingContext.Provider>
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Removed the import of OrgBrandingProvider
2. Created a mock context using React.createContext
3. Created a mock useOrgBranding hook that uses our mock context
4. Used jest.mock to override the actual hook with our mock version
5. Wrapped the component with our MockOrgBrandingContext.Provider

This approach should work better because:
1. We're mocking the context at a lower level
2. We're providing the exact same interface that the component expects
3. We're ensuring the hook is available before the component renders

If this still doesn't work, we might need to try one more approach where we modify the component itself to handle the case where the context is not available. Let me know if you still see the error.

