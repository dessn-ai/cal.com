    brandColor: "#292929",
    darkBrandColor: "#fafafa",
    logo: "",
    name: "Test Organization",
  }
};

// Create a HOC to inject the mock context
const withMockOrgBranding = (WrappedComponent: React.ComponentType<any>) => {
  return function WithMockOrgBrandingComponent(props: any) {
    // @ts-ignore - Temporarily ignore type checking for the mock
    React.useEffect(() => {
      // Inject the mock into the module
      const orgModule = require('../../../../packages/features/ee/organizations/context/provider');
      orgModule.useOrgBranding = () => mockOrgBranding;
    }, []);

    return <WrappedComponent {...props} />;
  };
};

const WrappedAddNewTeamMembersForm = withMockOrgBranding(AddNewTeamMembersForm);

export default function ComponentPreview() {
