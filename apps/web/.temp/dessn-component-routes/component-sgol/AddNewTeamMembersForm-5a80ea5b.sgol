<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { AddNewTeamMembersForm } from '../../../../packages/features/ee/teams/components/AddNewTeamMembers';
import { useForm } from 'react-hook-form';

// Create a mock context with the required shape
const mockOrgBranding = {
  orgBranding: {
    theme: null,
    brandColor: "#292929",
    darkBrandColor: "#fafafa",
    logo: "",
    name: "Test Organization",
  }
};

// Create a HOC to inject the mock context
const withMockOrgBranding = (WrappedComponent: React.ComponentType<any>) => {
  return function WithMockOrgBrandingComponent(props: any) {
    // @ts-ignore - Temporarily ignore type checking for the mock
    React.useEffect(() => {
      // Inject the mock into the module
      const orgModule = require('../../../../packages/features/ee/organizations/context/provider');
      orgModule.useOrgBranding = () => mockOrgBranding;
    }, []);

    return <WrappedComponent {...props} />;
  };
};

const WrappedAddNewTeamMembersForm = withMockOrgBranding(AddNewTeamMembersForm);

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
    isOrg: {
      type: "boolean",
      value: false,
      label: "Is Organization",
    },
  });

  const form = useForm();

  return (
    <WrappedAddNewTeamMembersForm
      teamId={state.teamId.value}
      isOrg={state.isOrg.value}
    />
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Removed the jest.mock approach
2. Created a HOC (Higher Order Component) that injects our mock
3. Used require and runtime modification to inject the mock
4. Wrapped the AddNewTeamMembersForm with our HOC
5. Simplified the component structure

This approach should work better because:
1. We're not relying on jest or other testing frameworks
2. We're injecting the mock at runtime
3. We're keeping the original component structure intact
4. We're using a more direct approach to provide the mock data

If this still doesn't work, we could try one more approach where we modify the component to handle missing context gracefully. Let me know if you still see any errors.

