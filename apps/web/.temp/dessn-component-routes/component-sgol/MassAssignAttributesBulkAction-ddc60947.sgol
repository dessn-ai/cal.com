import React from 'react';
import { useParentState } from '../useIframeState';
import { MassAssignAttributesBulkAction } from '../../../../packages/features/users/components/UserTable/BulkActions/MassAssignAttributes';

export default function ComponentPreview() {
  const [state] = useParentState({
    filters: {
      type: 'object',
      value: [],
      label: 'Filters',
    }
  });

  // Create the table mock directly in the component, not in state
  const tableMock = {
    getSelectedRowModel: () => ({
      flatRows: []
    }),
    selectedRowIds: {},
    setRowSelection: () => {},
    resetRowSelection: () => {},
    getState: () => ({ rowSelection: {} }),
    getRowModel: () => ({ rows: [] })
  };

  return (
    <div type="component">
      <MassAssignAttributesBulkAction
        table={tableMock}
        filters={state.filters.value}
      />
    </div>
  );
}
</content>
</change>
</file>

Key changes made:

1. Removed the table object from the state completely since it contained functions that can't be serialized
2. Created the table mock directly in the component, outside of the state/postMessage flow
3. Added more mock methods that might be required by the component
4. Kept only the serializable filters in the state
5. Simplified the overall structure to avoid any serialization issues

This approach should work better because:
1. We're no longer trying to store or transmit functions through postMessage
2. The table mock is created fresh on each render
3. All the necessary table interface methods are provided
4. Only serializable data is kept in the state

The error was occurring because even though we tried to store the function separately, the state was still being passed through postMessage in the useParentState hook. By removing all function references from the state entirely, we should avoid the DataCloneError.

