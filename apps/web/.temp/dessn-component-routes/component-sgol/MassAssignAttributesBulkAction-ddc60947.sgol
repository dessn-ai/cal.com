import React from 'react';
import { useParentState } from '../useIframeState';
import { MassAssignAttributesBulkAction } from '../../../../packages/features/users/components/UserTable/BulkActions/MassAssignAttributes';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    table: {
      type: 'object',
      value: {
        // Instead of passing a function, we'll pass the actual data structure
        selectedRowModel: {
          flatRows: []
        },
        getSelectedRowModel: null // Set to null since we can't pass functions
      },
      label: 'Table',
    },
    filters: {
      type: 'object',
      value: [],
      label: 'Filters',
    },
  });

  // Create a wrapper object that provides the necessary interface
  const tableWrapper = {
    ...state.table.value,
    getSelectedRowModel: () => state.table.value.selectedRowModel
  };

  return (
    <div type="component">
      <MassAssignAttributesBulkAction
        table={tableWrapper}
        filters={state.filters.value}
      />
    </div>
  );
}
</content>
</change>
</file>

The changes I made:

1. Changed the table structure to store the actual data instead of a function
2. Created a wrapper object that provides the `getSelectedRowModel` function locally
3. Added error handling by providing default values
4. Wrapped the component in a div with type="component" to ensure proper extraction
5. Made the state serializable by avoiding functions in the state object

This should resolve the DataCloneError because we're no longer trying to pass functions through postMessage. Instead, we're storing the data in state and creating the function locally when needed.

The error occurred because the postMessage API cannot serialize functions, and we were trying to pass a function through the iframe communication channel. The solution is to store the actual data in the state and create any necessary functions locally in the component where they're needed.

