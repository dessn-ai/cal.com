import React from 'react';
import { useParentState } from '../useIframeState';
import { UserForm } from '../../../../packages/features/ee/users/components/UserForm';
import { useForm, FormProvider } from 'react-hook-form';
import { I18nextProvider } from 'react-i18next';

// Mock i18n instance
const mockI18n = {
  language: 'en',
  languages: ['en'],
  resolvedLanguage: 'en',
  dir: () => 'ltr',
  t: (key: string) => key,
  exists: () => true,
  getFixedT: () => (key: string) => key,
  changeLanguage: () => Promise.resolve(),
  options: {
    fallbackLng: 'en',
    ns: ['translation'],
    defaultNS: 'translation',
    interpolation: { escapeValue: false }
  }
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    defaultValues: {
      type: 'object',
      value: {
        avatarUrl: 'https://example.com/avatar.jpg',
        name: 'John Doe',
        username: 'johndoe',
        email: 'john@example.com',
        bio: 'A short bio',
        locale: 'en',
        timeFormat: 12,
        timeZone: 'America/New_York',
        weekStart: 'Monday',
        role: 'USER',
        identityProvider: 'CAL'
      },
      label: 'Default Values'
    },
    localeProp: {
      type: 'string',
      value: 'en',
      label: 'Locale'
    },
    submitLabel: {
      type: 'string',
      value: 'Save',
      label: 'Submit Button Label'
    }
  });

  const form = useForm({
    defaultValues: state.defaultValues.value
  });

  const onSubmit = (data: any) => {
    console.log('Form submitted with data:', data);
  };

  return (
    <I18nextProvider i18n={mockI18n as any}>
      <FormProvider {...form}>
        <UserForm
          defaultValues={state.defaultValues.value}
          localeProp={state.localeProp.value}
          onSubmit={onSubmit}
          submitLabel={state.submitLabel.value}
        />
      </FormProvider>
    </I18nextProvider>
  );
}
</content>
</change>
</file>

The changes made:
1. Removed direct i18next import and initialization
2. Created a mock i18n instance with required methods and properties
3. Added FormProvider from react-hook-form to properly provide form context
4. Initialized useForm with defaultValues
5. Added type casting for the mock i18n instance
6. Wrapped UserForm with both I18nextProvider and FormProvider

This approach should resolve the `require is not defined` error by:
1. Avoiding the direct use of i18next which was trying to use require
2. Providing a mock i18n instance that has all the necessary methods
3. Ensuring proper form context is available to the UserForm component

The mock i18n instance provides all the basic functionality that the component might need without requiring the actual i18n implementation that was causing the require error.

