<description>Maintain state structure while providing a properly configured table</description>
<content>
import React, { useRef } from 'react';
import { useParentState } from '../useIframeState';
import { DataTable } from '../../../../packages/features/data-table/components/DataTable';
import {
  createColumnHelper,
  getCoreRowModel,
  useReactTable,
} from '@tanstack/react-table';

// Define a simple data type for the table
type Person = {
  firstName: string;
  lastName: string;
  age: number;
};

// Create some sample data
const defaultData: Person[] = [
  {
    firstName: 'John',
    lastName: 'Doe',
    age: 30,
  },
  {
    firstName: 'Jane',
    lastName: 'Smith',
    age: 25,
  },
];

export default function ComponentPreview() {
  const tableContainerRef = useRef<HTMLDivElement>(null);
  const columnHelper = createColumnHelper<Person>();

  const columns = [
    columnHelper.accessor('firstName', {
      header: 'First Name',
      cell: info => info.getValue(),
    }),
    columnHelper.accessor('lastName', {
      header: 'Last Name',
      cell: info => info.getValue(),
    }),
    columnHelper.accessor('age', {
      header: 'Age',
      cell: info => info.getValue(),
    }),
  ];

  const tableInstance = useReactTable({
    data: defaultData,
    columns,
    getCoreRowModel: getCoreRowModel(),
  });

  const [state, setState] = useParentState({
    table: {
      type: "object",
      value: tableInstance,
      label: "Table",
    },
    tableContainerRef: {
      type: "object",
      value: { current: null },
      label: "Table Container Ref",
    },
    isPending: {
      type: "boolean",
      value: false,
      label: "Is Pending",
    },
    variant: {
      type: "dropdown",
      value: "default",
      options: ["default", "compact"],
      label: "Variant",
    },
    hideHeader: {
      type: "boolean",
      value: false,
      label: "Hide Header",
    },
    enableColumnResizing: {
      type: "boolean",
      value: false,
      label: "Enable Column Resizing",
    },
  });

  return (
    <DataTable
      table={tableInstance}
      tableContainerRef={tableContainerRef}
      isPending={state.isPending.value}
      variant={state.variant.value}
      hideHeader={state.hideHeader.value}
      enableColumnResizing={state.enableColumnResizing.value}
    />
  );
}
</content>
</change>
</file>

Key changes made:
1. Kept the original state structure using useParentState
2. Created a proper table instance using useReactTable
3. Included the table instance in the state.table.value
4. Used the actual tableInstance in the DataTable component props instead of state.table.value
5. Maintained the proper tableContainerRef usage

The main issue before was that we were trying to use the state.table.value directly, which wasn't properly initialized. Now we're creating a proper table instance with useReactTable and using that directly in the DataTable component while still maintaining it in the state for other purposes.

This should resolve the "table.getRowModel is not a function" error because we're now passing a properly initialized table instance with all required methods to the DataTable component.

