<file path="apps/web/.temp/dessn-component-routes/DataTable-86e34381.tsx">
<change>
<description>Initialize a proper table instance using @tanstack/react-table</description>
<content>
import React, { useRef } from 'react';
import { useParentState } from '../useIframeState';
import { DataTable } from '../../../../packages/features/data-table/components/DataTable';
import {
  createColumnHelper,
  getCoreRowModel,
  useReactTable,
} from '@tanstack/react-table';

// Define a simple data type for the table
type Person = {
  firstName: string;
  lastName: string;
  age: number;
};

// Create some sample data
const defaultData: Person[] = [
  {
    firstName: 'John',
    lastName: 'Doe',
    age: 30,
  },
  {
    firstName: 'Jane',
    lastName: 'Smith',
    age: 25,
  },
];

export default function ComponentPreview() {
  const tableContainerRef = useRef<HTMLDivElement>(null);
  const columnHelper = createColumnHelper<Person>();

  const columns = [
    columnHelper.accessor('firstName', {
      header: 'First Name',
      cell: info => info.getValue(),
    }),
    columnHelper.accessor('lastName', {
      header: 'Last Name',
      cell: info => info.getValue(),
    }),
    columnHelper.accessor('age', {
      header: 'Age',
      cell: info => info.getValue(),
    }),
  ];

  const table = useReactTable({
    data: defaultData,
    columns,
    getCoreRowModel: getCoreRowModel(),
  });

  const [state, setState] = useParentState({
    isPending: {
      type: "boolean",
      value: false,
      label: "Is Pending",
    },
    variant: {
      type: "dropdown",
      value: "default",
      options: ["default", "compact"],
      label: "Variant",
    },
    hideHeader: {
      type: "boolean",
      value: false,
      label: "Hide Header",
    },
    enableColumnResizing: {
      type: "boolean",
      value: false,
      label: "Enable Column Resizing",
    },
  });

  return (
    <DataTable
      table={table}
      tableContainerRef={tableContainerRef}
      isPending={state.isPending.value}
      variant={state.variant.value}
      hideHeader={state.hideHeader.value}
      enableColumnResizing={state.enableColumnResizing.value}
    />
  );
}
</content>
</change>
</file>

The changes I made:

1. Added necessary imports from @tanstack/react-table
2. Created a simple data type (Person) and sample data
3. Created column definitions using columnHelper
4. Initialized a proper table instance using useReactTable with:
   - Data
   - Columns
   - Core row model
5. Created a proper tableContainerRef using useRef
6. Passed the properly initialized table instance to the DataTable component

This should resolve the "table.getRowModel is not a function" error because now we're passing a properly initialized table instance with all the required methods and properties.

The error occurred because previously we were passing an empty object as the table prop, but the DataTable component expects a fully initialized table instance from @tanstack/react-table with all its methods and properties.

