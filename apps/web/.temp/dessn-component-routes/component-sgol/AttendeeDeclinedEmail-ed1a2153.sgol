<file path="apps/web/.temp/dessn-component-routes/AttendeeDeclinedEmail-ed1a2153.tsx">
  <change>
    <description>Update recurring event structure to match RRule requirements</description>
    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { AttendeeDeclinedEmail } from '../../../../packages/emails/src/templates/AttendeeDeclinedEmail';

// Define TimeFormat enum locally instead of importing
enum TimeFormat {
  TWELVE_HOUR = '12h',
  TWENTY_FOUR_HOUR = '24h'
}

// RRule frequency constants
const FREQUENCY = {
  YEARLY: 0,
  MONTHLY: 1,
  WEEKLY: 2,
  DAILY: 3
};

export default function ComponentPreview() {
  // Translation function that handles recurring strings
  const t = (key: string, vars?: Record<string, string | number>) => {
    const translations: Record<string, string> = {
      'every_day': 'Every day',
      'every_week': 'Every week',
      'every_month': 'Every month',
      'every_year': 'Every year',
      'every_freq': 'Every {0}',
      'weekly': 'Weekly',
      'monthly': 'Monthly',
      'yearly': 'Yearly',
      'daily': 'Daily',
      'recurring_event_count': '{0} times',
    };
    let translation = translations[key] || key;
    if (vars) {
      Object.entries(vars).forEach(([k, v]) => {
        translation = translation.replace(`{${k}}`, String(v));
      });
    }
    return translation;
  };

  const [state, setState] = useParentState({
    calEvent: {
      type: 'string',
      value: JSON.stringify({
        type: 'default',
        title: 'Meeting',
        startTime: new Date().toISOString(),
        endTime: new Date(Date.now() + 3600000).toISOString(),
        organizer: {
          name: 'John Doe',
          email: 'john@example.com',
          timeZone: 'America/New_York',
          language: { translate: t, locale: 'en' },
        },
        attendees: [
          {
            name: 'Jane Smith',
            email: 'jane@example.com',
            timeZone: 'America/Los_Angeles',
            language: { translate: t, locale: 'en' },
          },
        ],
        recurringEvent: {
          count: 1,
          interval: 1,
          freq: 2, // WEEKLY
          dtstart: new Date().toISOString(),
          until: null,
          byday: null,
          bymonth: null,
          bymonthday: null,
          bysetpos: null,
          wkst: null
        },
      }),
      label: 'Calendar Event',
    },
    attendee: {
      type: 'string',
      value: JSON.stringify({
        name: 'Jane Smith',
        email: 'jane@example.com',
        timeZone: 'America/Los_Angeles',
        language: { translate: t, locale: 'en' },
      }),
      label: 'Attendee',
    },
    timeZone: {
      type: 'string',
      value: 'America/New_York',
      label: 'Time Zone',
    },
    includeAppsStatus: {
      type: 'boolean',
      value: false,
      label: 'Include Apps Status',
    },
    locale: {
      type: 'string',
      value: 'en',
      label: 'Locale',
    },
    timeFormat: {
      type: 'dropdown',
      value: TimeFormat.TWELVE_HOUR,
      options: Object.values(TimeFormat),
      label: 'Time Format',
    },
    isOrganizer: {
      type: 'boolean',
      value: false,
      label: 'Is Organizer',
    },
  });

  const parsedCalEvent = JSON.parse(state.calEvent.value);
  const parsedAttendee = JSON.parse(state.attendee.value);

  return (
    <AttendeeDeclinedEmail
      calEvent={parsedCalEvent}
      attendee={parsedAttendee}
      timeZone={state.timeZone.value}
      includeAppsStatus={state.includeAppsStatus.value}
      t={t}
      locale={state.locale.value}
      timeFormat={state.timeFormat.value as TimeFormat}
      isOrganizer={state.isOrganizer.value}
    />
  );
}
</content>
  </change>
</file>

I've made the following changes:
1. Updated the recurring event structure to match RRule's expected format with all necessary fields:
   - Added `dtstart`
   - Added `until`
   - Added `byday`
   - Added `bymonth`
   - Added `bymonthday`
   - Added `bysetpos`
   - Added `wkst`
2. Enhanced the translation function to handle variable replacement
3. Removed the custom type field that was causing the RRule error
4. Set freq directly to 2 (WEEKLY) instead of using an object reference
5. Kept all other fields as null when not needed

These changes should resolve the "Invalid options: type" error by providing a properly structured recurring event object that matches what the RRule library expects.

The main fix here is removing the `type` property from the recurringEvent object and providing all the required RRule fields, even if they're null. This should allow the RRule library to properly initialize and handle the recurring event information.

