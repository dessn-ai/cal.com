<file path="apps/web/.temp/dessn-component-routes/AttendeeDeclinedEmail-ed1a2153.tsx">
  <change>
    <description>Enhance translation function and update calEvent structure</description>
    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { AttendeeDeclinedEmail } from '../../../../packages/emails/src/templates/AttendeeDeclinedEmail';

// Define TimeFormat enum locally instead of importing
enum TimeFormat {
  TWELVE_HOUR = '12h',
  TWENTY_FOUR_HOUR = '24h'
}

export default function ComponentPreview() {
  // Enhanced translation function that handles interpolation
  const t = (key: string, vars?: Record<string, string | number>) => {
    if (!vars) return key;
    let translated = key;
    Object.entries(vars).forEach(([k, v]) => {
      translated = translated.replace(new RegExp(`{{${k}}}`, 'g'), String(v));
    });
    return translated;
  };

  const [state, setState] = useParentState({
    calEvent: {
      type: 'string',
      value: JSON.stringify({
        type: 'default',
        title: 'Meeting',
        startTime: new Date().toISOString(),
        endTime: new Date(Date.now() + 3600000).toISOString(),
        organizer: {
          name: 'John Doe',
          email: 'john@example.com',
          timeZone: 'America/New_York',
          language: { translate: t, locale: 'en' },
        },
        attendees: [
          {
            name: 'Jane Smith',
            email: 'jane@example.com',
            timeZone: 'America/Los_Angeles',
            language: { translate: t, locale: 'en' },
          },
        ],
        recurringEvent: { 
          count: 1, 
          interval: 1, 
          freq: 'WEEKLY',
          type: 'recurring',
        },
        language: { translate: t, locale: 'en' },
      }),
      label: 'Calendar Event',
    },
    attendee: {
      type: 'string',
      value: JSON.stringify({
        name: 'Jane Smith',
        email: 'jane@example.com',
        timeZone: 'America/Los_Angeles',
        language: { translate: t, locale: 'en' },
      }),
      label: 'Attendee',
    },
    timeZone: {
      type: 'string',
      value: 'America/New_York',
      label: 'Time Zone',
    },
    includeAppsStatus: {
      type: 'boolean',
      value: false,
      label: 'Include Apps Status',
    },
    locale: {
      type: 'string',
      value: 'en',
      label: 'Locale',
    },
    timeFormat: {
      type: 'dropdown',
      value: TimeFormat.TWELVE_HOUR,
      options: Object.values(TimeFormat),
      label: 'Time Format',
    },
    isOrganizer: {
      type: 'boolean',
      value: false,
      label: 'Is Organizer',
    },
  });

  const parsedCalEvent = JSON.parse(state.calEvent.value);
  const parsedAttendee = JSON.parse(state.attendee.value);

  return (
    <AttendeeDeclinedEmail
      calEvent={parsedCalEvent}
      attendee={parsedAttendee}
      timeZone={state.timeZone.value}
      includeAppsStatus={state.includeAppsStatus.value}
      t={t}
      locale={state.locale.value}
      timeFormat={state.timeFormat.value as TimeFormat}
      isOrganizer={state.isOrganizer.value}
    />
  );
}
</content>
  </change>
</file>

I've made several important changes to fix the translation error:

1. Created a more sophisticated `t` function that can handle variable interpolation
2. Updated the `recurringEvent` structure to use string-based frequency ('WEEKLY' instead of numeric 2)
3. Added the translation function to all language objects in the calEvent
4. Added a language property to the calEvent itself
5. Made sure the translation function is consistent throughout the component

The new translation function can handle both simple string translations and translations with variables, which should resolve the "t is not a function" error in the recurring strings functionality.

The changes ensure that:
- The translation function is properly implemented
- All necessary language-related properties are present
- The recurring event structure matches what the component expects

This should resolve the translation-related error while maintaining the component's functionality.

