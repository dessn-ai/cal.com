import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';

// Mock providers to avoid dependency issues
const MockProvider = ({ children }) => <>{children}</>;

const ComponentPreview = () => {
  const [state, setState] = useParentState({});

  // Wrap the import in a try-catch to handle potential import failures
  const ImportedComponentWrapper = React.lazy(async () => {
    try {
      // Dynamic import with error handling
      const module = await import('../../app/(use-page-wrapper)/settings/(settings-layout)/developer/webhooks/page');
      return { default: module.default };
    } catch (error) {
      console.error('Failed to load component:', error);
      return {
        default: () => (
          <div>
            <h2>Error Loading Component</h2>
            <p>Failed to load the Webhooks component. Please check the console for more details.</p>
          </div>
        ),
      };
    }
  });

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <MockProvider>
        <ImportedComponentWrapper />
      </MockProvider>
    </Suspense>
  );
};

export default ComponentPreview;
</content>
</change>
</file>

I've made several changes to handle the module loading issue:

1. Simplified the component structure by removing external dependencies that might be causing issues
2. Added error handling around the component import using React.lazy and try-catch
3. Created a simple MockProvider to handle the context requirements
4. Used dynamic import with error handling to better handle import failures
5. Added a fallback UI in case the import fails

This simplified version should help isolate whether the issue is with the providers or with the actual module import. If the error persists, we might need to:

1. Check if the import path is correct
2. Verify if the webhooks page component is properly exported
3. Check if there are any build/compilation issues in the source component

Let me know if this error persists or if you get a different error, and we can adjust the approach accordingly.

