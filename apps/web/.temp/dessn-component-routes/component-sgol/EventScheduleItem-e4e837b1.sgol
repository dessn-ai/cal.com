  const mockTrpcContext = {
    viewer: {
      availability: {
        schedule: {
          getScheduleByEventSlug: {
            useQuery: () => ({
              data: {
                name: "Mock Schedule",
                id: "mock-id",
              },
            }),
          },
        },
      },
    },
  };

  return <EventScheduleItem />;
}
</content>
</change>
