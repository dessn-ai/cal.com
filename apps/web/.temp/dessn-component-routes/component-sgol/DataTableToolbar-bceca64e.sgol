import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { DataTableToolbar } from '../../../../packages/features/data-table/components/DataTableToolbar';

// Create a mock DataTable context
const DataTableContext = createContext(null);

export const DataTableProvider = ({ children }) => {
  const value = {
    table: {
      getState: () => ({
        columnFilters: [],
        globalFilter: '',
      }),
      setColumnFilters: () => {},
      setGlobalFilter: () => {},
      getColumn: () => ({
        getFilterValue: () => "",
        setFilterValue: () => {},
      }),
      resetColumnFilters: () => {},
    },
  };

  return (
    <DataTableContext.Provider value={value}>
      {children}
    </DataTableContext.Provider>
  );
};

// Export the useDataTable hook that components will use
export const useDataTable = () => {
  const context = useContext(DataTableContext);
  if (!context) {
    throw new Error('useDataTable must be used within a DataTableProvider');
  }
  return context;
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "custom-class",
      label: "Class Name",
    },
  });

  // Mock table object
  const mockTable = {
    getColumn: () => ({
      getFilterValue: () => "",
      setFilterValue: () => {},
    }),
    resetColumnFilters: () => {},
  };

  return (
    <DataTableProvider>
      <DataTableToolbar.Root className={state.className.value}>
        <DataTableToolbar.SearchBar table={mockTable} searchKey="name" />
        <DataTableToolbar.ClearFiltersButton table={mockTable} />
        <DataTableToolbar.CTA>Action</DataTableToolbar.CTA>
      </DataTableToolbar.Root>
    </DataTableProvider>
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Created a mock DataTableContext and DataTableProvider
2. Implemented a basic useDataTable hook that the components are expecting
3. Wrapped the DataTableToolbar components with the DataTableProvider
4. Provided necessary mock data and functions in the context

This should resolve the "useDataTable must be used within a DataTableProvider" error by providing the required context. The mock provider includes basic functionality that should allow the DataTableToolbar components to render without errors.

