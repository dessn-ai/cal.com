import React from 'react';
import { useParentState } from '../useIframeState';
import { DataTableToolbar } from '../../../../packages/features/data-table/components/DataTableToolbar';
import { DataTableProvider } from '../../../../packages/features/data-table/context/provider';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "custom-class",
      label: "Class Name",
    },
  });

  // Mock table object with required properties
  const mockTable = {
    getColumn: () => ({
      getFilterValue: () => "",
      setFilterValue: () => {},
    }),
    resetColumnFilters: () => {},
    getState: () => ({
      columnFilters: [],
      globalFilter: "",
    }),
    setColumnFilters: () => {},
    setGlobalFilter: () => {},
  };

  // Mock data table context values
  const mockDataTableContext = {
    table: mockTable,
    data: [],
    meta: { count: 0 },
    tableContainerRef: { current: null },
    onRowSelectionChange: () => {},
    selectedRows: new Set(),
    flexRender: () => null,
  };

  return (
    <DataTableProvider {...mockDataTableContext}>
      <DataTableToolbar.Root className={state.className.value}>
        <DataTableToolbar.SearchBar table={mockTable} searchKey="name" />
        <DataTableToolbar.ClearFiltersButton table={mockTable} />
        <DataTableToolbar.CTA>Action</DataTableToolbar.CTA>
      </DataTableToolbar.Root>
    </DataTableProvider>
  );
}
</content>
</change>
</file>

