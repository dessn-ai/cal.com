import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { DataTableToolbar } from '../../../../packages/features/data-table/components/DataTableToolbar';

// Create mock context
const DataTableContext = createContext(null);

// Create mock hook that the component is trying to use
const useDataTable = () => {
  const context = useContext(DataTableContext);
  if (!context) {
    throw new Error('useDataTable must be used within a DataTableProvider');
  }
  return context;
};

// Mock Provider component
const MockDataTableProvider = ({ children }) => {
  const mockTable = {
    getColumn: () => ({
      getFilterValue: () => "",
      setFilterValue: () => {},
    }),
    resetColumnFilters: () => {},
    getState: () => ({
      columnFilters: [],
      globalFilter: "",
    }),
    setColumnFilters: () => {},
    setGlobalFilter: () => {},
  };

  const mockContext = {
    table: mockTable,
    data: [],
    meta: { count: 0 },
    tableContainerRef: { current: null },
    onRowSelectionChange: () => {},
    selectedRows: new Set(),
    flexRender: () => null,
  };

  return (
    <DataTableContext.Provider value={mockContext}>
      {children}
    </DataTableContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "custom-class",
      label: "Class Name",
    },
  });

  const mockTable = {
    getColumn: () => ({
      getFilterValue: () => "",
      setFilterValue: () => {},
    }),
    resetColumnFilters: () => {},
    getState: () => ({
      columnFilters: [],
      globalFilter: "",
    }),
    setColumnFilters: () => {},
    setGlobalFilter: () => {},
  };

  return (
    <MockDataTableProvider>
      <DataTableToolbar.Root className={state.className.value}>
        <DataTableToolbar.SearchBar table={mockTable} searchKey="name" />
        <DataTableToolbar.ClearFiltersButton table={mockTable} />
        <DataTableToolbar.CTA>Action</DataTableToolbar.CTA>
      </DataTableToolbar.Root>
    </MockDataTableProvider>
  );
}
</content>
</change>
</file>

The changes made include:

1. Removed the import of DataTableProvider since we couldn't find it
2. Created a mock DataTableContext using React's createContext
3. Created a mock useDataTable hook that the component is trying to use
4. Created a MockDataTableProvider component that provides the necessary context
5. Wrapped the DataTableToolbar components with our MockDataTableProvider

This approach should resolve the error by providing the necessary context that the DataTableToolbar components expect, without needing to import the actual DataTableProvider. The mock context provides all the necessary values and functions that the components might need.

