import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { DataTableToolbar } from '../../../../packages/features/data-table/components/DataTableToolbar';

// Create a mock DataTable context
const DataTableContext = createContext({
  table: {
    getState: () => ({
      columnFilters: [],
      globalFilter: '',
    }),
    setColumnFilters: () => {},
    setGlobalFilter: () => {},
    resetColumnFilters: () => {},
    getColumn: () => ({
      getFilterValue: () => "",
      setFilterValue: () => {},
    }),
  },
  tableContainerRef: { current: null },
  selectedRows: [],
  setSelectedRows: () => {},
});

// Create a mock provider component
const MockDataTableProvider = ({ children }) => {
  const value = {
    table: {
      getState: () => ({
        columnFilters: [],
        globalFilter: '',
      }),
      setColumnFilters: () => {},
      setGlobalFilter: () => {},
      resetColumnFilters: () => {},
      getColumn: () => ({
        getFilterValue: () => "",
        setFilterValue: () => {},
      }),
    },
    tableContainerRef: { current: null },
    selectedRows: [],
    setSelectedRows: () => {},
  };

  return (
    <DataTableContext.Provider value={value}>
      {children}
    </DataTableContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "custom-class",
      label: "Class Name",
    },
  });

  // Mock table object
  const mockTable = {
    getColumn: () => ({
      getFilterValue: () => "",
      setFilterValue: () => {},
    }),
    resetColumnFilters: () => {},
  };

  return (
    <MockDataTableProvider>
      <DataTableToolbar.Root className={state.className.value}>
        <DataTableToolbar.SearchBar table={mockTable} searchKey="name" />
        <DataTableToolbar.ClearFiltersButton table={mockTable} />
        <DataTableToolbar.CTA>Action</DataTableToolbar.CTA>
      </DataTableToolbar.Root>
    </MockDataTableProvider>
  );
}
</content>
