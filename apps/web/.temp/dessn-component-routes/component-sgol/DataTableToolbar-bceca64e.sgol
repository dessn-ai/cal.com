import React from 'react';
import { useParentState } from '../useIframeState';
import { DataTableToolbar } from '../../../../packages/features/data-table/components/DataTableToolbar';

// Mock the module that contains useDataTable
jest.mock('../../../../packages/features/data-table/hooks/useDataTable', () => ({
  useDataTable: () => ({
    table: {
      getState: () => ({
        columnFilters: [],
        globalFilter: '',
      }),
      setColumnFilters: () => {},
      setGlobalFilter: () => {},
      getColumn: () => ({
        getFilterValue: () => "",
        setFilterValue: () => {},
      }),
      resetColumnFilters: () => {},
    }
  })
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "custom-class",
      label: "Class Name",
    },
  });

  // Create a more complete mock table object
  const mockTable = {
    getState: () => ({
      columnFilters: [],
      globalFilter: '',
    }),
    setColumnFilters: () => {},
    setGlobalFilter: () => {},
    getColumn: (key: string) => ({
      getFilterValue: () => "",
      setFilterValue: () => {},
      columnDef: { cell: () => null },
      id: key,
    }),
    resetColumnFilters: () => {},
    options: {
      state: {
        columnFilters: [],
        globalFilter: '',
      }
    }
  };

  return (
    <div className="p-4">
      <DataTableToolbar.Root className={state.className.value}>
        <DataTableToolbar.SearchBar table={mockTable} searchKey="name" />
        <DataTableToolbar.ClearFiltersButton table={mockTable} />
        <DataTableToolbar.CTA>Action</DataTableToolbar.CTA>
      </DataTableToolbar.Root>
    </div>
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Removed the custom DataTableProvider and context implementation
2. Added a mock for the useDataTable hook using jest.mock
3. Enhanced the mock table object with more complete properties and methods
4. Wrapped the component in a div with padding for better presentation
5. Removed the DataTableProvider wrapper since we're mocking the hook directly

Let me also try an alternative approach in case the jest.mock doesn't work in this environment:

<file path="apps/web/.temp/dessn-component-routes/DataTableToolbar-bceca64e.tsx">
<change>
<description>Alternative approach using module override</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { DataTableToolbar } from '../../../../packages/features/data-table/components/DataTableToolbar';

// Override the useDataTable hook
const mockUseDataTable = () => ({
  table: {
    getState: () => ({
      columnFilters: [],
      globalFilter: '',
    }),
    setColumnFilters: () => {},
    setGlobalFilter: () => {},
    getColumn: (key: string) => ({
      getFilterValue: () => "",
      setFilterValue: () => {},
      columnDef: { cell: () => null },
      id: key,
    }),
    resetColumnFilters: () => {},
    options: {
      state: {
        columnFilters: [],
        globalFilter: '',
      }
    }
  }
});

// Override the module
(window as any).useDataTable = mockUseDataTable;

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "custom-class",
      label: "Class Name",
    },
  });

  const mockTable = {
    getState: () => ({
      columnFilters: [],
      globalFilter: '',
    }),
    setColumnFilters: () => {},
    setGlobalFilter: () => {},
    getColumn: (key: string) => ({
      getFilterValue: () => "",
      setFilterValue: () => {},
      columnDef: { cell: () => null },
      id: key,
    }),
    resetColumnFilters: () => {},
    options: {
      state: {
        columnFilters: [],
        globalFilter: '',
      }
    }
  };

  try {
    return (
      <div className="p-4">
        <DataTableToolbar.Root className={state.className.value}>
          <DataTableToolbar.SearchBar table={mockTable} searchKey="name" />
          <DataTableToolbar.ClearFiltersButton table={mockTable} />
          <DataTableToolbar.CTA>Action</DataTableToolbar.CTA>
        </DataTableToolbar.Root>
      </div>
    );
  } catch (error) {
    console.error('Error rendering DataTableToolbar:', error);
    return <div>Error loading DataTableToolbar component</div>;
  }
}
</content>
</change>
</file>

I've provided two different approaches to fix the issue. The second approach:
1. Creates a mock useDataTable hook
2. Attaches it to the window object to make it globally available
3. Adds error handling with try/catch
4. Provides a more complete mock table object
5. Wraps the component in a div with padding

One of these approaches should resolve the error. If the error persists, we might need to examine the actual DataTableToolbar component implementation to better understand what hooks and context it's trying to use.

