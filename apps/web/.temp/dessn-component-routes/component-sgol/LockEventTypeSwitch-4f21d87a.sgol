import React from 'react';
import { useParentState } from '../useIframeState';
import { LockEventTypeSwitch } from '../../../../packages/features/ee/organizations/pages/components/LockEventTypeSwitch';
import { useForm, FormProvider } from 'react-hook-form';
import { trpc } from '@calcom/trpc/react';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { httpBatchLink } from '@trpc/client';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    isAdminOrOwner: {
      type: "boolean",
      value: true,
      label: "Is Admin or Owner",
    },
  });

  const currentOrg = {
    organizationSettings: {
      lockEventTypeCreationForUsers: false,
    },
  };

  const formMethods = useForm();

  // Create a new QueryClient instance
  const queryClient = new QueryClient();

  // Create a new trpc client
  const trpcClient = trpc.createClient({
    links: [
      httpBatchLink({
        url: '/api/trpc',
      }),
    ],
  });

  return (
    <QueryClientProvider client={queryClient}>
      <trpc.Provider client={trpcClient} queryClient={queryClient}>
        <FormProvider {...formMethods}>
          <LockEventTypeSwitch
            currentOrg={currentOrg}
            isAdminOrOwner={state.isAdminOrOwner.value}
          />
        </FormProvider>
      </trpc.Provider>
    </QueryClientProvider>
  );
}
</content>
</change>
</file>

I've made the following changes to fix the error:

1. Added `FormProvider` import and wrapped the component with `FormProvider` since we're using `react-hook-form`
2. Added `QueryClientProvider` and `trpc.Provider` since the component might be using TRPC for data fetching
3. Added necessary imports for TRPC and React Query
4. Created instances of `QueryClient` and TRPC client
5. Wrapped the component with all necessary providers in the correct order

These changes should resolve the "Failed to fetch dynamically imported module" error by providing all the required context providers that the `LockEventTypeSwitch` component might need. The error was likely occurring because the component was trying to access these providers but they weren't available in the preview environment.

If you still see any errors, please let me know and I can help adjust the solution further.

