      }),
      label: 'Attendee',
    },
    newSeat: {
      type: 'boolean',
      value: false,
      label: 'New Seat',
    },
    attendeeCancelled: {
      type: 'boolean',
      value: false,
      label: 'Attendee Cancelled',
    },
    timeZone: {
      type: 'string',
      value: 'America/New_York',
      label: 'Time Zone',
    },
    includeAppsStatus: {
      type: 'boolean',
      value: false,
      label: 'Include Apps Status',
    },
    locale: {
      type: 'string',
      value: 'en',
      label: 'Locale',
    },
    timeFormat: {
      type: 'dropdown',
      value: TimeFormat.TWELVE_HOUR,
      options: Object.values(TimeFormat),
      label: 'Time Format',
    },
    isOrganizer: {
      type: 'boolean',
      value: true,
      label: 'Is Organizer',
    },
  });

  const parsedCalEvent = JSON.parse(state.calEvent.value);
  const parsedAttendee = JSON.parse(state.attendee.value);

  // Create a more comprehensive translation function
  const translationFunction = React.useCallback(
    (key: string | { id: string; defaultMessage: string }, variables?: Record<string, any>) => {
      try {
        // Handle object format
        if (typeof key === 'object' && key !== null) {
          return key.defaultMessage || key.id || '';
        }

        // Handle string format
        if (typeof key === 'string') {
          if (!variables) return key;

          // Replace variables in the string
          return Object.entries(variables).reduce((acc, [varKey, value]) => {
            const regex = new RegExp(`{${varKey}}`, 'g');
            return acc.replace(regex, String(value));
          }, key);
        }

        // Fallback
        return typeof key === 'string' ? key : '';
      } catch (error) {
        console.error('Translation error:', error);
        return typeof key === 'string' ? key : '';
      }
    },
    []
  );

  return (
    <OrganizerRescheduledEmail
      calEvent={parsedCalEvent}
      attendee={parsedAttendee}
      newSeat={state.newSeat.value}
      attendeeCancelled={state.attendeeCancelled.value}
      timeZone={state.timeZone.value}
      includeAppsStatus={state.includeAppsStatus.value}
      t={translationFunction}
      locale={state.locale.value}
      timeFormat={state.timeFormat.value as TimeFormat}
      isOrganizer={state.isOrganizer.value}
    />
  );
}
