    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { OrganizerRescheduledEmail } from '../../../../packages/emails/src/templates/OrganizerRescheduledEmail';

// Define TimeFormat enum locally instead of importing
enum TimeFormat {
  TWELVE_HOUR = '12h',
  TWENTY_FOUR_HOUR = '24h'
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    calEvent: {
      type: 'string',
      value: JSON.stringify({
        type: 'Meeting',
        title: 'Team Sync',
        startTime: '2023-06-15T10:00:00Z',
        endTime: '2023-06-15T11:00:00Z',
        organizer: {
          name: 'John Doe',
          email: 'john@example.com',
          timeZone: 'America/New_York',
          language: { translate: (key: string) => key, locale: 'en' },
        },
        attendees: [
          {
            name: 'Jane Smith',
            email: 'jane@example.com',
            timeZone: 'America/Los_Angeles',
            language: { translate: (key: string) => key, locale: 'en' },
          },
        ],
      }),
      label: 'Calendar Event',
    },
    attendee: {
      type: 'string',
      value: JSON.stringify({
        name: 'Jane Smith',
        email: 'jane@example.com',
        timeZone: 'America/Los_Angeles',
        language: { translate: (key: string) => key, locale: 'en' },
      }),
      label: 'Attendee',
    },
    newSeat: {
      type: 'boolean',
      value: false,
      label: 'New Seat',
    },
    attendeeCancelled: {
      type: 'boolean',
      value: false,
      label: 'Attendee Cancelled',
    },
    timeZone: {
      type: 'string',
      value: 'America/New_York',
      label: 'Time Zone',
    },
    includeAppsStatus: {
      type: 'boolean',
      value: false,
      label: 'Include Apps Status',
    },
    locale: {
      type: 'string',
      value: 'en',
      label: 'Locale',
    },
    timeFormat: {
      type: 'dropdown',
      value: TimeFormat.TWELVE_HOUR,
      options: Object.values(TimeFormat),
      label: 'Time Format',
    },
    isOrganizer: {
      type: 'boolean',
      value: true,
      label: 'Is Organizer',
    },
  });

  const parsedCalEvent = JSON.parse(state.calEvent.value);
  const parsedAttendee = JSON.parse(state.attendee.value);

  // Create a more comprehensive translation function
  const translationFunction = React.useCallback(
    (key: string | { id: string; defaultMessage: string }, variables?: Record<string, any>) => {
      try {
        // Handle object format
        if (typeof key === 'object' && key !== null) {
          return key.defaultMessage || key.id || '';
        }

        // Handle string format
        if (typeof key === 'string') {
          if (!variables) return key;

          // Replace variables in the string
          return Object.entries(variables).reduce((acc, [varKey, value]) => {
            const regex = new RegExp(`{${varKey}}`, 'g');
            return acc.replace(regex, String(value));
          }, key);
        }

        // Fallback
        return typeof key === 'string' ? key : '';
      } catch (error) {
        console.error('Translation error:', error);
        return typeof key === 'string' ? key : '';
      }
    },
    []
  );

  return (
    <OrganizerRescheduledEmail
      calEvent={parsedCalEvent}
      attendee={parsedAttendee}
      newSeat={state.newSeat.value}
      attendeeCancelled={state.attendeeCancelled.value}
      timeZone={state.timeZone.value}
      includeAppsStatus={state.includeAppsStatus.value}
      t={translationFunction}
      locale={state.locale.value}
      timeFormat={state.timeFormat.value as TimeFormat}
      isOrganizer={state.isOrganizer.value}
    />
  );
}
</content>
  </change>
</file>

I've made the following changes:
1. Removed the Context-based approach since it wasn't solving the issue
2. Created a more comprehensive translation function that:
   - Handles both string and object formats
   - Includes error handling
   - Supports variable interpolation
   - Has proper TypeScript typing
   - Handles null/undefined cases
   - Provides fallback behavior
3. Memoized the translation function with useCallback to prevent unnecessary rerenders
4. Simplified the component structure by removing the unnecessary provider wrapper

The new translation function should be more compatible with what the email component expects because:
1. It handles both string keys and object-style translations
2. It includes proper error handling
3. It supports variable interpolation in the format {varName}
4. It has fallback behavior to prevent undefined errors
5. It's properly memoized to maintain reference stability

This should resolve the "t is not a function" error by providing a proper translation function that matches the expected interface of the email component.

