    if (typeof key === 'object') {
      return key.defaultMessage || key.id;
    }
    
    if (!vars) {
      return key;
    }

    let result = key;
    Object.entries(vars).forEach(([varKey, value]) => {
      result = result.replace(new RegExp(`{${varKey}}`, 'g'), String(value));
    });
    
    return result;
  }

  return (
