    attendee: attendeeData,
    newSeat: state.newSeat.value,
    attendeeCancelled: state.attendeeCancelled.value,
    teamMember: teamMemberData,
    reassigned: reassignedData
  };

  return <OrganizerCancelledEmail {...props} />;
}
