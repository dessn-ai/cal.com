import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';
import { CreateTeamEventType, LayoutWrapper } from '../../modules/settings/teams/[id]/event-types-view';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { trpc } from '@calcom/trpc/react';
import { httpBatchLink } from '@trpc/client';
import { useState } from 'react';

// Create a mock trpc client
const mockTrpcClient = trpc.createClient({
  links: [
    httpBatchLink({
      url: '/api/trpc',
    }),
  ],
});

// Create a mock QueryClient
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      cacheTime: 0,
    },
  },
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({});
  
  return (
    <trpc.Provider client={mockTrpcClient} queryClient={queryClient}>
      <QueryClientProvider client={queryClient}>
        <Suspense fallback={<div>Loading...</div>}>
          <LayoutWrapper>
            <CreateTeamEventType />
          </LayoutWrapper>
        </Suspense>
      </QueryClientProvider>
    </trpc.Provider>
  );
}
</file>

