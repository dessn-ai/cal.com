<description>Fix the store implementation to prevent infinite updates and properly mock the required functionality</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { TimeDial } from '../../../../packages/features/timezone-buddy/components/TimeDial';
import { TBContext } from '../../../../packages/features/timezone-buddy/store';
import dayjs from '@calcom/dayjs';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    timezone: {
      type: "string",
      value: "America/New_York",
      label: "Timezone",
    },
    dateRanges: {
      type: "string",
      value: JSON.stringify([
        {
          start: dayjs().startOf('day').add(9, 'hour').toISOString(),
          end: dayjs().startOf('day').add(17, 'hour').toISOString(),
        },
      ]),
      label: "Date Ranges",
    },
  });

  const parsedDateRanges = React.useMemo(() => {
    try {
      return JSON.parse(state.dateRanges.value).map((range) => ({
        start: dayjs(range.start),
        end: dayjs(range.end),
      }));
    } catch (e) {
      console.error("Failed to parse date ranges", e);
      return undefined;
    }
  }, [state.dateRanges.value]);

  // Create a stable store reference that won't change on every render
  const store = React.useMemo(() => {
    const initialState = {
      browsingDate: dayjs(),
      emitCellPosition: (position: number) => {
        // No-op implementation since it's just for preview
      },
    };

    let listeners: Array<() => void> = [];

    return {
      getState: () => initialState,
      setState: () => {}, // No-op since we don't need to update state in preview
      subscribe: (listener: () => void) => {
        listeners.push(listener);
        return () => {
          listeners = listeners.filter(l => l !== listener);
        };
      },
      destroy: () => {
        listeners = [];
      },
    };
  }, []);

  return (
    <TBContext.Provider value={store}>
      <TimeDial 
        timezone={state.timezone.value}
        dateRanges={parsedDateRanges}
      />
    </TBContext.Provider>
  );
}
</content>
</change>
</file>

The key changes made to fix the infinite update loop:

1. Created a proper Zustand-like store implementation with all required methods (getState, setState, subscribe, destroy)
2. Made the store reference stable by using useMemo
3. Implemented a proper subscription system that won't trigger unnecessary updates
4. Made the emitCellPosition function a no-op since it's just for preview
5. Ensured the store state is immutable and won't cause re-renders

This should resolve the maximum update depth exceeded error by preventing the infinite loop of updates that was occurring in the previous implementation.

The store now properly implements the Zustand store interface that the TimeDial component expects, while keeping the store state stable and preventing unnecessary re-renders. The emitCellPosition function is implemented as a no-op since it's just for preview purposes and doesn't need to actually do anything in this context.

