import React from 'react';
import { useParentState } from '../useIframeState';
import Select from '../../../../packages/features/form/components/Select';
import { ThemeProvider } from 'next-themes';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    inputClassName: {
      type: "string",
      value: "custom-input-class",
      label: "Input Class Name"
    },
    placeholder: {
      type: "string",
      value: "Select an option",
      label: "Placeholder"
    },
    isDisabled: {
      type: "boolean",
      value: false,
      label: "Is Disabled"
    },
    isClearable: {
      type: "boolean",
      value: true,
      label: "Is Clearable"
    },
    isSearchable: {
      type: "boolean",
      value: true,
      label: "Is Searchable"
    }
  });

  const options = [
    { value: 'option1', label: 'Option 1' },
    { value: 'option2', label: 'Option 2' },
    { value: 'option3', label: 'Option 3' },
  ];

  return (
    <ThemeProvider attribute="class" defaultTheme="light">
      <Select
        className={state.inputClassName.value}
        placeholder={state.placeholder.value}
        isDisabled={state.isDisabled.value}
        isClearable={state.isClearable.value}
        isSearchable={state.isSearchable.value}
        options={options}
        onChange={(selectedOption) => console.log(selectedOption)}
      />
    </ThemeProvider>
  );
}
</content>
</change>
</file>

I've made the following changes:

1. Changed the import from `InputComponent` to the default `Select` export since that's the main component that handles all the styling and theming
2. Added `ThemeProvider` from `next-themes` to provide the theme context that the Select component needs
3. Changed `inputClassName` prop to `className` as that's what the Select component expects
4. Wrapped the Select component with ThemeProvider to ensure the theme context is available

These changes should resolve the "getStyles is not a function" error by providing the necessary theme context and using the correct component with proper styling setup.

