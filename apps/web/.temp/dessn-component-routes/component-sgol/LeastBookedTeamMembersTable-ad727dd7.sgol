import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { LeastBookedTeamMembersTable } from '../../../../packages/features/insights/components/LeastBookedTeamMembersTable';

// Create a mock context with the structure expected by the component
const InsightsOrgTeamsContext = createContext({
  teams: [
    {
      id: 1,
      name: "Team 1",
      members: [
        { id: 1, name: "Member 1", bookingCount: 5 },
        { id: 2, name: "Member 2", bookingCount: 3 }
      ]
    }
  ],
  isLoading: false,
  error: null,
  fetchTeams: () => Promise.resolve(),
  selectedTeamId: 1,
  setSelectedTeamId: () => {},
});

// Create a mock provider component
const MockInsightsOrgTeamsProvider = ({ children }) => {
  return (
    <InsightsOrgTeamsContext.Provider
      value={{
        teams: [
          {
            id: 1,
            name: "Team 1",
            members: [
              { id: 1, name: "Member 1", bookingCount: 5 },
              { id: 2, name: "Member 2", bookingCount: 3 }
            ]
          }
        ],
        isLoading: false,
        error: null,
        fetchTeams: () => Promise.resolve(),
        selectedTeamId: 1,
        setSelectedTeamId: () => {},
      }}
    >
      {children}
    </InsightsOrgTeamsContext.Provider>
  );
};

// Export the useInsightsOrgTeams hook to override the original
export const useInsightsOrgTeams = () => {
  const context = useContext(InsightsOrgTeamsContext);
  if (!context) {
    throw new Error('useInsightsOrgTeams must be used within a InsightsOrgTeamsProvider');
  }
  return context;
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to configure for this component
  });

  return (
    <MockInsightsOrgTeamsProvider>
      <LeastBookedTeamMembersTable />
    </MockInsightsOrgTeamsProvider>
  );
}
</content>
</change>
</file>

