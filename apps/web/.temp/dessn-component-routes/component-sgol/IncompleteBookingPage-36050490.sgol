            conditions: [],
            target: "https://example.com",
            queryValue: {}
          }
        ],
        _count: { responses: 0 },
      },
      label: "Form",
    },
    appUrl: {
      type: "string",
      value: "https://example.com",
      label: "App URL",
    },
    enrichedWithUserProfileForm: {
      type: "object",
      value: {
        user: {
          metadata: {},
          id: 1,
          username: "johndoe",
          profile: {
            name: "John Doe",
            email: "john@example.com"
          },
        },
        team: null,
