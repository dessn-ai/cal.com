  links: [
    httpBatchLink({
      url: '/api/trpc',
      // Add headers if needed
      headers: () => ({
        'Content-Type': 'application/json',
      }),
    }),
  ],
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    showDialog: {
      type: "boolean",
