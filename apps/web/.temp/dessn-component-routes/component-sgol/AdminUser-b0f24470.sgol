import React from 'react';
import { useParentState } from "../useIframeState";
import ImportedComponent from "../../components/booking/CancelBooking";

// Mock the Frequency enum locally instead of importing from @calcom/types/Calendar
enum Frequency {
  YEARLY = "YEARLY",
  MONTHLY = "MONTHLY",
  WEEKLY = "WEEKLY",
  DAILY = "DAILY",
  ONCE = "ONCE"
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    booking: {
      id: 123,
      title: "Test Booking",
      description: "Test Description",
      startTime: new Date().toISOString(),
      endTime: new Date().toISOString(),
      attendees: [],
      recurring: false,
      recurringCount: 0,
      frequency: Frequency.ONCE
    }
  });

  return (
    <ImportedComponent
      booking={state.booking}
      profile={{ name: "Test User", email: "test@example.com" }}
    />
  );
}
    </content>
  </change>
</file>

I've made the following changes:
1. Removed the problematic import from "@calcom/types/Calendar"
2. Created a local enum definition for `Frequency` that matches the expected structure
3. Added proper mock data for the booking and profile props
4. Kept the component structure and other imports intact

This should resolve the error by providing the necessary type definition locally instead of trying to import it from an unavailable package. The enum values are based on standard calendar frequency values that are commonly used.

