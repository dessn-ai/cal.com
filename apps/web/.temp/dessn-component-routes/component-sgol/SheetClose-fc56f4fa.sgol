import React from 'react';
import { useParentState } from '../useIframeState';
import { RadioArea } from '@calcom/ui';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    value: {
      type: "string",
      value: "option1",
      label: "Selected Value",
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled",
    },
    id: {
      type: "string",
      value: "radio-example",
      label: "ID",
    },
    label: {
      type: "string",
      value: "Example Radio",
      label: "Label",
    },
    withPadding: {
      type: "boolean",
      value: true,
      label: "With Padding",
    },
  });

  return (
    <RadioArea
      value={state.value.value}
      disabled={state.disabled.value}
      id={state.id.value}
      label={state.label.value}
      onChange={(value) => {
        setState((prev) => ({
          ...prev,
          value: { ...prev.value, value },
        }));
      }}
    >
      {state.label.value}
    </RadioArea>
  );
}
</content>
</change>
</file>

