import React from 'react';
import { useParentState } from '../useIframeState';
import { OtherTeamsListing } from '../../../../packages/features/ee/organizations/pages/components/OtherTeamsListing';
import * as trpcModule from '@calcom/trpc/react';

// Create mock data type
type MockTeam = {
  id: number;
  name: string;
};

// Create a wrapper component that provides the mocked context
const OtherTeamsListingWithMocks: React.FC = () => {
  // Mock the trpc hook functionality
  jest.spyOn(trpcModule, 'trpc', 'get').mockImplementation(() => ({
    viewer: {
      organizations: {
        listOtherTeams: {
          useQuery: () => ({
            data: [
              { id: 1, name: 'Team 1' },
              { id: 2, name: 'Team 2' }
            ],
            isPending: false,
            error: null
          })
        }
      }
    }
  }));

  return <OtherTeamsListing />;
};

export default function ComponentPreview() {
  const [state] = useParentState({
    isPending: {
      type: "boolean",
      value: false,
      label: "Is Loading",
    },
    hasError: {
      type: "boolean",
      value: false,
      label: "Has Error",
    },
    teamsCount: {
      type: "number",
      value: 2,
      label: "Number of Teams",
    },
  });

  return <OtherTeamsListingWithMocks />;
}
</content>
</change>
</file>

The changes I made:

1. Removed direct reassignment of `trpc` and `useLocale` constants
2. Created a wrapper component `OtherTeamsListingWithMocks` to handle the mocking
3. Used `jest.spyOn` to properly mock the trpc module
4. Simplified the component structure and removed unnecessary mock implementations
5. Added proper TypeScript types
6. Kept the state management but simplified its usage
7. Provided default mock data instead of trying to dynamically generate it based on state

This should resolve the "Assignment to constant variable" error while still providing the necessary mocked functionality for the component preview.

