<file path="apps/web/.temp/dessn-component-routes/MostBookedTeamMembersTable-0dc1c3a4.tsx">
  <change>
    <description>Remove jest.mock and use React context for session mocking</description>
    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { MostBookedTeamMembersTable } from '../../../../packages/features/insights/components/MostBookedTeamMembersTable';

// Create the InsightsOrgTeamsContext with the correct shape
export const InsightsOrgTeamsContext = React.createContext({
  orgTeamsType: "org" as const,
  selectedTeamId: 1,
  setOrgTeamsType: (type: "org" | "team" | "yours") => {},
  setSelectedTeamId: (id: number) => {},
});

// Create a Provider component
const InsightsOrgTeamsProvider = ({ children }) => {
  const [orgTeamsType, setOrgTeamsType] = React.useState<"org" | "team" | "yours">("org");
  const [selectedTeamId, setSelectedTeamId] = React.useState(1);

  return (
    <InsightsOrgTeamsContext.Provider
      value={{
        orgTeamsType,
        selectedTeamId,
        setOrgTeamsType,
        setSelectedTeamId,
      }}
    >
      {children}
    </InsightsOrgTeamsContext.Provider>
  );
};

// Create Session Context
const SessionContext = React.createContext({
  data: {
    user: {
      id: 1,
      org: {
        id: 1
      }
    }
  },
  status: "authenticated",
  update: () => Promise.resolve(null)
});

// Create a Session Provider component
const MockSessionProvider = ({ children }) => {
  return (
    <SessionContext.Provider
      value={{
        data: {
          user: {
            id: 1,
            org: {
              id: 1
            }
          }
        },
        status: "authenticated",
        update: () => Promise.resolve(null)
      }}
    >
      {children}
    </SessionContext.Provider>
  );
};

// Mock data for the table
const mockData = [
  { name: 'John Doe', bookings: 50 },
  { name: 'Jane Smith', bookings: 45 },
  { name: 'Bob Johnson', bookings: 40 },
];

// Create a wrapper component that provides all necessary mocks
const MockProvider = ({ children }) => {
  const mockQueryResult = {
    data: mockData,
    isSuccess: true,
    isPending: false,
  };

  // Create a mock TRPC provider
  const MockTRPCProvider = ({ children }) => {
    const mockTrpc = {
      viewer: {
        insights: {
          membersWithMostBookings: {
            useQuery: () => mockQueryResult,
          },
        },
      },
    };

    // Create a mock context
    const TRPCContext = React.createContext(mockTrpc);

    return (
      <TRPCContext.Provider value={mockTrpc}>
        {children}
      </TRPCContext.Provider>
    );
  };

  return (
    <MockSessionProvider>
      <InsightsOrgTeamsProvider>
        <MockTRPCProvider>
          {children}
        </MockTRPCProvider>
      </InsightsOrgTeamsProvider>
    </MockSessionProvider>
  );
};

// Create InsightsParameters Context and Provider
const InsightsParametersContext = React.createContext({
  isAll: true,
  teamId: 1,
  startDate: new Date('2023-01-01'),
  endDate: new Date('2023-12-31'),
  eventTypeId: null,
});

// Override the useSession hook
const useSession = () => React.useContext(SessionContext);

// Make it available globally
(window as any).useSession = useSession;

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  return (
    <InsightsParametersContext.Provider
      value={{
        isAll: true,
        teamId: 1,
        startDate: new Date('2023-01-01'),
        endDate: new Date('2023-12-31'),
        eventTypeId: null,
      }}
    >
      <MockProvider>
        <MostBookedTeamMembersTable />
      </MockProvider>
    </InsightsParametersContext.Provider>
  );
}
</content>
  </change>
</file>

I've made several important changes:

1. Removed the `jest.mock()` call which was causing the error
2. Created a proper `SessionContext` and `MockSessionProvider` to handle session data
3. Created a custom `useSession` hook that uses our mock context
4. Made the `useSession` hook available globally through the window object
5. Added the `MockSessionProvider` to our provider chain
6. Maintained all other necessary contexts and providers

The key changes are:
- Replaced Jest mocking with React context-based mocking
- Created a proper session context structure that matches what the component expects
- Made the session data available through a custom hook
- Ensured all the necessary provider hierarchy is maintained

This should now work without the Jest-related error while still providing all the necessary context and data for the component to function properly.

