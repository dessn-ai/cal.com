import React from 'react';
import { useParentState } from '../useIframeState';
import { MostBookedTeamMembersTable } from '../../../../packages/features/insights/components/MostBookedTeamMembersTable';

// Create and export the InsightsOrgTeamsContext
export const InsightsOrgTeamsContext = React.createContext({
  teams: [
    { id: 1, name: 'Team 1', membership: { accepted: true, role: 'ADMIN' } },
    { id: 2, name: 'Team 2', membership: { accepted: true, role: 'MEMBER' } }
  ],
  isLoading: false,
  error: null,
  fetchTeams: () => Promise.resolve()
});

// Create a Provider component
const InsightsOrgTeamsProvider = ({ children }) => {
  const value = {
    teams: [
      { id: 1, name: 'Team 1', membership: { accepted: true, role: 'ADMIN' } },
      { id: 2, name: 'Team 2', membership: { accepted: true, role: 'MEMBER' } }
    ],
    isLoading: false,
    error: null,
    fetchTeams: () => Promise.resolve()
  };

  return (
    <InsightsOrgTeamsContext.Provider value={value}>
      {children}
    </InsightsOrgTeamsContext.Provider>
  );
};

// Mock data for the table
const mockData = [
  { name: 'John Doe', bookings: 50 },
  { name: 'Jane Smith', bookings: 45 },
  { name: 'Bob Johnson', bookings: 40 },
];

// Create a wrapper component that provides all necessary mocks
const MockProvider = ({ children }) => {
  const mockQueryResult = {
    data: mockData,
    isSuccess: true,
    isPending: false,
  };

  // Create a mock TRPC provider
  const MockTRPCProvider = ({ children }) => {
    const mockTrpc = {
      viewer: {
        insights: {
          membersWithMostBookings: {
            useQuery: () => mockQueryResult,
          },
        },
      },
    };

    return React.createElement(React.Fragment, null, children);
  };

  return (
    <InsightsOrgTeamsProvider>
      <MockTRPCProvider>
        {children}
      </MockTRPCProvider>
    </InsightsOrgTeamsProvider>
  );
};

// Mock the useInsightsParameters hook
const InsightsParametersContext = React.createContext({
  isAll: true,
  teamId: 1,
  startDate: new Date('2023-01-01'),
  endDate: new Date('2023-12-31'),
  eventTypeId: null,
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to control for this component
  });

  return (
    <InsightsParametersContext.Provider
      value={{
        isAll: true,
        teamId: 1,
        startDate: new Date('2023-01-01'),
        endDate: new Date('2023-12-31'),
        eventTypeId: null,
      }}
    >
      <MockProvider>
        <MostBookedTeamMembersTable />
      </MockProvider>
    </InsightsParametersContext.Provider>
  );
}
</content>
  </change>
</file>

I've made the following changes to fix the error:

1. Exported the `InsightsOrgTeamsContext` by adding the `export` keyword
2. Enhanced the mock data structure to include `membership` property which is likely required by the component
3. Added a `fetchTeams` function to the context value to match the expected interface
4. Made sure the context value is properly structured in both the context creation and provider

The error was occurring because the `useInsightsOrgTeams` hook couldn't access the context since it wasn't properly exported and available. Now that we've exported the context and provided all the necessary properties, the hook should be able to access the context correctly.

The mock data structure has also been improved to better match what the actual component might expect, including team membership information which is often required in team-related components.

