import React from 'react';
import { useParentState } from '../useIframeState';
import { MostBookedTeamMembersTable } from '../../../../packages/features/insights/components/MostBookedTeamMembersTable';

// Create the InsightsOrgTeamsContext
const InsightsOrgTeamsContext = React.createContext({
  teams: [
    { id: 1, name: 'Team 1' },
    { id: 2, name: 'Team 2' }
  ],
  isLoading: false,
  error: null
});

// Create a Provider component
const InsightsOrgTeamsProvider = ({ children }) => {
  return (
    <InsightsOrgTeamsContext.Provider
      value={{
        teams: [
          { id: 1, name: 'Team 1' },
          { id: 2, name: 'Team 2' }
        ],
        isLoading: false,
        error: null
      }}
    >
      {children}
    </InsightsOrgTeamsContext.Provider>
  );
};

// Mock data for the table
const mockData = [
  { name: 'John Doe', bookings: 50 },
  { name: 'Jane Smith', bookings: 45 },
  { name: 'Bob Johnson', bookings: 40 },
];

// Create a wrapper component that provides all necessary mocks
const MockProvider = ({ children }) => {
  const mockQueryResult = {
    data: mockData,
    isSuccess: true,
    isPending: false,
  };

  // Create a mock TRPC provider
  const MockTRPCProvider = ({ children }) => {
    const mockTrpc = {
      viewer: {
        insights: {
          membersWithMostBookings: {
            useQuery: () => mockQueryResult,
          },
        },
      },
    };

    return React.createElement(React.Fragment, null, children);
  };

  return (
    <InsightsOrgTeamsProvider>
      <MockTRPCProvider>
        {children}
      </MockTRPCProvider>
    </InsightsOrgTeamsProvider>
  );
};

// Mock the useInsightsParameters hook
