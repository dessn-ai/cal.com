import React from 'react';
import { useParentState } from '../useIframeState';
import { MostBookedTeamMembersTable } from '../../../../packages/features/insights/components/MostBookedTeamMembersTable';
import { InsightsOrgTeamsProvider } from '../../../../packages/features/insights/providers/InsightsOrgTeamsProvider';

// Mock data for the table
const mockData = [
  { name: 'John Doe', bookings: 50 },
  { name: 'Jane Smith', bookings: 45 },
  { name: 'Bob Johnson', bookings: 40 },
];

// Create a wrapper component that provides all necessary mocks
const MockProvider = ({ children }) => {
  const mockQueryResult = {
    data: mockData,
    isSuccess: true,
    isPending: false,
  };

  // Create a mock TRPC provider
  const MockTRPCProvider = ({ children }) => {
    // Mock the trpc object
    const mockTrpc = {
      viewer: {
        insights: {
          membersWithMostBookings: {
            useQuery: () => mockQueryResult,
          },
        },
      },
    };

    // Create a mock context
    const TRPCContext = React.createContext(mockTrpc);

    // Provide the mock trpc context
    return (
      <TRPCContext.Provider value={mockTrpc}>
        {children}
      </TRPCContext.Provider>
    );
  };

  return (
    <MockTRPCProvider>
      {children}
    </MockTRPCProvider>
  );
};

// Create InsightsParameters Context and Provider
const InsightsParametersContext = React.createContext({
  isAll: true,
  teamId: 1,
  startDate: new Date('2023-01-01'),
  endDate: new Date('2023-12-31'),
  eventTypeId: null,
});

// Mock the useLocale hook
jest.mock('@calcom/lib/hooks/useLocale', () => ({
  useLocale: () => ({
    t: (key) => key,
  }),
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  // Mock teams data
  const teamsData = {
    teams: [
      { id: 1, name: 'Team 1', membership: { accepted: true, role: 'ADMIN' } },
      { id: 2, name: 'Team 2', membership: { accepted: true, role: 'MEMBER' } }
    ],
    isLoading: false,
    error: null,
    fetchTeams: () => Promise.resolve()
  };

  return (
    <InsightsParametersContext.Provider
      value={{
        isAll: true,
        teamId: 1,
        startDate: new Date('2023-01-01'),
        endDate: new Date('2023-12-31'),
        eventTypeId: null,
      }}
    >
      <InsightsOrgTeamsProvider defaultValue={teamsData}>
        <MockProvider>
          <MostBookedTeamMembersTable />
        </MockProvider>
      </InsightsOrgTeamsProvider>
    </InsightsParametersContext.Provider>
  );
}
</content>
  </change>
</file>

I've made several important changes:

1. Imported the actual `InsightsOrgTeamsProvider` from the package instead of creating our own mock
2. Provided a `defaultValue` to the `InsightsOrgTeamsProvider` with the necessary team data
3. Restructured the mock providers to better handle the TRPC context
4. Added a mock for the `useLocale` hook which is used in the component
5. Maintained the necessary contexts for parameters and team data
6. Properly structured the provider hierarchy to ensure all required contexts are available

The error should now be resolved as we're using the actual provider from the package instead of our mock implementation. The component should have access to all the contexts and data it needs to render properly.

