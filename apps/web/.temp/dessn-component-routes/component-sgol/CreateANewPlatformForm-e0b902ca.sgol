import React from 'react';
import { useParentState } from '../useIframeState';
import { CreateANewPlatformForm } from '../../../../packages/features/ee/platform/components/CreateANewPlatformForm';
import { SessionProvider } from 'next-auth/react';
import { UserPermissionRole } from '@calcom/prisma/enums';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    mockSession: {
      type: 'boolean',
      value: true,
      label: 'Mock Session',
    },
  });

  const mockSession = {
    data: {
      user: {
        id: 1,
        email: 'test@example.com',
        name: 'Test User',
        role: 'ADMIN',
        username: 'testuser',
        completedOnboarding: true,
        timeZone: 'UTC',
        weekStart: 'Monday',
        startTime: 0,
        endTime: 1440,
        defaultScheduleId: 1,
        locale: 'en',
        timeFormat: 12,
      },
      expires: new Date(Date.now() + 2 * 86400).toISOString(),
      hasValidLicense: true,
      upId: 'test-platform',
    },
    status: 'authenticated',
    update: async () => Promise.resolve(null),
  };

  return (
    <div className="m-8">
      <SessionProvider session={mockSession}>
        <CreateANewPlatformForm />
      </SessionProvider>
    </div>
  );
}
</content>
</change>
</file>

Key changes made:
1. Provided a more complete user object with all the fields that next-auth typically expects
2. Changed the role to be a string 'ADMIN' instead of using the enum directly
3. Added additional session properties like hasValidLicense and upId
4. Added more user properties that might be expected by the component
5. Wrapped the component in a div with margin for better visibility
6. Made sure the session structure exactly matches what next-auth expects

This should resolve the role undefined error by providing a more complete and accurate session mock that matches what the component expects when using useSession() internally.

