  locale: {
    locale: 'en',
    i18n: {
      language: 'en',
      languages: ['en'],
      loadPath: '/locales/{{lng}}/{{ns}}.json',
      defaultNS: 'common',
    },
    t: (key: string) => key,
    isLocaleReady: true,
  }
});

export default function ComponentPreview() {
