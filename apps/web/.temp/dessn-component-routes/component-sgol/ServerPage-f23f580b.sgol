import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';

// Mock the VerifyPage component since we can't access the actual one in preview
const MockVerifyPage = ({ EMAIL_FROM }: { EMAIL_FROM: string }) => {
  return (
    <div>
      <h1>Verify Email Page</h1>
      <p>Email will be sent from: {EMAIL_FROM}</p>
    </div>
  );
};

// Mock the actual page component
const MockImportedComponent = () => {
  return <MockVerifyPage EMAIL_FROM={process.env.EMAIL_FROM} />;
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    EMAIL_FROM: {
      type: "string",
      value: "noreply@example.com",
      label: "EMAIL_FROM",
    },
  });

  // Create a mock environment
  const mockEnv = {
    EMAIL_FROM: state.EMAIL_FROM.value,
  };

  // Create a mock process object
  const mockProcess = {
    env: mockEnv
  };

  // Assign it to the global scope
  (global as any).process = mockProcess;

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <div className="preview-container">
        <MockImportedComponent />
      </div>
    </Suspense>
  );
}
</content>
</change>
</file>

