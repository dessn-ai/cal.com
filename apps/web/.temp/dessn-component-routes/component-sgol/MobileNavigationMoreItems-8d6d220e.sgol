import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { MobileNavigationMoreItems } from '../../../../packages/features/shell/navigation/Navigation';

// Create mock context for OrgBranding
const OrgBrandingContext = createContext({
  theme: null,
  logo: '',
  name: 'Test Organization',
  brandColor: '#292929',
  darkBrandColor: '#fafafa',
  organizationId: 1,
});

// Override the actual useOrgBranding hook
const useOrgBranding = () => useContext(OrgBrandingContext);

// Create a mock NavigationContext
const NavigationContext = createContext({
  mobileNavigationItems: [],
  mobileMoreItems: []
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  const mockOrgBranding = {
    theme: null,
    logo: '',
    name: 'Test Organization',
    brandColor: '#292929',
    darkBrandColor: '#fafafa',
    organizationId: 1,
  };

  const mockNavigation = {
    mobileNavigationItems: [],
    mobileMoreItems: []
  };

  try {
    return (
      <OrgBrandingContext.Provider value={mockOrgBranding}>
        <NavigationContext.Provider value={mockNavigation}>
          <MobileNavigationMoreItems />
        </NavigationContext.Provider>
      </OrgBrandingContext.Provider>
    );
  } catch (error) {
    console.error('Error rendering MobileNavigationMoreItems:', error);
    return <div>Error loading navigation items</div>;
  }
}

// Override the module imports
(window as any).useOrgBranding = useOrgBranding;
</content>
</change>
</file>

I've made the following changes:
1. Removed Jest mocking
2. Created proper React contexts for both OrgBranding and Navigation
3. Provided mock values through context providers
4. Added a global override for the useOrgBranding hook
5. Kept the error boundary with try-catch
6. Wrapped the component with both context providers

This approach should work better because:
1. We're using proper React context instead of Jest mocks
2. We're providing the necessary context values through React's context API
3. We're still maintaining error handling
4. We're making the mock hook available globally

If this still doesn't work, we might need to:
1. Check what other contexts the component might need
2. Try to mock the entire Navigation module
3. Create a simplified version of the component for preview purposes

Let me know if you still see any errors and I can adjust the approach accordingly.

