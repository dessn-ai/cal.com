<description>Create a mock context and provider for organization branding</description>
<content>
import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { MobileNavigationMoreItems } from '../../../../packages/features/shell/navigation/Navigation';

// Create a mock context
const MockOrgBrandingContext = createContext({
  orgBranding: {
    theme: null,
    logo: null,
    brandColor: '#292929',
    darkBrandColor: '#fafafa',
    name: 'Test Organization',
  }
});

// Create a mock provider component
const MockOrgBrandingProvider = ({ children }: { children: React.ReactNode }) => {
  const value = {
    orgBranding: {
      theme: null,
      logo: null,
      brandColor: '#292929',
      darkBrandColor: '#fafafa',
      name: 'Test Organization',
    }
  };
  
  return (
    <MockOrgBrandingContext.Provider value={value}>
      {children}
    </MockOrgBrandingContext.Provider>
  );
};

// Mock the useOrgBranding hook by creating a new component that wraps the original
const MockedMobileNavigationMoreItems = () => {
  // Provide a mock implementation of any hooks the component might need
  const mockNavigation = {
    mobileNavigationItems: [],
    mobileMoreItems: [],
  };

  return (
    <MockOrgBrandingProvider>
      <MobileNavigationMoreItems />
    </MockOrgBrandingProvider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // Since there are no props for this component, we don't need to define any state
  });

  return (
    <div className="h-screen w-screen">
      <MockedMobileNavigationMoreItems />
    </div>
  );
}
</content>
</change>
</file>

