import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/(use-page-wrapper)/settings/(settings-layout)/organizations/sso/page';

// Create mock components and utilities
const MockOrgSSOView = () => <div>Mock OrgSSOView</div>;
const MockSettingsHeader = ({ children }: { children: React.ReactNode }) => (
  <div>Mock SettingsHeader {children}</div>
);

// Mock modules using React.createContext for feature flags
const mockFeatureFlags = {
  flags: {},
  setFlag: () => {},
};

// Create mock functions
const mockGenerateMetadata = () => ({
  title: 'Mock Title',
  description: 'Mock Description',
});

const mockGetTranslate = () => (key: string) => key;

// Mock the modules
jest.mock('app/_utils', () => ({
  _generateMetadata: mockGenerateMetadata,
  getTranslate: mockGetTranslate,
}));

jest.mock('@calcom/features/ee/sso/page/orgs-sso-view', () => MockOrgSSOView);
jest.mock('@calcom/features/settings/appDir/SettingsHeader', () => MockSettingsHeader);

// Mock any additional required contexts or providers
const MockFeatureProvider = ({ children }: { children: React.ReactNode }) => {
  return <div>{children}</div>;
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  return (
    <MockFeatureProvider>
      <div className="preview-container">
        <ImportedComponent />
      </div>
    </MockFeatureProvider>
  );
}
</content>
  </change>
</file>

