        description: "Add GIFs to your booking confirmations",
        logo: "https://example.com/giphy-logo.png",
        category: "other",
        url: "https://giphy.com",
        credentialOwner: null,
        credentialIds: [],
        categories: ["other"],
        enabled: true,
        isInstalled: true,
        isSetupAlready: true,
        variant: "other",
        type: "giphy_other"
      },
      label: "App"
    },
    disabled: {
      type: "boolean",
      value: false,
