import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/app-store/giphy/components/EventTypeAppCardInterface';
import { EventTypeAppContext } from '@calcom/app-store/EventTypeAppContext';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    eventType: {
      type: "object",
      value: {
        id: 1,
        title: "Sample Event",
        description: "This is a sample event description",
        teamId: null,
        length: 30,
        recurringEvent: null,
        seatsPerTimeSlot: null,
        team: null,
        schedulingType: "COLLECTIVE",
        URL: "https://example.com/event"
      },
      label: "Event Type"
    },
    app: {
      type: "object",
      value: {
        name: "Giphy",
        slug: "giphy",
        description: "Add GIFs to your booking confirmations",
        logo: "https://example.com/giphy-logo.png",
        category: "other",
        url: "https://giphy.com",
        credentialOwner: null,
        credentialIds: []
      },
      label: "App"
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled"
    }
  });

  // Mock the context values
  const contextValue = {
    getAppData: () => ({}),
    setAppData: () => {},
    disabled: state.disabled.value,
    appUrl: state.app.value.url,
  };

  return (
    <EventTypeAppContext.Provider value={contextValue}>
      <ImportedComponent
        eventType={state.eventType.value}
        app={state.app.value}
        disabled={state.disabled.value}
      />
    </EventTypeAppContext.Provider>
  );
}
</content>
</change>
</file>

The changes I made:

1. Imported the `EventTypeAppContext` from the cal.com app-store
2. Created a mock context value object with the required properties:
   - `getAppData`: A function that returns an empty object
   - `setAppData`: A no-op function
   - `disabled`: Using the state's disabled value
   - `appUrl`: Using the app's URL from state
3. Wrapped the `ImportedComponent` with the `EventTypeAppContext.Provider` and passed the mock context value

This should resolve the "Cannot read properties of undefined" error by providing the necessary context that the component expects. The error was occurring because the component was trying to access context values that weren't available without the provider.

