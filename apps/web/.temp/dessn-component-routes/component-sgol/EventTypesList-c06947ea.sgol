<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { EventTypesList } from '../../../../packages/features/ee/teams/components/EventTypesList';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    table: {
      type: "object",
      value: {
        // Using plain objects instead of functions
        _getSelectedRowModel: {
          flatRows: [
            {
              original: {
                id: 1,
                name: 'Test User',
                email: 'test@example.com',
              }
            }
          ]
        },
        _state: {
          rowSelection: {}
        },
        _rowModel: {
          rows: []
        },
        // Add methods as properties that can be serialized
        getSelectedRowModel() {
          return this._getSelectedRowModel;
        },
        toggleAllRowsSelected() {
          return;
        },
        getState() {
          return this._state;
        },
        setRowSelection() {
          return;
        },
        getRowModel() {
          return this._rowModel;
        },
        getPreFilteredRowModel() {
          return this._rowModel;
        },
        getFilteredRowModel() {
          return this._rowModel;
        },
        getCoreRowModel() {
          return this._rowModel;
        },
        getPaginationRowModel() {
          return this._rowModel;
        },
        getSortedRowModel() {
          return this._rowModel;
        }
      },
      label: "Table",
    },
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
  });

  return (
    <div className="w-full">
      <EventTypesList
        table={state.table.value}
        teamId={state.teamId.value}
      />
    </div>
  );
}
</content>
