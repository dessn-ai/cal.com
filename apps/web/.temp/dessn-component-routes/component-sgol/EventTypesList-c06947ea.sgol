  };

  const [state, setState] = useParentState({
    table: {
      type: "object",
      value: mockTable,
      label: "Table",
    },
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
  });

  return (
    <div className="w-full">
      <EventTypesList
        table={state.table.value}
        teamId={state.teamId.value}
      />
    </div>
  );
}
