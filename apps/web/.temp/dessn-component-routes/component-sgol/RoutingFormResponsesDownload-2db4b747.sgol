  const mockValue = {
    data: [],
    columns: [],
    sorting: [],
    setSorting: () => {},
    pagination: { pageIndex: 0, pageSize: 10 },
    // Add any other properties that the component might need
  };

  return (
    <DataTableContext.Provider value={mockValue}>
      {children}
    </DataTableContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    sorting: {
      type: "string",
      value: JSON.stringify([{ id: 'name', desc: false }]),
      label: "Sorting",
    },
  });

  const sorting = JSON.parse(state.sorting.value);

  return (
    <MockDataTableProvider>
      <InsightsOrgTeamsProvider>
        <RoutingFormResponsesDownload sorting={sorting} />
      </InsightsOrgTeamsProvider>
    </MockDataTableProvider>
  );
}
