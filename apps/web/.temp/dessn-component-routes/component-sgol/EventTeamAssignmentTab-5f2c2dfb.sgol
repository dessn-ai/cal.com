import React from 'react';
import { useParentState } from '../useIframeState';
import { EventTeamAssignmentTab } from '../../../../packages/features/eventtypes/components/tabs/assignment/EventTeamAssignmentTab';
import { FormProvider, useForm } from 'react-hook-form';
import { SchedulingType } from '@calcom/prisma/enums';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    teamMembers: {
      type: "string",
      value: JSON.stringify([
        { 
          id: 1, 
          name: "John Doe", 
          email: "john@example.com", 
          username: "johndoe",
          membership: {},
          eventTypes: ["sample-event"],
          avatar: "",
          profile: {},
          defaultScheduleId: 1
        },
        { 
          id: 2, 
          name: "Jane Smith", 
          email: "jane@example.com", 
          username: "janesmith",
          membership: {},
          eventTypes: ["sample-event"],
          avatar: "",
          profile: {},
          defaultScheduleId: 2
        }
      ]),
      label: "Team Members"
    },
    team: {
      type: "string",
      value: JSON.stringify({ 
        id: 1, 
        name: "Sample Team",
        parentId: null
      }),
      label: "Team"
    },
    eventType: {
      type: "string",
      value: JSON.stringify({ 
        slug: "sample-event",
        team: { parentId: null },
        children: [],
        schedulingType: SchedulingType.COLLECTIVE
      }),
      label: "Event Type"
    },
    orgId: {
      type: "number",
      value: 1,
      label: "Organization ID"
    },
    isSegmentApplicable: {
      type: "boolean",
      value: true,
      label: "Is Segment Applicable"
    }
  });

  const methods = useForm({
    defaultValues: {
      schedulingType: SchedulingType.COLLECTIVE,
      hosts: [],
      assignAllTeamMembers: false,
      children: [],
      maxLeadThreshold: null,
      isRRWeightsEnabled: false,
      assignRRMembersUsingSegment: false,
      rrSegmentQueryValue: ""
    }
  });

  return (
    <FormProvider {...methods}>
      <EventTeamAssignmentTab
        teamMembers={JSON.parse(state.teamMembers.value)}
        team={JSON.parse(state.team.value)}
        eventType={JSON.parse(state.eventType.value)}
        orgId={state.orgId.value}
        isSegmentApplicable={state.isSegmentApplicable.value}
      />
    </FormProvider>
  );
}
</content>
</change>
</file>

I've made several important changes to fix the error:

1. Added complete team member objects with all required properties including `membership`, `eventTypes`, `avatar`, `profile`, and `defaultScheduleId`
2. Added proper typing for the event type with `SchedulingType` enum
3. Added all required form default values including:
   - `maxLeadThreshold`
   - `isRRWeightsEnabled`
   - `assignRRMembersUsingSegment`
   - `rrSegmentQueryValue`
4. Imported `SchedulingType` enum from `@calcom/prisma/enums`
5. Ensured team object has proper structure with `parentId`

These changes should resolve the "Cannot read properties of undefined (reading 'filter')" error by ensuring all required data is properly initialized and structured. The error was likely occurring because some of these properties were missing or undefined when the component tried to filter or access them.

