import React from 'react';
import { useParentState } from '../useIframeState';
import { BookingStatusLineChart } from '../../../../packages/features/insights/components/BookingStatusLineChart';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { httpBatchLink } from '@trpc/client';
import { createTRPCReact } from '@trpc/react-query';
import superjson from 'superjson';
import { InsightsOrgTeamsProvider } from '../../../../packages/features/insights/context/InsightsOrgTeamsProvider';
import { DataTableProvider } from '../../../../packages/features/data-table/components/DataTableProvider';

// Create a new TRPC instance
const trpc = createTRPCReact();

// Create a new query client
const queryClient = new QueryClient();

// Create TRPC client
const trpcClient = trpc.createClient({
  links: [
    httpBatchLink({
      url: '/api/trpc',
    }),
  ],
  transformer: superjson,
});

// Mock data for InsightsOrgTeamsProvider
const mockTeamsData = {
  teams: [],
  currentTeamId: undefined,
  setCurrentTeamId: () => {},
  isLoading: false,
};

// Mock data for DataTableProvider
const mockDataTableData = {
  data: [],
  isLoading: false,
  tableContainerRef: { current: null },
  filter: '',
  setFilter: () => {},
  filterValue: {},
  setFilterValue: () => {},
  selectedRows: new Set(),
  setSelectedRows: () => {},
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to set for this component
  });

  return (
    <trpc.Provider client={trpcClient} queryClient={queryClient}>
      <QueryClientProvider client={queryClient}>
        <DataTableProvider value={mockDataTableData}>
          <InsightsOrgTeamsProvider value={mockTeamsData}>
            <BookingStatusLineChart />
          </InsightsOrgTeamsProvider>
        </DataTableProvider>
      </QueryClientProvider>
    </trpc.Provider>
  );
}
</content>
</change>
</file>

