import { InsightsOrgTeamsProvider } from '@calcom/features/insights/context/InsightsOrgTeamsProvider';

// Create a mock DataTable context
const DataTableContext = createContext({
  filters: [],
  setFilters: () => {},
  filterValue: {},
  setFilterValue: () => {},
  selectedIds: new Set(),
  setSelectedIds: () => {},
  currentPage: 1,
  setCurrentPage: () => {},
  pageSize: 10,
  setPageSize: () => {},
  sortBy: [],
  setSortBy: () => {},
  tableState: {
    pagination: {
      pageIndex: 0,
      pageSize: 10
    },
    sorting: []
  }
});

// Create a mock provider component
