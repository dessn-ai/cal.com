<file path="apps/web/.temp/dessn-component-routes/BookingStatusLineChart-b92bde5d.tsx">
  <change>
    <description>Export DataTableContext and add useDataTable hook</description>
    <content>
import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { BookingStatusLineChart } from '../../../../packages/features/insights/components/BookingStatusLineChart';
import { trpc } from '@calcom/trpc';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { InsightsOrgTeamsProvider } from '@calcom/features/insights/context/InsightsOrgTeamsProvider';

// Create a mock DataTable context
export const DataTableContext = createContext(null);

// Create a useDataTable hook
export const useDataTable = () => {
  const context = useContext(DataTableContext);
  if (!context) {
    throw new Error('useDataTable must be used within a DataTableProvider');
  }
  return context;
};

// Create a mock provider component
const MockDataTableProvider = ({ children }) => {
  const mockValue = {
    filters: [
      {
        id: 'dateRange',
        isActive: true,
        label: 'Date Range',
        value: { start: new Date(), end: new Date() },
      },
      {
        id: 'teamId',
        isActive: true,
        label: 'Team',
        value: null,
      },
      {
        id: 'userId',
        isActive: true,
        label: 'User',
        value: null,
      }
    ],
    setFilters: () => {},
    filterValue: {
      dateRange: { start: new Date(), end: new Date() },
      teamId: null,
      userId: null
    },
    setFilterValue: () => {},
    selectedIds: new Set(),
    setSelectedIds: () => {},
    currentPage: 1,
    setCurrentPage: () => {},
    pageSize: 10,
    setPageSize: () => {},
    sortBy: [],
    setSortBy: () => {},
    tableState: {
      pagination: {
        pageIndex: 0,
        pageSize: 10
      },
      sorting: []
    }
  };

  return (
    <DataTableContext.Provider value={mockValue}>
      {children}
    </DataTableContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to set for this component
  });

  const queryClient = new QueryClient({
    defaultOptions: {
      queries: {
        retry: false,
        refetchOnWindowFocus: false,
      },
    },
  });

  // Mock data for InsightsOrgTeamsProvider
  const mockTeamsData = {
    teams: [],
    currentTeam: null,
    setCurrentTeam: () => {},
    loading: false,
  };

  return (
    <QueryClientProvider client={queryClient}>
      <MockDataTableProvider>
        <InsightsOrgTeamsProvider value={mockTeamsData}>
          <BookingStatusLineChart />
        </InsightsOrgTeamsProvider>
      </MockDataTableProvider>
    </QueryClientProvider>
  );
}
</content>
  </change>
</file>

I've made several important changes:

1. Changed the DataTableContext to be created with `null` as initial value and exported it
2. Added a `useDataTable` hook that properly checks for context existence
3. Simplified the context structure and made it more explicit
4. Moved the mock value into the provider component
5. Added proper type checking for context
6. Configured QueryClient with default options to prevent unnecessary retries
7. Exported necessary context and hooks that might be needed by child components
8. Ensured the filters array is properly structured and available

The error was likely occurring because the context wasn't properly accessible to the components that needed it. By exporting the context and providing a proper hook to access it, we should resolve the "Cannot read properties of undefined (reading 'find')" error.

