<file path="apps/web/.temp/dessn-component-routes/BookingStatusLineChart-b92bde5d.tsx">
<change>
<description>Replace jest.mock with React context override for useInsightsParameters</description>
<content>
import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { BookingStatusLineChart } from '../../../../packages/features/insights/components/BookingStatusLineChart';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { httpBatchLink } from '@trpc/client';
import { createTRPCReact } from '@trpc/react-query';
import superjson from 'superjson';
import { InsightsOrgTeamsProvider } from '../../../../packages/features/insights/context/InsightsOrgTeamsProvider';

// Create a mock context for insights parameters
const InsightsParametersContext = createContext({
  isAll: true,
  teamId: undefined,
  userId: undefined,
  startDate: new Date(new Date().setMonth(new Date().getMonth() - 1)),
  endDate: new Date(),
  dateRangePreset: 'm',
  eventTypeId: undefined,
});

// Override the useInsightsParameters hook
const useInsightsParameters = () => {
  return useContext(InsightsParametersContext);
};

// Create a new TRPC instance
const trpc = createTRPCReact();

// Create a new query client
const queryClient = new QueryClient();

// Create TRPC client
const trpcClient = trpc.createClient({
  links: [
    httpBatchLink({
      url: '/api/trpc',
    }),
  ],
  transformer: superjson,
});

// Mock data for InsightsOrgTeamsProvider
const mockTeamsData = {
  teams: [],
  currentTeamId: undefined,
  setCurrentTeamId: () => {},
  isLoading: false,
};

// Override the module import
const originalModule = require('../../../../packages/features/insights/hooks/useInsightsParameters');
originalModule.useInsightsParameters = useInsightsParameters;

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to set for this component
  });

  return (
    <trpc.Provider client={trpcClient} queryClient={queryClient}>
      <QueryClientProvider client={queryClient}>
        <InsightsParametersContext.Provider
          value={{
            isAll: true,
            teamId: undefined,
            userId: undefined,
            startDate: new Date(new Date().setMonth(new Date().getMonth() - 1)),
            endDate: new Date(),
            dateRangePreset: 'm',
            eventTypeId: undefined,
          }}
        >
          <InsightsOrgTeamsProvider value={mockTeamsData}>
            <BookingStatusLineChart />
          </InsightsOrgTeamsProvider>
        </InsightsParametersContext.Provider>
      </QueryClientProvider>
    </trpc.Provider>
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Removed the jest.mock approach which wasn't working
2. Created a React context for insights parameters
3. Created a context provider with mock data
4. Overridden the useInsightsParameters hook to use our context
5. Added the InsightsParametersContext.Provider to the component tree

The main changes:
- Using React's context system instead of jest mocking
- Providing the mock data through context
- Ensuring the hook is available throughout the component tree

This approach should work better because:
1. It uses React's built-in context system
2. It doesn't rely on jest or other testing frameworks
3. It provides the same data but through a more appropriate mechanism

If you encounter any other errors, please let me know and I'll help you resolve them.

