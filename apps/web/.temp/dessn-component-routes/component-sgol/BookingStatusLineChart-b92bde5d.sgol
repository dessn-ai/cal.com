  return (
    <DataTableContext.Provider
      value={{
        filters: [],
        setFilters: () => {},
        filterValue: {},
        setFilterValue: () => {},
        selectedIds: new Set(),
        setSelectedIds: () => {},
        currentPage: 1,
        setCurrentPage: () => {},
        pageSize: 10,
        setPageSize: () => {},
        sortBy: [],
        setSortBy: () => {},
        tableState: {
          pagination: {
            pageIndex: 0,
            pageSize: 10
          },
          sorting: []
        }
      }}
    >
      {children}
    </DataTableContext.Provider>
  );
};

export default function ComponentPreview() {
