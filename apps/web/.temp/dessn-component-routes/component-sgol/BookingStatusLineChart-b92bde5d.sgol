import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { BookingStatusLineChart } from '../../../../packages/features/insights/components/BookingStatusLineChart';
import { trpc } from '@calcom/trpc';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { InsightsOrgTeamsProvider } from '@calcom/features/insights/context/InsightsOrgTeamsProvider';

// Create contexts for the required functionality
const FilterContext = createContext({
  filters: [
    {
      id: 'dateRange',
      isActive: true,
      label: 'Date Range',
      value: { start: new Date(), end: new Date() }
    }
  ],
  filterValue: {
    dateRange: { start: new Date(), end: new Date() },
    teamId: null,
    userId: null
  }
});

// Override the useFilterValue hook
const useFilterValue = (filterId) => {
  const context = useContext(FilterContext);
  return context.filterValue[filterId] || null;
};

// Create a provider that combines all necessary contexts
const MockProviders = ({ children }) => {
  const filterContextValue = {
    filters: [
      {
        id: 'dateRange',
        isActive: true,
        label: 'Date Range',
        value: { start: new Date(), end: new Date() }
      }
    ],
    filterValue: {
      dateRange: { start: new Date(), end: new Date() },
      teamId: null,
      userId: null
    }
  };

  return (
    <FilterContext.Provider value={filterContextValue}>
      {children}
    </FilterContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  const queryClient = new QueryClient({
    defaultOptions: {
      queries: {
        retry: false,
        refetchOnWindowFocus: false,
      },
    },
  });

  // Mock data for InsightsOrgTeamsProvider
  const mockTeamsData = {
    teams: [],
    currentTeam: null,
    setCurrentTeam: () => {},
    loading: false,
  };

  return (
    <QueryClientProvider client={queryClient}>
      <MockProviders>
        <InsightsOrgTeamsProvider value={mockTeamsData}>
          <BookingStatusLineChart />
        </InsightsOrgTeamsProvider>
      </MockProviders>
    </QueryClientProvider>
  );
}

// Make the useFilterValue hook available globally
(window as any).useFilterValue = useFilterValue;
</content>
