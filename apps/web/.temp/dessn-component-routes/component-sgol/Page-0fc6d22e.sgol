import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';

// Using dynamic import with error handling
const ImportedComponent = React.lazy(() => import('../../app/(use-page-wrapper)/settings/(admin-layout)/admin/page')
  .catch(err => {
    console.error('Failed to load component:', err);
    return { 
      default: () => (
        <div className="error-message">
          Failed to load component. Please check the console for more details.
        </div>
      )
    };
  })
);

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <ErrorBoundary>
        <ImportedComponent />
      </ErrorBoundary>
    </Suspense>
  );
}

// Simple Error Boundary Component
class ErrorBoundary extends React.Component<
  { children: React.ReactNode },
  { hasError: boolean }
> {
  constructor(props: { children: React.ReactNode }) {
    super(props);
    this.state = { hasError: false };
  }

  static getDerivedStateFromError(error: any) {
    return { hasError: true };
  }

  componentDidCatch(error: any, errorInfo: any) {
    console.error('Component Error:', error, errorInfo);
  }

  render() {
    if (this.state.hasError) {
      return (
        <div className="error-boundary">
          Something went wrong loading this component.
        </div>
      );
    }

    return this.props.children;
  }
}
</content>
  </change>
</file>

The changes I made include:

1. Added `Suspense` and proper error handling for the dynamic import
2. Implemented a proper `ErrorBoundary` component to catch and handle any rendering errors
3. Used React.lazy() for component importing with a fallback error handler
4. Added loading state with Suspense
5. Improved error reporting and user feedback

This implementation should:
- Handle the dynamic import more gracefully
- Provide better error feedback if the import fails
- Show a loading state while the component is being loaded
- Catch and handle any rendering errors that might occur

The error you're seeing might also be related to the build process or the file path. If the error persists, we might need to:
1. Verify the import path is correct
2. Check if the target component file exists
3. Ensure all necessary dependencies are installed
4. Verify the build configuration is correct

Let me know if you need any adjustments or if you're still seeing errors.

