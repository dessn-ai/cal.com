  const parsedCalEvent = JSON.parse(state.calEvent.value);
  const parsedAttendee = JSON.parse(state.attendee.value);

  // Get the translation function from context
  const translate = (key: string, vars?: Record<string, any>) => {
    if (!key) return '';
