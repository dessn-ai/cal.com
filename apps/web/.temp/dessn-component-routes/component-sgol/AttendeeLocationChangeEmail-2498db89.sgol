        cancellationReason: undefined,
        team: {
          name: 'Team',
          members: []
        },
        recurringEvent: null,
        platformClientId: null
      }),
      label: 'Calendar Event',
    },
    attendee: {
      type: 'string',
      value: JSON.stringify({
        name: 'Jane Smith',
        email: 'jane@example.com',
        timeZone: 'Europe/London',
        language: { translate, locale: 'en' },
      }),
      label: 'Attendee',
    },
