<file path="apps/web/.temp/dessn-component-routes/SingleSelectFilterOptions-96fa6e40.tsx">
  <change>
    <description>Use DataTableProvider with try-catch and proper mocking</description>
    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { SingleSelectFilterOptions } from '../../../../packages/features/data-table/components/filters/SingleSelectFilterOptions';
import { DataTableProvider } from '../../../../packages/features/data-table/components/DataTableProvider';
import { ColumnFilterType } from '../../../../packages/features/data-table/lib/types';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    columnId: {
      type: "string",
      value: "exampleColumn",
      label: "Column ID",
    },
    columnTitle: {
      type: "string",
      value: "Example Column",
      label: "Column Title",
    },
    columnIcon: {
      type: "dropdown",
      value: "user",
      options: ["user", "calendar", "settings", "star"],
      label: "Column Icon",
    },
  });

  const column = {
    id: state.columnId.value,
    title: state.columnTitle.value,
    icon: state.columnIcon.value,
    type: ColumnFilterType.SINGLE_SELECT,
    options: [
      { label: "Option 1", value: "option1" },
      { label: "Option 2", value: "option2" },
      { label: "Option 3", value: "option3" },
    ],
  };

  const mockData = [
    { id: 1, [state.columnId.value]: 'option1' },
    { id: 2, [state.columnId.value]: 'option2' },
  ];

  try {
    return (
      <DataTableProvider
        data={mockData}
        columns={[column]}
        initialState={{
          columnFilters: {},
          sorting: [],
          pagination: { pageIndex: 0, pageSize: 10 }
        }}
        onStateChange={() => {}}
        options={{
          enableFilters: true,
          enableSorting: true,
          enablePagination: true
        }}
      >
        <div className="p-4">
          <SingleSelectFilterOptions column={column} />
        </div>
      </DataTableProvider>
    );
  } catch (error) {
    console.error('Error rendering SingleSelectFilterOptions:', error);
    return <div>Error loading filter options</div>;
  }
}
</content>
  </change>
</file>

I've made the following changes:
1. Removed the custom context implementation and went back to using DataTableProvider
2. Added more complete mock data and configuration
3. Added proper error handling with try-catch
4. Added more comprehensive provider props:
   - Actual mock data array with the column ID
   - Complete initial state object
   - Added options object with common features enabled
5. Wrapped the component in a div with padding for better presentation
6. Added fallback error UI

This should provide a more robust implementation with proper error handling and all the necessary context data that the SingleSelectFilterOptions component needs to function.

