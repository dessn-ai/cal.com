import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { SingleSelectFilterOptions } from '../../../../packages/features/data-table/components/filters/SingleSelectFilterOptions';
import { ColumnFilterType } from '../../../../packages/features/data-table/lib/types';

// Create a local context
const DataTableContext = createContext<any>(null);

// Create a local hook to match the original
const useDataTable = () => {
  const context = useContext(DataTableContext);
  if (!context) {
    throw new Error("useDataTable must be used within a DataTableProvider");
  }
  return context;
};

// Mock DataTableProvider
const DataTableProvider = ({ children }) => {
  const value = {
    setFilter: () => {},
    getFilter: () => undefined,
    removeFilter: () => {},
    table: {
      getState: () => ({
        columnFilters: [],
        sorting: [],
        pagination: {
          pageIndex: 0,
          pageSize: 10
        }
      }),
      setColumnFilters: () => {},
      setSorting: () => {},
      setPagination: () => {},
    },
    setSelectedRows: () => {},
    selectedRows: new Set(),
    isLoading: false,
    tableState: {
      pagination: {
        pageIndex: 0,
        pageSize: 10
      },
      sorting: [],
      columnFilters: []
    }
  };

  return (
    <DataTableContext.Provider value={value}>
      {children}
    </DataTableContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    columnId: {
      type: "string",
      value: "exampleColumn",
      label: "Column ID",
    },
    columnTitle: {
      type: "string",
      value: "Example Column",
      label: "Column Title",
    },
    columnIcon: {
      type: "dropdown",
      value: "user",
      options: ["user", "calendar", "settings", "star"],
      label: "Column Icon",
    },
  });

  const column = {
    id: state.columnId.value,
    title: state.columnTitle.value,
    icon: state.columnIcon.value,
    type: ColumnFilterType.SINGLE_SELECT,
    options: [
      { label: "Option 1", value: "option1" },
      { label: "Option 2", value: "option2" },
      { label: "Option 3", value: "option3" },
    ],
  };

  return (
    <DataTableProvider>
      <SingleSelectFilterOptions column={column} />
    </DataTableProvider>
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Removed the problematic import and created our own context using createContext
2. Created a local useDataTable hook that matches the behavior of the original
3. Enhanced the mock context value with additional table-related methods and state
4. Implemented a more complete DataTableProvider with the necessary context structure

This approach should work because:
1. We're no longer trying to import the context from an inaccessible path
2. We're providing all the necessary context values and methods that the SingleSelectFilterOptions component might need
3. The implementation follows the same pattern as the original context but is self-contained

The error should now be resolved since we're using a local context implementation rather than trying to import one that isn't accessible.

