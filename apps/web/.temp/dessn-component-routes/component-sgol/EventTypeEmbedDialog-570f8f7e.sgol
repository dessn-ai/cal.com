import React from 'react';
import { useParentState } from '../useIframeState';
import { EventTypeEmbedDialog } from '../../../../packages/features/embed/EventTypeEmbed';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { trpc } from '@calcom/trpc/react';

// Create a mock TRPC Provider component that just renders children
const MockTRPCProvider = ({ children }: { children: React.ReactNode }) => {
  return <>{children}</>;
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({});
  const queryClient = new QueryClient({
    defaultOptions: {
      queries: {
        retry: false,
        cacheTime: 0,
        staleTime: 0,
      },
    },
  });

  return (
    <QueryClientProvider client={queryClient}>
      <MockTRPCProvider>
        <EventTypeEmbedDialog />
      </MockTRPCProvider>
    </QueryClientProvider>
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Removed the complex TRPC client setup that was causing the error
2. Created a simple `MockTRPCProvider` that just renders its children
3. Kept the QueryClientProvider with a basic configuration
4. Simplified the overall structure

This should resolve the error by providing a minimal working setup for the preview component. Since this is just a preview, we don't need the full TRPC functionality, and mocking the provider should be sufficient to render the component.

If we still see errors related to TRPC calls within the `EventTypeEmbedDialog` component, we might need to mock those specific TRPC calls as well. Let me know if you encounter any other errors.

