import React from 'react';
import { useParentState } from '../useIframeState';
import { Dialog, DialogOverlay } from '@radix-ui/react-dialog';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "",
      label: "Class Name",
    },
  });

  return (
    <Dialog open={true}>
      <DialogOverlay className={state.className.value} />
    </Dialog>
  );
}
    </content>
  </change>
</file>

I made the following changes:
1. Added import for the root `Dialog` component
2. Wrapped `DialogOverlay` with `Dialog` component
3. Set `open={true}` on the Dialog to ensure it's visible for preview purposes

This should resolve the context error since `DialogOverlay` is now properly nested within its required parent `Dialog` component. The `Dialog` component provides the necessary context for all its child components like `DialogOverlay` to function correctly.

