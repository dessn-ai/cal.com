import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/app-store/hubspot/components/EventTypeAppCardInterface';

// Mock the useIsAppEnabled hook
jest.mock('@calcom/app-store/_utils/useIsAppEnabled', () => ({
  useIsAppEnabled: () => ({
    enabled: true,
    updateEnabled: () => {},
    isLoading: false
  })
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    eventType: {
      type: "object",
      value: {
        id: 1,
        title: "Sample Event Type",
        description: "This is a sample event type description",
        teamId: null,
        length: 30,
        recurringEvent: null,
        seatsPerTimeSlot: null,
        team: null,
        schedulingType: "COLLECTIVE",
        URL: "https://example.com/event-type",
        metadata: {},
        apps: {
          hubspot: {
            enabled: true
          }
        }
      },
      label: "Event Type"
    },
    app: {
      type: "object",
      value: {
        name: "Hubspot",
        description: "Hubspot integration",
        logo: "https://example.com/hubspot-logo.png",
        category: "crm",
        url: "https://www.hubspot.com",
        credentialOwner: {
          name: "John Doe",
          avatar: "https://example.com/avatar.png"
        },
        credentialIds: [1, 2, 3],
        enabled: true,
        dirName: "hubspot"
      },
      label: "App"
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled"
    }
  });

  // Create a wrapper component that provides the mocked hook
  const ComponentWithMockedHook = () => {
    // Wrap the imported component with try-catch to handle potential errors
    try {
      return (
        <ImportedComponent
          eventType={state.eventType.value}
          app={state.app.value}
          disabled={state.disabled.value}
        />
      );
    } catch (error) {
      console.error('Error rendering component:', error);
      return <div>Error rendering component</div>;
    }
  };

  return <ComponentWithMockedHook />;
}
</content>
  </change>
</file>

I've made several changes to fix the error:

1. Removed the previous context approach and instead mocked the `useIsAppEnabled` hook directly
2. Added error handling with try-catch
3. Added `dirName` to the app object which might be needed for the app identification
4. Created a wrapper component to handle the mocked hook
5. Simplified the component structure while maintaining all necessary props

The error was occurring because the hook was trying to access some properties that were undefined. By mocking the hook to return fixed values, we should bypass the error. The mock provides:
- `enabled: true`
- `updateEnabled: () => {}`
- `isLoading: false`

These are the typical values that the hook would return in a working environment. The try-catch block will also help us catch and handle any other potential errors that might occur during rendering.

