import React from 'react';
import { useParentState } from '../useIframeState';
import { EventAdvancedTab } from '../../../../packages/features/eventtypes/components/tabs/advanced/EventAdvancedTab';
import { FormProvider, useForm } from 'react-hook-form';

export default function ComponentPreview() {
  const methods = useForm({
    defaultValues: {
      // Add any form default values needed by EventAdvancedTab
      seatsPerTimeSlot: null,
      requiresConfirmation: false,
      successRedirectUrl: '',
      // Add other form fields as needed
    }
  });

  const [state, setState] = useParentState({
    eventType: {
      type: "object",
      value: {
        id: 1,
        title: "Sample Event",
        workflows: [],
        seatsPerTimeSlot: null,
        bookerUrl: "sample-url",
      },
      label: "Event Type",
    },
    team: {
      type: "object",
      value: null,
      label: "Team",
    },
    calendarsQuery: {
      type: "object",
      value: {
        data: undefined,
        isPending: false,
        error: null,
      },
      label: "Calendars Query",
    },
    user: {
      type: "object",
      value: {
        email: "user@example.com",
        secondaryEmails: [],
        theme: "light",
        defaultBookerLayouts: {},
      },
      label: "User",
    },
    isUserLoading: {
      type: "boolean",
      value: false,
      label: "Is User Loading",
    },
    showBookerLayoutSelector: {
      type: "boolean",
      value: true,
      label: "Show Booker Layout Selector",
    },
  });

  const showToast = (message: string, variant: "success" | "warning" | "error") => {
    console.log(`Toast: ${message} (${variant})`);
  };

  return (
    <FormProvider {...methods}>
      <EventAdvancedTab
        eventType={state.eventType.value}
        team={state.team.value}
        calendarsQuery={state.calendarsQuery.value}
        user={state.user.value}
        isUserLoading={state.isUserLoading.value}
        showToast={showToast}
        showBookerLayoutSelector={state.showBookerLayoutSelector.value}
      />
    </FormProvider>
  );
}
</content>
  </change>
</file>

The changes I made:

1. Added import for `FormProvider` and `useForm` from 'react-hook-form'
2. Created a form methods object using `useForm` hook with some default values
3. Wrapped the EventAdvancedTab component with FormProvider and spread the methods
4. The FormProvider will now provide the form context to all child components, including the getValues method that was previously null

This should resolve the "Cannot read properties of null (reading 'getValues')" error as the form context will now be properly provided to the component.

