<file path="apps/web/.temp/dessn-component-routes/ServerPage-037ca84d.tsx">
<change>
<description>Add error handling, suspense, and type safety to the component preview</description>
<content>
import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';

// Define types for the component props
interface PageParams {
  provider: string;
}

interface SearchParams {
  code: string;
  state: string;
}

const ImportedComponent = React.lazy(() => import('../../app/(use-page-wrapper)/auth/sso/[provider]/page')
  .catch((err) => {
    console.error('Error loading component:', err);
    return { default: () => <div>Error loading component</div> };
  })
);

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    params: {
      type: "string",
      value: JSON.stringify({ provider: "google" }),
      label: "Params",
    },
    searchParams: {
      type: "string",
      value: JSON.stringify({ code: "123456", state: "abcdef" }),
      label: "Search Params",
    },
  });

  // Safe JSON parsing with error handling
  const params: PageParams = React.useMemo(() => {
    try {
      return JSON.parse(state.params.value);
    } catch (e) {
      console.error('Error parsing params:', e);
      return { provider: "google" };
    }
  }, [state.params.value]);

  const searchParams: SearchParams = React.useMemo(() => {
    try {
      return JSON.parse(state.searchParams.value);
    } catch (e) {
      console.error('Error parsing searchParams:', e);
      return { code: "", state: "" };
    }
  }, [state.searchParams.value]);

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <ErrorBoundary>
        <ImportedComponent params={params} searchParams={searchParams} />
      </ErrorBoundary>
    </Suspense>
  );
}

// Simple Error Boundary Component
class ErrorBoundary extends React.Component<
  { children: React.ReactNode },
  { hasError: boolean }
> {
  constructor(props: { children: React.ReactNode }) {
    super(props);
    this.state = { hasError: false };
  }

  static getDerivedStateFromError(error: any) {
    return { hasError: true };
  }

  componentDidCatch(error: Error, errorInfo: React.ErrorInfo) {
    console.error('Component Error:', error, errorInfo);
  }

  render() {
    if (this.state.hasError) {
      return <div>Something went wrong loading the component.</div>;
    }

    return this.props.children;
  }
}
</content>
</change>
</file>

The changes made include:

1. Added React.lazy() for proper dynamic importing with error handling
2. Wrapped the component in Suspense with a loading fallback
3. Added an ErrorBoundary component to catch and handle rendering errors
4. Added proper TypeScript interfaces for the params
5. Added safe JSON parsing with error handling using useMemo
6. Included fallback values for when parsing fails
7. Added proper error messages and console logging for debugging

This should handle the dynamic import error and provide better error handling and user feedback when issues occur. The ErrorBoundary will catch any rendering errors, and the Suspense component will handle the loading state while the dynamic import is in progress.

