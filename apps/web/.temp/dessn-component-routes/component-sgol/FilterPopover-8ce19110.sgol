<description>Create DataTableContext directly in the preview file instead of importing it</description>
<content>
import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { FilterPopover } from '../../../../packages/features/data-table/components/filters/FilterPopover';
import { ColumnFilterType } from '../../../../packages/features/data-table/lib/types';

// Create the context directly in this file
const DataTableContext = createContext(null);

// Create a custom hook to use the context
const useDataTable = () => {
  const context = useContext(DataTableContext);
  if (!context) {
    throw new Error('useDataTable must be used within a DataTableProvider');
  }
  return context;
};

// Create a mock DataTableProvider
const DataTableProvider = ({ children }) => {
  const value = {
    data: [],
    setData: () => {},
    columns: [],
    setColumns: () => {},
    selectedRows: new Set(),
    setSelectedRows: () => {},
    tableState: {
      sorting: [],
      columnFilters: [],
      columnVisibility: {},
      rowSelection: {},
    },
    setTableState: () => {},
    onRowSelectionChange: () => {},
    tableRef: { current: null },
    isLoading: false,
    page: 0,
    setPage: () => {},
    pageSize: 10,
    setPageSize: () => {},
    total: 0,
    filterValue: '',
    setFilterValue: () => {},
  };

  return (
    <DataTableContext.Provider value={value}>
      {children}
    </DataTableContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    column: {
      type: "dropdown",
      value: JSON.stringify({
        id: "example-column",
        title: "Example Column",
        icon: "filter",
        type: ColumnFilterType.SINGLE_SELECT,
        options: [
          { label: "Option 1", value: "option1" },
          { label: "Option 2", value: "option2" },
        ],
      }),
      options: [
        JSON.stringify({
          id: "example-column",
          title: "Example Column",
          icon: "filter",
          type: ColumnFilterType.SINGLE_SELECT,
          options: [
            { label: "Option 1", value: "option1" },
            { label: "Option 2", value: "option2" },
          ],
        }),
        JSON.stringify({
          id: "another-column",
          title: "Another Column",
          icon: "calendar",
          type: ColumnFilterType.DATE_RANGE,
        }),
      ],
      label: "Column Configuration",
    },
  });

  const column = JSON.parse(state.column.value);

  return (
    <DataTableProvider>
      <FilterPopover column={column} />
    </DataTableProvider>
  );
}
</content>
</change>
</file>

