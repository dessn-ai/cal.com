import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { FilterPopover } from '../../../../packages/features/data-table/components/filters/FilterPopover';
import { ColumnFilterType } from '../../../../packages/features/data-table/lib/types';

// Create mock DataTable context
const DataTableContext = createContext(null);

// Create mock useDataTable hook
export const useDataTable = () => {
  const context = useContext(DataTableContext);
  if (!context) {
    throw new Error('useDataTable must be used within a DataTableProvider');
  }
  return context;
};

// Mock DataTableProvider component
const DataTableProvider = ({ children, value }) => {
  return (
    <DataTableContext.Provider value={value}>
      {children}
    </DataTableContext.Provider>
  );
};

