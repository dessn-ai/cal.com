import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { FilterPopover } from '../../../../packages/features/data-table/components/filters/FilterPopover';
import { ColumnFilterType } from '../../../../packages/features/data-table/lib/types';

// Create a mock DataTable context with the same shape as the original
const MockDataTableContext = createContext({
  tableState: {
    columnFilters: [],
    sorting: [],
    columnVisibility: {},
    rowSelection: {}
  },
  setTableState: () => {},
  data: [],
  setData: () => {},
  columns: [],
  setColumns: () => {},
  selectedRows: new Set(),
  setSelectedRows: () => {},
  onRowSelectionChange: () => {},
  tableRef: { current: null },
  isLoading: false,
  page: 0,
  setPage: () => {},
  pageSize: 10,
  setPageSize: () => {},
  total: 0,
  filterValue: '',
  setFilterValue: () => {}
});

// Create a mock wrapper component
const MockFilterPopover = (props) => {
  // Provide a mock implementation of useDataTable
  const mockDataTableValue = useContext(MockDataTableContext);

  // Create a div that will catch the original hook calls and provide mock data
  return (
    <div
      data-testid="mock-filter-popover"
      style={{ position: 'relative' }}
    >
      <MockDataTableContext.Provider value={mockDataTableValue}>
        <div data-hook-context="data-table">
          <FilterPopover {...props} />
        </div>
      </MockDataTableContext.Provider>
    </div>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    column: {
      type: "dropdown",
      value: JSON.stringify({
        id: "example-column",
        title: "Example Column",
        icon: "filter",
        type: ColumnFilterType.SINGLE_SELECT,
        options: [
          { label: "Option 1", value: "option1" },
          { label: "Option 2", value: "option2" },
        ],
      }),
      options: [
        JSON.stringify({
          id: "example-column",
          title: "Example Column",
          icon: "filter",
          type: ColumnFilterType.SINGLE_SELECT,
          options: [
            { label: "Option 1", value: "option1" },
            { label: "Option 2", value: "option2" },
          ],
        }),
        JSON.stringify({
          id: "another-column",
          title: "Another Column",
          icon: "calendar",
          type: ColumnFilterType.DATE_RANGE,
        }),
      ],
      label: "Column Configuration",
    },
  });

  const column = JSON.parse(state.column.value);

  // Use our mock wrapper instead of the original FilterPopover
  return <MockFilterPopover column={column} />;
}
</content>
</change>
</file>

