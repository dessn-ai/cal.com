import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { FilterPopover } from '../../../../packages/features/data-table/components/filters/FilterPopover';
import { ColumnFilterType } from '../../../../packages/features/data-table/lib/types';

// Create contexts for our hooks
const DataTableContext = createContext(null);
const FilterValueContext = createContext(null);

// Override the hooks from the package
import * as dataTableHooks from '../../../../packages/features/data-table/hooks/useDataTable';
import * as filterValueHooks from '../../../../packages/features/data-table/hooks/useFilterValue';

// Mock implementations
const mockDataTableValue = {
  tableState: {
    columnFilters: [],
    sorting: [],
    columnVisibility: {},
    rowSelection: {}
  },
  setTableState: () => {},
  data: [],
  setData: () => {},
  columns: [],
  setColumns: () => {},
  selectedRows: new Set(),
  setSelectedRows: () => {},
  onRowSelectionChange: () => {},
  tableRef: { current: null },
  isLoading: false,
  page: 0,
  setPage: () => {},
  pageSize: 10,
  setPageSize: () => {},
  total: 0,
  filterValue: '',
  setFilterValue: () => {}
};

// Provider component
const DataTableProvider = ({ children }) => {
  return (
    <DataTableContext.Provider value={mockDataTableValue}>
      <FilterValueContext.Provider value={{
        data: {
          operator: 'equals',
          operand: 'test'
        }
      }}>
        {children}
      </FilterValueContext.Provider>
    </DataTableContext.Provider>
  );
};

// Override the original hooks
(dataTableHooks as any).useDataTable = () => useContext(DataTableContext);
(filterValueHooks as any).useFilterValue = () => useContext(FilterValueContext);

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    column: {
      type: "dropdown",
      value: JSON.stringify({
        id: "example-column",
        title: "Example Column",
        icon: "filter",
        type: ColumnFilterType.SINGLE_SELECT,
        options: [
          { label: "Option 1", value: "option1" },
          { label: "Option 2", value: "option2" },
        ],
      }),
      options: [
        JSON.stringify({
          id: "example-column",
          title: "Example Column",
          icon: "filter",
          type: ColumnFilterType.SINGLE_SELECT,
          options: [
            { label: "Option 1", value: "option1" },
            { label: "Option 2", value: "option2" },
          ],
        }),
        JSON.stringify({
          id: "another-column",
          title: "Another Column",
          icon: "calendar",
          type: ColumnFilterType.DATE_RANGE,
        }),
      ],
      label: "Column Configuration",
    },
  });

  const column = JSON.parse(state.column.value);

  return (
    <DataTableProvider>
      <FilterPopover column={column} />
    </DataTableProvider>
  );
}
