<file path="apps/web/.temp/dessn-component-routes/SamlIdpPage-5a6274b8.tsx">
<change>
<description>Handle async component rendering properly with Suspense and error boundaries</description>
<content>
import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/(use-page-wrapper)/auth/saml-idp/page';

function AsyncComponentWrapper({ params, searchParams }) {
  try {
    return <ImportedComponent params={params} searchParams={searchParams} />;
  } catch (error) {
    if (error instanceof Promise) {
      throw error;
    }
    return <div>Error loading component: {error.message}</div>;
  }
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    params: {
      type: "string",
      value: "{}",
      label: "Params",
    },
    searchParams: {
      type: "string",
      value: '{"code": "example_code"}',
      label: "Search Params",
    },
  });

  const params = JSON.parse(state.params.value);
  const searchParams = JSON.parse(state.searchParams.value);

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <AsyncComponentWrapper params={params} searchParams={searchParams} />
    </Suspense>
  );
}
</content>
</change>
</file>

The changes made include:

1. Added `Suspense` import from React
2. Created an `AsyncComponentWrapper` component to handle the async component properly
3. Wrapped the component rendering in a try-catch block to handle potential Promise throws
4. Wrapped the entire component in a Suspense boundary with a loading fallback
5. Added proper error handling for non-Promise errors

This solution should properly handle the async nature of the component and prevent the "[object Promise]" error from occurring. The Suspense boundary will show a loading state while the component is being loaded, and the error handling will catch any issues that might occur during rendering.

