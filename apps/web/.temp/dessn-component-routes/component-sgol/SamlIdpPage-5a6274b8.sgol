import React, { Suspense, useState, useEffect } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/(use-page-wrapper)/auth/saml-idp/page';

function SamlIdpPageWrapper({ params, searchParams }) {
  const [PageComponent, setPageComponent] = useState(null);
  const [error, setError] = useState(null);

  useEffect(() => {
    const loadComponent = async () => {
      try {
        // Handle both cases where ImportedComponent might be a promise or a component
        const Component = await Promise.resolve(ImportedComponent);
        const ResolvedComponent = Component.default || Component;
        setPageComponent(() => ResolvedComponent);
      } catch (err) {
        setError(err);
        console.error("Error loading SamlIdpPage:", err);
      }
    };

    loadComponent();
  }, []);

  if (error) {
    return <div>Error loading component</div>;
  }

  if (!PageComponent) {
    return <div>Loading...</div>;
  }

  return <PageComponent params={params} searchParams={searchParams} />;
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    params: {
      type: "string",
      value: "{}",
      label: "Params",
    },
    searchParams: {
      type: "string",
      value: '{"code": "example_code"}',
      label: "Search Params",
    },
  });

  const params = JSON.parse(state.params.value);
  const searchParams = JSON.parse(state.searchParams.value);

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <SamlIdpPageWrapper params={params} searchParams={searchParams} />
    </Suspense>
  );
}
