<file name="apps/web/.temp/dessn-component-routes/Page-c549806b.tsx" type="preview>
import React, { Suspense, useEffect } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/(use-page-wrapper)/apps/categories/[category]/page';
import { AppCategories } from "@calcom/prisma/enums";

// Create a mock validator object
const mockValidator = {
  validate: () => true,
  validateSync: () => true,
  validateAsync: async () => true,
};

const MockedComponent = ({ params, searchParams }) => {
  useEffect(() => {
    // Attach mock to window object
    window.prisma = {
      validator: mockValidator,
    };
    
    // Also try to mock the module itself
    window.__calcom_prisma = {
      validator: mockValidator,
      prisma: {
        validator: mockValidator,
      },
    };

    // Mock the module system
    const originalRequire = window.require;
    window.require = function(path) {
      if (path.includes('@calcom/prisma')) {
        return window.__calcom_prisma;
      }
      return originalRequire?.apply(this, arguments);
    };

    // Cleanup
    return () => {
      delete window.prisma;
      delete window.__calcom_prisma;
      window.require = originalRequire;
    };
  }, []);

  try {
    return <ImportedComponent params={params} searchParams={searchParams} />;
  } catch (error) {
    console.error('Failed to render component:', error);
    return <div>Error: Failed to load component</div>;
  }
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    params: {
      type: "string",
      value: JSON.stringify({ category: AppCategories.CALENDAR }),
      label: "Params",
    },
    searchParams: {
      type: "string",
      value: JSON.stringify({}),
      label: "Search Params",
    },
  });

  const params = JSON.parse(state.params.value);
  const searchParams = JSON.parse(state.searchParams.value);

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <MockedComponent params={params} searchParams={searchParams} />
    </Suspense>
  );
}

// Ensure the mock is available immediately
if (typeof window !== 'undefined') {
  window.prisma = {
    validator: mockValidator,
  };
}
</file>

