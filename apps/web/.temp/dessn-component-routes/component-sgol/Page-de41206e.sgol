import React from 'react';
import { useParentState } from '../useIframeState';
import WorkflowsPage from '../../app/(use-page-wrapper)/workflows/page';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    params: {
      type: "string",
      value: JSON.stringify({ id: "123" }),
      label: "Params",
    },
    searchParams: {
      type: "string",
      value: JSON.stringify({ query: "test" }),
      label: "Search Params",
    },
  });

  let params;
  let searchParams;

  try {
    params = JSON.parse(state.params.value);
    searchParams = JSON.parse(state.searchParams.value);
  } catch (error) {
    console.error('Error parsing params:', error);
    params = { id: "123" };
    searchParams = { query: "test" };
  }

  try {
    return <WorkflowsPage params={params} searchParams={searchParams} />;
  } catch (error) {
    console.error('Error rendering component:', error);
    return <div>Error: Failed to render component</div>;
  }
}
</content>
  </change>
</file>

I've made the following changes:
1. Removed the React.lazy() and dynamic import
2. Using direct import for the WorkflowsPage component
3. Simplified the component structure by removing Suspense and custom ErrorBoundary
4. Added a try-catch block around the component rendering
5. Kept the JSON parsing error handling
6. Removed unnecessary complexity that might be causing the import issues

This simplified version should be more stable and easier to debug. The direct import approach might work better in this environment, and we still maintain error handling for both the params parsing and component rendering.

