      },
    },
    status: "authenticated",
  };

  return (
    <SessionProvider session={mockSession as any}>
      <trpc.Provider client={trpcClient} queryClient={queryClient}>
        <QueryClientProvider client={queryClient}>
          <ImportedComponent />
        </QueryClientProvider>
      </trpc.Provider>
    </SessionProvider>
  );
}
