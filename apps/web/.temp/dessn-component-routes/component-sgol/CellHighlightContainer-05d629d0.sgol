import React from 'react';
import { useParentState } from '../useIframeState';
import { CellHighlightContainer } from '../../../../packages/features/timezone-buddy/components/CellHighlightContainer';
import { TBContext, createTimezoneBuddyStore } from '../../../../packages/features/timezone-buddy/store';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    children: {
      type: "string",
      value: "<div>Sample content</div>",
      label: "Children",
    },
  });

  // Initialize the store with default values
  const store = React.useMemo(() => createTimezoneBuddyStore({
    browsingDate: new Date(),
    timeMode: "24h",
    x: 0,
    y: 0,
    height: 0,
  }), []);

  return (
    <TBContext.Provider value={store}>
      <CellHighlightContainer>
        {React.createElement('div', { dangerouslySetInnerHTML: { __html: state.children.value } })}
      </CellHighlightContainer>
    </TBContext.Provider>
  );
}
</content>
</change>
</file>

The changes I made:

1. Imported the necessary `TBContext` and `createTimezoneBuddyStore` from the timezone-buddy store
2. Created a store instance using `createTimezoneBuddyStore` with default values using `useMemo` to prevent unnecessary re-creation
3. Wrapped the `CellHighlightContainer` with `TBContext.Provider` and passed the store as the value

This should resolve the "Missing TBContext.Provider in the tree" error since we're now providing the required context to the component.

