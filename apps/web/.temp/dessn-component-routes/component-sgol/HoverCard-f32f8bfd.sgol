import React from 'react';
import { useParentState } from '../useIframeState';
import { HoverCard, HoverCardContent, HoverCardTrigger, HoverCardPortal } from '../../../../packages/ui/components/hover-card';
import { classNames } from "@calcom/lib";

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    theme: {
      type: "dropdown",
      value: "light",
      options: ["light", "dark", "auto"],
      label: "Theme",
    },
    align: {
      type: "dropdown",
      value: "center",
      options: ["center", "start", "end"],
      label: "Align",
    },
    sideOffset: {
      type: "number",
      value: 4,
      label: "Side Offset",
    },
  });

  return (
    <div className="flex items-center justify-center h-32">
      <HoverCard>
        <HoverCardTrigger asChild>
          <button className="px-4 py-2 rounded-md border border-gray-300">
            Hover over me
          </button>
        </HoverCardTrigger>
        <HoverCardPortal>
          <HoverCardContent
            align={state.align.value}
            sideOffset={state.sideOffset.value}
          >
            <div className="space-y-2">
              <p>This is the hover card content</p>
            </div>
          </HoverCardContent>
        </HoverCardPortal>
      </HoverCard>
    </div>
  );
}
    </content>
  </change>
</file>

The changes I made:

1. Updated the imports to use the local HoverCard component from the correct path
2. Added the classNames utility import which is used by the HoverCard component
3. Simplified the component structure to match the local implementation
4. Removed custom className on HoverCardContent since the component already has its own styling
5. Added a wrapper div with flex centering to better position the hover card
6. Improved the trigger button styling
7. Removed the data-theme prop since it's not needed with the local implementation

The local HoverCard component already has proper styling and animations built-in, so we don't need to add additional styles to the content. This should resolve the undefined component error since we're now using the correct local implementation.

