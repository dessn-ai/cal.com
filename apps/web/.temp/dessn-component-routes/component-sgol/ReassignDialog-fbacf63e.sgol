  const [state, setState] = useParentState({
    isOpenDialog: {
      type: "boolean",
      value: true,
      label: "Is Open Dialog",
    },
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
    bookingId: {
