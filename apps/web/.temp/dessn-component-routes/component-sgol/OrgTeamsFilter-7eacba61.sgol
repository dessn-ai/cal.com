<file path="apps/web/.temp/dessn-component-routes/OrgTeamsFilter-7eacba61.tsx">
<change>
<description>Fix constant reassignment issue by mocking modules differently</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { OrgTeamsFilter } from '../../../../packages/features/insights/filters/OrgTeamsFilter';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Create a client
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

// Mock data
const mockTeamsData = [
  { id: 1, name: 'Team 1', logoUrl: 'https://example.com/logo1.jpg', isOrg: true },
  { id: 2, name: 'Team 2', logoUrl: 'https://example.com/logo2.jpg', isOrg: false },
  { id: 3, name: 'Team 3', logoUrl: 'https://example.com/logo3.jpg', isOrg: false },
];

// Mock Providers
const MockSessionProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  return children;
};

const MockTRPCProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  return children;
};

// Create mock hooks
const mockUseSession = () => ({
  data: {
    user: {
      org: { id: 1 },
      name: 'John Doe',
      avatarUrl: 'https://example.com/avatar.jpg',
    },
  },
  status: "authenticated"
});

const mockTrpcHook = {
  viewer: {
    insights: {
      teamListForUser: {
        useQuery: () => ({
          data: mockTeamsData,
          isLoading: false,
          error: null
        })
      }
    }
  }
};

// Mock the modules
jest.mock('next-auth/react', () => ({
  useSession: () => mockUseSession()
}));

jest.mock('@calcom/trpc', () => ({
  trpc: mockTrpcHook
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to set for this component
  });

  return (
    <QueryClientProvider client={queryClient}>
      <MockSessionProvider>
        <MockTRPCProvider>
          <OrgTeamsFilter />
        </MockTRPCProvider>
      </MockSessionProvider>
    </QueryClientProvider>
  );
}
</content>
</change>
</file>

Changes made:
1. Removed direct reassignment of constant variables (useSession and trpc)
2. Created proper mock providers instead of trying to override the modules
3. Used jest.mock for module mocking (which is the proper way to mock modules)
4. Kept the QueryClientProvider for React Query support
5. Organized the mock data and providers in a cleaner way
6. Wrapped the component with all necessary providers
7. Removed direct imports of modules we're mocking

This approach should resolve the "Assignment to constant variable" error because we're no longer trying to reassign constant variables. Instead, we're properly mocking the modules and providing the necessary context through React components.

