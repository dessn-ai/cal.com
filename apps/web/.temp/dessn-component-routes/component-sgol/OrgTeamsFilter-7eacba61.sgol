<description>Add necessary providers and improve mocking</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { OrgTeamsFilter } from '../../../../packages/features/insights/filters/OrgTeamsFilter';
import { useSession } from 'next-auth/react';
import { trpc } from '@calcom/trpc';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Create a client
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

// Mock the modules at the top level
const mockSession = {
  data: {
    user: {
      org: { id: 1 },
      name: 'John Doe',
      avatarUrl: 'https://example.com/avatar.jpg',
    },
  },
  status: "authenticated"
};

// Override the useSession hook
const mockUseSession = () => mockSession;
(useSession as any) = mockUseSession;

// Mock data for teams
const mockTeamsData = [
  { id: 1, name: 'Team 1', logoUrl: 'https://example.com/logo1.jpg', isOrg: true },
  { id: 2, name: 'Team 2', logoUrl: 'https://example.com/logo2.jpg', isOrg: false },
  { id: 3, name: 'Team 3', logoUrl: 'https://example.com/logo3.jpg', isOrg: false },
];

// Create mock TRPC provider
const TRPCProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  return children;
};

// Mock the trpc hook
(trpc as any) = {
  viewer: {
    insights: {
      teamListForUser: {
        useQuery: () => ({
          data: mockTeamsData,
          isLoading: false,
          error: null
        })
      }
    }
  }
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to set for this component
  });

  return (
    <QueryClientProvider client={queryClient}>
      <TRPCProvider>
        <OrgTeamsFilter />
      </TRPCProvider>
    </QueryClientProvider>
  );
}
</content>
</change>
</file>

Changes made:
1. Added QueryClientProvider from @tanstack/react-query
2. Created a QueryClient instance with some default options
3. Added a simple TRPCProvider wrapper
4. Wrapped the OrgTeamsFilter component with both providers
5. Kept the existing mocks but wrapped them in the proper provider context

This should provide the necessary context for the component to render properly. The error you shared was actually about a different component (RoutingFormEmbedButton), but these changes should help stabilize the OrgTeamsFilter component rendering.

