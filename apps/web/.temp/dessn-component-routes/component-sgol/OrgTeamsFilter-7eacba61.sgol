<change>
<description>Replace module mocking with context providers</description>
<content>
import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { OrgTeamsFilter } from '../../../../packages/features/insights/filters/OrgTeamsFilter';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Create a client
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

// Mock data
const mockTeamsData = [
  { id: 1, name: 'Team 1', logoUrl: 'https://example.com/logo1.jpg', isOrg: true },
  { id: 2, name: 'Team 2', logoUrl: 'https://example.com/logo2.jpg', isOrg: false },
  { id: 3, name: 'Team 3', logoUrl: 'https://example.com/logo3.jpg', isOrg: false },
];

const mockSession = {
  data: {
    user: {
      org: { id: 1 },
      name: 'John Doe',
      avatarUrl: 'https://example.com/avatar.jpg',
    },
  },
  status: "authenticated"
};

// Create contexts for our mocks
const SessionContext = createContext(null);
const TRPCContext = createContext(null);

// Create mock providers
const MockSessionProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  return (
    <SessionContext.Provider value={mockSession}>
      {children}
    </SessionContext.Provider>
  );
};

const MockTRPCProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const mockTrpc = {
    viewer: {
      insights: {
        teamListForUser: {
          useQuery: () => ({
            data: mockTeamsData,
            isLoading: false,
            error: null
          })
        }
      }
    }
  };

  return (
    <TRPCContext.Provider value={mockTrpc}>
      {children}
    </TRPCContext.Provider>
  );
};

// Mock the hooks by overriding the imports
// @ts-ignore
window.useSession = () => mockSession;

// @ts-ignore
window.trpc = {
  viewer: {
    insights: {
      teamListForUser: {
        useQuery: () => ({
          data: mockTeamsData,
          isLoading: false,
          error: null
        })
      }
    }
  }
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to set for this component
  });

  return (
    <QueryClientProvider client={queryClient}>
      <MockSessionProvider>
        <MockTRPCProvider>
          <OrgTeamsFilter />
        </MockTRPCProvider>
      </MockSessionProvider>
    </QueryClientProvider>
  );
}
</content>
</change>
</file>

Changes made:
1. Removed direct module property redefinition
2. Created context providers for session and TRPC data
3. Used window object to globally define our mock hooks (this is a common pattern in browser environments)
4. Wrapped the component with all necessary providers
5. Added proper TypeScript ignores for the window object extensions
6. Maintained the QueryClientProvider for React Query support
7. Organized the mock data and providers in a cleaner structure

This approach should work better because:
1. We're no longer trying to modify module properties
2. We're using React's context system which is more reliable for this use case
3. We're defining globals on the window object which is more permissive
4. We've maintained all the necessary data and functionality

The component should now render properly with all the mock data and functionality available through the context providers and global definitions.

