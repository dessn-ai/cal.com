<file path="apps/web/.temp/dessn-component-routes/OrgTeamsFilter-7eacba61.tsx">
<change>
<description>Add InsightsOrgTeamsProvider and its mock implementation</description>
<content>
import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { OrgTeamsFilter } from '../../../../packages/features/insights/filters/OrgTeamsFilter';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Create a client
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

// Mock data
const mockTeamsData = [
  { id: 1, name: 'Team 1', logoUrl: 'https://example.com/logo1.jpg', isOrg: true },
  { id: 2, name: 'Team 2', logoUrl: 'https://example.com/logo2.jpg', isOrg: false },
  { id: 3, name: 'Team 3', logoUrl: 'https://example.com/logo3.jpg', isOrg: false },
];

const mockSession = {
  data: {
    user: {
      org: { id: 1 },
      name: 'John Doe',
      avatarUrl: 'https://example.com/avatar.jpg',
    },
  },
  status: "authenticated"
};

// Create InsightsOrgTeamsContext and Provider
const InsightsOrgTeamsContext = createContext<{
  selectedTeams: number[];
  setSelectedTeams: (teams: number[]) => void;
  teams: typeof mockTeamsData;
  isLoading: boolean;
}>({
  selectedTeams: [],
  setSelectedTeams: () => {},
  teams: [],
  isLoading: false,
});

const InsightsOrgTeamsProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [selectedTeams, setSelectedTeams] = React.useState<number[]>([]);

  const value = {
    selectedTeams,
    setSelectedTeams,
    teams: mockTeamsData,
    isLoading: false,
  };

  return (
    <InsightsOrgTeamsContext.Provider value={value}>
      {children}
    </InsightsOrgTeamsContext.Provider>
  );
};

// Mock the useInsightsOrgTeams hook
window.useInsightsOrgTeams = () => useContext(InsightsOrgTeamsContext);

// Create mock providers
const MockSessionProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  return (
    <SessionContext.Provider value={mockSession}>
      {children}
    </SessionContext.Provider>
  );
};

const MockTRPCProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const mockTrpc = {
    viewer: {
      insights: {
        teamListForUser: {
          useQuery: () => ({
            data: mockTeamsData,
            isLoading: false,
            error: null
          })
        }
      }
    }
  };

  return (
    <TRPCContext.Provider value={mockTrpc}>
      {children}
    </TRPCContext.Provider>
  );
};

// Create contexts for our mocks
const SessionContext = createContext(null);
const TRPCContext = createContext(null);

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to set for this component
  });

  return (
    <QueryClientProvider client={queryClient}>
      <MockSessionProvider>
        <MockTRPCProvider>
          <InsightsOrgTeamsProvider>
            <OrgTeamsFilter />
          </InsightsOrgTeamsProvider>
        </MockTRPCProvider>
      </MockSessionProvider>
    </QueryClientProvider>
  );
}
</content>
</change>
</file>

