import { useFormContext } from 'react-hook-form';

export const FormInput = ({ name }: { name: string }) => {
  const { register, formState } = useFormContext();
  const error = formState.errors[name]?.message;  // Error occurs here
  
  return (
    <input {...register(name)} />
  );
};

Step 2: Fix the issue by adding proper error handling

<file path="src/components/common/form/FormInput.tsx">
  <change>
    <description>Add null check for formState and provide default values</description>
    <content>
===
import { useFormContext } from 'react-hook-form';

export const FormInput = ({ name }: { name: string }) => {
  const { register, formState = {} } = useFormContext() || {};
  const error = formState?.errors?.[name]?.message;
  
  return (
    <input {...register(name)} />
  );
};
===
    </content>
  </change>
</file>

The fix:
1. Added null check for useFormContext result
2. Provided default empty object for formState
3. Used optional chaining for safer property access

Please proceed with fixing any errors you encounter following these guidelines.

