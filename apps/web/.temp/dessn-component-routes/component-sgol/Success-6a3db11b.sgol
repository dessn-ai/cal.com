import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../modules/bookings/views/bookings-single-view';

// Mock the router hooks that the component uses internally
const mockRouter = {
  query: { uid: "booking-123" },
  push: () => Promise.resolve(true),
  replace: () => Promise.resolve(true),
  pathname: "/booking/success"
};

// Mock the router hooks
jest.mock('next/navigation', () => ({
  useRouter: () => mockRouter,
  useSearchParams: () => new URLSearchParams({ uid: "booking-123" }),
  usePathname: () => "/booking/success"
}));

jest.mock('@calcom/lib/hooks/useRouterQuery', () => ({
  useRouterQuery: () => ({ uid: "booking-123" })
}));

export default function ComponentPreview() {
  const bookingUid = "booking-123";
  const [state, setState] = useParentState({
    userTimeFormat: {
      type: "number",
      value: 24,
      label: "User Time Format",
