<file path="apps/web/.temp/dessn-component-routes/Signup-5b3f34b6.tsx">
<change>
<description>Simplify providers and add error handling</description>
<content>
import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../modules/signup-view';

// Mock minimal versions of providers to avoid dependency issues
const MockProvider = ({ children }) => <>{children}</>;

// Simplified error boundary component
class ErrorBoundary extends React.Component {
  constructor(props) {
    super(props);
    this.state = { hasError: false };
  }

  static getDerivedStateFromError(error) {
    return { hasError: true };
  }

  render() {
    if (this.state.hasError) {
      return <div>Something went wrong. Please try again.</div>;
    }

    return this.props.children;
  }
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    prepopulateFormValues: {
      type: "string",
      value: JSON.stringify({ email: "example@example.com", username: "exampleuser" }),
      label: "Prepopulate Form Values",
    },
    token: {
      type: "string",
      value: "exampleToken",
      label: "Token",
    },
    orgSlug: {
      type: "string",
      value: "exampleOrg",
      label: "Organization Slug",
    },
    isGoogleLoginEnabled: {
      type: "boolean",
      value: true,
      label: "Is Google Login Enabled",
    },
    isSAMLLoginEnabled: {
      type: "boolean",
      value: true,
      label: "Is SAML Login Enabled",
    },
    orgAutoAcceptEmail: {
      type: "string",
      value: "example@org.com",
      label: "Organization Auto Accept Email",
    },
    redirectUrl: {
      type: "string",
      value: "/example-redirect",
      label: "Redirect URL",
    },
    emailVerificationEnabled: {
      type: "boolean",
      value: true,
      label: "Email Verification Enabled",
    },
  });

  return (
    <ErrorBoundary>
      <Suspense fallback={<div>Loading...</div>}>
        <MockProvider>
          {/* Wrap the component in a try-catch block */}
          {(() => {
            try {
              return (
                <ImportedComponent
                  prepopulateFormValues={state.prepopulateFormValues.value ? JSON.parse(state.prepopulateFormValues.value) : undefined}
                  token={state.token.value}
                  orgSlug={state.orgSlug.value}
                  isGoogleLoginEnabled={state.isGoogleLoginEnabled.value}
                  isSAMLLoginEnabled={state.isSAMLLoginEnabled.value}
                  orgAutoAcceptEmail={state.orgAutoAcceptEmail.value}
                  redirectUrl={state.redirectUrl.value}
                  emailVerificationEnabled={state.emailVerificationEnabled.value}
                />
              );
            } catch (error) {
              console.error('Error rendering component:', error);
              return <div>Error loading component. Please try again.</div>;
            }
          })()}
        </MockProvider>
      </Suspense>
    </ErrorBoundary>
  );
}
</content>
</change>
</file>

I've made several changes to handle the module loading issue:

1. Removed all external provider dependencies that might be causing issues
2. Added a simple MockProvider component that just renders children
3. Implemented a proper ErrorBoundary component to catch and handle errors
4. Wrapped the ImportedComponent in a try-catch block using an IIFE
5. Kept the Suspense wrapper for handling lazy loading
6. Simplified the overall structure to minimize potential points of failure

This simplified version should help isolate whether the issue is with the providers or with the actual module loading. The error boundary and try-catch blocks will help catch and handle any errors more gracefully, while the MockProvider ensures that the component has at least a basic context wrapper.

If this still doesn't resolve the issue, we might need to:
1. Check if the ImportedComponent path is correct
2. Verify that the module is actually available at the specified path
3. Consider using dynamic imports with React.lazy()
4. Check for any build configuration issues that might be preventing proper module resolution

Let me know if the error persists and we can try another approach.

