    name: "Test Team",
    slug: "test-team",
    safeBio: "Safe bio content",
    members: [
      {
        name: "John Doe",
        id: "1",
        avatarUrl: "https://example.com/avatar.jpg",
        bio: "Member bio",
        profile: {
          id: 1,
          username: "johndoe",
        },
        subteams: [],
        username: "johndoe",
        accepted: true,
        organizationId: "org1",
