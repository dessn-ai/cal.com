      label: "End Time",
    },
    organizerName: {
      type: "string",
      value: "John Doe",
      label: "Organizer Name",
    },
    organizerEmail: {
      type: "string",
      value: "john@example.com",
      label: "Organizer Email",
    },
    attendeeName: {
      type: "string",
      value: "Jane Smith",
      label: "Attendee Name",
    },
    attendeeEmail: {
      type: "string",
      value: "jane@example.com",
      label: "Attendee Email",
    },
