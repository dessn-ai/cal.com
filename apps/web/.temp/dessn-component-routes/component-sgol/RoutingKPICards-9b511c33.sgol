jest.mock('@calcom/features/data-table/hooks/useFilterValue', () => ({
  useFilterValue: () => ['', () => {}],
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
    startDate: {
      type: "string",
      value: new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString(),
      label: "Start Date",
