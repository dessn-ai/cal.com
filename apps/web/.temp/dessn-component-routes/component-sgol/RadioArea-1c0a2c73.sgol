<file path="apps/web/.temp/dessn-component-routes/RadioArea-1c0a2c73.tsx">
<change>
<description>Update the preview with multiple radio options and correct value handling</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { RadioArea, RadioAreaGroup } from '../../../../packages/ui/form/radio-area/RadioAreaGroup';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    id: {
      type: "string",
      value: "radio-area-1",
      label: "ID",
    },
    value: {
      type: "string",
      value: "option1",
      label: "Value",
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled",
    },
    className: {
      type: "string",
      value: "",
      label: "Class Name",
    },
  });

  const handleValueChange = (newValue: string) => {
    setState((prev) => ({
      ...prev,
      value: {
        ...prev.value,
        value: newValue,
      },
    }));
  };

  return (
    <RadioAreaGroup 
      defaultValue="option1"
      value={state.value.value}
      onValueChange={handleValueChange}
    >
      <RadioArea
        value="option1"
        id="option1"
        disabled={state.disabled.value}
        className={state.className.value}
      >
        <div className="p-2">Option 1</div>
      </RadioArea>
      <RadioArea
        value="option2"
        id="option2"
        disabled={state.disabled.value}
        className={state.className.value}
      >
        <div className="p-2">Option 2</div>
      </RadioArea>
      <RadioArea
        value="option3"
        id="option3"
        disabled={state.disabled.value}
        className={state.className.value}
      >
        <div className="p-2">Option 3</div>
      </RadioArea>
    </RadioAreaGroup>
  );
}
</content>
</change>
</file>

I've made several important changes:

1. Added multiple `RadioArea` components within the `RadioAreaGroup` to demonstrate proper radio group functionality
2. Added a `defaultValue` prop to `RadioAreaGroup`
3. Ensured each `RadioArea` has a unique `value` and `id`
4. Simplified the value handling to match the Radix UI RadioGroup expectations
5. Added proper content and spacing to each radio option
6. Made sure each RadioArea has the correct props structure

This should resolve the error as we're now:
- Properly structuring the radio group with multiple options
- Correctly handling the value and state management
- Providing unique identifiers for each radio option
- Following the Radix UI RadioGroup component pattern more closely

The error was likely occurring because the component expects to be used as part of a group of radio options, rather than a single radio item. This new structure should work correctly.

