Assistant: I see the issue now. The `RadioArea` component needs to be wrapped in a `RadioAreaGroup` component since it uses Radix UI's RadioGroupPrimitive.Item internally. Let's fix the preview component:

<file path="apps/web/.temp/dessn-component-routes/RadioArea-1c0a2c73.tsx">
<change>
<description>Wrap RadioArea in RadioAreaGroup and add necessary imports</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { RadioArea, RadioAreaGroup } from '../../../../packages/ui/form/radio-area/RadioAreaGroup';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    id: {
      type: "string",
      value: "radio-area-1",
      label: "ID",
    },
    value: {
      type: "string",
      value: "option1",
      label: "Value",
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled",
    },
    className: {
      type: "string",
      value: "",
      label: "Class Name",
    },
  });

  return (
    <RadioAreaGroup value={state.value.value} onValueChange={(value) => setState((prev) => ({ ...prev, value: { ...prev.value, value } }))}>
      <RadioArea
        id={state.id.value}
        value={state.value.value}
        disabled={state.disabled.value}
        className={state.className.value}
      >
        <div>Radio Area Content</div>
      </RadioArea>
    </RadioAreaGroup>
  );
}
</content>
</change>
</file>

The changes I made:
1. Added `RadioAreaGroup` import from the same file
2. Wrapped the `RadioArea` component with `RadioAreaGroup`
3. Added required `value` and `onValueChange` props to `RadioAreaGroup` to make it controlled
4. Connected the state management to the `onValueChange` handler

This should resolve the error since now the `RadioArea` (which uses `RadioGroupPrimitive.Item` internally) is properly wrapped in a `RadioAreaGroup` (which uses `RadioGroupPrimitive.Root`).

