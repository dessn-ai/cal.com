<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { TeamsListing } from '../../../../packages/features/ee/teams/components/TeamsListing';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Create a new QueryClient for React Query
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

// Mock the trpc hooks
jest.mock('@calcom/trpc/react', () => ({
  trpc: {
    viewer: {
      teams: {
        list: {
          useQuery: () => ({
            data: [],
            isLoading: false,
            error: null
          })
        }
      },
      me: {
        useQuery: () => ({
          data: {
            id: 1,
            username: 'test',
            email: 'test@example.com'
          },
          isLoading: false
        })
      }
    }
  }
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  try {
    return (
      <QueryClientProvider client={queryClient}>
        <TeamsListing />
      </QueryClientProvider>
    );
  } catch (error) {
    console.error('Error rendering TeamsListing:', error);
    return <div>Error loading teams listing</div>;
  }
}
</content>
</change>
</file>

I've made several changes to fix the error:

1. Removed the problematic TRPC Provider setup
2. Added direct mocking of the TRPC hooks that the component might use
3. Wrapped the component in a try-catch block to handle potential errors
4. Kept the QueryClientProvider as it's still needed for React Query
5. Simplified the overall structure

The key changes are:
- Mocking the TRPC hooks directly instead of trying to create a provider
- Adding error handling to prevent crashes
- Providing mock data in the expected format

If this approach doesn't work, we might need to try one more alternative approach:

1. Create a mock wrapper component that provides the necessary context
2. Use React.Suspense to handle any loading states
3. Mock the specific hooks that TeamsListing uses

Let me know if you still see the error and I can try the alternative approach.

