import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/(use-page-wrapper)/apps/[slug]/page';

// Mock data that would normally come from the file system
const MOCK_DATA = {
  content: "# Example App\nThis is a mock content for preview.",
  data: {
    name: "Example App",
    description: "This is an example app description",
    categories: ["productivity"],
    price: "0",
    isDefault: false,
  }
};

// Mock the fs module
if (typeof window !== 'undefined') {
  window.fs = {
    readFileSync: () => JSON.stringify(MOCK_DATA),
    existsSync: () => true,
  };
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    params: {
      type: "string",
      value: JSON.stringify({ slug: "example-app" }),
      label: "Params",
    },
    searchParams: {
      type: "string",
      value: JSON.stringify({}),
      label: "Search Params",
    },
  });

  const props = {
    params: JSON.parse(state.params.value),
    searchParams: JSON.parse(state.searchParams.value),
  };

  try {
    return <ImportedComponent {...props} />;
  } catch (error) {
    return (
      <div>
        <h1>Preview Error</h1>
        <p>Could not render the component due to file system dependencies.</p>
        <pre>{error.message}</pre>
      </div>
    );
  }
}
