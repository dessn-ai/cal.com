  t: (key: string) => key,
});

// Create a proper mock for trpc
const mockTrpc = {
  viewer: {
    organizations: {
      update: {
        useMutation: () => ({
          mutate: () => Promise.resolve({ update: true }),
          isPending: false,
        }),
      },
    },
  },
};

