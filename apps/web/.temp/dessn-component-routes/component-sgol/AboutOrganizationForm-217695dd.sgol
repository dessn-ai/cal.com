    (global as any).useRouter = () => mockRouter;
    (global as any).useLocale = mockUseLocale;
    (global as any).trpc = mockTrpc;
    (global as any).useRouterQuery = () => ({ id: state.orgId.value });

    // Mock the imports
    mockImports();
  }, [state.orgId.value]);

  // Create a wrapper component that provides the necessary context
  const Wrapper = ({ children }: { children: React.ReactNode }) => {
    return (
      <div data-testid="about-organization-form">
        {children}
      </div>
    );
  };

  return (
    <Wrapper>
      <AboutOrganizationForm />
    </Wrapper>
  );
}
