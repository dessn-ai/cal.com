    useRouter: () => mockRouter,
  }));

  // Mock @calcom/lib/hooks/useLocale
  jest.mock('@calcom/lib/hooks/useLocale', () => ({
    useLocale: mockUseLocale,
  }));

  // Mock @calcom/trpc/react
  jest.mock('@calcom/trpc/react', () => ({
    trpc: mockTrpc,
  }));

  // Mock @calcom/lib/hooks/useRouterQuery
  jest.mock('@calcom/lib/hooks/useRouterQuery', () => ({
    useRouterQuery: mockUseRouterQuery,
  }));
};

export default function ComponentPreview() {
