<file path="apps/web/.temp/dessn-component-routes/AboutOrganizationForm-217695dd.tsx">
<change>
<description>Create a context wrapper and ensure router query is available immediately</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { AboutOrganizationForm } from '../../../../packages/features/ee/organizations/components/AboutOrganizationForm';
import { FormProvider, useForm } from 'react-hook-form';

// Create a context to provide the router query
const RouterContext = React.createContext({
  useRouterQuery: () => ({ id: '' }),
  useRouter: () => ({ push: () => {} }),
  useLocale: () => ({ t: (key: string) => key }),
  trpc: {
    viewer: {
      organizations: {
        update: {
          useMutation: () => ({
            mutate: () => {},
            isPending: false,
          }),
        },
      },
    },
  },
});

// Create a provider component
const MockProvider = ({ children, orgId }) => {
  const value = {
    useRouterQuery: () => ({ id: orgId }),
    useRouter: () => ({ push: () => {} }),
    useLocale: () => ({ t: (key: string) => key }),
    trpc: {
      viewer: {
        organizations: {
          update: {
            useMutation: () => ({
              mutate: () => {},
              isPending: false,
            }),
          },
        },
      },
    },
  };

  return (
    <RouterContext.Provider value={value}>
      {children}
    </RouterContext.Provider>
  );
};

// Override the global hooks to use context
if (typeof window !== 'undefined') {
  window.useRouterQuery = () => React.useContext(RouterContext).useRouterQuery();
  window.useRouter = () => React.useContext(RouterContext).useRouter();
  window.useLocale = () => React.useContext(RouterContext).useLocale();
  window.trpc = React.useContext(RouterContext).trpc;
}

export default function ComponentPreview() {
  const [state] = useParentState({
    orgId: {
      type: "string",
      value: "org123",
      label: "Organization ID",
    },
  });

  const formMethods = useForm();

  return (
    <MockProvider orgId={state.orgId.value}>
      <FormProvider {...formMethods}>
        <AboutOrganizationForm />
      </FormProvider>
    </MockProvider>
  );
}
</content>
</change>
</file>

The changes I made include:

1. Created a RouterContext to properly provide all required dependencies
2. Created a MockProvider component that provides all necessary context values
3. Removed the useEffect approach and replaced it with immediate context values
4. Ensured the router query with 'id' is available immediately through context
5. Set up global overrides using the context values
6. Wrapped the component with MockProvider passing the orgId

This approach should resolve the Zod validation error by ensuring that:
1. The router query with 'id' is available immediately when the component mounts
2. All required context values are provided properly through React's context system
3. There's no race condition with useEffect
4. The global overrides are set up before the component renders

The component should now have access to all required dependencies and the 'id' parameter should be properly available through the router query.

