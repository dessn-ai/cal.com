    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { AboutOrganizationForm } from '../../../../packages/features/ee/organizations/components/AboutOrganizationForm';

// Mock the required hooks and modules
const mockHooks = {
  useRouter: () => ({
    push: () => {},
  }),
  useLocale: () => ({
    t: (key: string) => key,
  }),
  useRouterQuery: () => ({
    id: 'org123',
  }),
  trpc: {
    viewer: {
      organizations: {
        update: {
          useMutation: () => ({
            mutate: () => {},
            isPending: false,
          }),
        },
      },
    },
  },
};

// Create a wrapper component that provides the mocked context
const MockedComponent = () => {
  // Override the hooks
  (global as any).useRouter = mockHooks.useRouter;
  (global as any).useLocale = mockHooks.useLocale;
  (global as any).useRouterQuery = mockHooks.useRouterQuery;
  (global as any).trpc = mockHooks.trpc;

  return <AboutOrganizationForm />;
};

export default function ComponentPreview() {
  const [state] = useParentState({
    orgId: {
      type: "string",
      value: "org123",
      label: "Organization ID",
    },
  });

  // Ensure the mocks are set up before rendering
  React.useEffect(() => {
    Object.assign(global, {
      useRouter: mockHooks.useRouter,
      useLocale: mockHooks.useLocale,
      useRouterQuery: () => ({
        id: state.orgId.value,
      }),
      trpc: mockHooks.trpc,
    });
  }, [state.orgId.value]);

  return <MockedComponent />;
}
</content>
  </change>
</file>

