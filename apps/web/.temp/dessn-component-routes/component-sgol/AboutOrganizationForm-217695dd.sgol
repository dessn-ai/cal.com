import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { AboutOrganizationForm } from '../../../../packages/features/ee/organizations/components/AboutOrganizationForm';

// Create mock contexts
const RouterContext = createContext({
  useRouter: () => ({ push: () => {} }),
  useRouterQuery: () => ({ id: 'org123' })
});

const LocaleContext = createContext({
  useLocale: () => ({ t: (key: string) => key })
});

const TrpcContext = createContext({
  trpc: {
    viewer: {
      organizations: {
        update: {
          useMutation: () => ({
            mutate: () => {},
            isPending: false
          })
        }
      }
    }
  }
});

// Create wrapper component to provide all necessary context
const ComponentWrapper = ({ children }: { children: React.ReactNode }) => {
  return (
    <RouterContext.Provider value={{
      useRouter: () => ({ push: () => {} }),
      useRouterQuery: () => ({ id: 'org123' })
    }}>
      <LocaleContext.Provider value={{
        useLocale: () => ({ t: (key: string) => key })
      }}>
        <TrpcContext.Provider value={{
          trpc: {
            viewer: {
              organizations: {
                update: {
                  useMutation: () => ({
                    mutate: () => {},
                    isPending: false
                  })
                }
              }
            }
          }
        }}>
          {children}
        </TrpcContext.Provider>
      </LocaleContext.Provider>
    </RouterContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    orgId: {
      type: "string",
      value: "org123",
      label: "Organization ID",
    },
  });

  // Set up global mocks
  React.useEffect(() => {
    const routerContext = useContext(RouterContext);
    const localeContext = useContext(LocaleContext);
    const trpcContext = useContext(TrpcContext);

    (global as any).useRouter = routerContext.useRouter;
    (global as any).useLocale = localeContext.useLocale;
    (global as any).trpc = trpcContext.trpc;
    (global as any).useRouterQuery = routerContext.useRouterQuery;
  }, []);

  return (
    <ComponentWrapper>
      <AboutOrganizationForm />
    </ComponentWrapper>
  );
}
