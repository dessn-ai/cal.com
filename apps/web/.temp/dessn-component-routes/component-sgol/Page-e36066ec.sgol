// Mock Feature Provider
const FeatureProvider = ({ children }) => {
  return <>{children}</>;
};

// Mock Org Branding Provider
const OrgBrandingProvider = ({ children }) => {
  return <>{children}</>;
};

// Mock TRPC Provider
const TRPCProvider = ({ children }) => {
  return <>{children}</>;
};

export default function ComponentPreview() {
