import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/ee/dsync/components/CreateTeamDialog';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Mock the exact context key that the original implementation uses
const OrgContext = React.createContext<{
  orgBranding: {
    logo: string;
    name: string;
    brand: {
      brandColor: string;
      darkBrandColor: string;
      theme: null;
    };
    hideBranding: boolean;
  };
}>({
  orgBranding: {
    logo: '',
    name: 'Demo Organization',
    brand: {
      brandColor: '#292929',
      darkBrandColor: '#ffffff',
      theme: null,
    },
    hideBranding: false,
  },
});

// Mock the useOrgBranding hook
React.createContext = ((createContext) => {
  return (defaultValue: any) => {
    if (defaultValue === undefined) {
      return OrgContext;
    }
    return createContext(defaultValue);
  };
})(React.createContext);

// Create a mock QueryClient
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      cacheTime: 0,
      staleTime: 0,
    },
  },
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    open: {
      type: "boolean",
      value: true,
      label: "Open",
    },
  });

  const handleOpenChange = (open: boolean) => {
    setState('open', open);
  };

  return (
    <QueryClientProvider client={queryClient}>
      <OrgContext.Provider 
        value={{
          orgBranding: {
            logo: '',
            name: 'Demo Organization',
            brand: {
              brandColor: '#292929',
              darkBrandColor: '#ffffff',
              theme: null,
            },
            hideBranding: false,
          }
        }}
      >
        <div className="bg-white">
          <ImportedComponent 
            open={state.open.value} 
            onOpenChange={handleOpenChange}
          />
        </div>
      </OrgContext.Provider>
    </QueryClientProvider>
  );
}
</content>
  </change>
</file>

