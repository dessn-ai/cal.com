import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/ee/dsync/components/CreateTeamDialog';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { createTRPCReact, httpBatchLink } from '@trpc/react-query';
import superjson from 'superjson';

// Create a simple TRPC instance
const trpc = createTRPCReact();

// Create a mock TRPC router
const mockTrpcClient = trpc.createClient({
  transformer: superjson,
  links: [
    httpBatchLink({
      url: 'http://localhost:3000/api/trpc',
      // Add headers here if needed
      headers() {
        return {
          // Add any required headers
        };
      },
    }),
  ],
});

// Create a stable QueryClient instance
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    open: {
      type: "boolean",
      value: true,
      label: "Open",
    },
  });

  const handleOpenChange = (open: boolean) => {
    setState('open', open);
  };

  return (
    <trpc.Provider client={mockTrpcClient} queryClient={queryClient}>
      <QueryClientProvider client={queryClient}>
        <ImportedComponent 
          open={state.open.value} 
          onOpenChange={handleOpenChange}
        />
      </QueryClientProvider>
    </trpc.Provider>
  );
}
    </content>
  </change>
</file>

I've made the following changes to fix the error:

1. Removed the dynamic client creation that was causing the error
2. Created a stable TRPC instance using `createTRPCReact()`
3. Set up a static QueryClient with proper default options
4. Created a mock TRPC client with superjson transformer
5. Moved the client and QueryClient creation outside the component to avoid recreation on each render
6. Added proper configuration for the httpBatchLink

This setup should provide a more stable environment for the preview component. The TRPC client is now properly configured with the necessary transformers and links, which should prevent the "map of undefined" error.

If you still encounter issues, we might need to mock the specific TRPC procedures that the component is trying to use. Let me know if you need further adjustments.

