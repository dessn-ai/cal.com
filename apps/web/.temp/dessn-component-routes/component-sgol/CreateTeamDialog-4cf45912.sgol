<file path="apps/web/.temp/dessn-component-routes/CreateTeamDialog-4cf45912.tsx">
  <change>
    <description>Create a mock wrapper component with context values</description>
    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/ee/dsync/components/CreateTeamDialog';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Create a mock QueryClient
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      cacheTime: 0,
      staleTime: 0,
    },
  },
});

// Create the same context key that the original uses
const OrgBrandingContext = React.createContext({
  orgBranding: {
    logo: '',
    name: 'Demo Organization',
    brand: {
      brandColor: '#292929',
      darkBrandColor: '#ffffff',
      theme: null,
    },
    hideBranding: false,
  }
});

// Create a mock provider component
const MockOrgProvider = ({ children }: { children: React.ReactNode }) => {
  // Create a stable reference to the context value
  const contextValue = React.useMemo(() => ({
    orgBranding: {
      logo: '',
      name: 'Demo Organization',
      brand: {
        brandColor: '#292929',
        darkBrandColor: '#ffffff',
        theme: null,
      },
      hideBranding: false,
    }
  }), []);

  return (
    <OrgBrandingContext.Provider value={contextValue}>
      {children}
    </OrgBrandingContext.Provider>
  );
};

// Create a HOC to wrap the imported component
const withOrgBranding = (WrappedComponent: typeof ImportedComponent) => {
  return function WithOrgBrandingComponent(props: React.ComponentProps<typeof ImportedComponent>) {
    return (
      <MockOrgProvider>
        <WrappedComponent {...props} />
      </MockOrgProvider>
    );
  };
};

// Wrap the imported component with our HOC
const WrappedComponent = withOrgBranding(ImportedComponent);

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    open: {
      type: "boolean",
      value: true,
      label: "Open",
    },
  });

  const handleOpenChange = (open: boolean) => {
    setState('open', open);
  };

  return (
    <QueryClientProvider client={queryClient}>
      <div className="bg-white">
        <WrappedComponent 
          open={state.open.value} 
          onOpenChange={handleOpenChange}
        />
      </div>
    </QueryClientProvider>
  );
}
</content>
  </change>
</file>

I've made the following changes:

1. Created a mock context with the same structure as the original
2. Created a MockOrgProvider component that provides the context values
3. Created a HOC (Higher Order Component) that wraps the imported component with the mock provider
4. Used React.useMemo to create a stable reference to the context value
5. Wrapped the ImportedComponent with our HOC before using it

This approach:
- Doesn't try to modify read-only modules
- Provides the necessary context at the component level
- Maintains proper React patterns with useMemo and HOC
- Should provide the same context interface that the original component expects

If this still doesn't work, we could try:
1. Using React.lazy to defer the component loading
2. Creating a completely mocked version of the component
3. Using a different context key or structure

