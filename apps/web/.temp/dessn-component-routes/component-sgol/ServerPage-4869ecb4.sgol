import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { I18nextProvider } from 'react-i18next';
import { TooltipProvider } from '@radix-ui/react-tooltip';
import { FeatureProvider } from '@calcom/features/flags/context/provider';
import { SessionProvider } from 'next-auth/react';
import { trpc } from '@calcom/trpc';

// Create a QueryClient instance
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

// Mock i18n instance
const i18nInstance = {
  language: 'en',
  languages: ['en'],
  loadNamespaces: () => Promise.resolve(),
  loadLanguages: () => Promise.resolve(),
  t: (key: string) => key,
  exists: () => false,
};

// Create a mock TRPC client
const mockTrpcClient = {
  query: () => ({
    data: null,
    error: null,
    isLoading: false,
  }),
  mutation: () => ({
    mutate: async () => {},
    data: null,
    error: null,
    isLoading: false,
  }),
  subscribe: () => ({
    data: null,
    error: null,
    isLoading: false,
  }),
  links: [],
  _def: { links: [] },
  request: () => Promise.resolve(),
};

const ImportedComponent = React.lazy(() => import('../../app/(use-page-wrapper)/booking/[uid]/page'));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    params: {
      type: "string",
      value: JSON.stringify({ uid: "example-uid" }),
      label: "Params",
    },
    searchParams: {
      type: "string",
      value: JSON.stringify({ query: "example" }),
      label: "Search Params",
    },
  });

  const params = JSON.parse(state.params.value);
  const searchParams = JSON.parse(state.searchParams.value);

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <SessionProvider session={null}>
        <I18nextProvider i18n={i18nInstance}>
          <trpc.Provider client={mockTrpcClient as any} queryClient={queryClient}>
            <QueryClientProvider client={queryClient}>
              <TooltipProvider>
                <FeatureProvider>
                  <ImportedComponent params={params} searchParams={searchParams} />
                </FeatureProvider>
              </TooltipProvider>
            </QueryClientProvider>
          </trpc.Provider>
        </I18nextProvider>
      </SessionProvider>
    </Suspense>
  );
}
</content>
  </change>
</file>

I made the following changes:

1. Added back the TRPC provider but with a properly mocked client
2. Created a `mockTrpcClient` object that implements the basic TRPC client interface with dummy methods
3. The mock client returns empty/null values but maintains the expected structure
4. Used type assertion (`as any`) to satisfy TypeScript while using the mock client
5. Kept all other providers and configuration the same

This approach should prevent the "Cannot read properties of undefined (reading 'map')" error by providing a mock TRPC client that has the expected structure but doesn't actually try to make any real TRPC calls.

The mock client provides empty implementations for:
- query
- mutation
- subscribe
- request
- links

This should allow the component to render without trying to make actual TRPC calls that would fail in the preview environment.

