                    <DynamicComponent params={params} searchParams={searchParams} />
                  ) : (
                    <div>Loading component...</div>
                  )}
                </FeatureProvider>
              </TooltipProvider>
            </QueryClientProvider>
          </TRPCProvider>
        </I18nextProvider>
      </SessionProvider>
    </Suspense>
  );
}
