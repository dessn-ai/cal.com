Assistant: The error occurs because we're trying to pass a function through postMessage in the iframe communication, which isn't possible. We need to modify our approach to avoid passing functions directly in the state. Let's fix this by providing a simple string-based translation implementation instead:

<file path="apps/web/.temp/dessn-component-routes/useLockedFieldsManager-40a865c1.tsx">
<change>
<description>Replace function-based translate with a simple implementation that avoids postMessage issues</description>
<content>
import React from 'react';
import useLockedFieldsManager from '../../../../packages/features/ee/managed-event-types/hooks/useLockedFieldsManager';
import { useForm } from 'react-hook-form';

export default function ComponentPreview() {
  const eventType = {
    schedulingType: "MANAGED",
    userId: 1,
    metadata: {
      managedEventConfig: {
        unlockedFields: {}
      }
    },
    id: 1
  };

  // Simple translation function that just returns the key
  const translate = (key: string) => {
    const translations: Record<string, string> = {
      'locked': 'Locked',
      'unlocked': 'Unlocked',
      'locked_fields_admin_description': 'This field is locked by admin',
      'locked_fields_member_description': 'This field is locked by member',
      'unlocked_fields_admin_description': 'This field is unlocked by admin',
      'unlocked_fields_member_description': 'This field is unlocked by member'
    };
    return translations[key] || key;
  };

  const formMethods = useForm<any>({
    defaultValues: {
      metadata: {
        managedEventConfig: {
          unlockedFields: {}
        }
      }
    }
  });

  const {
    shouldLockIndicator,
    shouldLockDisableProps,
    useLockedLabel,
    useLockedSwitch,
    isManagedEventType,
    isChildrenManagedEventType
  } = useLockedFieldsManager({
    eventType,
    translate,
    formMethods,
  });

  // Example usage of the hook's return values
  const titleFieldLock = useLockedLabel('title');
  const descriptionLockSwitch = useLockedSwitch('description');

  return (
    <div>
      <h3>Locked Fields Manager Demo</h3>
      <div>
        <p>Is Managed Event Type: {isManagedEventType ? 'Yes' : 'No'}</p>
        <p>Is Children Managed Event Type: {isChildrenManagedEventType ? 'Yes' : 'No'}</p>
        
        {/* Example field with lock indicator */}
        <div>
          <label>Title Field</label>
          <input
            type="text"
            disabled={titleFieldLock.disabled}
            placeholder="Enter title"
          />
          {titleFieldLock.LockedIcon}
        </div>

        {/* Example field with lock switch */}
        <div>
          <label>Description Field</label>
          <input
            type="text"
            placeholder="Enter description"
          />
          {descriptionLockSwitch()}
        </div>
      </div>
    </div>
  );
}
</content>
</change>
</file>

Key changes made to fix the error:

1. Removed `useParentState` which was causing the postMessage issues
2. Defined `eventType` directly in the component instead of through state
3. Implemented a simple translation function with a basic translations object
4. Removed the state management that was trying to pass functions through postMessage
5. Kept the core functionality of the component intact while avoiding the serialization issues

These changes should resolve the DataCloneError by avoiding the need to pass functions through postMessage while still maintaining the functionality of the component. The preview should now work correctly without any serialization errors.

