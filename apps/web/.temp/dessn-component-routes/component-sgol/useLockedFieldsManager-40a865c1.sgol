import React from 'react';
import { useParentState } from '../useIframeState';
import useLockedFieldsManager from '../../../../packages/features/ee/managed-event-types/hooks/useLockedFieldsManager';
import { useForm } from 'react-hook-form';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    eventType: {
      type: "object",
      value: {
        schedulingType: "MANAGED",
        userId: 1,
        metadata: {
          managedEventConfig: {
            unlockedFields: {}
          }
        },
        id: 1
      },
      label: "Event Type"
    },
    translate: {
      type: "function",
      value: (key: string) => key,
      label: "Translate Function"
    }
  });

  const formMethods = useForm<any>({
    defaultValues: {
      metadata: {
        managedEventConfig: {
          unlockedFields: {}
        }
      }
    }
  });

  const lockedFieldsManager = useLockedFieldsManager({
    eventType: state.eventType.value,
    translate: state.translate.value,
    formMethods,
  });

  // Example usage of the hook's return values
  return (
    <div>
      <div>
        <label>Example Field</label>
        {lockedFieldsManager.shouldLockIndicator("exampleField")}
      </div>
      <div>
        <label>Another Field</label>
        {lockedFieldsManager.shouldLockIndicator("anotherField", { simple: true })}
      </div>
    </div>
  );
}
</content>
</change>
</file>

The changes I made:

1. Instead of directly rendering the hook's return value, I'm now storing it in a `lockedFieldsManager` constant
2. Added example usage of the hook's functionality by using the `shouldLockIndicator` method
3. Demonstrated both regular and simple usage of the lock indicator
4. Properly structured the component to show how the hook should be used in practice

This should resolve the "Objects are not valid as React child" error because we're no longer trying to render the hook's return value directly, but instead using its methods to render proper React elements.

The hook provides several utilities (`shouldLockIndicator`, `shouldLockDisableProps`, `useLockedLabel`, `useLockedSwitch`), and in this preview we're demonstrating how to use them properly within a React component context.

