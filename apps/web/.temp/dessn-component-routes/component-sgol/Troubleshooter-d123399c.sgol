<file path="apps/web/.temp/dessn-component-routes/Troubleshooter-d123399c.tsx">
  <change>
    <description>Mock calendar store state and add date range handling</description>
    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { Troubleshooter } from '../../../../packages/features/troubleshooter/Troubleshooter';

const getDateRange = (date: Date) => {
  // Get the start of the week (Sunday)
  const start = new Date(date);
  start.setDate(date.getDate() - date.getDay());
  start.setHours(0, 0, 0, 0);

  // Get the end of the week (Saturday)
  const end = new Date(start);
  end.setDate(start.getDate() + 6);
  end.setHours(23, 59, 59, 999);

  return { start, end };
};

export default function ComponentPreview() {
  // Create a stable date at the start of the current month
  const today = new Date();
  const currentDate = new Date(today.getFullYear(), today.getMonth(), today.getDate(), 12, 0, 0, 0);
  const { start: weekStart, end: weekEnd } = getDateRange(currentDate);
  
  const [state, setState] = useParentState({
    month: {
      type: "string",
      value: currentDate.toISOString().slice(0, 7),
      label: "Month (YYYY-MM)",
    },
    selectedDate: {
      type: "string",
      value: currentDate.toISOString().slice(0, 10),
      label: "Selected Date",
    },
  });

  // Create a stable date object for the selected date
  const selectedDate = React.useMemo(() => {
    if (!state.selectedDate.value) return undefined;
    try {
      const [year, month, day] = state.selectedDate.value.split('-').map(Number);
      return new Date(year, month - 1, day, 12, 0, 0, 0);
    } catch {
      return undefined;
    }
  }, [state.selectedDate.value]);

  // Mock the calendar store initial state
  const calendarState = {
    startDate: weekStart,
    endDate: weekEnd,
    selectedDate,
    month: state.month.value,
    startHour: 0,
    endHour: 23,
    gridCellsPerHour: 4,
    hideHeader: false,
    availableTimeslots: [],
    events: [],
    isLoading: false,
    timezone: "UTC",
    initState: () => {},
    onDateSelect: () => {},
    onMonthChange: () => {},
  };

  // Try to initialize the calendar store
  React.useEffect(() => {
    try {
      // @ts-ignore - Attempting to set initial calendar state
      window.calendarStore = {
        getState: () => calendarState,
        setState: () => {},
        subscribe: () => () => {},
      };
    } catch (e) {
      console.error("Failed to initialize calendar store:", e);
    }
  }, [calendarState]);

  return (
    <div className="min-h-screen bg-white">
      <Troubleshooter
        {...calendarState}
      />
    </div>
  );
}
</content>
  </change>
</file>

