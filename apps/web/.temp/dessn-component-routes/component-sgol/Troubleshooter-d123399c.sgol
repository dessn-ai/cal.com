import React from 'react';
import { useParentState } from '../useIframeState';
import { Troubleshooter } from '../../../../packages/features/troubleshooter/Troubleshooter';

export default function ComponentPreview() {
  // Get the current date and ensure it's valid
  const today = new Date();
  const startOfDay = new Date(today.getFullYear(), today.getMonth(), today.getDate());

  const [state, setState] = useParentState({
    month: {
      type: "string",
      value: startOfDay.toISOString().slice(0, 7),
      label: "Month (YYYY-MM)",
    },
    selectedDate: {
      type: "string",
      value: startOfDay.toISOString().slice(0, 10),
      label: "Selected Date",
    },
  });

  // Safely create date object with error handling
  const getSelectedDate = () => {
    try {
      if (!state.selectedDate.value) return undefined;
      const date = new Date(state.selectedDate.value);
      // Check if date is valid
      return isNaN(date.getTime()) ? undefined : date;
    } catch {
      return undefined;
    }
  };

  return (
    <Troubleshooter
      month={state.month.value}
      selectedDate={getSelectedDate()}
    />
  );
}
</content>
  </change>
</file>

The changes I made:

1. Created a proper `startOfDay` date object that ensures we have a valid date at midnight (removing any time component that might cause issues)
2. Used this validated date for both the month and selectedDate initial values
3. Added a `getSelectedDate` helper function that:
   - Safely handles date conversion
   - Includes error checking for invalid dates
   - Returns undefined if the date is invalid
4. Added try-catch block to handle any potential date parsing errors
5. Used the safe date getter in the component props

This should resolve the "Invalid time value" error by ensuring we're always working with valid dates or undefined values when the dates are invalid.

