import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/app-store/closecom/components/EventTypeAppCardInterface';

// Mock the required hooks directly
const MockAppContext = React.createContext({});

// Mock the hooks by overriding the modules
const mockUseIsAppEnabled = () => ({
  enabled: true,
  updateEnabled: (value: boolean) => console.log('Update enabled:', value),
});

const mockUsePathname = () => '/settings/my-apps';

// Override the imports that the component uses
import('@calcom/app-store/_utils/useIsAppEnabled').then(module => {
  Object.defineProperty(module, 'default', { value: mockUseIsAppEnabled });
});

import('next/navigation').then(module => {
  Object.defineProperty(module, 'usePathname', { value: mockUsePathname });
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    eventType: {
      type: "object",
      value: {
        id: 1,
        title: "Sample Event Type",
        description: "This is a sample event type description",
        teamId: null,
        length: 30,
        recurringEvent: null,
        seatsPerTimeSlot: null,
        team: null,
        schedulingType: "COLLECTIVE",
        URL: "https://example.com/event-type",
        appIds: ["closecom"]
      },
      label: "Event Type"
    },
    app: {
      type: "object",
      value: {
        name: "Close.com",
        description: "Close.com integration",
        installed: true,
        type: "closecom_other_calendar",
        variant: "other_calendar",
        key: "closecom",
        credentialOwner: {
          name: "John Doe",
          avatar: "https://example.com/avatar.jpg"
        },
        credentialIds: [1, 2, 3],
        enabled: true,
        features: ["calendar"]
      },
      label: "App"
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled"
    }
  });

  try {
    return (
      <MockAppContext.Provider value={{}}>
        <ImportedComponent
          eventType={state.eventType.value}
          app={state.app.value}
          disabled={state.disabled.value}
        />
      </MockAppContext.Provider>
    );
  } catch (error) {
    console.error('Render error:', error);
    return <div>Error rendering component: {error.message}</div>;
  }
}
</content>
