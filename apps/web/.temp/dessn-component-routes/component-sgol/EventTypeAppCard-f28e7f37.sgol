import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/app-store/closecom/components/EventTypeAppCardInterface';

// Mock the modules at the top level
React.createContext = ((defaultValue) => ({
  Provider: ({ children }) => children,
  Consumer: ({ children }) => children(defaultValue),
})) as any;

// Create a HOC to provide mock hooks
const withMockHooks = (WrappedComponent: React.ComponentType<any>) => {
  return (props: any) => {
    // Mock the hooks that the component uses
    (window as any).useIsAppEnabled = () => ({
      enabled: true,
      updateEnabled: (value: boolean) => console.log('Update enabled:', value)
    });

    (window as any).usePathname = () => '/settings/my-apps';

    return <WrappedComponent {...props} />;
  };
};

const WrappedComponent = withMockHooks(ImportedComponent);

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    eventType: {
      type: "object",
      value: {
        id: 1,
        title: "Sample Event Type",
        description: "This is a sample event type description",
        teamId: null,
        length: 30,
        recurringEvent: null,
        seatsPerTimeSlot: null,
        team: null,
        schedulingType: "COLLECTIVE",
        URL: "https://example.com/event-type",
        appIds: ["closecom"]
      },
      label: "Event Type"
    },
    app: {
      type: "object",
      value: {
        name: "Close.com",
        description: "Close.com integration",
        installed: true,
        type: "closecom_other_calendar",
        variant: "other_calendar",
        key: "closecom",
        credentialOwner: {
          name: "John Doe",
          avatar: "https://example.com/avatar.jpg"
        },
        credentialIds: [1, 2, 3],
        enabled: true,
        features: ["calendar"]
      },
      label: "App"
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled"
    }
  });

  try {
    return (
      <WrappedComponent
        eventType={state.eventType.value}
        app={state.app.value}
        disabled={state.disabled.value}
      />
    );
  } catch (error) {
    console.error('Render error:', error);
    return <div>Error rendering component</div>;
  }
}
</content>
  </change>
</file>

