import React, { useEffect } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../lib/app-providers-app-dir';
import { ReactElement, JSXElementConstructor } from 'react';
import { I18nextProvider } from 'react-i18next';
import i18next from 'i18next';

// Initialize i18next
i18next.init({
  lng: 'en',
  resources: {
    en: {
      common: {}
    }
  },
  defaultNS: 'common',
  fallbackLng: 'en'
});

// Define window type augmentation
declare global {
  interface Window {
    getEmbedNamespace?: () => string | null;
    getEmbedTheme?: () => string | null;
    calNewLocale?: string | null;
  }
}

// Set up window functions immediately
if (typeof window !== 'undefined') {
  // Define the functions directly on window
  window.getEmbedNamespace = function() { return null; };
  window.getEmbedTheme = function() { return null; };
  window.calNewLocale = null;
  
  // Ensure the document lang is set
  document.documentElement.lang = 'en';
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    getLayout: {
      type: 'string',
