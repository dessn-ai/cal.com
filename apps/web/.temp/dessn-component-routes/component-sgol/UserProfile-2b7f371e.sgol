import ImportedComponent from '../../components/getting-started/steps-views/UserProfile';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { createTRPCReact, httpBatchLink } from '@trpc/react-query';
import { FormProvider, useForm } from "react-hook-form";
import { Provider as JotaiProvider } from "jotai";

// Create a new QueryClient instance
const queryClient = new QueryClient();

// Create a mock TRPC client
const mockTrpcClient = {
  viewer: {
    me: {
      useSuspenseQuery: () => [{
        id: 1,
        name: "John Doe",
        email: "john@example.com",
        avatar: "https://example.com/avatar.jpg",
        bio: "I'm a software developer"
      }],
    },
    eventTypes: {
      list: {
        useQuery: () => ({
          data: [
            { id: 1, title: "15min Meeting", slug: "15min", length: 15 },
            { id: 2, title: "30min Meeting", slug: "30min", length: 30 },
          ]
        }),
      },
      create: {
        useMutation: () => ({
          mutate: async () => {},
          isLoading: false,
        }),
      }
    },
    updateProfile: {
      useMutation: () => ({
        mutate: async () => {},
        isPending: false,
      }),
    },
  },
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    user: {
      type: "string",
      value: JSON.stringify({
        id: 1,
        name: "John Doe",
        email: "john@example.com",
        avatar: "https://example.com/avatar.jpg",
        bio: "I'm a software developer",
      }),
      label: "User Data",
    },
    eventTypes: {
      type: "string",
      value: JSON.stringify([
        { id: 1, title: "15min Meeting", slug: "15min", length: 15 },
        { id: 2, title: "30min Meeting", slug: "30min", length: 30 },
      ]),
      label: "Event Types",
    },
  });

  // Create a form context
  const methods = useForm();

  return (
    <JotaiProvider>
      <QueryClientProvider client={queryClient}>
        <FormProvider {...methods}>
          <div className="w-full">
            <ImportedComponent />
          </div>
        </FormProvider>
      </QueryClientProvider>
    </JotaiProvider>
  );
}
</content>
