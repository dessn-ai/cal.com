      eventTypes: {
        create: {
          useMutation: () => ({
            mutate: () => {},
          }),
        },
      },
    },
    useUtils: () => ({
      viewer: {
        me: {
          refetch: async () => {},
        },
      },
    }),
  };

  return (
    <trpc.Provider client={mockTrpc as any}>
      <ImportedComponent />
    </trpc.Provider>
  );
}
