    location: 'Online',
    description: null,
    status: 'ACCEPTED',
  };

  const baseAttendeeData = {
    name: 'Attendee',
    email: 'attendee@example.com',
    timeZone: 'UTC',
    language: { translate, locale: 'en' },
    timeFormat: TimeFormat.TWELVE_HOUR,
  };

  const [state, setState] = useParentState({
    calEvent: {
      type: 'string',
      value: JSON.stringify(baseEventData),
      label: 'Calendar Event',
