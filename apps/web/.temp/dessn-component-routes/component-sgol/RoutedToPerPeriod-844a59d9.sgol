import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { RoutedToPerPeriod } from '../../../../packages/features/insights/components/RoutedToPerPeriod';
import { useForm } from 'react-hook-form';

// Create a mock context with the same shape as the original
const InsightsOrgTeamsContext = createContext({
  teams: [
    {
      id: 1,
      name: "Team 1",
      slug: "team-1",
    }
  ],
  currentTeam: {
    id: 1,
    name: "Team 1",
    slug: "team-1",
  },
  setCurrentTeam: () => {},
});

// Create a mock hook that matches the original
export const useInsightsOrgTeams = () => {
  return useContext(InsightsOrgTeamsContext);
};

// Mock provider component
const MockInsightsOrgTeamsProvider = ({ children }) => {
  const value = {
    teams: [
      {
        id: 1,
        name: "Team 1",
        slug: "team-1",
      }
    ],
    currentTeam: {
      id: 1,
      name: "Team 1",
      slug: "team-1",
    },
    setCurrentTeam: () => {},
  };

  return (
    <InsightsOrgTeamsContext.Provider value={value}>
      {children}
    </InsightsOrgTeamsContext.Provider>
  );
};

// Mock the hook module
jest.mock('../../../../packages/features/insights/hooks/useInsightsOrgTeams', () => ({
  useInsightsOrgTeams: () => useContext(InsightsOrgTeamsContext)
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    userId: {
      type: "number",
      value: 1,
      label: "User ID",
    },
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
    startDate: {
      type: "string",
