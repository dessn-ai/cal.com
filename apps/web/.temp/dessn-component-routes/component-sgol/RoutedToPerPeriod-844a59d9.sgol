      label: "Start Date",
    },
    endDate: {
      type: "string",
      value: new Date().toISOString().split('T')[0],
      label: "End Date",
    },
    isAll: {
      type: "boolean",
      value: false,
      label: "Is All",
    },
    routingFormId: {
      type: "string",
      value: "form-123",
      label: "Routing Form ID",
    },
  });

  const methods = useForm();

  return (
    <MockInsightsOrgTeamsProvider>
      <RoutedToPerPeriod />
    </MockInsightsOrgTeamsProvider>
