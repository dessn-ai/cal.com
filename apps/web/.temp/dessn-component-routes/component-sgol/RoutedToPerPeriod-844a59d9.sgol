        membership: {
          accepted: true,
          role: "ADMIN",
        },
      }
    ],
    currentTeamId: 1,
    currentTeam: {
      id: 1,
      name: "Team 1",
      slug: "team-1",
      membership: {
        accepted: true,
        role: "ADMIN",
      },
