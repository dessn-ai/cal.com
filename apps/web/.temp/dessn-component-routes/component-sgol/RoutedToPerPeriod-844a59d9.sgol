    isError: false,
    status: "success",
    data: {
      teams: [
        {
          id: 1,
          name: "Team 1",
          slug: "team-1",
          membership: {
            accepted: true,
            role: "ADMIN",
          },
        }
      ]
    }
  };

  try {
    return (
      <InsightsOrgTeamsProvider defaultValue={mockTeamsData}>
