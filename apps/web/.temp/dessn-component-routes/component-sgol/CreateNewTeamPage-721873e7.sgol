import React from "react";
import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
import { useParentState } from "../useIframeState";
import ImportedComponent from "@calcom/features/bookings/components/IncompleteBookingPage";
import { I18nextAdapter } from "@calcom/web/lib/i18n";
import { trpc } from "@calcom/trpc/react";
import { EmbedDialogProvider } from "@calcom/features/embed/lib/hooks/useEmbedDialogCtx";
import { FormActionsProvider } from "@calcom/app-store/routing-forms/components/FormActions";
import { SchedulingType } from "./mocks/prisma-client";

const queryClient = new QueryClient();
const defaultOrgBranding = {
  logo: "",
  brandColor: "#292929",
  darkBrandColor: "#fafafa",
  theme: null,
  backgroundImage: null,
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    booking: {
      type: "object",
      value: {
        id: 123,
        uid: "abc123",
        title: "Test Booking",
        description: "Test Description",
        startTime: new Date().toISOString(),
        endTime: new Date(Date.now() + 3600000).toISOString(),
        attendees: [],
        user: {
          id: 1,
          name: "Test User",
          email: "test@example.com",
        },
        status: "PENDING",
      },
      label: "Booking",
    },
  });

  return (
    <QueryClientProvider client={queryClient}>
      <trpc.Provider client={queryClient}>
        <I18nextAdapter>
          <EmbedDialogProvider>
            <FormActionsProvider>
              <ImportedComponent
                booking={state.booking.value}
              />
            </FormActionsProvider>
          </EmbedDialogProvider>
        </I18nextAdapter>
      </trpc.Provider>
    </QueryClientProvider>
  );
}
</content>
