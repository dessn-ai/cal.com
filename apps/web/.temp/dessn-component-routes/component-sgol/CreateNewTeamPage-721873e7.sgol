      role: "OWNER",
      theme: null,
      brandColor: "#292929",
      darkBrandColor: "#fafafa",
      logo: "",
      logoUrl: "",
    }
  };

  return (
    <OrgBrandingProvider value={mockOrgBranding}>
      <WizardLayout currentStep={1} maxSteps={3}>
        <ImportedComponent />
      </WizardLayout>
    </OrgBrandingProvider>
  );
}
