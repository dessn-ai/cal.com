import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/(use-page-wrapper)/settings/(settings-layout)/layout';
import { SessionProvider } from "next-auth/react";
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Mock TRPC Provider
const MockTRPCProvider = ({ children }) => {
  return children;
};

// Mock Feature Provider
const MockFeatureProvider = ({ children }) => {
  return children;
};

// Create a client
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

// Mock crypto for browser environment
if (typeof window !== 'undefined' && !window.crypto) {
  window.crypto = {
    getRandomValues: function(buffer) {
      return crypto.getRandomValues(buffer);
    },
    subtle: crypto.subtle
  };
}

// Error boundary to catch crypto-related errors
class CryptoErrorBoundary extends React.Component {
  constructor(props) {
    super(props);
    this.state = { hasError: false };
  }

  static getDerivedStateFromError(error) {
    return { hasError: true };
  }

  render() {
    if (this.state.hasError) {
      return this.props.fallback || <div>Something went wrong.</div>;
    }

    return this.props.children;
  }
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    children: {
      type: "string",
      value: "<div>Sample Content</div>",
      label: "Children",
    },
    containerClassName: {
      type: "string",
      value: "container-class",
      label: "Container Class Name",
    },
  });

  return (
    <QueryClientProvider client={queryClient}>
      <SessionProvider>
        <MockTRPCProvider>
          <MockFeatureProvider>
            <CryptoErrorBoundary>
              <ImportedComponent
                children={<div dangerouslySetInnerHTML={{ __html: state.children.value }} />}
                containerClassName={state.containerClassName.value}
              />
            </CryptoErrorBoundary>
          </MockFeatureProvider>
        </MockTRPCProvider>
      </SessionProvider>
    </QueryClientProvider>
  );
}
</content>
</change>
</file>

I've made the following changes:

1. Added a mock TRPCProvider component that simply renders its children
2. Added QueryClientProvider from @tanstack/react-query which is typically required for TRPC
3. Added SessionProvider from next-auth/react
4. Added a mock FeatureProvider
5. Wrapped the ImportedComponent with all necessary providers in the correct order
6. Created a QueryClient instance with some sensible default options

This should resolve the TRPC provider error and provide the necessary context for the component to render properly. The mock providers will allow the component to render without the actual implementation of these services.

If you encounter any other missing provider errors, we can add more mock providers as needed. Let me know if you need any adjustments or if you encounter any other issues.

