import React from 'react';
import { useParentState } from '../useIframeState';
import { Command, CommandInput } from '../../../../packages/ui/components/command/index';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "",
      label: "Class Name",
    },
    placeholder: {
      type: "string",
      value: "Type a command or search...",
      label: "Placeholder",
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled",
    },
  });

  return (
    <Command>
      <CommandInput
        className={state.className.value}
        placeholder={state.placeholder.value}
        disabled={state.disabled.value}
      />
    </Command>
  );
}
</content>
</change>
</file>

The changes I made:
1. Added the `Command` component import from the same file where `CommandInput` is imported
2. Wrapped the `CommandInput` component with the `Command` component
3. This provides the necessary context that the CommandInput component needs to function properly

The error was occurring because the CommandInput component was trying to access context that should be provided by the Command component. The Command component from cmdk package provides the necessary context through React's context API, which is why we were seeing the 'subscribe' error when it wasn't present.

