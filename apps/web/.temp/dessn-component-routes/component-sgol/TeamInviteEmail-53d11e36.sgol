import React from 'react';
import { useParentState } from '../useIframeState';
import { TeamInviteEmail } from '../../../../packages/emails/src/templates/TeamInviteEmail';
import { I18nextProvider } from 'react-i18next';
import i18next from 'i18next';

// Create a mock context for Prisma
const PrismaMockContext = React.createContext({
  validator: { validate: () => true }
});

// Create a provider component
const PrismaMockProvider = ({ children }) => {
  const mockPrisma = {
    validator: { validate: () => true }
  };

  return (
    <PrismaMockContext.Provider value={mockPrisma}>
      {children}
    </PrismaMockContext.Provider>
  );
};

// Mock the actual Prisma module
const mockPrismaModule = {
  default: { validator: { validate: () => true } }
};

// Override the module import
if (typeof window !== 'undefined') {
  window.__vite__resolveModule = function(id) {
    if (id.includes('@calcom/prisma')) {
      return mockPrismaModule;
    }
  };
}

// Initialize i18next
i18next.init({
  lng: 'en',
  resources: {
    en: {
      translation: {
        'email_team_invite|heading|invited_to_regular_team': 'Invited to team',
        'email_team_invite|content|invited_to_regular_team': 'You have been invited to join the team',
        'email_no_user_signoff': 'Best regards, {appName}',
        'have_any_questions': 'Have any questions?',
        'contact': 'Contact',
        'our_support_team': 'our support team',
        'create_your_account': 'Create your account',
        'email_user_cta': 'Join team',
        'login': 'Login'
      }
    }
  }
});

// Constants
const APP_NAME = 'Cal.com';
const WEBAPP_URL = 'http://localhost:3000';
const IS_PRODUCTION = false;

// Mock components
const V2BaseEmailHtml = ({ children, subject }) => (
  <div className="email-wrapper">
    <h2>{subject}</h2>
    {children}
  </div>
);

const CallToAction = ({ label, href }) => (
  <a href={href} style={{ 
    padding: '10px 20px',
    background: '#000',
    color: '#fff',
    textDecoration: 'none',
    borderRadius: '5px',
    display: 'inline-block'
  }}>
    {label}
  </a>
);

// Wrap the TeamInviteEmail component to handle Prisma dependency
const TeamInviteEmailWrapper = (props) => {
  try {
    return <TeamInviteEmail {...props} />;
  } catch (error) {
    console.error('Error in TeamInviteEmail:', error);
    return (
      <div style={{ color: 'red', padding: '20px' }}>
        Error rendering email template: {error.message}
      </div>
    );
  }
};

