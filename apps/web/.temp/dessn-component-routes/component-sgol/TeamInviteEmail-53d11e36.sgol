// Mock Prisma module before imports
const prisma = {
  validator: { validate: () => true },
  user: { findFirst: () => null },
  team: { findFirst: () => null }
};

// Mock the module
window.__vite__module__['@calcom/prisma'] = { prisma };
window.__vite__module__['@calcom/lib/constants'] = {
  IS_PRODUCTION: false,
  WEBAPP_URL: 'http://localhost:3000',
  APP_NAME: 'Cal.com'
};

