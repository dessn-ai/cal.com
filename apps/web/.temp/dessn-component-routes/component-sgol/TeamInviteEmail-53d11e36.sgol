    },
    isCalcomMember: {
      type: "boolean",
      value: false,
      label: "Is Calcom Member",
    },
    isAutoJoin: {
      type: "boolean",
      value: false,
      label: "Is Auto Join",
    },
    isOrg: {
      type: "boolean",
      value: false,
      label: "Is Organization",
    },
