// Mock the Prisma module directly
const mockValidator = { validate: () => true };
window.mockPrismaModule = { validator: mockValidator, prisma: { validator: mockValidator } };

// Intercept the module resolution
const originalDefineProperty = Object.defineProperty;
Object.defineProperty = function(obj, prop, descriptor) {
  if (prop === '__esModule' && descriptor.value === true) {
    const currentStack = new Error().stack || '';
    if (currentStack.includes('@calcom/prisma')) {
      return originalDefineProperty(obj, prop, {
        ...descriptor,
        get: () => window.mockPrismaModule
      });
    }
  }
  return originalDefineProperty(obj, prop, descriptor);
};

