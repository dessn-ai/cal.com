import React from 'react';
import { useParentState } from '../useIframeState';
import { UpgradeTeamsBadge } from '../../../../packages/ui/components/badge/UpgradeTeamsBadge';

// Mock modules directly
const mockLink = ({ children }: { children: React.ReactNode }) => <>{children}</>;
mockLink.displayName = 'Link';

// Mock the necessary context/providers
const MockProviders = ({ children }: { children: React.ReactNode }) => {
  return children;
};

// Override the imports that the component uses
import('@calcom/lib/hooks/useLocale').then((module) => {
  Object.defineProperty(module, 'useLocale', {
    value: () => ({
      t: (key: string) => key,
    }),
    writable: true,
  });
});

import('@calcom/lib/hooks/useHasPaidPlan').then((module) => {
  Object.defineProperty(module, 'useHasPaidPlan', {
    value: () => ({
      hasPaidPlan: false,
    }),
    writable: true,
  });
});

import('next/link').then((module) => {
  Object.defineProperty(module, 'default', {
    value: mockLink,
    writable: true,
  });
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to control for this component
  });

  return (
    <MockProviders>
      <UpgradeTeamsBadge />
    </MockProviders>
  );
}
</content>
  </change>
</file>

I've made the following changes:
1. Removed all Jest-related mocking (`jest.mock`) since Jest is not available in the preview environment
2. Replaced it with direct module mocking using dynamic imports and `Object.defineProperty`
3. Added a `MockProviders` component to wrap the preview component
4. Kept the same mock implementations but restructured how they're provided
5. Maintained the same functionality but in a way that works in a browser environment

This should resolve the "jest is not defined" error while still providing the necessary mocked functionality for the component to render properly.

