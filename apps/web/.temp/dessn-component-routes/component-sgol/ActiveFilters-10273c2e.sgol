<description>Create a mock version of both the ActiveFilters component and the DataTable context</description>
<content>
import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import type { Table } from '@tanstack/react-table';

// Create a mock context with the minimum required properties
const DataTableContext = createContext<{
  activeFilters: Array<{ f: string }>;
  setActiveFilters: (filters: Array<{ f: string }>) => void;
}>({
  activeFilters: [],
  setActiveFilters: () => {},
});

// Create a mock provider component
function DataTableProvider({ children }: { children: React.ReactNode }) {
  const value = {
    activeFilters: [{ f: 'mockFilter' }],
    setActiveFilters: () => {},
  };

  return (
    <DataTableContext.Provider value={value}>
      {children}
    </DataTableContext.Provider>
  );
}

// Mock the useDataTable hook
const useDataTable = () => {
  return useContext(DataTableContext);
};

// Mock the useFilterableColumns hook
const useFilterableColumns = (table: Table<any>) => {
  return [{
    id: 'mockFilter',
    label: 'Mock Filter'
  }];
};

// Mock the ActiveFilters component
function MockActiveFilters({ table }: { table: Table<any> }) {
  const { activeFilters } = useDataTable();
  const filterableColumns = useFilterableColumns(table);

  return (
    <div>
      {activeFilters.map((filter) => {
        const column = filterableColumns.find((col) => col.id === filter.f);
        if (!column) return null;
        return (
          <div key={column.id}>
            Filter: {column.label}
          </div>
        );
      })}
    </div>
  );
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    table: {
      type: 'object',
      value: {} as Table<any>,
      label: 'Table',
    },
  });

  return (
    <DataTableProvider>
      <MockActiveFilters table={state.table.value} />
    </DataTableProvider>
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Created a fully mocked version of the ActiveFilters component (MockActiveFilters)
2. Added proper TypeScript types for the context and components
3. Provided mock data for activeFilters and filterableColumns
4. Removed the import of the actual ActiveFilters component and replaced it with our mock version
5. Added proper typing for the Table generic from @tanstack/react-table
6. Created mock implementations of both useDataTable and useFilterableColumns hooks

This approach should work because:
1. We're no longer depending on the external DataTableProvider
2. All the required functionality is mocked locally
3. The component will render with mock data
4. We maintain the same interface but with local implementations

The mock component will display a simple representation of the filters, which should be sufficient for preview purposes. This should resolve the context error since we're now using our local context implementation instead of trying to access the external one.

