const MockOrgBrandingProvider = ({ children }) => {
  const value = {
    organization: {
      id: 1,
      slug: "test-org",
      name: "Test Organization",
      logoUrl: null,
      brandColor: "#292929",
      darkBrandColor: "#fafafa",
      theme: null,
    },
    isLoading: false,
  };

  return (
    <MockOrgContext.Provider value={value}>
      {children}
    </MockOrgContext.Provider>
  );
};

// Override the useOrgBranding hook
React.createContext = () => MockOrgContext;

