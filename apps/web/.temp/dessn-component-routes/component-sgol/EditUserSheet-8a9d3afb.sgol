    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { EditUserSheet } from '../../../../packages/features/users/components/UserTable/EditSheet/EditUserSheet';

// Create a mock context with default values
const OrgBrandingContext = React.createContext({
  theme: null,
  brandColor: "#292929",
  darkBrandColor: "#fafafa",
  logo: null,
  name: "Test Organization",
  slug: "test-org",
  hideBranding: false
});

// Create a mock provider component
const MockOrgBrandingProvider = ({ children }) => {
  const value = {
    theme: null,
    brandColor: "#292929",
    darkBrandColor: "#fafafa",
    logo: null,
    name: "Test Organization",
    slug: "test-org",
    hideBranding: false
  };

  return (
    <OrgBrandingContext.Provider value={value}>
      {children}
    </OrgBrandingContext.Provider>
  );
};

// Override the original hook
const useOrgBranding = () => React.useContext(OrgBrandingContext);

// Mock the module
React.createContext.__defineGetter__('useOrgBranding', () => useOrgBranding);

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    editSheet: {
      type: "object",
      value: {
        showModal: true,
        user: {
          id: 1,
          username: "johndoe",
          email: "john@example.com",
          timeZone: "America/New_York",
          role: "MEMBER",
          avatarUrl: null,
          accepted: true,
          disableImpersonation: false,
          completedOnboarding: true,
          lastActiveAt: new Date().toISOString(),
          teams: [
            { id: 1, name: "Team A", slug: "team-a" },
            { id: 2, name: "Team B", slug: "team-b" }
          ],
          attributes: [
            {
              id: "1",
              attributeId: "attr1",
              value: "Value 1",
              slug: "value-1",
              weight: 1,
              contains: ["value1"]
            }
          ]
        }
      },
      label: "Edit Sheet State"
    }
  });

  const mockDispatch = React.useCallback(() => {
    console.log("Dispatch called");
  }, []);

  return (
    <MockOrgBrandingProvider>
      <EditUserSheet
        state={{
          changeMemberRole: { showModal: false },
          deleteMember: { showModal: false },
          impersonateMember: { showModal: false },
          inviteMember: { showModal: false },
          editSheet: state.editSheet.value
        }}
        dispatch={mockDispatch}
      />
    </MockOrgBrandingProvider>
  );
}
</content>
