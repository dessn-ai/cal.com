      value: "team@example.com",
      label: "Team Member Email",
    },
    crmOwnerRecordType: {
      type: "string",
      value: "default",
      label: "CRM Owner Record Type",
    },
    crmAppSlug: {
      type: "string",
      value: "crm-app",
      label: "CRM App Slug",
    },
  });

  const mockBooking = {};
  const mockEventData = {
    entity: {},
    eventTypeId: 1,
    metadata: {
      multipleDuration: [30, 60, 90],
