import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../modules/settings/admin/impersonation-view';

// Mock the required dependencies
const mockUseLocale = () => ({
  t: (key: string) => key,
});

// Mock the constants
const WEBAPP_URL = 'http://localhost:3000';
const NEXT_PUBLIC_WEBSITE_URL = 'http://localhost:3000';

// Mock the components
const MockTextField = React.forwardRef((props: any, ref) => (
  <input ref={ref} {...props} className={props.containerClassName} />
));

const MockButton = (props: any) => (
  <button {...props} />
);

// Mock the modules
jest.mock('@calcom/lib/hooks/useLocale', () => ({
  useLocale: mockUseLocale,
}));

jest.mock('@calcom/lib/constants', () => ({
  WEBAPP_URL,
}));

jest.mock('@calcom/ui', () => ({
  Button: MockButton,
  TextField: MockTextField,
}));

export default function ComponentPreview() {
  const [state] = useParentState({
    username: {
      type: "string",
      value: "johndoe",
      label: "Username",
