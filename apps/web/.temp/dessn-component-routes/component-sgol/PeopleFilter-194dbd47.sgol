import React from 'react';
import { useParentState } from '../useIframeState';
import { PeopleFilter } from '../../../../packages/features/bookings/components/PeopleFilter';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { httpBatchLink } from '@trpc/client';
import { createTRPCReact } from '@trpc/react-query';
import superjson from 'superjson';

// Create a new QueryClient instance
const queryClient = new QueryClient();

// Create a mock trpc client
const trpc = createTRPCReact();
const trpcClient = trpc.createClient({
  links: [
    httpBatchLink({
      url: '/api/trpc',
    }),
  ],
  transformer: superjson,
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to set for this component
  });

  return (
    <trpc.Provider client={trpcClient} queryClient={queryClient}>
      <QueryClientProvider client={queryClient}>
        <PeopleFilter />
      </QueryClientProvider>
    </trpc.Provider>
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Removed the incorrect TRPCProvider import
2. Added proper imports for React Query and TRPC
3. Created a QueryClient instance
4. Set up a mock TRPC client with basic configuration
5. Wrapped the component with the correct provider structure using trpc.Provider and QueryClientProvider

This setup should resolve the TRPCProvider error and provide the necessary context for the PeopleFilter component to work. The mock TRPC client setup will allow the component to render in the preview environment, though actual API calls may not work without proper backend configuration.

