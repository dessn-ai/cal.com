import React from 'react';
import { useParentState } from '../useIframeState';
import { PeopleFilter } from '../../../../packages/features/bookings/components/PeopleFilter';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Create a new QueryClient instance
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to set for this component
  });

  return (
    <QueryClientProvider client={queryClient}>
      <div className="w-full">
        <PeopleFilter />
      </div>
    </QueryClientProvider>
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Removed the TRPC-specific code since it's causing issues in the preview environment
2. Kept the QueryClientProvider as it might be needed by the PeopleFilter component
3. Created a single QueryClient instance outside the component to prevent recreation on renders
4. Added a wrapper div with full width to ensure proper layout
5. Simplified the overall setup to focus on just rendering the PeopleFilter component

This should resolve the error by removing the problematic TRPC initialization while still maintaining the necessary context for the component to render. If the PeopleFilter component requires specific TRPC functionality, we might need to mock those specific functions, but let's first see if this simpler setup works.

