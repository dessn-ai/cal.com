import React from 'react';
import { useForm, FormProvider } from 'react-hook-form';
import { useParentState } from '../useIframeState';
import { EventInstantTab } from '../../../../packages/features/eventtypes/components/tabs/instant/EventInstantTab';

export default function ComponentPreview() {
  const methods = useForm({
    defaultValues: {
      // Add any form default values needed
      instant: false,
      requiresConfirmation: true,
    }
  });

  const [state, setState] = useParentState({
    eventType: {
      type: "string",
      value: JSON.stringify({
        id: 1,
        title: "Sample Event",
        slug: "sample-event",
        metadata: {},
      }),
      label: "Event Type",
    },
    isTeamEvent: {
      type: "boolean",
      value: false,
      label: "Is Team Event",
    },
  });

  const eventType = JSON.parse(state.eventType.value);

  return (
    <FormProvider {...methods}>
      <EventInstantTab
        eventType={eventType}
        isTeamEvent={state.isTeamEvent.value}
      />
    </FormProvider>
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Added imports for `useForm` and `FormProvider` from react-hook-form
2. Created a form instance using `useForm` with some default values
3. Wrapped the `EventInstantTab` component with `FormProvider` and spread the form methods

This should resolve the error as the form context will now be available to all child components, including the `InstantEventController` that was trying to access `getValues`.

