<file path="apps/web/.temp/dessn-component-routes/AdminOrgTable-bd0a7fbc.tsx">
<change>
<description>Fix TRPC provider setup and improve mocking</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/ee/organizations/pages/settings/admin/AdminOrgPage';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { httpBatchLink } from '@trpc/client';
import { createTRPCReact } from '@trpc/react-query';

// Create a mock TRPC instance
const mockTrpc = createTRPCReact<any>();

// Create a mock client
const queryClient = new QueryClient();
const mockClient = mockTrpc.createClient({
  links: [
    httpBatchLink({
      url: 'http://localhost:3000/api/trpc',
    }),
  ],
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    mockData: {
      type: "string",
      value: JSON.stringify([
        {
          id: 1,
          name: "Sample Organization",
          slug: "sample-org",
          members: [{ user: { email: "user@example.com" } }],
          organizationSettings: {
            isAdminReviewed: false,
            isOrganizationConfigured: false,
            isAdminAPIEnabled: false,
          },
          metadata: { requestedSlug: "sample-org" },
        },
      ]),
      label: "Mock Data",
    },
  });

  // Mock the TRPC hooks
  mockTrpc.useContext = () => ({
    viewer: {
      organizations: {
        adminGetAll: {
          invalidate: async () => {},
        },
        adminGet: {
          invalidate: async () => {},
          refetch: async () => {},
        },
      },
    },
  });

  mockTrpc.viewer.organizations.adminGetAll.useSuspenseQuery = () => [JSON.parse(state.mockData.value)];
  mockTrpc.viewer.organizations.adminUpdate.useMutation = () => ({
    mutate: async () => {},
  });
  mockTrpc.viewer.organizations.adminDelete.useMutation = () => ({
    mutate: async () => {},
  });

  return (
    <QueryClientProvider client={queryClient}>
      <mockTrpc.Provider client={mockClient}>
        <ImportedComponent />
      </mockTrpc.Provider>
    </QueryClientProvider>
  );
}
</content>
</change>
</file>

The changes made include:

1. Added proper imports for React Query and TRPC
2. Created a proper TRPC instance using `createTRPCReact`
3. Set up a QueryClient and mock TRPC client
4. Wrapped the component with both QueryClientProvider and TRPC Provider
5. Improved the mocking of TRPC hooks and methods
6. Properly structured the provider hierarchy

This should resolve the "ctor is not a constructor" error by providing a proper TRPC setup with the necessary providers and client configuration. The mock data and functionality remain the same, but the implementation is now more structurally correct.

