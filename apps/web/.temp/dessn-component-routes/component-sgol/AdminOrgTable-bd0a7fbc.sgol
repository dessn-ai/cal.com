import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/ee/organizations/pages/settings/admin/AdminOrgPage';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { httpBatchLink } from '@trpc/client';
import { createTRPCReact } from '@trpc/react-query';

// Create a mock TRPC instance
const mockTrpc = createTRPCReact<any>();

// Create a mock client
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      refetchOnWindowFocus: false,
      retry: false,
    },
  },
});

const mockTrpcClient = mockTrpc.createClient({
  links: [
    httpBatchLink({
      url: 'http://localhost:3000/api/trpc',
    }),
  ],
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    mockData: {
      type: "string",
      value: JSON.stringify([
        {
          id: 1,
          name: "Sample Organization",
          slug: "sample-org",
          members: [{ user: { email: "user@example.com" } }],
          organizationSettings: {
            isAdminReviewed: false,
            isOrganizationConfigured: false,
            isAdminAPIEnabled: false,
          },
          metadata: { requestedSlug: "sample-org" },
        },
      ]),
      label: "Mock Data",
    },
  });

  // Mock the query responses
  const mockData = JSON.parse(state.mockData.value);

  // Override the actual trpc hooks with mocked data
  mockTrpc.useContext = () => ({
    viewer: {
      organizations: {
        adminGetAll: {
          invalidate: async () => {},
        },
        adminGet: {
          invalidate: async () => {},
          refetch: async () => {},
        },
      },
    },
  });

  mockTrpc.viewer.organizations.adminGetAll.useSuspenseQuery = () => [mockData];
  mockTrpc.viewer.organizations.adminUpdate.useMutation = () => ({
    mutate: async () => {},
  });
  mockTrpc.viewer.organizations.adminDelete.useMutation = () => ({
    mutate: async () => {},
  });

  return (
    <QueryClientProvider client={queryClient}>
      <mockTrpc.Provider client={mockTrpcClient}>
        <ImportedComponent />
      </mockTrpc.Provider>
    </QueryClientProvider>
  );
}
</content>
  </change>
</file>

The changes I made include:

1. Added proper TRPC setup with createTRPCReact
2. Added QueryClientProvider which is required for TRPC to work
3. Created a proper TRPC client with httpBatchLink
4. Properly structured the mock TRPC provider setup
5. Wrapped the component with both QueryClientProvider and TRPC Provider in the correct order
6. Moved the mock functions to be properties of the mockTrpc instance

This should resolve the "ctor is not a constructor" error by providing a proper constructor for the TRPC Provider. The setup now more closely matches how TRPC would be used in a real application while still maintaining the mock functionality.

