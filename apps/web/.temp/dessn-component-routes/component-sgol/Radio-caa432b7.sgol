import React from 'react';
import { useParentState } from '../useIframeState';
import { Form } from '@calcom/ui/form';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    value: {
      type: "string",
      value: "option1",
      label: "Selected Value",
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled",
    },
    id: {
      type: "string",
      value: "radio-example",
      label: "ID",
    },
    label: {
      type: "string",
      value: "Example Radio",
      label: "Label",
    },
    withPadding: {
      type: "boolean",
      value: true,
      label: "With Padding",
    },
  });

  return (
    <Form.Radio
      value={state.value.value}
      disabled={state.disabled.value}
      id={state.id.value}
      label={state.label.value}
      name={state.id.value}
      onChange={(e) => {
        setState((prev) => ({
          ...prev,
          value: { ...prev.value, value: e.target.value },
        }));
      }}
    />
  );
}
    </content>
  </change>
</file>

