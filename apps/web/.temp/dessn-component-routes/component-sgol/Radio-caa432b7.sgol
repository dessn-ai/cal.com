import React from 'react';
import { useParentState } from '../useIframeState';
import { Radio } from '../../../../packages/ui/form/radio-area/Radio';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    value: {
      type: "string",
      value: "option1",
      label: "Selected Value",
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled",
    },
    id: {
      type: "string",
      value: "radio-example",
      label: "ID",
    },
    label: {
      type: "string",
      value: "Example Radio",
      label: "Label",
    },
    withPadding: {
      type: "boolean",
      value: true,
      label: "With Padding",
    },
  });

  const options = [
    {
      label: "Option 1",
      value: "option1"
    },
    {
      label: "Option 2",
      value: "option2"
    }
  ];

  // Try to handle potential undefined Radio component
  if (!Radio) {
    return <div>Radio component not available</div>;
  }

  return (
    <div className="space-y-4">
      {options.map((option) => (
        <Radio
          key={option.value}
          label={option.label}
          id={`${state.id.value}-${option.value}`}
          value={option.value}
          checked={state.value.value === option.value}
          disabled={state.disabled.value}
        />
      ))}
    </div>
  );
}
    </content>
  </change>
</file>

I made several changes to fix the error:

1. Removed the RadioGroup since we'll handle the radio functionality directly
2. Added mock options array to provide actual radio options
3. Mapped through the options to create individual Radio components
4. Added error handling for undefined Radio component
5. Simplified the component structure
6. Added proper key prop for mapped elements
7. Added checked state comparison
8. Wrapped in a div with spacing for better layout

This approach should be more resilient and handle the case where the Radio component might be undefined. It also provides a more complete radio button group implementation with actual options to select from.

