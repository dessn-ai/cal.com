import React from 'react';
import { useParentState } from '../useIframeState';
import { Radio, RadioGroup } from '@calcom/ui';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    value: {
      type: "string",
      value: "option1",
      label: "Selected Value",
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled",
    },
    id: {
      type: "string",
      value: "radio-example",
      label: "ID",
    },
    label: {
      type: "string",
      value: "Example Radio",
      label: "Label",
    },
    withPadding: {
      type: "boolean",
      value: true,
      label: "With Padding",
    },
  });

  return (
    <RadioGroup
      name={state.id.value}
      value={state.value.value}
      onValueChange={(value) => {
        setState((prev) => ({
          ...prev,
          value: { ...prev.value, value },
        }));
      }}
    >
      <Radio
        value={state.value.value}
        disabled={state.disabled.value}
        id={state.id.value}
        label={state.label.value}
        withPadding={state.withPadding.value}
      />
    </RadioGroup>
  );
}
    </content>
  </change>
</file>

I made the following changes:
1. Added import for both `Radio` and `RadioGroup` from `@calcom/ui`
2. Wrapped the `Radio` component with `RadioGroup`
3. Moved the value and onChange handling to the `RadioGroup` component (using `onValueChange` which is the correct prop name for Radix UI RadioGroup)
4. Added the required `name` prop to RadioGroup

These changes should resolve the "`RadioGroupItem` must be used within `RadioGroup`" error by properly implementing the Radio component hierarchy as required by Radix UI's implementation.

