import React from 'react';
import { useParentState } from '../useIframeState';
import { Radio } from '@calcom/ui';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    value: {
      type: "string",
      value: "option1",
      label: "Selected Value",
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled",
    },
    id: {
      type: "string",
      value: "radio-example",
      label: "ID",
    },
    label: {
      type: "string",
      value: "Example Radio",
      label: "Label",
    },
    withPadding: {
      type: "boolean",
      value: true,
      label: "With Padding",
    },
  });

  return (
    <Radio
      value={state.value.value}
      disabled={state.disabled.value}
      id={state.id.value}
      label={state.label.value}
      withPadding={state.withPadding.value}
      onChange={(value) => {
        setState((prev) => ({
          ...prev,
          value: { ...prev.value, value },
        }));
      }}
    />
  );
}
    </content>
  </change>
</file>

I made the following changes:
1. Simplified the import to use just `@calcom/ui` package and import `Radio` directly
2. Removed the separate RadioGroup since it's likely handled internally by the Radio component
3. Added an `onChange` handler to properly update the state when the radio value changes
4. Simplified the component structure to use a single `Radio` component

These changes should resolve the import error by using the correct package structure. The Radio component from `@calcom/ui` should now be properly imported and rendered.

