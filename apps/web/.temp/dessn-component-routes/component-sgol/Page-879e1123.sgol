<content>
import React, { Suspense, useState } from 'react';
import { useParentState } from '../useIframeState';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { SessionProvider } from 'next-auth/react';
import { I18nextProvider } from 'react-i18next';
import { TooltipProvider } from '@radix-ui/react-tooltip';
import { FeatureProvider } from '@calcom/features/flags/context/provider';
import { createTRPCReact } from '@trpc/react-query';
import { httpBatchLink } from '@calcom/trpc';
import type { AppRouter } from '@calcom/trpc/server/routers/_app';

// Lazy load the component to handle any potential loading issues
const ImportedComponent = React.lazy(() => import('../../app/(use-page-wrapper)/(main-nav)/availability/page'));
const ShellMainAppDir = React.lazy(() => import('../../app/(use-page-wrapper)/(main-nav)/ShellMainAppDir'));

// Create TRPC
const mockedTrpc = createTRPCReact<AppRouter>();

// Create a new QueryClient instance
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
      staleTime: Infinity,
    },
  },
});

// Mock i18n instance
const i18nInstance = {
  language: 'en',
  t: (key: string) => key,
  exists: () => true,
  changeLanguage: () => new Promise(() => {}),
  options: {},
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    heading: {
      type: "string",
      value: "Availability",
      label: "Heading",
    },
    subtitle: {
      type: "string",
      value: "Configure availability",
      label: "Subtitle",
    },
  });

  const [trpcClient] = useState(() =>
    mockedTrpc.createClient({
      links: [httpBatchLink({ url: "" })],
    })
  );

  const mockGetTranslate = () => (key: string) => state[key as keyof typeof state]?.value || key;

  // Mock session data
  const mockSession = {
    user: {
      id: 1,
      name: 'Test User',
      email: 'test@example.com',
    },
    expires: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString(),
  };

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <SessionProvider session={mockSession}>
        <I18nextProvider i18n={i18nInstance}>
          <mockedTrpc.Provider client={trpcClient} queryClient={queryClient}>
            <QueryClientProvider client={queryClient}>
              <TooltipProvider>
                <FeatureProvider value={{}}>
                  <ShellMainAppDir
                    heading={state.heading.value}
                    subtitle={state.subtitle.value}
                    CTA={<div>Mock CTA</div>}
                  >
                    <ImportedComponent getTranslate={mockGetTranslate} />
                  </ShellMainAppDir>
                </FeatureProvider>
              </TooltipProvider>
            </QueryClientProvider>
          </mockedTrpc.Provider>
        </I18nextProvider>
      </SessionProvider>
    </Suspense>
  );
}
</content>
</change>
</file>

I've made the following changes:

1. Added the correct TRPC setup from Wrapper.tsx:
   - Imported createTRPCReact and httpBatchLink
   - Created mockedTrpc using createTRPCReact
   - Added trpcClient setup using useState
   - Used mockedTrpc.Provider instead of TRPCProvider

2. Matched the provider structure from Wrapper.tsx:
   - Correct nesting order of providers
   - Added proper TRPC client setup
   - Added empty feature flags object

3. Added proper type imports for AppRouter

4. Updated QueryClient configuration to match Wrapper.tsx settings

