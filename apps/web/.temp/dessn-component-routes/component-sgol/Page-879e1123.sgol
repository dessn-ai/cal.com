<content>
import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { SessionProvider } from 'next-auth/react';
import { I18nextProvider } from 'react-i18next';
import { TooltipProvider } from '@radix-ui/react-tooltip';
import { FeatureProvider } from '@calcom/features/flags/context/provider';

// Direct imports instead of lazy loading to avoid conversion issues
import ImportedComponent from '../../app/(use-page-wrapper)/(main-nav)/availability/page';
import { ShellMainAppDir } from '../../app/(use-page-wrapper)/(main-nav)/ShellMainAppDir';

// Create a new QueryClient instance
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
      staleTime: Infinity,
    },
  },
});

// Mock i18n instance with required methods
const i18nInstance = {
  language: 'en',
  t: (key: string) => key,
  exists: () => true,
  changeLanguage: () => new Promise(() => {}),
  options: {},
  init: () => {},
  use: () => i18nInstance,
  on: () => {},
  off: () => {},
  emit: () => {},
  resolvedLanguage: 'en',
  languages: ['en'],
  loadNamespaces: () => Promise.resolve(),
  loadLanguages: () => Promise.resolve(),
  dir: () => 'ltr',
  getFixedT: () => ((k: string) => k),
};

export default function ComponentPreview() {
  const [state] = useParentState({
    heading: {
      type: "string",
      value: "Availability",
      label: "Heading",
    },
    subtitle: {
      type: "string",
      value: "Configure availability",
      label: "Subtitle",
    },
  });

  const mockGetTranslate = () => (key: string) => state[key as keyof typeof state]?.value || key;

  // Mock session data
  const mockSession = {
    user: {
      id: 1,
      name: 'Test User',
      email: 'test@example.com',
    },
    expires: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString(),
  };

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <SessionProvider session={mockSession}>
        <I18nextProvider i18n={i18nInstance}>
          <QueryClientProvider client={queryClient}>
            <TooltipProvider>
              <FeatureProvider
                value={{
                  flags: {},
                  features: {},
                }}
              >
                <div type="component">
                  <ShellMainAppDir
                    heading={state.heading.value}
                    subtitle={state.subtitle.value}
                    CTA={<div>Mock CTA</div>}
                  >
                    <ImportedComponent getTranslate={mockGetTranslate} />
                  </ShellMainAppDir>
                </div>
              </FeatureProvider>
            </TooltipProvider>
          </QueryClientProvider>
        </I18nextProvider>
      </SessionProvider>
    </Suspense>
  );
}
</content>
</change>
</file>

I've made several important changes to fix the error:

1. Removed React.lazy() and dynamic imports
   - Using direct imports instead to avoid conversion issues
   - Removed TRPC setup since it might be causing issues with primitive conversion

2. Enhanced i18n mock instance
   - Added all required i18n methods and properties
   - Made sure all methods return proper primitive values

3. Simplified the FeatureProvider
   - Added proper value prop with empty flags and features objects
   - Removed unnecessary TRPC provider

4. Added a wrapper div with type="component"
   - This is needed for the useParentState hook to work properly
   - Helps with component extraction

5. Removed unused setState from useParentState

6. Simplified the provider structure
   - Removed redundant providers
   - Kept essential providers in the correct order

These changes should resolve the primitive value conversion error by:
1. Avoiding lazy loading issues
2. Providing proper primitive values to all context providers
3. Simplifying the component structure
4. Ensuring all provider values are properly typed

The component should now render without the conversion error. If you encounter any specific issues with the imported components, please let me know and we can add specific handling for those cases.

