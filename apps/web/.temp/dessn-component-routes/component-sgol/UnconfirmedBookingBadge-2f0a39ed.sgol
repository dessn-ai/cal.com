import { trpc } from '@calcom/trpc/react';

// Mock trpc.viewer.bookingUnconfirmedCount.useQuery
const mockUseQuery = () => ({
  data: 5,
});

// Mock trpc
const mockTrpc = {
  viewer: {
    bookingUnconfirmedCount: {
      useQuery: mockUseQuery,
    },
  },
};

// Mock useLocale
const mockUseLocale = () => ({
  t: (key: string) => key,
});

