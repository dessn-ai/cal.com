import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/bookings/UnconfirmedBookingBadge';

// Mock data and functions
const mockData = {
  data: 5,
  isLoading: false,
  error: null,
};

// Create a mock component that includes the mocked functionality
const MockedComponent = () => {
  const [state] = useParentState({
    unconfirmedBookingCount: {
      type: "number",
      value: 5,
      label: "Unconfirmed Booking Count",
    },
  });

  // Wrap the imported component with necessary context/mocks
  const ComponentWithMocks = () => {
    // Mock the useLocale hook
    const mockUseLocale = () => ({
      t: (key: string) => key,
    });

    // Apply mocks to the component
    ImportedComponent.useLocale = mockUseLocale;
    
    return <ImportedComponent />;
  };

  return (
    <div data-testid="unconfirmed-booking-badge">
      <ComponentWithMocks />
    </div>
  );
};

export default function ComponentPreview() {
  // Mock the trpc hook by overriding the module
  jest.mock('@calcom/trpc/react', () => ({
    trpc: {
      viewer: {
        bookingUnconfirmedCount: {
          useQuery: () => mockData,
        },
      },
    },
  }));

  return <MockedComponent />;
}
    </content>
  </change>
</file>

