import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../components/EnterprisePage';
import { useLocale } from "@calcom/lib/hooks/useLocale";

// Create a mock search params context
const SearchParamsContext = createContext({
  searchParams: new URLSearchParams(),
  setSearchParams: () => {},
});

// Mock provider for search params
const MockRouterProvider = ({ children }) => {
  return (
    <SearchParamsContext.Provider 
      value={{
        searchParams: new URLSearchParams(),
        setSearchParams: () => {},
      }}
    >
      {children}
    </SearchParamsContext.Provider>
  );
};

export default function ComponentPreview() {
  const { t } = useLocale();

  const [state, setState] = useParentState({
    heading: {
      type: "string",
      value: "Enterprise",
      label: "Heading",
    },
    subtitle: {
      type: "string",
      value: "Enterprise Description",
      label: "Subtitle",
    },
    withoutSeo: {
      type: "boolean",
      value: true,
      label: "Without SEO",
    },
  });

  return (
    <MockRouterProvider>
      <ImportedComponent 
        heading={state.heading.value}
        subtitle={state.subtitle.value}
        withoutSeo={state.withoutSeo.value}
      />
    </MockRouterProvider>
  );
}
</content>
  </change>
</file>

I made the following changes:
1. Removed the `react-router-dom` dependency
2. Created a simple mock context for search params
3. Created a `MockRouterProvider` component that provides the basic router context needed
4. Wrapped the `ImportedComponent` with our `MockRouterProvider`
5. Kept the props passing to `ImportedComponent`

This approach should resolve the immediate dependency error while still providing the necessary context for components that need router-related functionality. The mock provider supplies a basic implementation of the search params context that should prevent the null context errors.

If you're still seeing errors, please let me know what they are and I can help adjust the solution further.

