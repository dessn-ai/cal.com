import React from 'react';
import { BrowserRouter } from 'react-router-dom';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../components/EnterprisePage';
import { useLocale } from "@calcom/lib/hooks/useLocale";

export default function ComponentPreview() {
  const { t } = useLocale();

  const [state, setState] = useParentState({
    heading: {
      type: "string",
      value: "Enterprise",
      label: "Heading",
    },
    subtitle: {
      type: "string",
      value: "Enterprise Description",
      label: "Subtitle",
    },
    withoutSeo: {
      type: "boolean",
      value: true,
      label: "Without SEO",
    },
  });

  return (
    <BrowserRouter>
      <ImportedComponent 
        heading={state.heading.value}
        subtitle={state.subtitle.value}
        withoutSeo={state.withoutSeo.value}
      />
    </BrowserRouter>
  );
}
</content>
  </change>
</file>

I made the following changes:
1. Added `BrowserRouter` import from 'react-router-dom'
2. Wrapped the `ImportedComponent` with `BrowserRouter` to provide the routing context
3. Passed the state values as props to the `ImportedComponent`

This should resolve the error related to `useContext` being null, as the Router context will now be available to all child components including the Shell component that's using `useSearchParams`.

If you're still seeing errors, please let me know and I can help further. There might be additional providers needed depending on what other hooks are being used within the component tree.

