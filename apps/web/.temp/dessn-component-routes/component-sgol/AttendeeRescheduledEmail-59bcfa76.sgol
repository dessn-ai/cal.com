<file path="apps/web/.temp/dessn-component-routes/AttendeeRescheduledEmail-59bcfa76.tsx">
  <change>
    <description>Enhance the translation function to handle interpolation and provide a more complete implementation</description>
    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { AttendeeRescheduledEmail } from '../../../../packages/emails/src/templates/AttendeeRescheduledEmail';

// Define TimeFormat enum locally instead of importing
enum TimeFormat {
  TWELVE_HOUR = '12h',
  TWENTY_FOUR_HOUR = '24h'
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    calEvent: {
      type: 'string',
      value: JSON.stringify({
        type: 'meeting',
        title: 'Team Meeting',
        startTime: '2023-06-15T10:00:00Z',
        endTime: '2023-06-15T11:00:00Z',
        organizer: {
          name: 'John Doe',
          email: 'john@example.com',
          timeZone: 'America/New_York',
          language: { translate: (key: string) => key, locale: 'en' },
        },
        attendees: [
          {
            name: 'Jane Smith',
            email: 'jane@example.com',
            timeZone: 'Europe/London',
            language: { translate: (key: string) => key, locale: 'en' },
          },
        ],
      }),
      label: 'Calendar Event',
    },
    attendee: {
      type: 'string',
      value: JSON.stringify({
        name: 'Jane Smith',
        email: 'jane@example.com',
        timeZone: 'Europe/London',
        language: { translate: (key: string) => key, locale: 'en' },
      }),
      label: 'Attendee',
    },
    timeZone: {
      type: 'string',
      value: 'America/New_York',
      label: 'Time Zone',
    },
    includeAppsStatus: {
      type: 'boolean',
      value: false,
      label: 'Include Apps Status',
    },
    locale: {
      type: 'string',
      value: 'en',
      label: 'Locale',
    },
    timeFormat: {
      type: 'dropdown',
      value: TimeFormat.TWELVE_HOUR,
      options: Object.values(TimeFormat),
      label: 'Time Format',
    },
    isOrganizer: {
      type: 'boolean',
      value: false,
      label: 'Is Organizer',
    },
  });

  const parsedCalEvent = JSON.parse(state.calEvent.value);
  const parsedAttendee = JSON.parse(state.attendee.value);

  // Enhanced translation function that handles both simple strings and interpolation
  const t = (key: string, vars?: Record<string, string | number>) => {
    if (!vars) return key;
    
    let translated = key;
    Object.entries(vars).forEach(([k, v]) => {
      translated = translated.replace(new RegExp(`{{${k}}}`, 'g'), String(v));
      translated = translated.replace(new RegExp(`{${k}}`, 'g'), String(v));
    });
    return translated;
  };

  return (
    <AttendeeRescheduledEmail
      calEvent={parsedCalEvent}
      attendee={parsedAttendee}
      timeZone={state.timeZone.value}
      includeAppsStatus={state.includeAppsStatus.value}
      t={t}
      locale={state.locale.value}
      timeFormat={state.timeFormat.value as TimeFormat}
      isOrganizer={state.isOrganizer.value}
    />
  );
}
</content>
  </change>
</file>

I've made the following changes:
1. Enhanced the translation function `t` to handle both simple string translations and variable interpolation
2. The new `t` function now accepts a second parameter for variables that need to be interpolated into the translation string
3. It handles both `{{variable}}` and `{variable}` formats commonly used in translation systems
4. The function maintains backward compatibility with simple string translations

This should resolve the error in the ManageLink component which was expecting a more sophisticated translation function. The enhanced `t` function will now properly handle any translation keys and variable interpolation needed throughout the email template components.

