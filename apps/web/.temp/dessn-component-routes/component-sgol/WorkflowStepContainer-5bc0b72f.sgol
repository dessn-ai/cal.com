          },
          _names: {
            array: [],
            mount: [],
            unMount: [],
            watch: [],
            focus: "",
            watchAll: false
          },
          _subjects: {
            watch: { next: "function" },
            array: { next: "function" },
            state: { next: "function" }
          }
        },
        register: "function",
        formState: { errors: {} },
        clearErrors: "function",
        unregister: "function",
        watch: "function",
        handleSubmit: "function"
      },
      label: "Form",
    },
    user: {
      type: "object",
      value: {
        id: "user1",
        name: "John Doe",
        email: "john@example.com",
        timeFormat: 12,
      },
      label: "User",
    },
    reload: {
      type: "boolean",
      value: false,
      label: "Reload",
    },
    setReload: {
      type: "string",
      value: "function",
      label: "Set Reload",
    },
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
    readOnly: {
      type: "boolean",
      value: false,
      label: "Read Only",
    },
  });

  // Create a subject implementation
  const createSubject = () => {
    const observers = new Set();
    return {
      next: (value) => {
        observers.forEach(observer => observer(value));
      },
      subscribe: (observer) => {
        observers.add(observer);
        return {
          unsubscribe: () => observers.delete(observer)
        };
      }
    };
  };

  // Create the actual form methods object that will be used by the component
  const formMethods = {
    getValues: () => ({}),
    setValue: () => {},
    control: {
      _removeUnmounted: () => {},
      _updateValid: () => {},
      register: (name) => ({
        onChange: () => {},
        onBlur: () => {},
