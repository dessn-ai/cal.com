        isSubmitSuccessful: false,
        isValid: true,
        errors: {}
      },
      _names: {
        array: new Set(),
        mount: new Set(),
        unMount: new Set(),
        watch: new Set(),
        focus: "",
        watchAll: false
      },
      _subjects: {
        watch: createSubject(),
        array: createSubject(),
        state: createSubject()
      },
      _proxyFormState: {
        isDirty: false,
        dirtyFields: false,
        touched: false,
        isValidating: false,
        isValid: false,
        errors: false
      },
      _options: {
        shouldUnregister: false,
        shouldUnregisterOnUnmount: false
      }
    },
    register: (name) => ({
      onChange: () => {},
      onBlur: () => {},
      name,
      ref: () => {},
    }),
    formState: { errors: {} },
    clearErrors: () => {},
    unregister: () => {},
    watch: () => {},
    handleSubmit: (handler) => (e) => {
      e?.preventDefault();
      handler({});
    },
  };

  return (
    <ImportedComponent
      step={state.step.value}
      form={formMethods}
      user={state.user.value}
      reload={state.reload.value}
      setReload={() => {}}
      teamId={state.teamId.value}
      readOnly={state.readOnly.value}
    />
  );
}
