            watchAll: false
          },
          _subjects: {
            watch: { next: "function" },
            array: { next: "function" },
            state: { next: "function" }
          }
        },
        register: "function",
        formState: { errors: {} },
        clearErrors: "function",
        unregister: "function",
        watch: "function",
        handleSubmit: "function"
      },
      label: "Form",
    },
    user: {
      type: "object",
      value: {
        id: "user1",
        name: "John Doe",
        email: "john@example.com",
        timeFormat: 12,
      },
      label: "User",
    },
    reload: {
      type: "boolean",
      value: false,
      label: "Reload",
    },
    setReload: {
      type: "string",
      value: "function",
      label: "Set Reload",
    },
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
    readOnly: {
      type: "boolean",
      value: false,
      label: "Read Only",
    },
  });

  // Create the actual form methods object that will be used by the component
  const formMethods = {
    getValues: () => ({}),
    setValue: () => {},
    control: {
      _removeUnmounted: () => {},
      _updateValid: () => {},
      register: (name) => ({
        onChange: () => {},
        onBlur: () => {},
        name,
        ref: () => {},
      }),
      unregister: () => {},
      _getWatch: () => ({}),
      _getDirty: () => false,
      _updateFieldArray: () => {},
      _getFieldArray: () => [],
      _reset: () => {},
      defaultValuesRef: { current: {} },
      _fields: {},
      _formValues: {},
      _formState: {
        isDirty: false,
        isSubmitted: false,
        submitCount: 0,
        touched: {},
        isSubmitting: false,
        isSubmitSuccessful: false,
        isValid: true,
        errors: {}
      },
      _names: {
        array: new Set(),
        mount: new Set(),
        unMount: new Set(),
        watch: new Set(),
        focus: "",
        watchAll: false
      },
      _subjects: {
        watch: { next: () => {} },
        array: { next: () => {} },
        state: { next: () => {} }
      }
    },
    register: (name) => ({
      onChange: () => {},
      onBlur: () => {},
      name,
      ref: () => {},
    }),
    formState: { errors: {} },
    clearErrors: () => {},
    unregister: () => {},
    watch: () => {},
    handleSubmit: (handler) => (e) => {
      e?.preventDefault();
      handler({});
