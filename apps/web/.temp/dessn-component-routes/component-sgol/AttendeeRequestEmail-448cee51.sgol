    <description>Add crypto mock provider and wrap the component</description>
    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { AttendeeRequestEmail } from '../../../../packages/emails/src/templates/AttendeeRequestEmail';

// Mock crypto context
const CryptoContext = React.createContext({
  encrypt: (text: string) => text,
  decrypt: (text: string) => text,
});

const CryptoProvider = ({ children }: { children: React.ReactNode }) => {
  const value = {
    encrypt: (text: string) => text,
    decrypt: (text: string) => text,
  };
  return <CryptoContext.Provider value={value}>{children}</CryptoContext.Provider>;
};

enum TimeFormat {
  TWELVE_HOUR = '12h',
  TWENTY_FOUR_HOUR = '24h',
