<description>Update preview component to avoid crypto dependency and provide all necessary props</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { AttendeeRequestEmail } from '../../../../packages/emails/src/templates/AttendeeRequestEmail';
import { TimeFormat } from '../../../../packages/emails/src/templates/AttendeeRequestEmail';

// Mock translation function
const mockTranslate = (key: string, vars?: Record<string, string>) => {
  if (vars) {
    let result = key;
    Object.entries(vars).forEach(([key, value]) => {
      result = result.replace(`{${key}}`, value);
    });
    return result;
  }
  return key;
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    calEvent: {
      type: "string",
      value: JSON.stringify({
        type: "default",
        title: "Meeting with John",
        startTime: new Date().toISOString(),
        endTime: new Date(Date.now() + 3600000).toISOString(),
        organizer: {
          name: "Jane Organizer",
          email: "jane@example.com",
          timeZone: "America/New_York",
          language: {
            translate: mockTranslate,
            locale: "en"
          }
        },
        attendees: [{
          name: "John Attendee",
          email: "john@example.com",
          timeZone: "America/Los_Angeles",
          language: {
            translate: mockTranslate,
            locale: "en"
          }
        }],
        recurringEvent: null,
        uid: "mock-uid",
        location: "Online",
        description: "Test meeting description",
        status: "PENDING"
      }),
      label: "Calendar Event"
    },
    attendee: {
      type: "string",
      value: JSON.stringify({
        name: "John Attendee",
        email: "john@example.com",
        timeZone: "America/Los_Angeles",
        language: {
          translate: mockTranslate,
          locale: "en"
        }
      }),
      label: "Attendee"
    },
    timeZone: {
      type: "string",
      value: "America/New_York",
      label: "Time Zone"
    },
    includeAppsStatus: {
      type: "boolean",
      value: false,
      label: "Include Apps Status"
    },
    locale: {
      type: "string",
      value: "en",
      label: "Locale"
    },
    timeFormat: {
      type: "dropdown",
      value: TimeFormat.TWELVE_HOUR,
      options: [TimeFormat.TWELVE_HOUR, TimeFormat.TWENTY_FOUR_HOUR],
      label: "Time Format"
    },
    isOrganizer: {
      type: "boolean",
      value: false,
      label: "Is Organizer"
    }
  });

  const parsedCalEvent = JSON.parse(state.calEvent.value);
  const parsedAttendee = JSON.parse(state.attendee.value);

  return (
    <div className="preview-email-wrapper">
      <AttendeeRequestEmail
        calEvent={parsedCalEvent}
        attendee={parsedAttendee}
        timeZone={state.timeZone.value}
        includeAppsStatus={state.includeAppsStatus.value}
        t={mockTranslate}
        locale={state.locale.value}
        timeFormat={state.timeFormat.value as TimeFormat}
        isOrganizer={state.isOrganizer.value}
      />
    </div>
  );
}
</content>
</change>
</file>

Key changes made:
1. Added a `mockTranslate` function to handle translations without dependencies
2. Enhanced the calEvent object with additional required properties
3. Added a wrapper div with a class for styling
4. Improved the structure of the language and translation handling
5. Added more required fields like uid, location, description, and status
6. Moved the JSON parsing outside the JSX for better readability
7. Ensured all required props are properly typed and provided

This approach:
1. Avoids the crypto dependency entirely
2. Provides all necessary props for the email template
3. Uses simple mock functions for translations
4. Maintains type safety
5. Should render without the Buffer-related errors

The preview should now work without any crypto-related errors while still providing a meaningful preview of the email template.

