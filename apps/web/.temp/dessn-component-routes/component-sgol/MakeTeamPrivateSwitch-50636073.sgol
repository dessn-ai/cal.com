<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/ee/teams/components/MakeTeamPrivateSwitch';

// Create a mock context to avoid the need for actual TRPC provider
const MockTRPCContext = React.createContext({
  viewer: {
    teams: {
      update: {
        useMutation: () => ({
          mutate: async () => {},
          isPending: false
        })
      }
    }
  }
});

// Mock the trpc hooks that the component might use
const useTRPCMutation = () => ({
  mutate: async () => {},
  isPending: false
});

const useUtils = () => ({
  viewer: {
    teams: {
      get: {
        invalidate: async () => {}
      }
    }
  }
});

// Mock the required TRPC hooks
jest.mock('@calcom/trpc/react', () => ({
  useMutation: useTRPCMutation,
  useUtils: useUtils
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
    isPrivate: {
      type: "boolean",
      value: false,
      label: "Is Private",
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled",
    },
    isOrg: {
      type: "boolean",
      value: false,
      label: "Is Organization",
    },
  });

  return (
    <MockTRPCContext.Provider
      value={{
        viewer: {
          teams: {
            update: {
              useMutation: () => ({
                mutate: async () => {},
                isPending: false
              })
            }
          }
        }
      }}
    >
      <ImportedComponent
        teamId={state.teamId.value}
        isPrivate={state.isPrivate.value}
        disabled={state.disabled.value}
        isOrg={state.isOrg.value}
      />
    </MockTRPCContext.Provider>
  );
}
</content>
</change>
</file>

The changes I made include:

1. Removed the complex TRPC and Query Client setup
2. Created a simple mock context that provides the minimum required functionality
3. Mocked the essential TRPC hooks that the component might use
4. Simplified the provider structure to just use a basic React context
5. Removed unnecessary imports that were causing issues

This simplified approach should work better in the preview environment. Instead of trying to replicate the full TRPC infrastructure, we're just providing the minimal mock functionality that the component needs to render properly.

The key differences are:
- No more QueryClient or complex TRPC setup
- Direct mocking of the required hooks and functionality
- Simpler context provider structure
- Removed dependencies that were causing the constructor error

This should resolve the "ctor is not a constructor" error by avoiding the complex provider setup that was causing issues.

