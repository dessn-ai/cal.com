Assistant: I apologize for using Jest mocking in a non-test environment. Let's fix this by using a different approach with React's context and hooks.

<file path="apps/web/.temp/dessn-component-routes/MakeTeamPrivateSwitch-50636073.tsx">
<change>
<description>Remove Jest mocking and implement proper TRPC context mock</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/ee/teams/components/MakeTeamPrivateSwitch';
import { trpc } from '@calcom/trpc/react';

// Create a mock TRPC provider component
const MockTRPCProvider = ({ children }) => {
  const mockTrpcValue = {
    viewer: {
      teams: {
        update: {
          useMutation: () => ({
            mutate: async () => {},
            isPending: false
          })
        }
      }
    }
  };

  // Override the trpc hooks that the component uses
  const originalUseContext = React.useContext;
  React.useContext = (context) => {
    if (context === trpc.context) {
      return mockTrpcValue;
    }
    return originalUseContext(context);
  };

  return children;
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
    isPrivate: {
      type: "boolean",
      value: false,
      label: "Is Private",
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled",
    },
    isOrg: {
      type: "boolean",
      value: false,
      label: "Is Organization",
    },
  });

  // Create mock functions that the component might need
  const mockUtils = {
    viewer: {
      teams: {
        get: {
          invalidate: async () => {}
        }
      }
    }
  };

  // Override trpc.useUtils
  trpc.useUtils = () => mockUtils;

  return (
    <MockTRPCProvider>
      <ImportedComponent
        teamId={state.teamId.value}
        isPrivate={state.isPrivate.value}
        disabled={state.disabled.value}
        isOrg={state.isOrg.value}
      />
    </MockTRPCProvider>
  );
}
</content>
</change>
</file>

The changes I made include:

1. Removed all Jest-related code
2. Created a MockTRPCProvider component that provides the necessary context
3. Used React's context system to provide mock TRPC functionality
4. Directly overrode the necessary TRPC hooks and utilities
5. Simplified the overall structure while maintaining the required functionality

Key improvements:
- No more dependency on Jest
- Uses React's native context system
- Provides the same mock functionality in a more compatible way
- Maintains all the necessary TRPC mock implementations
- More straightforward and runtime-friendly approach

This should resolve the "jest is not defined" error while still providing the necessary mock functionality for the component to render properly.

