import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/ee/teams/components/MakeTeamPrivateSwitch';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Create a mock trpc context
const mockTrpcContext = {
  viewer: {
    teams: {
      update: {
        useMutation: () => ({
          mutate: async () => Promise.resolve(),
          isLoading: false,
          isPending: false
        })
      }
    }
  }
};

// Create a mock Provider component
const MockTrpcProvider = ({ children }) => {
  return children;
};

// Override the real trpc with our mock
const trpc = {
  Provider: MockTrpcProvider,
  useContext: () => mockTrpcContext
};

export default function ComponentPreview() {
  const queryClient = new QueryClient({
    defaultOptions: {
      queries: {
        retry: false,
        cacheTime: 0,
      },
    },
  });

  const [state, setState] = useParentState({
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
    isPrivate: {
      type: "boolean",
      value: false,
      label: "Is Private",
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled",
    },
    isOrg: {
      type: "boolean",
      value: false,
      label: "Is Organization",
    },
  });

  return (
    <QueryClientProvider client={queryClient}>
      <MockTrpcProvider>
        <React.Suspense fallback="Loading...">
          <ImportedComponent
            teamId={state.teamId.value}
            isPrivate={state.isPrivate.value}
            disabled={state.disabled.value}
            isOrg={state.isOrg.value}
          />
        </React.Suspense>
      </MockTrpcProvider>
    </QueryClientProvider>
  );
}
</content>
</change>
</file>

