import React from 'react';
import { useParentState } from '../useIframeState';
import { Dialog, DialogTrigger, DialogContent } from '../../../../packages/platform/atoms/src/components/ui/dialog';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    children: {
      type: "string",
      value: "Open Dialog",
      label: "Button Text",
    },
    className: {
      type: "string",
      value: "px-4 py-2 bg-blue-500 text-white rounded",
      label: "CSS Class",
    },
  });

  return (
    <Dialog>
      <DialogTrigger className={state.className.value}>
        {state.children.value}
      </DialogTrigger>
      <DialogContent>
        <div>Dialog Content</div>
      </DialogContent>
    </Dialog>
  );
}
</content>
</change>
</file>

The changes I made:
1. Added the import for `Dialog` and `DialogContent` components
2. Wrapped the `DialogTrigger` with the `Dialog` component
3. Added a `DialogContent` component to show some content when the dialog opens
4. The dialog content currently shows a simple placeholder text "Dialog Content"

This should resolve the error as the `DialogTrigger` is now properly wrapped within a `Dialog` component context.

