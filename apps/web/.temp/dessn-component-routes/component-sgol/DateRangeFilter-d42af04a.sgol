<file path="apps/web/.temp/dessn-component-routes/DateRangeFilter-d42af04a.tsx">
<change>
<description>Create a proper context provider with all required values</description>
<content>
import React, { createContext, useContext, useState } from 'react';
import { useParentState } from '../useIframeState';
import { DateRangeFilter } from '../../../../packages/features/data-table/components/filters/DateRangeFilter';
import { ColumnFilterType } from '../../../../packages/features/data-table/lib/types';

// Define necessary types
type DateRangeColumn = {
  id: string;
  title: string;
  type: ColumnFilterType.DATE_RANGE;
  icon: string;
};

interface DataTableContextValue {
  filterValue: Record<string, any>;
  setFilterValue: (value: any) => void;
  data: any[];
  setData: (data: any[]) => void;
  columns: any[];
  setColumns: (columns: any[]) => void;
  selectedRows: Set<string>;
  setSelectedRows: (rows: Set<string>) => void;
  options: Record<string, any>;
}

// Create the context
const DataTableContext = createContext<DataTableContextValue | null>(null);

// Create the provider component
const DataTableProvider = ({ children }: { children: React.ReactNode }) => {
  const [filterValue, setFilterValue] = useState({});
  const [data, setData] = useState([]);
  const [columns, setColumns] = useState([]);
  const [selectedRows, setSelectedRows] = useState(new Set<string>());

  const value: DataTableContextValue = {
    filterValue,
    setFilterValue,
    data,
    setData,
    columns,
    setColumns,
    selectedRows,
    setSelectedRows,
    options: {
      enableFilters: true,
      enableSorting: true,
      enableMultiSort: true,
      enableColumnFilters: true,
    }
  };

  return (
    <DataTableContext.Provider value={value}>
      {children}
    </DataTableContext.Provider>
  );
};

// Export the hook that the component will use internally
export const useDataTable = () => {
  const context = useContext(DataTableContext);
  if (!context) {
    throw new Error('useDataTable must be used within a DataTableProvider');
  }
  return context;
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    column: {
      type: "object",
      value: {
        id: "dateRange",
        title: "Date Range",
        type: ColumnFilterType.DATE_RANGE,
        icon: "calendar",
      },
      label: "Column",
    },
  });

  return (
    <DataTableProvider>
      <DateRangeFilter
        column={state.column.value as DateRangeColumn}
      />
    </DataTableProvider>
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Created a proper DataTableContext with all necessary values and types
2. Implemented a full DataTableProvider with actual state management
3. Added all the required context values that the DateRangeFilter might need:
   - filterValue and setFilterValue for filter state
   - data and setData for table data
   - columns and setColumns for table columns
   - selectedRows and setSelectedRows for selection state
   - options object with common table options
4. Provided a proper useDataTable hook that the component can use
5. Wrapped the DateRangeFilter with the DataTableProvider

This implementation should provide all the necessary context and functionality that the DateRangeFilter component needs to work properly. The context values are now properly managed with useState hooks, and the provider includes all the typical data table functionality.

