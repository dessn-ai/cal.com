<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { DateRangeFilter } from '../../../../packages/features/data-table/components/filters/DateRangeFilter';
import { ColumnFilterType } from '../../../../packages/features/data-table/lib/types';

// Create contexts to override the hooks
const DataTableContext = React.createContext({
  updateFilter: () => {},
  data: [],
  setData: () => {},
  columns: [],
  setColumns: () => {},
  selectedRows: new Set(),
  setSelectedRows: () => {},
  tableState: {
    sorting: [],
    columnFilters: [],
    columnVisibility: {},
    rowSelection: {},
  },
  setTableState: () => {},
  onRowSelectionChange: () => {},
  tableRef: { current: null },
});

// Override the hooks by providing a custom hook implementation
const useDataTable = () => React.useContext(DataTableContext);
const useFilterValue = () => ({
  data: {
    startDate: new Date(),
    endDate: new Date(),
    preset: 'custom',
  },
});
const useLocale = () => ({
  t: (key) => key,
});

// Override the modules
const originalModule = require('../../../../packages/features/data-table/hooks/useDataTable');
originalModule.useDataTable = useDataTable;

const LocaleContext = React.createContext({
  t: (key: string) => key,
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    column: {
      type: "object",
      value: {
        id: "dateRange",
        title: "Date Range",
        type: ColumnFilterType.DATE_RANGE,
        icon: "calendar",
      },
      label: "Column",
    },
  });

  return (
    <DataTableContext.Provider
      value={{
        updateFilter: () => {},
        data: [],
        setData: () => {},
        columns: [],
        setColumns: () => {},
        selectedRows: new Set(),
        setSelectedRows: () => {},
        tableState: {
          sorting: [],
          columnFilters: [],
          columnVisibility: {},
          rowSelection: {},
        },
        setTableState: () => {},
        onRowSelectionChange: () => {},
        tableRef: { current: null },
      }}
    >
      <LocaleContext.Provider value={{ t: (key: string) => key }}>
        <div className="p-4">
          <DateRangeFilter
            column={state.column.value as Extract<FilterableColumn, { type: ColumnFilterType.DATE_RANGE }>}
          />
        </div>
      </LocaleContext.Provider>
    </DataTableContext.Provider>
  );
}

// Make sure the hooks are available in the module scope
(window as any).useDataTable = useDataTable;
(window as any).useFilterValue = useFilterValue;
(window as any).useLocale = useLocale;
</content>
</change>
</file>

