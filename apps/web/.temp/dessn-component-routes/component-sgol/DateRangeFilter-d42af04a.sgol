import React from 'react';
import { useParentState } from '../useIframeState';
import { DateRangeFilter } from '../../../../packages/features/data-table/components/filters/DateRangeFilter';
import { ColumnFilterType } from '../../../../packages/features/data-table/lib/types';

// Mock the actual modules that DateRangeFilter uses
jest.mock('../../../../packages/features/data-table/hooks/useDataTable', () => ({
  useDataTable: () => ({
    updateFilter: () => {},
    tableState: {
      columnFilters: [],
    }
  })
}));

jest.mock('../../../../packages/features/data-table/hooks/useFilterValue', () => ({
  useFilterValue: () => ({
    data: {
      startDate: new Date(),
      endDate: new Date(),
      preset: 'custom'
    }
  })
}));

// Mock other dependencies
jest.mock('@calcom/lib/hooks/useLocale', () => ({
  useLocale: () => ({
    t: (str: string) => str
  })
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    column: {
      type: "object",
      value: {
        id: "dateRange",
        title: "Date Range",
        type: ColumnFilterType.DATE_RANGE,
        icon: "calendar",
      },
      label: "Column",
    },
  });

  return (
    <div>
      <DateRangeFilter
        column={state.column.value as Extract<FilterableColumn, { type: ColumnFilterType.DATE_RANGE }>}
      />
    </div>
  );
}
</content>
