<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { DateRangeFilter } from '../../../../packages/features/data-table/components/filters/DateRangeFilter';
import { ColumnFilterType } from '../../../../packages/features/data-table/lib/types';

// Create a context for the data table functionality
const DataTableContext = React.createContext({
  updateFilter: () => {},
  data: [],
  setData: () => {},
  columns: [],
  setColumns: () => {},
  selectedRows: new Set(),
  setSelectedRows: () => {},
  tableState: {
    sorting: [],
    columnFilters: [],
    columnVisibility: {},
    rowSelection: {},
  },
  setTableState: () => {},
  onRowSelectionChange: () => {},
  tableRef: { current: null },
});

// Create a context for locale
const LocaleContext = React.createContext({
  t: (key: string) => key,
});

// Create custom hooks that will be used by the component
const useDataTable = () => React.useContext(DataTableContext);

const useFilterValue = () => ({
  data: {
    startDate: new Date(),
    endDate: new Date(),
    preset: 'custom',
  },
  type: ColumnFilterType.DATE_RANGE,
});

const useLocale = () => React.useContext(LocaleContext);

// Override the hooks in the global scope
Object.defineProperty(window, '__dataTable', {
  value: {
    useDataTable,
    useFilterValue,
    useLocale,
  },
  writable: true,
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    column: {
      type: "object",
      value: {
        id: "dateRange",
        title: "Date Range",
        type: ColumnFilterType.DATE_RANGE,
        icon: "calendar",
      },
      label: "Column",
    },
  });

  const contextValue = {
    updateFilter: () => {},
    data: [],
    setData: () => {},
    columns: [],
    setColumns: () => {},
    selectedRows: new Set(),
    setSelectedRows: () => {},
    tableState: {
      sorting: [],
      columnFilters: [],
      columnVisibility: {},
      rowSelection: {},
    },
    setTableState: () => {},
    onRowSelectionChange: () => {},
    tableRef: { current: null },
  };

  return (
    <LocaleContext.Provider value={{ t: (key: string) => key }}>
      <DataTableContext.Provider value={contextValue}>
        <div className="p-4">
          <DateRangeFilter
            column={state.column.value as Extract<FilterableColumn, { type: ColumnFilterType.DATE_RANGE }>}
          />
        </div>
      </DataTableContext.Provider>
    </LocaleContext.Provider>
  );
}

// Export the hooks so they can be used by the DateRangeFilter component
export { useDataTable, useFilterValue, useLocale };
</content>
</change>
</file>

