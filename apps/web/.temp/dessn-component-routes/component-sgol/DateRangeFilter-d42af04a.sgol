import React from 'react';
import { useParentState } from '../useIframeState';
import { DateRangeFilter } from '../../../../packages/features/data-table/components/filters/DateRangeFilter';
import { ColumnFilterType } from '../../../../packages/features/data-table/lib/types';

// Create a wrapper component that provides all necessary mocked functionality
const MockedDateRangeFilter = (props: any) => {
  // Override the module imports that DateRangeFilter uses
  const originalModule = require('../../../../packages/features/data-table/hooks/useDataTable');
  const filterValueModule = require('../../../../packages/features/data-table/hooks/useFilterValue');
  const localeModule = require('@calcom/lib/hooks/useLocale');

  // Mock the modules
  originalModule.useDataTable = () => ({
    updateFilter: () => {},
    tableState: {
      columnFilters: [],
    },
    data: [],
    setData: () => {},
    loading: false,
    setLoading: () => {},
    sorting: [],
    pagination: { pageIndex: 0, pageSize: 10 },
    onStateChange: () => {},
    columns: [],
    filterableColumns: [],
  });

  filterValueModule.useFilterValue = () => ({
    data: {
      startDate: new Date(),
      endDate: new Date(),
      preset: 'custom'
    }
  });

  localeModule.useLocale = () => ({
    t: (str: string) => str
  });

  return <DateRangeFilter {...props} />;
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    column: {
      type: "object",
      value: {
        id: "dateRange",
        title: "Date Range",
        type: ColumnFilterType.DATE_RANGE,
        icon: "calendar",
      },
      label: "Column",
    },
  });

  return (
    <div>
      <MockedDateRangeFilter
        column={state.column.value as Extract<FilterableColumn, { type: ColumnFilterType.DATE_RANGE }>}
      />
    </div>
