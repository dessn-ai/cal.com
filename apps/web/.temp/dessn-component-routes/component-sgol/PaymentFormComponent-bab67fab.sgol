    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/ee/payments/components/Payment';

// Mock Elements component to avoid Stripe integration issues in preview
const MockElements = ({ children }) => {
  return (
    <div data-testid="mock-stripe-elements">
      {children}
    </div>
  );
};

// Mock PaymentElement component
const MockPaymentElement = () => {
  return (
    <div data-testid="mock-payment-element">
      Payment Element Mock
    </div>
  );
};

// Mock the stripe modules
jest.mock('@stripe/react-stripe-js', () => ({
  Elements: MockElements,
  PaymentElement: MockPaymentElement,
  useStripe: () => ({
    confirmPayment: () => Promise.resolve({ paymentIntent: { status: 'succeeded' } }),
  }),
  useElements: () => ({
    getElement: () => ({}),
  }),
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    payment: {
      type: "object",
      value: {
        amount: 1000,
        currency: "USD",
        paymentOption: "ON_BOOKING",
        data: {
          stripe_publishable_key: "pk_test_123"
        }
      },
      label: "Payment"
    },
    eventType: {
      type: "object",
      value: {
        id: 1,
        successRedirectUrl: "https://example.com/success",
        forwardParamsSuccessRedirect: true
      },
      label: "Event Type"
    },
    user: {
      type: "object",
      value: {
        username: "testuser"
      },
      label: "User"
    },
    location: {
      type: "string",
      value: "Online",
      label: "Location"
    },
    clientSecret: {
      type: "string",
      value: "mock_client_secret",
      label: "Client Secret"
    },
    booking: {
      type: "object",
      value: {
        uid: "booking123"
      },
      label: "Booking"
    }
  });

  return (
    <MockElements>
      <ImportedComponent
        payment={state.payment.value}
        eventType={state.eventType.value}
        user={state.user.value}
        location={state.location.value}
        clientSecret={state.clientSecret.value}
        booking={state.booking.value}
        onSubmit={(ev) => {
          ev.preventDefault();
          console.log("Form submitted");
        }}
        onCancel={() => console.log("Cancelled")}
        onPaymentElementChange={() => console.log("Payment element changed")}
        elements={null}
        paymentOption={state.payment.value.paymentOption}
        state={{ status: "idle" }}
      />
    </MockElements>
  );
}
</content>
  </change>
</file>

I've made the following changes:

1. Removed the actual Stripe integration (loadStripe and real Elements)
2. Created mock components for Stripe Elements and PaymentElement
3. Added mock implementations for useStripe and useElements hooks
4. Simplified the preview by using mock components instead of real Stripe integration
5. Removed the Stripe-specific options and configuration

This approach should work better for preview purposes since:
1. We don't need real Stripe integration in a preview environment
2. It avoids issues with client secret validation
3. It still allows the component to render and function for preview purposes
4. It maintains the same interface but with mocked functionality

The preview should now work without the Stripe integration errors while still showing how the component will look and behave.

