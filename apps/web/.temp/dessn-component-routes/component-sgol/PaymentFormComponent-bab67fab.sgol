import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/ee/payments/components/Payment';

// Create a mock context to provide stripe-related values
const MockStripeContext = React.createContext({
  stripe: {
    confirmPayment: () => Promise.resolve({ paymentIntent: { status: 'succeeded' } }),
  },
  elements: {
    getElement: () => ({}),
  },
});

// Mock hooks that the Payment component might use
const useStripe = () => {
  const context = React.useContext(MockStripeContext);
  return context.stripe;
};

const useElements = () => {
  const context = React.useContext(MockStripeContext);
  return context.elements;
};

// Mock Elements component
const Elements = ({ children }) => {
  const mockValue = {
    stripe: {
      confirmPayment: () => Promise.resolve({ paymentIntent: { status: 'succeeded' } }),
    },
    elements: {
      getElement: () => ({}),
    },
  };

  return (
    <MockStripeContext.Provider value={mockValue}>
      <div data-testid="mock-stripe-elements">
        {children}
      </div>
    </MockStripeContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    payment: {
      type: "object",
      value: {
        amount: 1000,
        currency: "USD",
        paymentOption: "ON_BOOKING",
        data: {
          stripe_publishable_key: "pk_test_123"
        }
      },
      label: "Payment"
    },
    eventType: {
      type: "object",
      value: {
        id: 1,
        successRedirectUrl: "https://example.com/success",
        forwardParamsSuccessRedirect: true
      },
      label: "Event Type"
    },
    user: {
      type: "object",
      value: {
        username: "testuser"
      },
      label: "User"
    },
    location: {
      type: "string",
      value: "Online",
      label: "Location"
    },
    clientSecret: {
      type: "string",
      value: "mock_client_secret",
      label: "Client Secret"
    },
    booking: {
      type: "object",
      value: {
        uid: "booking123"
      },
      label: "Booking"
    }
  });

  return (
    <Elements>
      <ImportedComponent
        payment={state.payment.value}
        eventType={state.eventType.value}
        user={state.user.value}
        location={state.location.value}
        clientSecret={state.clientSecret.value}
        booking={state.booking.value}
        onSubmit={(ev) => {
          ev.preventDefault();
          console.log("Form submitted");
        }}
        onCancel={() => console.log("Cancelled")}
        onPaymentElementChange={() => console.log("Payment element changed")}
        elements={null}
        paymentOption={state.payment.value.paymentOption}
        state={{ status: "idle" }}
      />
    </Elements>
  );
}

// Mock the PaymentElement component that might be used inside ImportedComponent
const PaymentElement = () => {
  return <div data-testid="mock-payment-element">Payment Element Mock</div>;
};

// Export the mocked components and hooks to be available for the ImportedComponent
export const mockStripeReactElements = {
  Elements,
  PaymentElement,
  useStripe,
  useElements,
};
</content>
  </change>
</file>

