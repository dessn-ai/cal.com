import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/(use-page-wrapper)/settings/(settings-layout)/teams/[id]/profile/page';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { TooltipProvider } from '@radix-ui/react-tooltip';
import { I18nextProvider } from 'react-i18next';
import { SessionProvider } from 'next-auth/react';
import { TRPCProvider } from '@calcom/trpc/react';

// Create a mock i18n instance
const i18n = {
  language: 'en',
  languages: ['en'],
  options: {},
  t: (key: string) => key,
  // Add other required i18next methods
  changeLanguage: () => Promise.resolve(),
};

// Create a new QueryClient
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

// Mock components
const MockLegacyPage = () => <div>Mock Legacy Page</div>;
const MockSettingsHeader = ({ children }: { children: React.ReactNode }) => (
  <div>Mock Settings Header {children}</div>
);

// Mock the required modules
jest.mock('@calcom/features/ee/teams/pages/team-profile-view', () => MockLegacyPage);
jest.mock('@calcom/features/settings/appDir/SettingsHeader', () => MockSettingsHeader);
jest.mock('app/_utils', () => ({
  _generateMetadata: () => ({
    title: 'Mock Title',
    description: 'Mock Description'
  }),
  getTranslate: () => (key: string) => key,
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  return (
    <SessionProvider session={null}>
      <I18nextProvider i18n={i18n}>
        <TRPCProvider>
          <QueryClientProvider client={queryClient}>
            <TooltipProvider>
              <div className="preview-container">
                <ImportedComponent />
              </div>
            </TooltipProvider>
          </QueryClientProvider>
        </TRPCProvider>
      </I18nextProvider>
    </SessionProvider>
  );
}
</file>

