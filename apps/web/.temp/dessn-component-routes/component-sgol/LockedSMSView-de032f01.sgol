import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../modules/settings/admin/locked-sms-view';
import { trpc } from "@calcom/trpc";
import { showToast } from "@calcom/ui";

// Mock SMSLockState enum
const SMSLockState = {
  LOCKED: 'LOCKED',
  UNLOCKED: 'UNLOCKED',
  REVIEW_NEEDED: 'REVIEW_NEEDED'
} as const;

// Mock the showToast function
(global as any).showToast = (message: string, type: string) => {
  console.log(`Toast: ${message}, type: ${type}`);
};

// Mock data
const mockUsers = [
  {
    id: 1,
    username: "johndoe",
    name: "John Doe",
    email: "john@example.com",
    smsLockState: SMSLockState.LOCKED,
    avatarUrl: null
  },
  {
    id: 2,
    username: "janedoe",
    name: "Jane Doe",
    email: "jane@example.com",
    smsLockState: SMSLockState.REVIEW_NEEDED,
    avatarUrl: null
  }
];

const mockTeams = [
  {
    id: 1,
    name: "Team A",
    smsLockState: SMSLockState.LOCKED,
    slug: "team-a",
    logoUrl: null
  }
];

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to set for this component
  });

  // Create a more complete mock of trpc
  const mockTrpc = {
    useContext: () => ({
      viewer: {
        admin: {
          getSMSLockStateTeamsUsers: {
            invalidate: () => Promise.resolve(),
          },
        },
      },
    }),
    viewer: {
      admin: {
        setSMSLockState: {
          useMutation: ({ onSuccess, onError }: any) => ({
            mutate: (params: any) => {
              console.log('Mutation called with params:', params);
              // Simulate a successful mutation
              onSuccess?.({
                name: params.username || 'User',
                locked: true,
              });
            },
            isLoading: false,
          }),
        },
        getSMSLockStateTeamsUsers: {
          useQuery: () => ({
            data: {
              users: {
                locked: mockUsers.filter(u => u.smsLockState === SMSLockState.LOCKED),
                reviewNeeded: mockUsers.filter(u => u.smsLockState === SMSLockState.REVIEW_NEEDED)
              },
              teams: {
                locked: mockTeams.filter(t => t.smsLockState === SMSLockState.LOCKED),
                reviewNeeded: mockTeams.filter(t => t.smsLockState === SMSLockState.REVIEW_NEEDED)
              }
            },
            isLoading: false
          })
        }
      },
    },
  };

  // Mock the trpc object
  (trpc as any) = mockTrpc;

  // Mock the prisma client export
  if (typeof window !== 'undefined') {
    (window as any).SMSLockState = SMSLockState;
  }

  return (
    <div className="p-6">
      <ImportedComponent />
    </div>
  );
}
</content>
</change>
</file>

