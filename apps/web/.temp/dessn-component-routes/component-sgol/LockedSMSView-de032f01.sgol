<file name="apps/web/.temp/dessn-component-routes/LockedSMSView-de032f01.tsx" type="preview>
import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../modules/settings/admin/locked-sms-view';
import { trpc } from "@calcom/trpc";
import { showToast } from "@calcom/ui";

// Mock the Prisma client module
jest.mock('@calcom/prisma/client', () => ({
  SMSLockState: {
    LOCKED: 'LOCKED',
    UNLOCKED: 'UNLOCKED',
    REVIEW_NEEDED: 'REVIEW_NEEDED'
  }
}));

// Create a mock module for @calcom/prisma/client
const mockPrismaModule = {
  SMSLockState: {
    LOCKED: 'LOCKED',
    UNLOCKED: 'UNLOCKED',
    REVIEW_NEEDED: 'REVIEW_NEEDED'
  }
};

// Inject the mock module into the module system
if (typeof window !== 'undefined') {
  (window as any).__modules = {
    '@calcom/prisma/client': mockPrismaModule
  };
}

// Mock data using the mock SMSLockState
const mockUsers = [
  {
    id: 1,
    username: "johndoe",
    name: "John Doe",
    email: "john@example.com",
    smsLockState: mockPrismaModule.SMSLockState.LOCKED,
    avatarUrl: null
  },
  {
    id: 2,
    username: "janedoe",
    name: "Jane Doe",
    email: "jane@example.com",
    smsLockState: mockPrismaModule.SMSLockState.REVIEW_NEEDED,
    avatarUrl: null
  }
];

const mockTeams = [
  {
    id: 1,
    name: "Team A",
    smsLockState: mockPrismaModule.SMSLockState.LOCKED,
    slug: "team-a",
    logoUrl: null
  }
];

// Create a proxy to intercept module imports
const ModuleProxy = new Proxy({}, {
  get: (target, prop) => {
    if (prop === '@calcom/prisma/client') {
      return mockPrismaModule;
    }
    return target[prop];
  }
});

// Assign the proxy to global scope
if (typeof window !== 'undefined') {
  (window as any).__modules = ModuleProxy;
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  // Create a more complete mock of trpc
  const mockTrpc = {
    useContext: () => ({
      viewer: {
        admin: {
          getSMSLockStateTeamsUsers: {
            invalidate: () => Promise.resolve(),
          },
        },
      },
    }),
    viewer: {
      admin: {
        setSMSLockState: {
          useMutation: ({ onSuccess, onError }: any) => ({
            mutate: (params: any) => {
              console.log('Mutation called with params:', params);
              onSuccess?.({
                name: params.username || 'User',
                locked: true,
              });
            },
            isLoading: false,
          }),
        },
        getSMSLockStateTeamsUsers: {
          useQuery: () => ({
            data: {
              users: {
                locked: mockUsers.filter(u => u.smsLockState === mockPrismaModule.SMSLockState.LOCKED),
                reviewNeeded: mockUsers.filter(u => u.smsLockState === mockPrismaModule.SMSLockState.REVIEW_NEEDED)
              },
              teams: {
                locked: mockTeams.filter(t => t.smsLockState === mockPrismaModule.SMSLockState.LOCKED),
                reviewNeeded: mockTeams.filter(t => t.smsLockState === mockPrismaModule.SMSLockState.REVIEW_NEEDED)
              }
            },
            isLoading: false
          })
        }
      },
    },
  };

  // Mock the trpc object
  (trpc as any) = mockTrpc;

  return (
    <div className="p-6">
      <ImportedComponent />
    </div>
  );
}

// Add module.exports mock for CommonJS compatibility
if (typeof module !== 'undefined' && module.exports) {
  module.exports = {
    ...mockPrismaModule
  };
}
</file>

