      type: "string",
      value: "https://example.com/logo.png",
      label: "Logo URL",
    },
    slug: {
      type: "string",
      value: "sample-app",
      label: "Slug",
    },
    variant: {
      type: "string",
      value: "other",
      label: "Variant",
    },
    categories: {
      type: "string",
      value: "productivity,communication",
      label: "Categories",
    },
    author: {
      type: "string",
      value: "Sample Author",
      label: "Author",
    },
    price: {
      type: "number",
      value: 0,
      label: "Price",
    },
    email: {
      type: "string",
      value: "support@sampleapp.com",
      label: "Email",
    },
    licenseRequired: {
      type: "boolean",
      value: false,
      label: "License Required",
    },
    concurrentMeetings: {
      type: "boolean",
      value: false,
      label: "Concurrent Meetings",
    },
  });

  const ShellHeading = () => {
    const { t } = useLocale();
    return <span className="block py-2">{t("app_store")}</span>;
  };

  const props = {
    name: state.name.value,
    description: state.description.value,
    type: state.type.value,
    isGlobal: state.isGlobal.value,
    logo: state.logo.value,
    slug: state.slug.value,
    variant: state.variant.value,
