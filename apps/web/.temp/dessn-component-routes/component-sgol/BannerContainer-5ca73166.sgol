import React from 'react';
import { useParentState } from '../useIframeState';
import { BannerContainer } from '../../../../packages/features/shell/banners/LayoutBanner';
import { SessionProvider } from 'next-auth/react';

// Mock session data with proper structure
const mockSession = {
  data: {
    user: {
      id: 1,
      role: 'ADMIN',
      email: 'test@example.com',
      username: 'testuser',
      impersonatedBy: null
    },
    hasValidLicense: true,
    status: "authenticated"
  },
  status: "authenticated"
};

// Create a mock QueryClient
const mockQueryClient = {
  getQueryData: () => null,
  setQueryData: () => null,
  defaultOptions: {
    queries: {
      retry: false,
    },
  },
};

// Mock TRPC responses
const mockTRPCResponses = {
  viewer: {
    teams: {
      list: {
        data: [{
          id: 1,
          name: 'Test Team',
          slug: 'test-team',
          role: 'OWNER'
        }]
      }
    },
    organizations: {
      listCurrent: {
        data: [{
          id: 1,
          name: 'Test Org',
          slug: 'test-org'
        }]
      }
    },
    integrations: {
      appCredentialsByType: {
        data: [{
          type: 'test_type',
          invalid: true
        }]
      }
    }
  }
};

// Create wrapper component with all necessary providers
const ProvidersWrapper = ({ children }) => (
  <SessionProvider session={mockSession}>
    {children}
  </SessionProvider>
);

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    teamUpgradeBanner: {
      type: 'boolean',
      value: true,
      label: 'Show Team Upgrade Banner',
    },
    orgUpgradeBanner: {
      type: 'boolean',
      value: true,
      label: 'Show Org Upgrade Banner',
