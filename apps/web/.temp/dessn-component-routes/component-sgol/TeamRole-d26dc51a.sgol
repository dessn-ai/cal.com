<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { TeamPill } from '../../../../packages/features/ee/teams/components/TeamPill';
import { MembershipRole } from '@calcom/prisma/enums';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    role: {
      type: "dropdown",
      value: "MEMBER",
      options: ["OWNER", "ADMIN", "MEMBER"],
      label: "Role",
    },
  });

  const role = state.role.value as MembershipRole;
  const keys = {
    [MembershipRole.OWNER]: "blue",
    [MembershipRole.ADMIN]: "red",
    [MembershipRole.MEMBER]: undefined,
  };

  return (
    <TeamPill 
      text={role.toLowerCase()}
      color={keys[role]}
    />
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Removed the Jest mocking attempt
2. Instead of using TeamRole, we're using TeamPill directly with the same logic
3. Implemented the role-to-color mapping directly in the preview component
4. Simplified the component structure to avoid the need for useLocale
5. Using the role value directly as the display text

This should work without needing the locale provider or any mocking. The component will display the role name in lowercase with the appropriate color coding.

