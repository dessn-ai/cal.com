import React from 'react';
import { useParentState } from '../useIframeState';
import { Dialog, DialogPortal } from '../../../../packages/platform/atoms/src/components/ui/dialog';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    children: {
      type: "string",
      value: "Dialog Content",
      label: "Children",
    },
    className: {
      type: "string",
      value: "",
      label: "Class Name",
    },
  });

  return (
    <Dialog.Root open={true}>
      <DialogPortal>
        {state.children.value}
      </DialogPortal>
    </Dialog.Root>
  );
}
    </content>
  </change>
</file>

The changes I made:
1. Added import for `Dialog` component alongside `DialogPortal`
2. Wrapped `DialogPortal` with `Dialog.Root`
3. Set `open={true}` on Dialog.Root to ensure the dialog is visible in the preview
4. Kept the existing state management and children rendering

This should resolve the context error since `DialogPortal` now has access to the required Dialog context through `Dialog.Root`.

