<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { OrganizerRequestEmail } from '../../../../packages/emails/src/templates/OrganizerRequestEmail';

const mockTranslate = (key: string) => key;

export default function ComponentPreview() {
  const [state] = useParentState({
    calEvent: {
      type: 'object',
      value: {
        uid: 'event-123',
        title: 'Meeting with John',
        startTime: '2023-06-15T10:00:00',
        endTime: '2023-06-15T11:00:00',
        location: 'Online',
        description: 'Project discussion',
        organizer: {
          id: 1,
          name: 'Jane Doe',
          email: 'jane@example.com',
          timeZone: 'America/New_York',
          language: {
            locale: 'en',
            translate: mockTranslate
          }
        },
        attendees: [
          {
            id: 2,
            name: 'John Smith',
            email: 'john@example.com',
            timeZone: 'America/Los_Angeles',
            language: {
              locale: 'en',
              translate: mockTranslate
            }
          }
        ],
        type: 'default',
        status: 'ACCEPTED'
      },
      label: 'Calendar Event',
    },
    attendee: {
      type: 'object',
      value: {
        id: 2,
        name: 'John Smith',
        email: 'john@example.com',
        timeZone: 'America/Los_Angeles',
        language: {
          locale: 'en',
          translate: mockTranslate
        }
      },
      label: 'Attendee',
    },
    newSeat: {
      type: 'boolean',
      value: false,
      label: 'New Seat',
    },
    attendeeCancelled: {
      type: 'boolean',
      value: false,
      label: 'Attendee Cancelled',
    },
  });

  try {
    return (
      <OrganizerRequestEmail
        calEvent={{
          ...state.calEvent.value,
          organizer: {
            ...state.calEvent.value.organizer,
            language: {
              locale: 'en',
              translate: (key: string) => key
            }
          },
          attendees: state.calEvent.value.attendees.map(attendee => ({
            ...attendee,
            language: {
              locale: 'en',
              translate: (key: string) => key
            }
          }))
        }}
        attendee={{
          ...state.attendee.value,
          language: {
            locale: 'en',
            translate: (key: string) => key
          }
        }}
        newSeat={state.newSeat.value}
        attendeeCancelled={state.attendeeCancelled.value}
      />
    );
  } catch (error) {
    console.error('Error rendering OrganizerRequestEmail:', error);
    return <div>Error rendering email preview</div>;
  }
}
</content>
</change>
</file>

Key changes made:
1. Simplified the component structure
2. Added the translate function directly in the render method
3. Wrapped the component in a try-catch block to handle any rendering errors
4. Removed the separate state manipulation
5. Provided the translate function directly where it's needed
6. Added error boundary rendering
7. Made sure the translate function is defined at the point of use rather than trying to pass it through state

The main difference in this approach is that we're:
1. Defining the translate function directly where it's used
2. Adding error handling
3. Simplifying the overall structure
4. Making sure the function is available at render time

This should resolve the issue with the translate function not being available. If the component still has issues, we'll at least catch them and show a fallback UI instead of crashing.

