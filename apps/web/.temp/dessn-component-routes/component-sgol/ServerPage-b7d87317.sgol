import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../pages/router/index';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { I18nextProvider } from 'react-i18next';
import { SessionProvider } from 'next-auth/react';
import { TooltipProvider } from '@radix-ui/react-tooltip';
import { FeatureProvider } from '@calcom/features/flags/context/provider';
import i18next from 'i18next';

// Create a mock i18n instance
const i18n = i18next.createInstance();
i18n.init({
  lng: 'en',
  fallbackLng: 'en',
  resources: {
    en: {
      translation: {}
    }
  },
  interpolation: {
    escapeValue: false
  }
});

// Create a client
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

// Mock session data
const mockSession = {
  user: {
    id: 1,
    name: 'Test User',
    email: 'test@example.com',
  },
  expires: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString(),
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    formName: {
      type: "string",
      value: "Sample Form",
      label: "Form Name",
    },
    message: {
      type: "string",
      value: "Welcome to the router page",
      label: "Message",
    },
    isEmbed: {
      type: "boolean",
      value: false,
      label: "Is Embed",
    },
  });

  const mockForm = {
    name: state.formName.value,
    // Add other necessary form properties here
  };

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <QueryClientProvider client={queryClient}>
        <SessionProvider session={mockSession}>
          <I18nextProvider i18n={i18n}>
            <TooltipProvider>
              <FeatureProvider>
                <ImportedComponent
                  form={mockForm}
                  message={state.message.value}
                  isEmbed={state.isEmbed.value}
                />
              </FeatureProvider>
            </TooltipProvider>
          </I18nextProvider>
        </SessionProvider>
      </QueryClientProvider>
    </Suspense>
  );
}
</content>
  </change>
</file>

The changes I made include:

1. Removed the import of `../../lib/i18n` which was causing the error
2. Imported i18next directly from the package
3. Created a mock i18n instance with basic configuration
4. Used the mock i18n instance in the I18nextProvider

This should resolve the import error while still providing the necessary i18n functionality for the preview. The mock i18n instance will handle translations in a basic way, which should be sufficient for preview purposes.

