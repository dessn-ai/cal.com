import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';

// Mock crypto functionality
const mockCrypto = {
  randomBytes: (size) => {
    const array = new Uint8Array(size);
    crypto.getRandomValues(array);
    return {
      toString: (format) => {
        if (format === 'hex') {
          return Array.from(array)
            .map(b => b.toString(16).padStart(2, '0'))
            .join('');
        }
        return array.toString();
      }
    };
  }
};

// Mock the generateNonce function
globalThis.generateNonce = () => {
  return mockCrypto.randomBytes(16).toString('hex');
};

// Mock providers to avoid dependency issues
const MockSessionProvider = ({ children }) => <>{children}</>;
const MockI18nextProvider = ({ children }) => <>{children}</>;
const MockTooltipProvider = ({ children }) => <>{children}</>;
const MockFeatureProvider = ({ children }) => <>{children}</>;
const MockQueryClientProvider = ({ children }) => <>{children}</>;

// Mock any server-side only functionality
if (typeof window !== 'undefined') {
  window.crypto = window.crypto || {
    getRandomValues: function(buf) {
      for (let i = 0; i < buf.length; i++) {
        buf[i] = Math.floor(Math.random() * 256);
      }
      return buf;
    }
  };
}

// Import component directly instead of using dynamic import
import ImportedComponent from '../../app/(use-page-wrapper)/signup/page';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    params: {
      type: "string",
      value: JSON.stringify({ id: "example" }),
      label: "Params",
    },
    searchParams: {
      type: "string",
      value: JSON.stringify({ query: "test" }),
      label: "Search Params",
    },
  });

  const pageProps = {
    params: JSON.parse(state.params.value),
    searchParams: JSON.parse(state.searchParams.value),
  };

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <ErrorBoundary>
        <MockSessionProvider>
          <MockI18nextProvider>
            <MockQueryClientProvider>
              <MockTooltipProvider>
                <MockFeatureProvider>
                  <ImportedComponent {...pageProps} />
                </MockFeatureProvider>
              </MockTooltipProvider>
            </MockQueryClientProvider>
          </MockI18nextProvider>
        </MockSessionProvider>
      </ErrorBoundary>
    </Suspense>
  );
}

// Simple Error Boundary component
class ErrorBoundary extends React.Component {
  constructor(props) {
    super(props);
    this.state = { hasError: false };
  }

  static getDerivedStateFromError(error) {
    return { hasError: true };
  }

  componentDidCatch(error, errorInfo) {
    console.error('Component Error:', error, errorInfo);
  }

  render() {
    if (this.state.hasError) {
      return <div>Something went wrong loading the component.</div>;
    }

    return this.props.children;
  }
}

// Mock any other Node.js specific modules that might be used
if (typeof window !== 'undefined') {
  window.crypto = window.crypto || {
    getRandomValues: function(buf) {
      for (let i = 0; i < buf.length; i++) {
        buf[i] = Math.floor(Math.random() * 256);
      }
      return buf;
    }
  };
  
  // Mock other potential Node.js modules
  global.Buffer = global.Buffer || require('buffer').Buffer;
}
