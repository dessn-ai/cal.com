import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/(use-page-wrapper)/signup/page';
import { SessionProvider } from 'next-auth/react';
import { I18nextProvider } from 'react-i18next';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { TooltipProvider } from '@radix-ui/react-tooltip';
import { trpc } from '@calcom/trpc';
import { FeatureProvider } from '@calcom/features/flags/context/provider';

const queryClient = new QueryClient();

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    params: {
      type: "string",
      value: JSON.stringify({ id: "example" }),
      label: "Params",
    },
    searchParams: {
      type: "string",
      value: JSON.stringify({ query: "test" }),
      label: "Search Params",
    },
  });

  const pageProps = {
    params: JSON.parse(state.params.value),
    searchParams: JSON.parse(state.searchParams.value),
  };

  // Mock session data
  const mockSession = {
    expires: new Date(Date.now() + 2 * 86400).toISOString(),
    user: { name: "Test User", email: "test@example.com" }
  };

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <SessionProvider session={mockSession}>
        <I18nextProvider i18n={{} as any}>
          <QueryClientProvider client={queryClient}>
            <trpc.Provider client={queryClient}>
              <TooltipProvider>
                <FeatureProvider>
                  <ImportedComponent {...pageProps} />
                </FeatureProvider>
              </TooltipProvider>
            </trpc.Provider>
          </QueryClientProvider>
        </I18nextProvider>
      </SessionProvider>
    </Suspense>
  );
}
</content>
  </change>
</file>

The changes I made include:

1. Added all the necessary providers that were shown in the component stack trace:
   - SessionProvider
   - I18nextProvider
   - QueryClientProvider
   - TRPCProvider
   - TooltipProvider
   - FeatureProvider

2. Added Suspense wrapper to handle any lazy-loaded components

3. Added mock session data for SessionProvider to prevent authentication-related errors

4. Added necessary imports for all providers

5. Wrapped the ImportedComponent with all providers in the correct order as shown in the stack trace

This should resolve the module fetching error by providing all the required context providers that the signup page needs to function properly. The providers are added in the same order as they appear in the component stack to maintain the correct context hierarchy.

