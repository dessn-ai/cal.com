    <content>
import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/(use-page-wrapper)/[user]/page';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { SessionProvider } from 'next-auth/react';
import { I18nextProvider } from 'react-i18next';
import { TRPCProvider } from '@calcom/trpc/react';
import { TooltipProvider } from '@radix-ui/react-tooltip';
import { FeatureProvider } from '@calcom/features/flags/context/provider';

// Mock crypto functionality
if (typeof global.crypto === 'undefined') {
  global.crypto = {
    randomBytes: (size: number) => ({
      toString: () => Array(size * 2).fill(0).map(() => Math.floor(Math.random() * 16).toString(16)).join('')
    })
  } as any;
}

const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

// Error boundary component
class ErrorBoundary extends React.Component<
  { children: React.ReactNode },
  { hasError: boolean }
> {
  constructor(props: { children: React.ReactNode }) {
    super(props);
    this.state = { hasError: false };
  }

  static getDerivedStateFromError() {
    return { hasError: true };
  }

  render() {
    if (this.state.hasError) {
      return <div>Something went wrong. Please try again.</div>;
    }
    return this.props.children;
  }
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    params: {
      type: "string",
      value: JSON.stringify({ user: "johndoe" }),
      label: "Params",
    },
    searchParams: {
      type: "string",
      value: JSON.stringify({ date: "2023-06-01" }),
      label: "Search Params",
    },
  });

  const params = JSON.parse(state.params.value);
  const searchParams = JSON.parse(state.searchParams.value);

  return (
    <ErrorBoundary>
      <Suspense fallback={<div>Loading...</div>}>
        <SessionProvider>
          <I18nextProvider i18n={{} as any}>
            <QueryClientProvider client={queryClient}>
              <TRPCProvider>
                <TooltipProvider>
                  <FeatureProvider>
                    <ImportedComponent params={params} searchParams={searchParams} />
                  </FeatureProvider>
                </TooltipProvider>
              </TRPCProvider>
            </QueryClientProvider>
          </I18nextProvider>
        </SessionProvider>
      </Suspense>
    </ErrorBoundary>
  );
}
</content>
  </change>
</file>

I've made the following changes to fix the crypto-related error:

1. Added a mock implementation for the `crypto` module that provides a similar functionality to `crypto.randomBytes()` using browser-safe random number generation.

2. Added an ErrorBoundary component to catch and handle any runtime errors gracefully.

3. Configured the QueryClient with more restrictive default options to prevent unnecessary retries and refetches.

4. Wrapped the entire component tree with the ErrorBoundary component.

The mock implementation of crypto provides a similar interface to the Node.js crypto module but uses `Math.random()` instead, which is available in the browser. This should resolve the crypto module resolution error while maintaining similar functionality.

The error boundary will catch any other potential runtime errors that might occur during component rendering and provide a fallback UI instead of crashing the application.

These changes should resolve the crypto module resolution error while making the component more resilient to other potential issues.

