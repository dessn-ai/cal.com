import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/(use-page-wrapper)/[user]/page';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { SessionProvider } from 'next-auth/react';
import { I18nextProvider } from 'react-i18next';
import { TooltipProvider } from '@radix-ui/react-tooltip';

// Create a mock TRPC Provider to avoid initialization issues
const MockTRPCProvider = ({ children }: { children: React.ReactNode }) => {
  return <>{children}</>;
};

// Create a mock Feature Provider
const MockFeatureProvider = ({ children }: { children: React.ReactNode }) => {
  return <>{children}</>;
};

// Mock i18n instance
const i18nInstance = {
  language: 'en',
  languages: ['en'],
  loadNamespaces: () => Promise.resolve(),
  loadLanguages: () => Promise.resolve(),
  t: (key: string) => key,
  exists: () => false,
};

const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
      staleTime: Infinity,
    },
  },
});

export default function ComponentPreview() {
  try {
    const [state, setState] = useParentState({
      params: {
        type: "string",
        value: JSON.stringify({ user: "johndoe" }),
        label: "Params",
      },
      searchParams: {
        type: "string",
        value: JSON.stringify({ date: "2023-06-01" }),
        label: "Search Params",
      },
    });

    const params = JSON.parse(state.params.value);
    const searchParams = JSON.parse(state.searchParams.value);

    return (
      <Suspense fallback={<div>Loading...</div>}>
        <SessionProvider session={null}>
          <I18nextProvider i18n={i18nInstance as any}>
            <QueryClientProvider client={queryClient}>
              <MockTRPCProvider>
                <TooltipProvider>
                  <MockFeatureProvider>
                    <div style={{ padding: '20px' }}>
                      <ImportedComponent params={params} searchParams={searchParams} />
                    </div>
                  </MockFeatureProvider>
                </TooltipProvider>
              </MockTRPCProvider>
            </QueryClientProvider>
          </I18nextProvider>
        </SessionProvider>
      </Suspense>
    );
  } catch (error) {
    console.error('Preview Error:', error);
    return <div>Error loading preview component</div>;
  }
}
</content>
  </change>
</file>

I've made several changes to fix the dynamic import issue:

1. Replaced the complex TRPC provider with a simple mock version that just renders children
2. Created a mock Feature Provider to avoid initialization issues
3. Created a proper i18n instance mock with required methods
4. Removed the custom ErrorBoundary in favor of a try-catch block
5. Added proper session handling for SessionProvider
6. Simplified the provider structure
7. Added error handling with try-catch
8. Removed the global crypto mock as it might be causing issues
9. Added padding to the preview container for better visibility
10. Set QueryClient with infinity staleTime to prevent unnecessary refetches

The main changes focus on:
- Simplifying the provider structure
- Using mock providers where possible
- Better error handling
- Removing potentially problematic global modifications

These changes should help resolve the dynamic import issue while maintaining the necessary context for the component to render properly. The mock providers should provide enough context for the component to work without initializing complex external services.

