import React, { createContext, useContext, useState } from 'react';
import { useParentState } from '../useIframeState';
import { AverageEventDurationChart } from '../../../../packages/features/insights/components/AverageEventDurationChart';

// Create mock contexts
const InsightsParametersContext = createContext<any>(null);

// Mock session data
const mockSession = {
  data: {
    user: {
      id: 1,
      org: {
        id: 1
      }
    }
  }
};

// Mock the trpc hook
const mockTrpc = {
  viewer: {
    insights: {
      averageEventDuration: {
        useQuery: () => ({
          data: [
            { Date: '2024-01-01', Average: 30 },
            { Date: '2024-01-02', Average: 45 },
            { Date: '2024-01-03', Average: 35 }
          ],
          isSuccess: true,
          isPending: false
        })
      }
    }
  }
};

// Mock providers for preview
const I18nLanguageHandler = ({ children }: { children: React.ReactNode }) => {
  return <>{children}</>;
};

// Mock TRPC Provider
const MockTRPCProvider = ({ children }: { children: React.ReactNode }) => {
  React.useEffect(() => {
    (window as any).trpc = mockTrpc;
  }, []);
  return <>{children}</>;
};

// Mock InsightsParameters Provider
const MockInsightsParametersProvider = ({ children }: { children: React.ReactNode }) => {
  const parameters = {
    isAll: true,
    teamId: 1,
    userId: 1,
    memberUserId: null,
    startDate: new Date('2024-01-01'),
    endDate: new Date('2024-01-31'),
    eventTypeId: null,
    selectedTimeView: 'week',
    selectedCustomViewStartDate: null,
    selectedCustomViewEndDate: null,
    setSelectedTimeView: () => {},
    setSelectedCustomViewStartDate: () => {},
    setSelectedCustomViewEndDate: () => {}
  };

  return (
    <InsightsParametersContext.Provider value={parameters}>
      {children}
    </InsightsParametersContext.Provider>
  );
};

// Create a wrapper component that provides mock data
const MockInsightsWrapper = ({ children }: { children: React.ReactNode }) => {
  // Override hooks
  React.useEffect(() => {
    (window as any).useSession = () => mockSession;
    (window as any).useInsightsParameters = () => {
      const context = useContext(InsightsParametersContext);
      if (!context) {
        throw new Error("useInsightsParameters must be used within a InsightsParametersProvider");
      }
      return context;
    };
    (window as any).useLocale = () => ({
      t: (key: string) => key,
      i18n: { language: 'en' }
    });
  }, []);

  return (
    <MockInsightsParametersProvider>
      {children}
    </MockInsightsParametersProvider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to set for this component
  });

  return (
    <I18nLanguageHandler>
      <MockTRPCProvider>
        <MockInsightsWrapper>
          <div style={{ width: '100%', height: '400px' }}>
            <AverageEventDurationChart />
          </div>
        </MockInsightsWrapper>
      </MockTRPCProvider>
    </I18nLanguageHandler>
  );
}
</content>
</change>
</file>

