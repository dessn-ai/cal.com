  return {
    orgTeamsType: context.orgTeamsType,
    setOrgTeamsType: context.setOrgTeamsType,
    selectedTeamId: context.selectedTeamId,
    setSelectedTeamId: context.setSelectedTeamId,
    isAll: context.orgTeamsType === 'org',
    teamId: context.selectedTeamId,
    userId: mockSession.data.user.id
  };
};

