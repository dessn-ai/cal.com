import React, { createContext, useContext, useState } from 'react';
import { useParentState } from '../useIframeState';
import { AverageEventDurationChart } from '../../../../packages/features/insights/components/AverageEventDurationChart';

// Create mock InsightsOrgTeamsContext
const InsightsOrgTeamsContext = createContext<{
  orgTeamsType: 'org' | 'team' | 'yours';
  selectedTeamId: number | null;
  setOrgTeamsType: (type: 'org' | 'team' | 'yours') => void;
  setSelectedTeamId: (id: number | null) => void;
} | null>(null);

// Mock InsightsOrgTeamsProvider
const MockInsightsOrgTeamsProvider = ({ children }: { children: React.ReactNode }) => {
  const [orgTeamsType, setOrgTeamsType] = useState<'org' | 'team' | 'yours'>('team');
  const [selectedTeamId, setSelectedTeamId] = useState<number | null>(1);

  return (
    <InsightsOrgTeamsContext.Provider
      value={{
        orgTeamsType,
        selectedTeamId,
        setOrgTeamsType,
        setSelectedTeamId,
      }}>
      {children}
    </InsightsOrgTeamsContext.Provider>
  );
};

// Mock session data
const mockSession = {
  data: {
    user: {
      id: 1,
      org: {
        id: 1
      }
    }
  }
};

// Mock next-auth session
jest.mock('next-auth/react', () => ({
  useSession: () => mockSession
}));

// Mock providers for preview
const I18nLanguageHandler = ({ children }: { children: React.ReactNode }) => {
  return <>{children}</>;
};

// Mock TRPC Provider
const MockTRPCProvider = ({ children }: { children: React.ReactNode }) => {
  return <>{children}</>;
};

// Create a wrapper component that provides mock data
const MockInsightsWrapper = ({ children }: { children: React.ReactNode }) => {
  return (
    <MockInsightsOrgTeamsProvider>
      {children}
    </MockInsightsOrgTeamsProvider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to set for this component
  });

  // Mock the useSession hook
  (window as any).useSession = () => mockSession;

  return (
    <I18nLanguageHandler>
      <MockTRPCProvider>
        <MockInsightsWrapper>
          <div style={{ width: '100%', height: '400px' }}>
            <AverageEventDurationChart />
          </div>
        </MockInsightsWrapper>
      </MockTRPCProvider>
    </I18nLanguageHandler>
  );
}
</content>
</change>
