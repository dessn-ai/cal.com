import React, { createContext, useState } from 'react';
import { useParentState } from '../useIframeState';
import { AverageEventDurationChart } from '../../../../packages/features/insights/components/AverageEventDurationChart';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { createTRPCReact, httpBatchLink } from '@trpc/react-query';
import superjson from 'superjson';
import { SessionProvider } from 'next-auth/react';

// Create mock InsightsOrgTeamsContext
export const InsightsOrgTeamsContext = createContext(null);

const InsightsOrgTeamsProvider = ({ children }) => {
  const [orgTeamsType, setOrgTeamsType] = useState("org");
  const [selectedTeamId, setSelectedTeamId] = useState(null);

  return (
    <InsightsOrgTeamsContext.Provider
      value={{
        orgTeamsType,
        setOrgTeamsType,
        selectedTeamId,
        setSelectedTeamId,
      }}>
      {children}
    </InsightsOrgTeamsContext.Provider>
  );
};

// Create a mock TRPC instance
const trpc = createTRPCReact();

// Mock data provider
const mockTrpcProvider = trpc.createClient({
  links: [
    httpBatchLink({
      url: 'http://localhost:3000/api/trpc',
    }),
  ],
  transformer: superjson,
});

// Mock session data
const mockSession = {
  data: {
    user: {
      id: 1,
      org: {
        id: 1,
      },
    },
  },
  status: 'authenticated',
};

// Create a wrapper component to provide mock data
const MockProvider = ({ children }) => {
  const [queryClient] = React.useState(() => new QueryClient({
    defaultOptions: {
      queries: {
        retry: false,
      },
    },
  }));

  // Mock the TRPC query response
  React.useEffect(() => {
    queryClient.setQueryData(
      [['viewer', 'insights', 'averageEventDuration']],
      [
        { Date: '2023-01-01', Average: 30 },
        { Date: '2023-01-02', Average: 45 },
        { Date: '2023-01-03', Average: 35 },
        { Date: '2023-01-04', Average: 40 },
      ]
    );
  }, [queryClient]);

  return (
    <SessionProvider session={mockSession}>
      <InsightsOrgTeamsProvider>
        <trpc.Provider client={mockTrpcProvider} queryClient={queryClient}>
          <QueryClientProvider client={queryClient}>
            {children}
          </QueryClientProvider>
        </trpc.Provider>
      </InsightsOrgTeamsProvider>
    </SessionProvider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to set for this component
  });

  return (
    <MockProvider>
      <AverageEventDurationChart />
    </MockProvider>
  );
}
</content>
  </change>
</file>

I've made the following changes:
1. Added the InsightsOrgTeamsProvider with mock context values
2. Added SessionProvider with mock session data
3. Created the InsightsOrgTeamsContext and its provider implementation
4. Wrapped the component with all necessary providers in the correct order
5. Provided mock data for the session and team context

This should resolve the error by providing all the required context providers and mock data that the AverageEventDurationChart component needs to function properly.

