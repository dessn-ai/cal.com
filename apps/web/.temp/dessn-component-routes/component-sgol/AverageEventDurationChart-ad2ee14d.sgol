<description>Simplify by directly mocking hooks without context providers</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { AverageEventDurationChart } from '../../../../packages/features/insights/components/AverageEventDurationChart';

// Mock data
const mockSession = {
  data: {
    user: {
      id: 1,
      org: {
        id: 1
      }
    }
  }
};

const mockInsightsData = {
  orgTeamsType: 'team' as const,
  selectedTeamId: 1,
  setOrgTeamsType: () => {},
  setSelectedTeamId: () => {},
  isAll: false,
  teamId: 1,
  userId: 1,
  memberUserId: null,
  startDate: new Date('2024-01-01'),
  endDate: new Date('2024-01-31'),
  eventTypeId: null
};

// Mock the trpc hook
const mockTrpc = {
  viewer: {
    insights: {
      averageEventDuration: {
        useQuery: () => ({
          data: [
            { Date: '2024-01-01', Average: 30 },
            { Date: '2024-01-02', Average: 45 },
            { Date: '2024-01-03', Average: 35 }
          ],
          isSuccess: true,
          isPending: false
        })
      }
    }
  }
};

// Mock providers for preview
const I18nLanguageHandler = ({ children }: { children: React.ReactNode }) => {
  return <>{children}</>;
};

// Mock TRPC Provider
const MockTRPCProvider = ({ children }: { children: React.ReactNode }) => {
  return <>{children}</>;
};

// Create a wrapper component that provides mock data
const MockInsightsWrapper = ({ children }: { children: React.ReactNode }) => {
  // Set up all mocks before rendering
  React.useEffect(() => {
    // Mock all required hooks
    Object.assign(window, {
      useSession: () => mockSession,
      useInsightsOrgTeams: () => mockInsightsData,
      useInsightsParameters: () => mockInsightsData,
      useLocale: () => ({
        t: (key: string) => key,
        i18n: { language: 'en' }
      }),
      trpc: mockTrpc
    });
  }, []);

  return <>{children}</>;
};

export default function ComponentPreview() {
  // Set up mocks immediately
  React.useEffect(() => {
    Object.assign(window, {
      useSession: () => mockSession,
      useInsightsOrgTeams: () => mockInsightsData,
      useInsightsParameters: () => mockInsightsData,
      useLocale: () => ({
        t: (key: string) => key,
        i18n: { language: 'en' }
      }),
      trpc: mockTrpc
    });
  }, []);

  return (
    <I18nLanguageHandler>
      <MockTRPCProvider>
        <MockInsightsWrapper>
          <div style={{ width: '100%', height: '400px' }}>
            <AverageEventDurationChart />
          </div>
        </MockInsightsWrapper>
      </MockTRPCProvider>
    </I18nLanguageHandler>
  );
}
</content>
</change>
</file>

