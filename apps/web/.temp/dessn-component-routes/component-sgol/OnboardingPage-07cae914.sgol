import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../modules/apps/installation/[[...step]]/step-view';

// Mock Prisma Client module
const mockPrismaModule = {
  SchedulingType: {
    ROUND_ROBIN: 'ROUND_ROBIN',
    COLLECTIVE: 'COLLECTIVE',
    MANAGED: 'MANAGED'
  }
};

// Mock the module
if (typeof window !== 'undefined') {
  (window as any).__mocks__ = {
    ...(window as any).__mocks__,
    '@calcom/prisma': mockPrismaModule
  };
}

// Mock the types and data structures needed by the component
const mockEventType = {
  id: 1,
  title: "Default Event",
  slug: "default-event",
  length: 30,
  description: "",
  schedulingType: mockPrismaModule.SchedulingType.ROUND_ROBIN,
  hidden: false,
  position: 0,
  metadata: {},
  locations: [],
  bookingFields: [],
  selected: false,
  requiresConfirmation: false,
  destinationCalendar: null,
  seatsPerTimeSlot: null
};

const AppOnboardingSteps = {
  ACCOUNTS_STEP: "accounts_step",
  EVENT_TYPES_STEP: "event_types_step",
  CONFIGURE_STEP: "configure_step",
} as const;

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    appMetadata: {
      type: "string",
      value: JSON.stringify({
        name: "Sample App",
        type: "calendar_other",
        categories: ["calendar"],
        variant: "other",
        slug: "sample-app"
      }),
