<file path="apps/web/.temp/dessn-component-routes/OnboardingPage-07cae914.tsx">
  <change>
    <description>Create a wrapper component with mocked Prisma exports</description>
    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../modules/apps/installation/[[...step]]/step-view';

// Mock the Prisma types and exports
const MockPrismaProvider = ({ children }) => {
  // Create a mock module object
  const mockModule = {
    SchedulingType: {
      ROUND_ROBIN: "ROUND_ROBIN",
      COLLECTIVE: "COLLECTIVE",
      MANAGED: "MANAGED"
    }
  };

  // Create a context to hold the mock
  const PrismaMockContext = React.createContext(mockModule);

  return (
    <PrismaMockContext.Provider value={mockModule}>
      {children}
    </PrismaMockContext.Provider>
  );
};

// Wrap the imported component to provide mocked values
const WrappedImportedComponent = (props) => {
  return (
    <MockPrismaProvider>
      <div data-testid="wrapped-component">
        <ImportedComponent {...props} />
      </div>
    </MockPrismaProvider>
  );
};

const PreviewComponent = () => {
  const [state, setState] = useParentState({
    appMetadata: {
      type: "string",
      value: JSON.stringify({
        name: "Sample App",
        type: "calendar_other",
        categories: ["calendar"],
        slug: "sample-app",
        variant: "other_calendar"
      }),
      label: "App Metadata"
    },
    step: {
      type: "string",
      value: "accounts_step",
      label: "Current Step"
    },
    userName: {
      type: "string",
      value: "John Doe",
      label: "User Name"
    },
    showEventTypesStep: {
      type: "boolean",
      value: true,
      label: "Show Event Types Step"
    },
    isConferencing: {
      type: "boolean",
      value: false,
      label: "Is Conferencing"
    },
    installableOnTeams: {
      type: "boolean",
      value: true,
      label: "Installable on Teams"
    },
    isOrg: {
      type: "boolean",
      value: false,
      label: "Is Organization"
    }
  });

  const personalAccount = {
    id: 1,
    avatarUrl: "https://example.com/avatar.jpg",
    name: "John Doe",
    alreadyInstalled: false
  };

  // Add error handling wrapper
  const renderComponent = () => {
    try {
      return (
        <WrappedImportedComponent
          appMetadata={JSON.parse(state.appMetadata.value)}
          step={state.step.value}
          userName={state.userName.value}
          showEventTypesStep={state.showEventTypesStep.value}
          isConferencing={state.isConferencing.value}
          installableOnTeams={state.installableOnTeams.value}
          isOrg={state.isOrg.value}
          personalAccount={personalAccount}
        />
      );
    } catch (error) {
      console.error('Error rendering component:', error);
      return <div>Error: Failed to load component</div>;
    }
  };

  return (
    <React.Suspense fallback={<div>Loading...</div>}>
      {renderComponent()}
    </React.Suspense>
  );
};

// Add the mock to the window object as well
if (typeof window !== 'undefined') {
  Object.defineProperty(window, '__prismaClient', {
    value: {
      SchedulingType: {
        ROUND_ROBIN: "ROUND_ROBIN",
        COLLECTIVE: "COLLECTIVE",
        MANAGED: "MANAGED"
      }
    },
    writable: false,
    configurable: false
  });
}

export default PreviewComponent;
</content>
  </change>
</file>

