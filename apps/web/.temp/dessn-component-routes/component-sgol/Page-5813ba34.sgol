import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';

// Mock components and utilities
const MockSettingsHeader = ({ children }: { children: React.ReactNode }) => (
  <div data-testid="settings-header">{children}</div>
);

const MockCreateNewOutOfOfficeEntryButton = () => (
  <button data-testid="add_entry_ooo">Add Entry</button>
);

const MockOutOfOfficeEntriesList = () => (
  <div data-testid="out-of-office-entries-list">Entries List</div>
);

// Mock the metadata generator
const mockGenerateMetadata = () => ({
  title: "Out of Office",
  description: "Out of Office settings"
});

// Create mock modules
const mockModules = {
  "@calcom/features/settings/appDir/SettingsHeader": MockSettingsHeader,
  "@calcom/features/settings/outOfOffice/CreateNewOutOfOfficeEntryButton": MockCreateNewOutOfOfficeEntryButton,
  "@calcom/features/settings/outOfOffice/OutOfOfficeEntriesList": {
    OutOfOfficeEntriesList: MockOutOfOfficeEntriesList
  },
  "app/_utils": {
    _generateMetadata: mockGenerateMetadata,
    getTranslate: () => (key: string) => key,
  }
};

// Mock the modules
jest.mock("@calcom/features/settings/appDir/SettingsHeader", () => mockModules["@calcom/features/settings/appDir/SettingsHeader"]);
jest.mock("@calcom/features/settings/outOfOffice/CreateNewOutOfOfficeEntryButton", () => 
  mockModules["@calcom/features/settings/outOfOffice/CreateNewOutOfOfficeEntryButton"]);
jest.mock("@calcom/features/settings/outOfOffice/OutOfOfficeEntriesList", () => 
  mockModules["@calcom/features/settings/outOfOffice/OutOfOfficeEntriesList"]);
jest.mock("app/_utils", () => mockModules["app/_utils"]);

// Lazy load the component to handle dynamic imports better
const ImportedComponent = React.lazy(() => import('../../app/(use-page-wrapper)/settings/(settings-layout)/my-account/out-of-office/page'));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    // No props to configure for this component
  });

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <ImportedComponent />
    </Suspense>
  );
}
</content>
  </change>
</file>

