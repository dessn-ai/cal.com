        byUser: 'Bob Manager',
      },
      label: 'Reassigned',
    },
    timeZone: {
      type: 'string',
      value: 'UTC',
      label: 'Time Zone',
    },
    includeAppsStatus: {
      type: 'boolean',
      value: false,
      label: 'Include Apps Status',
    },
    locale: {
      type: 'string',
      value: 'en',
      label: 'Locale',
