import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { CreateANewTeamForm } from '../../../../packages/features/ee/teams/components/CreateANewTeamForm';
import { useForm } from 'react-hook-form';

// Create mock context and provider
const MockOrgBrandingContext = createContext({
  organization: {
    logo: '',
    name: 'Test Organization',
    slug: 'test-org',
    theme: null,
  },
});

// Create mock hook that CreateANewTeamForm will use
export const useOrgBranding = () => {
  return useContext(MockOrgBrandingContext).organization;
};

// Override the actual module
const MockOrgBrandingProvider = ({ children }) => {
  const value = {
    organization: {
      logo: '',
      name: 'Test Organization',
      slug: 'test-org',
      theme: null,
    },
  };

  return (
    <MockOrgBrandingContext.Provider value={value}>
      {children}
    </MockOrgBrandingContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    submitLabel: {
      type: "string",
