import React from 'react';
import { useParentState } from '../useIframeState';
import { CreateANewTeamForm } from '../../../../packages/features/ee/teams/components/CreateANewTeamForm';

import { useForm } from 'react-hook-form';

// Create a wrapper component that doesn't use org branding
const CreateTeamFormWrapper = (props) => {
  try {
    return <CreateANewTeamForm {...props} />;
  } catch (error) {
    // Fallback UI if the component fails
    return (
      <div className="space-y-4">
        <h2 className="text-lg font-medium">Create New Team</h2>
        <p>Team creation form placeholder</p>
      </div>
    );
  }
};

