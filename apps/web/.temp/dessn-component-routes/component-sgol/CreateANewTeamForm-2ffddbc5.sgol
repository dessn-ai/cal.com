import React from 'react';
import { useParentState } from '../useIframeState';
import { CreateANewTeamForm as OriginalCreateANewTeamForm } from '../../../../packages/features/ee/teams/components/CreateANewTeamForm';

// Mock the useOrgBranding hook
jest.mock('../../../../packages/features/ee/organizations/context/provider', () => ({
  useOrgBranding: () => ({
    logo: '',
    name: 'Test Organization',
    brand: {
      brandColor: '#292929',
      darkBrandColor: '#fafafa',
      theme: null,
    }
  })
}));

// Create a wrapped version of the component
const WrappedCreateANewTeamForm = (props: any) => {
  try {
    return <OriginalCreateANewTeamForm {...props} />;
  } catch (error) {
    console.error('Error in CreateANewTeamForm:', error);
    return (
      <div className="p-4 border rounded">
        <h3>Create New Team Form</h3>
        <p>Preview mode: Some features may be limited</p>
        <button 
          className="bg-blue-500 text-white px-4 py-2 rounded"
          onClick={() => props.onSuccess({ teamName: 'Test Team' })}
        >
          {props.submitLabel}
        </button>
        {props.inDialog && (
          <button 
            className="ml-2 px-4 py-2 rounded border"
            onClick={props.onCancel}
          >
            Cancel
          </button>
        )}
      </div>
    );
  }
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    submitLabel: {
      type: "string",
      value: "Create Team",
      label: "Submit Label",
    },
    inDialog: {
      type: "boolean",
      value: false,
      label: "In Dialog",
    },
    slug: {
      type: "string",
      value: "my-team",
      label: "Slug",
    },
  });

  const onCancel = () => {
    console.log("Cancelled");
  };

  const onSuccess = (data: any) => {
    console.log("Success:", data);
  };

  return (
    <WrappedCreateANewTeamForm
      onCancel={onCancel}
      submitLabel={state.submitLabel.value}
      onSuccess={onSuccess}
      inDialog={state.inDialog.value}
      slug={state.slug.value}
    />
  );
}
</content>
