import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/ee/workflows/pages/index';
import { SessionProvider } from 'next-auth/react';
import { trpc } from '@calcom/trpc/react';
import { createContext } from 'react';

// Create mock context and provider for org branding
const OrgContext = createContext({
  orgBranding: {
    theme: null,
    orgSlug: null,
    hideBranding: false,
    logo: '',
    name: 'Default Organization',
    isLoading: false,
  },
  setOrgBranding: () => {},
});

const MockOrgBrandingProvider = ({ children }) => {
  const value = {
    orgBranding: {
      theme: null,
      orgSlug: null,
      hideBranding: false,
      logo: '',
      name: 'Default Organization',
      isLoading: false,
    },
    setOrgBranding: () => {},
  };

  return <OrgContext.Provider value={value}>{children}</OrgContext.Provider>;
};

// Mock the actual module
jest.mock('@calcom/features/ee/organizations/context/provider', () => ({
  OrgBrandingProvider: MockOrgBrandingProvider,
  useOrgBranding: () => ({
    orgBranding: {
      theme: null,
      orgSlug: null,
      hideBranding: false,
      logo: '',
      name: 'Default Organization',
      isLoading: false,
    },
  }),
}));

const mockSession = {
  user: {
    id: 1,
    name: 'John Doe',
    username: 'johndoe',
  },
  hasValidLicense: true,
  expires: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString(),
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    filteredList: {
      type: 'string',
      value: JSON.stringify({
        totalCount: 5,
        filtered: [
          {
            id: 1,
            name: 'Sample Workflow 1',
            activeOn: [],
            steps: [],
            team: null,
          },
          {
            id: 2,
            name: 'Sample Workflow 2',
            activeOn: [],
            steps: [],
            team: null,
          },
        ],
      }),
      label: 'Filtered List',
    },
  });

  const parsedFilteredList = JSON.parse(state.filteredList.value);

  // Mock trpc
  trpc.viewer.workflows.filteredList.useQuery = () => ({
    data: parsedFilteredList,
    isPending: false,
  });

  trpc.viewer.workflows.create.useMutation = () => ({
    mutate: () => {},
    isPending: false,
  });

  return (
    <SessionProvider session={mockSession}>
      <MockOrgBrandingProvider>
        <ImportedComponent filteredList={parsedFilteredList} />
      </MockOrgBrandingProvider>
    </SessionProvider>
  );
}
