import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/ee/workflows/pages/index';
import { SessionProvider } from 'next-auth/react';
import { trpc } from '@calcom/trpc/react';

// Create a mock context
const OrgBrandingContext = createContext({
  orgBranding: {
    theme: null,
    orgSlug: null,
    hideBranding: false,
    logo: '',
    name: 'Default Organization',
    isLoading: false,
  },
  setOrgBranding: () => {},
});

// Create a custom provider component
const MockOrgBrandingProvider = ({ children }) => {
  const value = {
    orgBranding: {
      theme: null,
      orgSlug: null,
      hideBranding: false,
      logo: '',
      name: 'Default Organization',
      isLoading: false,
    },
    setOrgBranding: () => {},
  };

  return (
    <OrgBrandingContext.Provider value={value}>
      {children}
    </OrgBrandingContext.Provider>
  );
};

const mockSession = {
  user: {
    id: 1,
    name: 'John Doe',
    username: 'johndoe',
  },
  hasValidLicense: true,
  expires: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString(),
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    filteredList: {
      type: 'string',
      value: JSON.stringify({
        totalCount: 5,
        filtered: [
          {
            id: 1,
            name: 'Sample Workflow 1',
            activeOn: [],
            steps: [],
            team: null,
          },
          {
            id: 2,
            name: 'Sample Workflow 2',
            activeOn: [],
            steps: [],
            team: null,
          },
        ],
      }),
      label: 'Filtered List',
    },
  });

  const parsedFilteredList = JSON.parse(state.filteredList.value);

  // Mock trpc
  trpc.viewer.workflows.filteredList.useQuery = () => ({
    data: parsedFilteredList,
    isPending: false,
  });

  trpc.viewer.workflows.create.useMutation = () => ({
    mutate: () => {},
    isPending: false,
  });

  return (
    <SessionProvider session={mockSession}>
      <MockOrgBrandingProvider>
        <ImportedComponent filteredList={parsedFilteredList} />
      </MockOrgBrandingProvider>
    </SessionProvider>
  );
}

// Export the useOrgBranding hook to be used by other components
export const useOrgBranding = () => useContext(OrgBrandingContext);
</content>
  </change>
</file>

