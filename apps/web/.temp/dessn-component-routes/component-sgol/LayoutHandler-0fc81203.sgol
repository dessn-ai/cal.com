<description>Mock the Prisma client and add necessary providers</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/app-store/routing-forms/pages/layout-handler/[...appPages]';
import { FormProvider, useForm } from 'react-hook-form';

// Mock the entire prisma client
const mockPrismaClient = {
  SchedulingType: {
    ROUND_ROBIN: "ROUND_ROBIN",
    COLLECTIVE: "COLLECTIVE",
    MANAGED: "MANAGED"
  }
};

// Mock the module
if (typeof window !== 'undefined') {
  window.prismaClient = mockPrismaClient;
}

// Create a feature flags context
const FeatureFlagsContext = React.createContext({
  features: new Set(),
  isEnabled: () => false,
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    exampleProp: {
      type: "string",
      value: "Example Value",
      label: "Example Prop",
    },
  });

  const methods = useForm();

  // Wrap the component with error handling
  return (
    <FeatureFlagsContext.Provider value={{ features: new Set(), isEnabled: () => false }}>
      <FormProvider {...methods}>
        <React.Suspense fallback={<div>Loading...</div>}>
          <ErrorBoundaryWrapper>
            <ImportedComponent {...state} />
          </ErrorBoundaryWrapper>
        </React.Suspense>
      </FormProvider>
    </FeatureFlagsContext.Provider>
  );
}

// Error boundary wrapper component
function ErrorBoundaryWrapper({ children }: { children: React.ReactNode }) {
  const [error, setError] = React.useState<Error | null>(null);

  React.useEffect(() => {
    const handleError = (event: ErrorEvent) => {
      event.preventDefault();
      setError(event.error);
    };

    window.addEventListener('error', handleError);
    return () => window.removeEventListener('error', handleError);
  }, []);

  if (error) {
    return (
      <div>
        <h2>Something went wrong</h2>
        <pre>{error.message}</pre>
      </div>
    );
  }

  try {
    return <>{children}</>;
  } catch (err) {
    setError(err as Error);
    return null;
  }
}

// Export mock types that might be needed
export const SchedulingType = mockPrismaClient.SchedulingType;
</content>
</change>
</file>

I've made several changes to try to resolve the issue:

1. Created a mock Prisma client object with the `SchedulingType` enum
2. Added it to the window object to make it globally available
3. Created a more robust error boundary wrapper with error logging
4. Added a FeatureFlagsContext provider since it appears in the stack trace
5. Exported the mock SchedulingType directly
6. Wrapped everything in a try-catch block to handle potential runtime errors

The key changes are:
- Mocking the Prisma client globally
- Adding better error handling
- Including the FeatureFlagsContext provider
- Exporting the SchedulingType enum directly

If this error still persists, we might need to:
1. Mock additional Prisma types
2. Add more providers from the stack trace
3. Or try to intercept the import differently

