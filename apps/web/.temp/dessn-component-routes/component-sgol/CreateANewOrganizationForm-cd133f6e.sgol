<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { CreateANewOrganizationForm } from '../../../../packages/features/ee/organizations/components/CreateANewOrganizationForm';
import { SessionProvider } from 'next-auth/react';
import { UserPermissionRole } from '@calcom/prisma/enums';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    mockSession: {
      type: 'boolean',
      value: true,
      label: 'Mock Session',
    },
  });

  // Create a properly structured mock session
  const mockSession = {
    expires: new Date(Date.now() + 2 * 86400).toISOString(),
    user: {
      id: 1,
      email: 'user@example.com',
      name: 'Test User',
      role: UserPermissionRole.USER,
      username: 'testuser',
      completedOnboarding: true,
      timeZone: 'UTC',
      weekStart: 'Monday',
      startTime: 0,
      endTime: 1440,
      defaultScheduleId: null,
      bufferTime: 0,
      theme: null,
    },
  };

  return (
    <div className="m-4">
      <SessionProvider 
        session={{
          data: mockSession,
          status: "authenticated",
          update: () => Promise.resolve(mockSession)
        }}
      >
        <CreateANewOrganizationForm />
      </SessionProvider>
    </div>
  );
}
</content>
</change>
</file>

Key changes made:

1. Restructured the mock session to better match the next-auth session structure
2. Moved the user object to the top level of mockSession
3. Changed how we pass the session to SessionProvider
4. Made sure all required user properties are present
5. Ensured the update function returns the correct type
6. Simplified the session structure to match what next-auth expects

The main difference is in how we structure the session data. Instead of nesting the user inside data, we create the session object first and then wrap it in the structure that SessionProvider expects. This should better match what the CreateANewOrganizationForm component is expecting when it accesses session.data.user.role.

The session is now structured as:
```typescript
{
  data: {
    expires: string,
    user: {
      // user properties
    }
  },
  status: "authenticated",
  update: () => Promise<Session>
}
```

This structure should properly provide the user.role property that the component is trying to access. Let's see if this resolves the error.

