<description>Add error boundary and mock server-side functionality</description>
<content>
import React, { Component } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/(use-page-wrapper)/settings/platform/page';

// Error Boundary to catch crypto-related errors
class ErrorBoundary extends Component<
  { children: React.ReactNode },
  { hasError: boolean }
> {
  constructor(props: { children: React.ReactNode }) {
    super(props);
    this.state = { hasError: false };
  }

  static getDerivedStateFromError(error: Error) {
    return { hasError: true };
  }

  render() {
    if (this.state.hasError) {
      return (
        <div className="p-4 text-red-500">
          This component requires server-side functionality and cannot be previewed in the current environment.
        </div>
      );
    }

    return this.props.children;
  }
}

// Mock crypto functionality if needed
if (typeof window !== 'undefined' && !window.crypto) {
  (window as any).crypto = {
    getRandomValues: function(buffer: Uint8Array) {
      for (let i = 0; i < buffer.length; i++) {
        buffer[i] = Math.floor(Math.random() * 256);
      }
      return buffer;
    }
  };
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  return (
    <ErrorBoundary>
      <ImportedComponent />
    </ErrorBoundary>
  );
}
</content>
</change>
</file>

This solution:

1. Adds an Error Boundary to gracefully handle any crypto-related errors
2. Provides a mock implementation of crypto for the browser environment
3. Wraps the ImportedComponent in the ErrorBoundary
4. Shows a user-friendly message if the component fails to render

This should prevent the crypto-related error from breaking the preview and provide a better user experience. The error boundary will catch any server-side functionality errors that might occur during rendering, and the mock crypto implementation might help in cases where basic crypto functionality is needed.

If you're still seeing issues, we might need to:
1. Mock the specific crypto functions being used in the server component
2. Create a client-side version of the component for preview purposes
3. Or disable certain functionality in the preview environment

Let me know if you need any adjustments to this solution.

