import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';

// Using dynamic import with error handling
const ImportedComponent = React.lazy(() => import('../../app/(use-page-wrapper)/settings/platform/page')
  .catch(err => {
    console.error('Error loading component:', err);
    return { 
      default: () => <div>Error loading component</div> 
    };
  })
);

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <ErrorBoundary>
        <ImportedComponent />
      </ErrorBoundary>
    </Suspense>
  );
}

// Simple Error Boundary Component
class ErrorBoundary extends React.Component {
  constructor(props) {
    super(props);
    this.state = { hasError: false };
  }

  static getDerivedStateFromError(error) {
    return { hasError: true };
  }

  componentDidCatch(error, errorInfo) {
    console.error('Component Error:', error, errorInfo);
  }

  render() {
    if (this.state.hasError) {
      return <div>Something went wrong loading the component.</div>;
    }

    return this.props.children;
  }
}
</content>
</change>
</file>

The changes I made include:

1. Added Suspense import and wrapped the component in Suspense for better loading handling
2. Changed the static import to a dynamic import with error handling
3. Added an ErrorBoundary component to catch and handle any rendering errors
4. Added loading state feedback with fallback
5. Implemented proper error catching for the dynamic import

This implementation should:
- Handle the dynamic import more gracefully
- Provide better error feedback
- Show a loading state while the component is being loaded
- Catch and handle any rendering errors
- Prevent the entire application from crashing if the component fails to load

The error you're seeing might be related to the module not being found or not being able to be imported correctly. This solution provides better error handling and fallback options while attempting to load the component.

If you're still seeing issues, it might be worth checking:
1. If the import path is correct
2. If the target component exists at the specified location
3. If there are any build/bundling issues preventing the import

Let me know if you need any adjustments or if you're still seeing errors.

