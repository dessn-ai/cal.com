import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/(use-page-wrapper)/settings/platform/page';
import { FeatureProvider } from '@calcom/features/flags/context/provider';
import { SessionProvider } from 'next-auth/react';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { TooltipProvider } from '@radix-ui/react-tooltip';
import { trpc } from '@calcom/trpc/react';
import { httpBatchLink } from '@trpc/client';
import { I18nextProvider } from 'react-i18next';
import i18next from 'i18next';

// Initialize i18next
const i18n = i18next.createInstance();
i18n.init({
  fallbackLng: 'en',
  resources: {},
});

// Initialize QueryClient
const queryClient = new QueryClient();

// Initialize TRPC
const trpcClient = trpc.createClient({
  links: [
    httpBatchLink({
      url: '/api/trpc',
    }),
  ],
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  return (
    <SessionProvider session={null}>
      <I18nextProvider i18n={i18n}>
        <trpc.Provider client={trpcClient} queryClient={queryClient}>
          <QueryClientProvider client={queryClient}>
            <TooltipProvider>
              <FeatureProvider>
                <ImportedComponent />
              </FeatureProvider>
            </TooltipProvider>
          </QueryClientProvider>
        </trpc.Provider>
      </I18nextProvider>
    </SessionProvider>
  );
}
</content>
</change>
</file>

The changes I made include:

1. Removed the dynamic import and Suspense/ErrorBoundary as they might be causing issues
2. Added all the necessary providers that appear in the stack trace:
   - SessionProvider from next-auth
   - I18nextProvider for internationalization
   - TRPCProvider for API calls
   - QueryClientProvider for React Query
   - TooltipProvider from Radix UI
   - FeatureProvider for feature flags
3. Initialized required instances for providers (QueryClient, i18next, trpc)
4. Used regular import instead of dynamic import

This implementation:
- Provides all the necessary context that the component might need
- Simplifies the import mechanism
- Matches the provider structure shown in the stack trace

The error was likely occurring because the component needed certain providers that were available in the main app but not in the preview environment. By adding these providers, we should resolve the context-related issues.

