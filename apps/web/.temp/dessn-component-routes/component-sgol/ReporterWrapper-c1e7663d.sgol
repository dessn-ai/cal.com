import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/app-store/routing-forms/pages/reporting/[...appPages]';
import { FormProvider, useForm } from 'react-hook-form';

// Create a mock context for org branding
const OrgBrandingContext = createContext({
  orgBranding: {
    theme: null,
    brandColor: "#292929",
    darkBrandColor: "#fafafa",
    logo: "",
    name: "Test Organization",
  },
});

// Create a mock provider component
const MockOrgBrandingProvider = ({ children }) => {
  const value = {
    orgBranding: {
      theme: null,
      brandColor: "#292929",
      darkBrandColor: "#fafafa",
      logo: "",
      name: "Test Organization",
    },
  };
  return <OrgBrandingContext.Provider value={value}>{children}</OrgBrandingContext.Provider>;
};

// Export the useOrgBranding hook for components that need it
export const useOrgBranding = () => useContext(OrgBrandingContext);

export default function ComponentPreview() {
  const methods = useForm();
  
  const [state, setState] = useParentState({
    trpcState: {
      type: "string",
      value: JSON.stringify({
        queries: [],
        mutations: [],
        subscriptions: [],
      }),
      label: "TRPC State",
    },
    form: {
      type: "string",
      value: JSON.stringify({
        id: 1,
        name: "Test Form",
        description: "Test Description",
        fields: [],
        routes: [],
        settings: {
          emailOwnerOnSubmission: false,
          sendUpdatesTo: [],
          sendToAll: false,
        },
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString(),
        disabled: false,
        responses: [],
        teamId: null,
        userId: 1,
        _count: {
          responses: 0,
          routes: 0,
        },
        routers: [],
        connectedForms: [],
        teamMembers: [],
      }),
      label: "Form",
    },
    enrichedWithUserProfileForm: {
      type: "string",
      value: JSON.stringify({
        id: 1,
        name: "Test Form",
        description: "Test Description",
        fields: [],
        routes: [],
        settings: {
          emailOwnerOnSubmission: false,
          sendUpdatesTo: [],
          sendToAll: false,
        },
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString(),
        disabled: false,
        responses: [],
        teamId: null,
        userId: 1,
        _count: {
          responses: 0,
          routes: 0,
        },
        user: {
