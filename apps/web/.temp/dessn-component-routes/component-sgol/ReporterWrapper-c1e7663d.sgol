            trpcState={JSON.parse(state.trpcState.value)}
            form={JSON.parse(state.form.value)}
            enrichedWithUserProfileForm={JSON.parse(state.enrichedWithUserProfileForm.value)}
            appUrl={state.appUrl.value}
          />
