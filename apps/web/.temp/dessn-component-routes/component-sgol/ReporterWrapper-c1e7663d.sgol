import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/app-store/routing-forms/pages/reporting/[...appPages]';
import { FormProvider, useForm } from 'react-hook-form';

// Create a mock context for org branding
const OrgBrandingContext = createContext({
  orgBranding: {
    theme: null,
    brandColor: "#292929",
    darkBrandColor: "#fafafa",
    logo: "",
    name: "Test Organization",
  },
});

// Create a mock provider component
const MockOrgBrandingProvider = ({ children }) => {
  const value = {
    orgBranding: {
      theme: null,
      brandColor: "#292929",
      darkBrandColor: "#fafafa",
      logo: "",
      name: "Test Organization",
    },
  };
  return <OrgBrandingContext.Provider value={value}>{children}</OrgBrandingContext.Provider>;
};

// Export the useOrgBranding hook for components that need it
export const useOrgBranding = () => useContext(OrgBrandingContext);

