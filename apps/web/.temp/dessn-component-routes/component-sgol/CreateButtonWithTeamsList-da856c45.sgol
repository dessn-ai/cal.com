import React from 'react';
import { useParentState } from '../useIframeState';
import { CreateButtonWithTeamsList } from '../../../../packages/ui/components/createButton/CreateButtonWithTeamsList';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { createTRPCReact, httpBatchLink } from '@trpc/react-query';

// Create a mock QueryClient
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      cacheTime: 0,
      staleTime: 0,
    },
  },
});

// Mock data
const mockTeamsData = [
  { teamId: 1, name: 'Team 1', slug: 'team-1', image: 'https://example.com/team1.jpg', readOnly: false },
  { teamId: 2, name: 'Team 2', slug: 'team-2', image: 'https://example.com/team2.jpg', readOnly: false },
  { teamId: null, name: 'User Profile', slug: 'user-profile', image: 'https://example.com/user.jpg', readOnly: false },
];

// Create a wrapper component that provides the mock data
const MockProvider = ({ children }) => {
  return (
    <QueryClientProvider client={queryClient}>
      {children}
    </QueryClientProvider>
  );
};

// Mock the useQuery hook result
jest.mock('@calcom/trpc/react', () => ({
  trpc: {
    viewer: {
      teamsAndUserProfilesQuery: {
        useQuery: () => ({
          data: mockTeamsData,
          isLoading: false,
          error: null,
        }),
      },
    },
  },
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    onlyShowWithTeams: {
      type: "boolean",
      value: false,
      label: "Only Show With Teams",
    },
    onlyShowWithNoTeams: {
      type: "boolean",
      value: false,
      label: "Only Show With No Teams",
    },
    isAdmin: {
      type: "boolean",
      value: false,
      label: "Is Admin",
    },
    includeOrg: {
      type: "boolean",
      value: false,
      label: "Include Org",
    },
  });

  return (
    <MockProvider>
      <CreateButtonWithTeamsList
        onlyShowWithTeams={state.onlyShowWithTeams.value}
        onlyShowWithNoTeams={state.onlyShowWithNoTeams.value}
        isAdmin={state.isAdmin.value}
        includeOrg={state.includeOrg.value}
      />
    </MockProvider>
  );
}
</content>
  </change>
</file>

The changes made:
1. Removed the direct assignment to `trpc` which was causing the error
2. Added proper mock setup using jest.mock()
3. Created a MockProvider component to wrap the CreateButtonWithTeamsList
4. Added necessary imports for QueryClient and QueryClientProvider
5. Set up a mock QueryClient with appropriate default options
6. Wrapped the component with MockProvider to provide the necessary context

This approach should resolve the "Assignment to constant variable" error while still providing the mock data needed for the component to function properly.

