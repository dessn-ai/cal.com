import React from 'react';
import { useParentState } from '../useIframeState';
import { ScheduleDay } from '../../../../packages/features/schedules/components/Schedule';
import { useForm, FormProvider } from 'react-hook-form';
import { defaultDayRange } from '@calcom/lib/availability';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    name: {
      type: "string",
      value: "schedule.0",
      label: "Name",
    },
    weekday: {
      type: "string",
      value: "Monday",
      label: "Weekday",
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled",
    },
    userTimeFormat: {
      type: "number",
      value: 12,
      label: "User Time Format",
    },
  });

  // Create a stable reference for the default values
  const defaultValues = React.useMemo(() => ({
    [state.name.value]: [
      {
        start: {
          hours: 9,
          minutes: 0
        },
        end: {
          hours: 17,
          minutes: 0
        }
      }
    ]
  }), [state.name.value]);

  const methods = useForm({
    defaultValues,
    mode: "onSubmit"
  });

  // Initialize form with default values
  React.useEffect(() => {
    const currentValues = methods.getValues(state.name.value);
    if (!currentValues || currentValues.length === 0) {
      methods.reset(defaultValues);
    }
  }, [methods, state.name.value, defaultValues]);

  return (
    <FormProvider {...methods}>
      <div className="p-4">
        <ScheduleDay
          name={state.name.value}
          weekday={state.weekday.value}
          control={methods.control}
          CopyButton={<div />}
          disabled={state.disabled.value}
          userTimeFormat={state.userTimeFormat.value}
        />
      </div>
    </FormProvider>
  );
}
</content>
  </change>
</file>

