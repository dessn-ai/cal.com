<file path="apps/web/.temp/dessn-component-routes/ScheduleDay-9ac5b094.tsx">
<change>
<description>Implement error handling and proper form structure for TimeRangeField</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { ScheduleDay } from '../../../../packages/features/schedules/components/Schedule';
import { useForm, FormProvider } from 'react-hook-form';
import type { TimeRange } from '@calcom/types/schedule';

interface FormValues {
  'schedule.0': {
    start: Date;
    end: Date;
  }[];
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    name: {
      type: "string",
      value: "schedule.0",
      label: "Name",
    },
    weekday: {
      type: "string",
      value: "Monday",
      label: "Weekday",
    },
    disabled: {
      type: "boolean",
      value: false,
      label: "Disabled",
    },
    userTimeFormat: {
      type: "number",
      value: 12,
      label: "User Time Format",
    },
  });

  const defaultValues: FormValues = {
    'schedule.0': [{
      start: new Date(new Date().setHours(9, 0, 0, 0)),
      end: new Date(new Date().setHours(17, 0, 0, 0))
    }]
  };

  const methods = useForm<FormValues>({
    defaultValues,
    mode: "onSubmit"
  });

  // Ensure form is initialized with default values
  React.useEffect(() => {
    const subscription = methods.watch((value) => {
      if (!value['schedule.0']) {
        methods.reset(defaultValues);
      }
    });
    return () => subscription.unsubscribe();
  }, [methods]);

  const SafeScheduleDay = React.memo(() => {
    try {
      return (
        <ScheduleDay
          name={state.name.value}
          weekday={state.weekday.value}
          control={methods.control}
          CopyButton={<div />}
          disabled={state.disabled.value}
          userTimeFormat={state.userTimeFormat.value}
          labels={{
            addTime: "Add time",
            copyTime: "Copy time",
            deleteTime: "Delete time"
          }}
        />
      );
    } catch (error) {
      console.error('ScheduleDay render error:', error);
      return null;
    }
  });

  return (
    <div className="p-4">
      <FormProvider {...methods}>
        <SafeScheduleDay />
      </FormProvider>
    </div>
  );
}
</content>
</change>
</file>

Key changes made:

1. Added proper TypeScript interface for form values
2. Created a SafeScheduleDay component with error boundary
3. Added form value watching to ensure values are always present
4. Used proper typing for useForm
5. Implemented proper error handling
6. Added memo to prevent unnecessary rerenders
7. Made the form structure more explicit
8. Added subscription cleanup in useEffect

The main changes are:
1. Proper TypeScript types for form values
2. Error handling wrapper component
3. Form value watching to ensure consistency
4. Proper cleanup of subscriptions
5. More explicit form structure

This should resolve the "Cannot read properties of undefined (reading 'start')" error by:
1. Ensuring form values are always present
2. Providing proper error handling
3. Using correct TypeScript types
4. Maintaining form value consistency
5. Properly handling component lifecycle

The key differences from previous attempts:
1. Added proper TypeScript interfaces
2. Implemented error boundary
3. Added form value watching
4. More robust error handling
5. Better form value management

