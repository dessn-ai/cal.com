  const value = {
    orgBranding: {
      logo: '',
      name: 'Test Organization',
      brandColor: '#292929',
      darkBrandColor: '#ffffff',
      theme: null,
      backgroundImage: null,
    },
    isLoading: false,
  };

  return (
    <OrgBrandingContext.Provider value={value}>
      {children}
