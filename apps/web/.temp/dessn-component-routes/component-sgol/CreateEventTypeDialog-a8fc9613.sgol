  const mockValue = {
    orgBranding: {
      logo: '',
      brandColor: '#292929',
      darkBrandColor: '#fafafa',
      theme: null,
      backgroundImage: null,
    },
    isLoading: false,
    organization: {
      id: 1,
      slug: 'test-org',
      name: 'Test Organization',
    },
  };

  return (
    <OrgBrandingContext.Provider value={mockValue}>
      {children}
    </OrgBrandingContext.Provider>
  );
};

// Create a mock hook that matches the original
const useOrgBranding = () => {
  const context = useContext(OrgBrandingContext);
  if (!context) {
    throw new Error('useOrgBranding must be used within OrgBrandingProvider');
  }
  return context;
};

// Override the imported module
