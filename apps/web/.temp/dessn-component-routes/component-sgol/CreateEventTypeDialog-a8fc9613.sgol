import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/eventtypes/components/CreateEventTypeDialog';
import { MembershipRole } from '@calcom/prisma/enums';

// Mock the original context and hook
const OrgBrandingContext = createContext({
  orgBranding: {
    logo: '',
    brandColor: '#292929',
    darkBrandColor: '#fafafa',
    theme: null,
    backgroundImage: null,
  },
  isLoading: false,
  organization: {
    id: 1,
    slug: 'test-org',
    name: 'Test Organization',
  },
});

// Mock the provider from @calcom/features/ee/organizations/context/provider
jest.mock('@calcom/features/ee/organizations/context/provider', () => ({
  useOrgBranding: () => useContext(OrgBrandingContext),
  OrgBrandingProvider: ({ children }) => (
    <OrgBrandingContext.Provider
      value={{
        orgBranding: {
          logo: '',
          brandColor: '#292929',
          darkBrandColor: '#fafafa',
          theme: null,
          backgroundImage: null,
        },
        isLoading: false,
        organization: {
          id: 1,
          slug: 'test-org',
          name: 'Test Organization',
        },
      }}>
      {children}
    </OrgBrandingContext.Provider>
  ),
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    profileOptions: {
      type: 'string',
      value: JSON.stringify([
        {
          teamId: 1,
          label: 'Team A',
          image: 'https://example.com/team-a.jpg',
          membershipRole: MembershipRole.MEMBER,
        },
        {
          teamId: null,
          label: 'Personal',
          image: 'https://example.com/personal.jpg',
          membershipRole: null,
        },
        {
          teamId: 2,
          label: 'Team B',
          image: 'https://example.com/team-b.jpg',
          membershipRole: MembershipRole.ADMIN,
        },
      ]),
      label: 'Profile Options',
    },
  });

  const profileOptions = JSON.parse(state.profileOptions.value);

  return (
    <OrgBrandingContext.Provider
      value={{
        orgBranding: {
          logo: '',
          brandColor: '#292929',
          darkBrandColor: '#fafafa',
          theme: null,
          backgroundImage: null,
        },
        isLoading: false,
        organization: {
          id: 1,
          slug: 'test-org',
          name: 'Test Organization',
        },
      }}>
      <ImportedComponent profileOptions={profileOptions} />
    </OrgBrandingContext.Provider>
  );
}
</content>
  </change>
</file>

