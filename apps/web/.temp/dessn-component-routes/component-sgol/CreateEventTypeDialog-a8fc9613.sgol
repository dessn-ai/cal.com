import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/eventtypes/components/CreateEventTypeDialog';
import { MembershipRole } from '@calcom/prisma/enums';

// Create the same context structure as the original
const OrgBrandingContext = createContext(null);

// Create a provider component that matches the original
const MockOrgBrandingProvider = ({ children }) => {
  const mockValue = {
    orgBranding: {
      logo: '',
      brandColor: '#292929',
      darkBrandColor: '#fafafa',
      theme: null,
      backgroundImage: null,
    },
    isLoading: false,
    organization: {
      id: 1,
      slug: 'test-org',
      name: 'Test Organization',
    },
  };

  return (
    <OrgBrandingContext.Provider value={mockValue}>
      {children}
    </OrgBrandingContext.Provider>
  );
};

// Create a mock hook that matches the original
const useOrgBranding = () => {
  const context = useContext(OrgBrandingContext);
  if (!context) {
    throw new Error('useOrgBranding must be used within OrgBrandingProvider');
  }
  return context;
};

// Override the imported module
import * as orgModule from '@calcom/features/ee/organizations/context/provider';
// Mock the module's exports
const originalModule = { ...orgModule };
originalModule.useOrgBranding = useOrgBranding;
originalModule.OrgBrandingProvider = MockOrgBrandingProvider;

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    profileOptions: {
      type: 'string',
      value: JSON.stringify([
        {
          teamId: 1,
          label: 'Team A',
          image: 'https://example.com/team-a.jpg',
          membershipRole: MembershipRole.MEMBER,
        },
        {
          teamId: null,
          label: 'Personal',
          image: 'https://example.com/personal.jpg',
          membershipRole: null,
        },
        {
          teamId: 2,
          label: 'Team B',
          image: 'https://example.com/team-b.jpg',
          membershipRole: MembershipRole.ADMIN,
        },
      ]),
      label: 'Profile Options',
    },
  });

  const profileOptions = JSON.parse(state.profileOptions.value);

  return (
    <MockOrgBrandingProvider>
      <ImportedComponent profileOptions={profileOptions} />
    </MockOrgBrandingProvider>
  );
}
</content>
  </change>
</file>

The changes made:
1. Created a new `OrgBrandingContext` with the same structure as the original
