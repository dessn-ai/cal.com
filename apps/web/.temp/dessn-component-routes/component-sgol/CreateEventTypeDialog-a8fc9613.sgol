import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/eventtypes/components/CreateEventTypeDialog';
import { OrgBrandingProvider } from '@calcom/features/ee/organizations/context/provider';
import { MembershipRole } from '@calcom/prisma/enums';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    profileOptions: {
      type: 'string',
      value: JSON.stringify([
        {
          teamId: 1,
          label: 'Team A',
          image: 'https://example.com/team-a.jpg',
          membershipRole: MembershipRole.MEMBER,
        },
        {
          teamId: null,
          label: 'Personal',
          image: 'https://example.com/personal.jpg',
          membershipRole: null,
        },
        {
          teamId: 2,
          label: 'Team B',
          image: 'https://example.com/team-b.jpg',
          membershipRole: MembershipRole.ADMIN,
        },
      ]),
      label: 'Profile Options',
    },
  });

  const profileOptions = JSON.parse(state.profileOptions.value);

  // Mock data for OrgBrandingProvider
  const mockOrgBranding = {
    orgBranding: {
      logo: '',
      name: 'Test Organization',
      brandColor: '#292929',
      darkBrandColor: '#ffffff',
      theme: null,
      backgroundImage: null,
    },
    isLoading: false,
  };

  return (
    <ErrorBoundary>
      <OrgBrandingProvider {...mockOrgBranding}>
        <ImportedComponent profileOptions={profileOptions} />
      </OrgBrandingProvider>
    </ErrorBoundary>
  );
}

// Simple error boundary component
function ErrorBoundary({ children }: { children: React.ReactNode }) {
  try {
    return <>{children}</>;
  } catch (error) {
    console.error('Error in component:', error);
    return <div>Something went wrong</div>;
  }
}
</content>
  </change>
</file>

I've made the following changes:
1. Added mock data for `OrgBrandingProvider` with required properties
2. Added an ErrorBoundary component to gracefully handle any potential errors
3. Passed the mock data to `OrgBrandingProvider` using spread operator
4. Kept all other functionality the same

The mock data includes:
- Basic organization branding properties (logo, name, colors, theme)
- Loading state indicator
- Null values for optional properties

This should resolve the error by providing the necessary context data that the `useOrgBranding` hook expects. The error boundary will also help catch and handle any potential issues that might occur during rendering.

