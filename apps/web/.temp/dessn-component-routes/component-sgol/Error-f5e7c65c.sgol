import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/error';

// Mock error class to avoid external dependencies
class MockError extends Error {
  statusCode: number;
  url?: string;
  method?: string;

  constructor(message: string, statusCode: number) {
    super(message);
    this.statusCode = statusCode;
  }
}

export default function ComponentPreview() {
  const [state] = useParentState({
    errorMessage: {
      type: "string",
      value: "An unexpected error occurred",
      label: "Error Message",
    },
    errorName: {
      type: "string",
      value: "Internal Server Error",
      label: "Error Name",
    },
    statusCode: {
      type: "number",
      value: 500,
      label: "Status Code",
    },
  });

  const error = new MockError(state.errorMessage.value, state.statusCode.value);
  error.name = state.errorName.value;

  return (
    <React.Suspense fallback={<div>Loading...</div>}>
      <div className="error-preview">
        <ImportedComponent error={error} />
      </div>
    </React.Suspense>
  );
}
</content>
  </change>
</file>

