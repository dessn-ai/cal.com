Assistant: I notice that the component might be failing because it requires the `useLocale` hook from `@calcom/lib/hooks/useLocale`. Let's modify the preview file to mock this dependency and provide the necessary context:

<file path="apps/web/.temp/dessn-component-routes/TeamPill-d26dc51a.tsx">
<change>
<description>Add mock for useLocale hook and fix imports</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import TeamPill, { TeamRole } from '../../../../packages/features/ee/teams/components/TeamPill';
import { MembershipRole } from '@calcom/prisma/enums';

// Mock the useLocale hook
jest.mock("@calcom/lib/hooks/useLocale", () => ({
  useLocale: () => ({
    t: (key: string) => {
      const translations = {
        'owner': 'Owner',
        'admin': 'Admin',
        'member': 'Member'
      };
      return translations[key] || key;
    }
  })
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    text: {
      type: "string",
      value: "Team Member",
      label: "Text",
    },
    color: {
      type: "dropdown",
      value: "blue",
      options: ["blue", "green", "red", "orange"],
      label: "Color",
    },
    role: {
      type: "dropdown",
      value: "MEMBER",
      options: ["OWNER", "ADMIN", "MEMBER"],
      label: "Role",
    },
  });

  // Mock the useLocale hook implementation
  const mockUseLocale = {
    t: (key: string) => {
      const translations = {
        'owner': 'Owner',
        'admin': 'Admin',
        'member': 'Member'
      };
      return translations[key] || key;
    }
  };

  // Override the useLocale hook
  (window as any).useLocale = () => mockUseLocale;

  return (
    <>
      <TeamPill text={state.text.value} color={state.color.value as "blue" | "green" | "red" | "orange"} />
      <TeamRole role={state.role.value as MembershipRole} />
    </>
  );
}
</content>
</change>
</file>

