import React from 'react';
import { useParentState } from '../useIframeState';
import TeamPill, { TeamRole } from '../../../../packages/features/ee/teams/components/TeamPill';
import { MembershipRole } from '@calcom/prisma/enums';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    text: {
      type: "string",
      value: "Team Member",
      label: "Text",
    },
    color: {
      type: "dropdown",
      value: "blue",
      options: ["blue", "green", "red", "orange"],
      label: "Color",
    },
    role: {
      type: "dropdown",
      value: "MEMBER",
      options: ["OWNER", "ADMIN", "MEMBER"],
      label: "Role",
    },
  });

  return (
    <>
      <TeamPill text={state.text.value} color={state.color.value as "blue" | "green" | "red" | "orange"} />
      <TeamRole role={state.role.value as MembershipRole} />
    </>
  );
}
</content>
</change>
</file>

The changes I made:

1. Updated the import statement to import both `TeamPill` and `TeamRole` separately:
```typescript
import TeamPill, { TeamRole } from '../../../../packages/features/ee/teams/components/TeamPill';
```

2. Changed the component usage from `ImportedComponent.TeamRole` to just `TeamRole` since it's now properly imported.

This should resolve the "invalid element type" error because we're now correctly importing and using both components as they are exported from the source file. The `TeamRole` component is exported as a named export, while `TeamPill` is the default export, so we need to import them separately.

