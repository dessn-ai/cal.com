  const context = useContext(OrgBrandingContext);
  if (context === null) {
    throw new Error("useOrgBranding was used outside of OrgBrandingProvider");
  }
  return context;
};

// Create the provider component
const OrgBrandingProvider = ({ children }: { children: React.ReactNode }) => {
  const value = {
    orgBranding: {
      fullDomain: "example.com",
      slug: "example",
      theme: null,
      hideBranding: false,
    },
    isLoading: false,
  };

  return (
