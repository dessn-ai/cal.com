        _count: {
          responses: 0,
        },
        team: {
          name: "Sample Team",
          slug: "sample-team",
        },
        teamMembers: [],
      },
      label: "Form",
    },
    isTestPreviewOpen: {
      type: "boolean",
      value: true,
      label: "Is Test Preview Open",
    },
