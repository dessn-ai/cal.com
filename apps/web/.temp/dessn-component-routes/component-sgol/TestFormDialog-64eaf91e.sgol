import { FormProvider, useForm } from 'react-hook-form';
import { trpc } from '@calcom/trpc/react';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Create contexts
const OrgBrandingContext = React.createContext(null);
const EmbedDialogContext = React.createContext(null);
const FormActionsContext = React.createContext(null);
const I18nContext = React.createContext(null);

// Create mock providers
const OrgBrandingProvider = ({ children }) => {
  const value = {
    orgBranding: {
      theme: null,
      brandColor: "#292929",
      darkBrandColor: "#fafafa",
      logo: "",
      textColor: "#292929",
      brandingId: 0,
      orgSlug: "",
    },
    getOrgUsernameFromEmail: () => "",
    orgAutoScaling: false,
  };
  return <OrgBrandingContext.Provider value={value}>{children}</OrgBrandingContext.Provider>;
};

const EmbedDialogProvider = ({ children }) => {
  const value = {
    embed: false,
    embedType: null,
    setEmbed: () => {},
    setEmbedType: () => {},
    isEmbedDialog: false,
    setIsEmbedDialog: () => {},
  };
  return <EmbedDialogContext.Provider value={value}>{children}</EmbedDialogContext.Provider>;
};

const FormActionsProvider = ({ children, appUrl }) => {
  const value = {
    appUrl,
    newFormDialogState: null,
    setNewFormDialogState: () => {},
  };
  return <FormActionsContext.Provider value={value}>{children}</FormActionsContext.Provider>;
};

const I18nProvider = ({ children }) => {
  const value = {
    t: (key) => key,
    i18n: {
      language: 'en',
      changeLanguage: () => Promise.resolve(),
    },
  };
  return <I18nContext.Provider value={value}>{children}</I18nContext.Provider>;
};

// Create a client
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
