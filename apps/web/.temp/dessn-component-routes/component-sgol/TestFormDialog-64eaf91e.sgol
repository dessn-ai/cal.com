queryClient.setQueryData(['viewer.me'], mockUserData);
queryClient.setQueryData(['viewer.appRoutingForms.formQuery', { id: "123" }], mockFormData);
queryClient.setQueryData(['viewer.teams.list'], [mockFormData.team]);
queryClient.setQueryData(['viewer.appRoutingForms.forms'], [mockFormData]);

export default function ComponentPreview() {
