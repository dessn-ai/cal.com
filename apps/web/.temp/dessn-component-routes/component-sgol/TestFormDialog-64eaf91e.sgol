import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/app-store/routing-forms/components/SingleForm';
import { FormProvider, useForm } from 'react-hook-form';
import { trpc } from '@calcom/trpc/react';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { OrgBrandingProvider } from '@calcom/features/ee/organizations/context/provider';
import { FormActionsProvider } from '@calcom/app-store/routing-forms/components/FormActions';
import { ShellMain } from '@calcom/features/shell/Shell';
import { EmbedDialogProvider } from '@calcom/features/embed/lib/hooks/useEmbedDialogCtx';

// Create a client
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

// Mock user data
const mockUser = {
  id: 1,
  name: "Test User",
  email: "test@example.com",
  username: "testuser",
};

// Mock the trpc hooks
const mockTrpc = {
  useUtils: () => ({}),
  viewer: {
    appRoutingForms: {
      formMutation: {
        useMutation: () => ({
          mutate: () => {},
          isLoading: false,
        }),
      },
      formQuery: {
        useQuery: () => ({
          data: null,
          isLoading: false,
        }),
      },
    },
  },
};

// Override the real implementation
trpc.useUtils = mockTrpc.useUtils;
trpc.viewer.appRoutingForms.formMutation.useMutation = mockTrpc.viewer.appRoutingForms.formMutation.useMutation;
trpc.viewer.appRoutingForms.formQuery.useQuery = mockTrpc.viewer.appRoutingForms.formQuery.useQuery;

// Mock the useMeQuery hook
const useMeQuery = () => ({
  data: mockUser,
  isLoading: false,
  error: null,
});

// Add to global scope
global.useMeQuery = useMeQuery;

export default function ComponentPreview() {
  const methods = useForm({
    defaultValues: {
      response: {},
    }
  });

  const [state, setState] = useParentState({
    form: {
      type: "object",
      value: {
        id: "123",
        name: "Sample Form",
        description: "This is a sample form",
        teamId: 1,
        routes: [],
        fields: [],
        settings: {
          sendUpdatesTo: [],
          sendToAll: false,
        },
        _count: {
          responses: 0,
        },
        team: {
          name: "Sample Team",
          slug: "sample-team",
        },
        teamMembers: [],
        routers: [],
        connectedForms: [],
      },
      label: "Form",
    },
    isTestPreviewOpen: {
      type: "boolean",
      value: true,
      label: "Is Test Preview Open",
    },
  });

  // Create the enriched form data
  const enrichedWithUserProfileForm = {
    ...state.form.value,
    user: mockUser,
    team: state.form.value.team,
    nonOrgUsername: "testuser",
    nonOrgTeamslug: "sample-team",
    userOrigin: "http://localhost:3000",
    teamOrigin: "http://localhost:3000",
  };

  // Mock data for FormActionsProvider
  const formActionsProviderProps = {
    appUrl: "/routing-forms",
    newFormDialogState: null,
    setNewFormDialogState: () => {},
  };

  return (
    <QueryClientProvider client={queryClient}>
      <OrgBrandingProvider>
        <EmbedDialogProvider>
          <FormActionsProvider {...formActionsProviderProps}>
            <FormProvider {...methods}>
              <ImportedComponent
                form={state.form.value}
                isTestPreviewOpen={state.isTestPreviewOpen.value}
                setIsTestPreviewOpen={(value) => setState("isTestPreviewOpen", value)}
                enrichedWithUserProfileForm={enrichedWithUserProfileForm}
                appUrl="/routing-forms"
              />
            </FormProvider>
          </FormActionsProvider>
        </EmbedDialogProvider>
      </OrgBrandingProvider>
    </QueryClientProvider>
  );
}
</content>
