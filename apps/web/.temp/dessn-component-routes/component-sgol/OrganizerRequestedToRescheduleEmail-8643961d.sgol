<file path="apps/web/.temp/dessn-component-routes/OrganizerRequestedToRescheduleEmail-8643961d.tsx">
  <change>
    <description>Fix the translation function being lost during JSON stringify/parse</description>
    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { OrganizerRequestedToRescheduleEmail } from '../../../../packages/emails/src/templates/OrganizerRequestedToRescheduleEmail';

// Define TimeFormat enum locally instead of importing
enum TimeFormat {
  TWELVE_HOUR = '12h',
  TWENTY_FOUR_HOUR = '24h'
}

export default function ComponentPreview() {
  const translate = (key: string, params: any) => `Translated: ${key}`;

  const [state, setState] = useParentState({
    calEvent: {
      type: 'object',
      value: {
        type: 'default',
        title: 'Meeting',
        startTime: new Date().toISOString(),
        endTime: new Date(Date.now() + 3600000).toISOString(),
        organizer: {
          name: 'John Organizer',
          email: 'john@example.com',
          timeZone: 'America/New_York',
          language: {
            translate,
            locale: 'en',
          },
        },
        attendees: [
          {
            name: 'Jane Attendee',
            email: 'jane@example.com',
            timeZone: 'America/Los_Angeles',
            language: {
              translate,
              locale: 'en',
            },
          },
        ],
      },
      label: 'Calendar Event',
    },
    attendee: {
      type: 'object',
      value: {
        name: 'Jane Attendee',
        email: 'jane@example.com',
        timeZone: 'America/Los_Angeles',
        language: {
          translate,
          locale: 'en',
        },
      },
      label: 'Attendee',
    },
    timeZone: {
      type: 'string',
      value: 'America/New_York',
      label: 'Time Zone',
    },
    timeFormat: {
      type: 'dropdown',
      value: TimeFormat.TWELVE_HOUR,
      options: Object.values(TimeFormat),
      label: 'Time Format',
    },
  });

  return (
    <OrganizerRequestedToRescheduleEmail
      calEvent={state.calEvent.value}
      attendee={state.attendee.value}
      timeZone={state.timeZone.value}
      timeFormat={state.timeFormat.value as TimeFormat}
    />
  );
}
</content>
  </change>
</file>

I've made the following changes:
1. Removed JSON.stringify/parse and changed the state structure to use objects directly
2. Defined the translate function once at the component level and reused it
3. Changed the type from 'string' to 'object' for calEvent and attendee
4. Simplified the code by removing the parsing step
5. Kept the translate function implementation consistent

This should resolve the "translate is not a function" error because now we're passing the actual function instead of trying to serialize it through JSON.stringify/parse. The translate function will remain intact when passed to the email component.

