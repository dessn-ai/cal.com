import React from 'react';
import { useParentState } from '../useIframeState';
import { InputComponent } from '../../../../packages/ui/components/form/select/components';
import { components } from 'react-select';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    inputClassName: {
      type: "string",
      value: "custom-input-class",
      label: "Input Class Name",
    },
  });

  // Create a mock props object that matches what react-select expects
  const inputProps = {
    inputClassName: state.inputClassName.value,
    onBlur: () => {},
    onChange: () => {},
    onFocus: () => {},
    value: "",
    // Add required react-select props
    cx: () => "",
    theme: {
      spacing: {},
      colors: {},
      borderRadius: 0,
    },
    selectProps: {
      classNamePrefix: "react-select",
    },
    isDisabled: false,
    isHidden: false,
    "aria-label": "input",
  };

  return (
    <div className="react-select-container">
      <InputComponent<any, false>
        {...inputProps}
      />
    </div>
  );
}
</content>
</change>
</file>

The changes I made include:

1. Added import for react-select components
2. Created a proper mock props object that includes all the required react-select properties
3. Added necessary theme and styling props that react-select expects
4. Wrapped the component in a container with proper className
5. Spread the complete props object to the InputComponent

This should resolve the "getStyles is not a function" error by providing the necessary styling context and props that react-select expects. The error was occurring because the component was missing essential react-select internal props that are normally provided by the Select component wrapper.

