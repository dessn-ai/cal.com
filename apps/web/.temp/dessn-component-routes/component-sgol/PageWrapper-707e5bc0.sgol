<file path="apps/web/.temp/dessn-component-routes/PageWrapper-707e5bc0.tsx">
<change>
<description>Remove font dependencies and create a simplified preview version</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import dynamic from 'next/dynamic';
import { DefaultSeo } from "next-seo";
import Head from "next/head";
import Script from "next/script";

import "@calcom/embed-core/src/embed-iframe";
import LicenseRequired from "@calcom/features/ee/common/components/LicenseRequired";
import { IS_CALCOM, WEBAPP_URL } from "@calcom/lib/constants";
import { buildCanonical } from "@calcom/lib/next-seo.config";
import { IconSprites } from "@calcom/ui";
import AppProviders from "@lib/app-providers";
import { seoConfig } from "@lib/config/next-seo.config";

// Create a simplified version of PageWrapper for preview
function PreviewPageWrapper({ Component, pageProps, err, router }) {
  let pageStatus = "200";

  if (router.pathname === "/404") {
    pageStatus = "404";
  } else if (router.pathname === "/500") {
    pageStatus = "500";
  } else if (router.pathname === "/403") {
    pageStatus = "403";
  }

  const nonce = typeof window !== "undefined" ? (pageProps.nonce ? "" : undefined) : pageProps.nonce;
  const providerProps = {
    pageProps: {
      ...pageProps,
      nonce,
    },
    Component,
    router,
    err,
  };

  const getLayout = Component.getLayout ?? ((page) => page);
  const path = router.asPath;

  return (
    <AppProviders {...providerProps}>
      <Head>
        <meta
          name="viewport"
          content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0, viewport-fit=cover"
        />
      </Head>
      <DefaultSeo
        canonical={
          IS_CALCOM
            ? buildCanonical({ path, origin: "https://cal.com" })
            : buildCanonical({ path, origin: WEBAPP_URL })
        }
        {...seoConfig.defaultNextSeo}
      />
      <Script
        nonce={nonce}
        id="page-status"
        dangerouslySetInnerHTML={{ __html: `window.CalComPageStatus = '${pageStatus}'` }}
      />

      <style jsx global>{`
        :root {
          --font-inter: 'Inter', sans-serif;
          --font-cal: 'Cal Sans', sans-serif;
        }
      `}</style>
      <IconSprites />

      {getLayout(
        Component.requiresLicense ? (
          <LicenseRequired>
            <Component {...pageProps} err={err} />
          </LicenseRequired>
        ) : (
          <Component {...pageProps} err={err} />
        )
      )}
    </AppProviders>
  );
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    Component: {
      type: 'object',
      value: {
        requiresLicense: false,
        isThemeSupported: true,
        isBookingPage: false,
      },
      label: 'Component',
    },
    pageProps: {
      type: 'object',
      value: {
        nonce: 'randomNonce123',
        themeBasis: 'light',
        session: {
          hasValidLicense: true,
          upId: 'user123',
          user: {
            id: 1,
            email: 'user@example.com',
            name: 'John Doe',
          },
        },
      },
      label: 'Page Props',
    },
    err: {
      type: 'object',
      value: null,
      label: 'Error',
    },
    router: {
      type: 'object',
      value: {
        pathname: '/home',
        asPath: '/home',
      },
      label: 'Router',
    },
  });

  return (
    <PreviewPageWrapper
      Component={state.Component.value}
      pageProps={state.pageProps.value}
      err={state.err.value}
      router={state.router.value}
    />
  );
}
</content>
</change>
</file>

I've made the following changes:

1. Removed the Next.js font imports and jest mocks completely
2. Created a simplified `PreviewPageWrapper` component that includes all the necessary functionality but without the Next.js font features
3. Added the font families directly in the CSS using standard web fonts
4. Maintained all the essential functionality from the original PageWrapper
5. Imported all necessary dependencies directly
6. Used CSS variables for fonts but with standard web font fallbacks

The key changes are:
- Removed all Next.js font-specific code
- Added direct CSS font definitions
- Kept all the core functionality intact
- Simplified the preview implementation while maintaining the same interface

This should resolve the font-related error while still providing a functional preview of the PageWrapper component. The fonts will fall back to system fonts, but the component's functionality will remain intact.

