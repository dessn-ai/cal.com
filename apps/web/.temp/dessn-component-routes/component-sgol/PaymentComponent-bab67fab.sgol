  elements: ({ clientSecret }) => ({
    ...mockElements,
    // Return mock elements instance that matches Stripe's expected format
    create: () => ({
      mount: () => {},
      unmount: () => {},
      destroy: () => {},
      update: () => {},
    }),
  }),
  confirmPayment: () => Promise.resolve({ paymentIntent: { status: 'succeeded' } }),
