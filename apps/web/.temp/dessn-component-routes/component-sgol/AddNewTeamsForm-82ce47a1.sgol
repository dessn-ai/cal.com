import React from 'react';
import { useParentState } from '../useIframeState';
import { AddNewTeamsForm } from '../../../../packages/features/ee/organizations/components/AddNewTeamsForm';
import { useForm } from 'react-hook-form';
import { trpc } from '@calcom/trpc/react';

// Create a mock context
const RouterQueryContext = React.createContext({ id: "1" });

// Create a custom hook to use the context
const useRouterQuery = () => React.useContext(RouterQueryContext);

// Mock the next/navigation router
const useRouter = () => ({
  push: (path: string) => console.log('Navigation to:', path),
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    orgId: {
      type: "number",
      value: 1,
      label: "Organization ID",
    },
