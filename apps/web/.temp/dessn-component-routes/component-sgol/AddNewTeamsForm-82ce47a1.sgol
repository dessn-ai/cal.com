<file path="apps/web/.temp/dessn-component-routes/AddNewTeamsForm-82ce47a1.tsx">
  <change>
    <description>Create a HOC to inject router query and other dependencies</description>
    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { AddNewTeamsForm } from '../../../../packages/features/ee/organizations/components/AddNewTeamsForm';
import { FormProvider, useForm } from 'react-hook-form';
import { trpc } from '@calcom/trpc/react';

// Create a HOC that injects the router query
const withRouterQuery = (WrappedComponent) => {
  return (props) => {
    // Mock the hooks module
    const mockHooks = {
      useRouterQuery: () => ({ id: '1' }),
      useSession: () => ({
        data: {
          user: {
            role: "ADMIN"
          }
        },
        status: "authenticated"
      })
    };

    // Inject the mocked hooks
    (window as any).useRouterQuery = mockHooks.useRouterQuery;
    (window as any).useSession = mockHooks.useSession;

    const mockTeams = [
      { id: 1, name: "Team 1", slug: "team-1" },
      { id: 2, name: "Team 2", slug: "team-2" },
    ];

    const mockOrg = {
      id: 1,
      slug: "org-slug",
      metadata: {
        requestedSlug: "org-slug"
      }
    };

    // Mock the trpc hooks
    const mockedTrpc = {
      viewer: {
        teams: {
          list: {
            useQuery: () => ({ data: mockTeams, isLoading: false }),
          },
          get: {
            useQuery: () => ({ data: mockOrg, isLoading: false }),
          },
        },
        organizations: {
          listCurrent: {
            useQuery: () => ({
              data: [{
                id: 1,
                slug: "org-slug",
                name: "Test Organization",
                members: [],
              }],
              isLoading: false,
            }),
          },
          createTeams: {
            useMutation: () => ({
              mutate: () => {},
              isPending: false,
              isSuccess: false,
            }),
          },
          publish: {
            useMutation: () => ({
              mutate: () => {},
            }),
          },
        },
      },
    };

    // Replace the global trpc object with our mocked version
    Object.assign(trpc, mockedTrpc);

    return <WrappedComponent {...props} />;
  };
};

// Wrap the AddNewTeamsForm with our HOC
const EnhancedAddNewTeamsForm = withRouterQuery(AddNewTeamsForm);

export default function ComponentPreview() {
  const form = useForm({
    defaultValues: {
      teams: [{ name: "" }],
      moveTeams: [],
    },
  });

  return (
    <FormProvider {...form}>
      <EnhancedAddNewTeamsForm />
    </FormProvider>
  );
}
</content>
  </change>
</file>

