import React from 'react';
import { useParentState } from '../useIframeState';
import { AddNewTeamsForm } from '../../../../packages/features/ee/organizations/components/AddNewTeamsForm';
import { FormProvider, useForm } from 'react-hook-form';
import { trpc } from '@calcom/trpc/react';

// Create a context for router query
const RouterQueryContext = React.createContext({ id: '1' });

// Create a custom hook to replace useRouterQuery
const useRouterQuery = () => React.useContext(RouterQueryContext);

// Override the module's useRouterQuery
import('@calcom/lib/hooks/useRouterQuery').then(module => {
  Object.defineProperty(module, 'useRouterQuery', {
    value: useRouterQuery,
    writable: true,
    configurable: true
  });
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    orgId: {
      type: "number",
      value: 1,
      label: "Organization ID",
    },
  });

  const form = useForm({
    defaultValues: {
      teams: [{ name: "" }],
      moveTeams: [],
    },
  });

  // Mock the trpc hooks
  const mockTeams = [
    { id: 1, name: "Team 1", slug: "team-1" },
    { id: 2, name: "Team 2", slug: "team-2" },
  ];

  const mockOrg = {
    id: state.orgId.value,
    slug: "org-slug",
    metadata: {
      requestedSlug: "org-slug"
    }
  };

  // Mock the trpc hooks as properties
  const mockedTrpc = {
    viewer: {
      teams: {
        list: {
          useQuery: () => ({ data: mockTeams, isLoading: false }),
        },
        get: {
          useQuery: () => ({ data: mockOrg, isLoading: false }),
        },
      },
      organizations: {
        listCurrent: {
          useQuery: () => ({
            data: [{
              id: state.orgId.value,
              slug: "org-slug",
              name: "Test Organization",
              members: [],
            }],
            isLoading: false,
          }),
        },
        createTeams: {
          useMutation: () => ({
            mutate: () => {},
            isPending: false,
            isSuccess: false,
          }),
        },
        publish: {
          useMutation: () => ({
            mutate: () => {},
          }),
        },
      },
    },
  };

  // Replace the global trpc object with our mocked version
  Object.assign(trpc, mockedTrpc);

  // Create a mock session provider
  const SessionContext = React.createContext({
    data: {
      user: {
        role: "ADMIN"
      }
    },
    status: "authenticated"
  });

  // Mock the useSession hook
  const useSession = () => React.useContext(SessionContext);
  (window as any).useSession = useSession;

  return (
    <RouterQueryContext.Provider value={{ id: '1' }}>
      <SessionContext.Provider value={{
        data: {
          user: {
            role: "ADMIN"
          }
        },
        status: "authenticated"
      }}>
        <FormProvider {...form}>
          <AddNewTeamsForm />
        </FormProvider>
      </SessionContext.Provider>
    </RouterQueryContext.Provider>
  );
}
</content>
