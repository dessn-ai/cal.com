<file path="apps/web/.temp/dessn-component-routes/AddNewTeamsForm-82ce47a1.tsx">
  <change>
    <description>Setup proper router query context for AddNewTeamsForm</description>
    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { AddNewTeamsForm } from '../../../../packages/features/ee/organizations/components/AddNewTeamsForm';
import { useForm } from 'react-hook-form';
import { trpc } from '@calcom/trpc/react';

// Mock the useRouterQuery hook
import * as hookModule from '@calcom/lib/hooks/useRouterQuery';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    orgId: {
      type: "number",
      value: 1,
      label: "Organization ID",
    },
  });

  // Mock the useRouterQuery hook to return the expected query parameters
  const mockUseRouterQuery = () => ({
    id: state.orgId.value.toString(),
  });

  // Override the useRouterQuery implementation
  Object.defineProperty(hookModule, 'useRouterQuery', {
    value: mockUseRouterQuery,
    writable: true,
  });

  // Mock the trpc hooks
  const mockTeams = [
    { id: 1, name: "Team 1", slug: "team-1" },
    { id: 2, name: "Team 2", slug: "team-2" },
  ];

  const mockOrg = {
    id: state.orgId.value,
    slug: "org-slug",
    metadata: {
      requestedSlug: "org-slug",
    },
  };

  // Create mock functions for trpc
  const mockTRPC = {
    viewer: {
      teams: {
        list: {
          useQuery: () => ({ data: mockTeams, isLoading: false }),
        },
        get: {
          useQuery: () => ({ data: mockOrg, isLoading: false }),
        },
      },
      organizations: {
        listMembers: {
          useQuery: () => ({ data: [], isLoading: false }),
        },
        createTeams: {
          useMutation: () => ({
            mutate: () => {},
            isPending: false,
            isSuccess: false,
          }),
        },
        publish: {
          useMutation: () => ({
            mutate: () => {},
          }),
        },
      },
    },
  };

  // Override trpc for the component
  Object.assign(trpc, mockTRPC);

  return (
    <div>
      <AddNewTeamsForm />
    </div>
  );
}
</content>
  </change>
</file>

I've made the following changes:

1. Removed the direct props passing to AddNewTeamsForm since it doesn't accept props
2. Added proper mocking of the useRouterQuery hook to provide the required `id` parameter
3. Enhanced the TRPC mocking to include all required endpoints (createTeams, publish)
4. Added proper metadata structure to the mock org data
5. Removed the form-related code since the component handles its own form state

The error was occurring because the component was trying to get the `id` from router query parameters, but we were trying to pass it as a prop. Now we're properly mocking the router query context to provide the `id` parameter in the way the component expects it.

