import * as routerHooks from '@calcom/lib/hooks/useRouterQuery';
(routerHooks as any).useRouterQuery = () => ({
  id: '1'
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    orgId: {
      type: "number",
      value: 1,
      label: "Organization ID",
    },
  });

  const form = useForm({
    defaultValues: {
      teams: [{ name: "" }],
      moveTeams: [],
    },
  });

  // Mock the trpc hooks
  const mockTeams = [
    { id: 1, name: "Team 1", slug: "team-1" },
    { id: 2, name: "Team 2", slug: "team-2" },
  ];

  const mockOrg = {
    id: state.orgId.value,
    slug: "org-slug",
    metadata: {
      requestedSlug: "org-slug"
    }
  };

  // Mock the trpc hooks as properties
  const mockedTrpc = {
    viewer: {
      teams: {
        list: {
          useQuery: () => ({ data: mockTeams, isLoading: false }),
        },
        get: {
          useQuery: () => ({ data: mockOrg, isLoading: false }),
        },
      },
      organizations: {
        listCurrent: {
          useQuery: () => ({
            data: [{
              id: state.orgId.value,
              slug: "org-slug",
              name: "Test Organization",
              members: [],
            }],
            isLoading: false,
          }),
        },
        createTeams: {
          useMutation: () => ({
            mutate: () => {},
            isPending: false,
            isSuccess: false,
          }),
        },
        publish: {
          useMutation: () => ({
            mutate: () => {},
          }),
        },
      },
    },
  };

  // Replace the global trpc object with our mocked version
  Object.assign(trpc, mockedTrpc);

  // Mock next-auth session
  const mockSession = {
    data: {
      user: {
        role: "ADMIN"
      }
    }
  };

  // Add session to window
  (window as any).mockSession = mockSession;

  return (
    <FormProvider {...form}>
      <AddNewTeamsForm />
    </FormProvider>
  );
}
</content>
  </change>
</file>

