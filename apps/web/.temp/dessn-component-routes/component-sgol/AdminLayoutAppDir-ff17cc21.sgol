    children: {
      type: "string",
      value: "<div>Sample Content</div>",
      label: "Children",
    },
    userRole: {
      type: "dropdown",
      value: "ADMIN",
      options: ["ADMIN", "OWNER", "MEMBER", "INACTIVE_ADMIN"],
