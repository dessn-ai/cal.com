  __esModule: true,
  default: MockAdminOrgTable
}));

jest.mock("@calcom/features/settings/appDir/SettingsHeader", () => ({
  __esModule: true,
  default: MockSettingsHeader
}));

jest.mock("@calcom/features/ee/common/components/LicenseRequired", () => ({
  __esModule: true,
  default: MockLicenseRequired
}));

jest.mock("app/_utils", () => ({
  __esModule: true,
  _generateMetadata: () => ({}),
  getTranslate: () => (key: string) => key,
}));

// Import the component after all mocks are set up
const ImportedComponent = React.lazy(() => import('../../app/(use-page-wrapper)/settings/(admin-layout)/admin/organizations/page'));

export default function ComponentPreview() {
  return (
    <React.Suspense fallback={<div>Loading...</div>}>
      <ImportedComponent />
    </React.Suspense>
  );
}
</content>
