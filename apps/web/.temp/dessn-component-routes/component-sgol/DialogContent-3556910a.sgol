import React from 'react';
import { useParentState } from '../useIframeState';
import { Dialog, DialogContent } from '../../../../packages/platform/atoms/src/components/ui/dialog';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "custom-dialog-content",
      label: "Class Name",
    },
  });

  return (
    <Dialog open={true}>
      <DialogContent className={state.className.value}>
        <h2>Dialog Content</h2>
        <p>This is an example of dialog content.</p>
      </DialogContent>
    </Dialog>
  );
}
</content>
</change>
</file>

I've made the following changes to fix the error:

1. Added the import for the `Dialog` component from the same location as `DialogContent`
2. Wrapped the `DialogContent` component with the `Dialog` component
3. Set the `open` prop to `true` on the Dialog component to ensure it's visible in the preview

This should resolve the "`DialogPortal` must be used within `Dialog`" error since we're now properly nesting the components according to Radix UI's requirements.

