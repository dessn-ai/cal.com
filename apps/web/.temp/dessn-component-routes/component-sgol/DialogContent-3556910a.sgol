import React from 'react';
import { useParentState } from '../useIframeState';
import * as DialogPrimitive from '@radix-ui/react-dialog';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "custom-dialog-content",
      label: "Class Name",
    },
  });

  return (
    <DialogPrimitive.Root open={true}>
      <DialogPrimitive.Portal>
        <DialogPrimitive.Overlay className="fixed inset-0 bg-black/80" />
        <DialogPrimitive.Content className={`fixed left-[50%] top-[50%] z-50 w-full max-w-lg translate-x-[-50%] translate-y-[-50%] bg-white p-6 shadow-lg duration-200 sm:rounded-lg ${state.className.value}`}>
          <h2>Dialog Content</h2>
          <p>This is an example of dialog content.</p>
          <DialogPrimitive.Close className="absolute right-4 top-4">
            ✕
          </DialogPrimitive.Close>
        </DialogPrimitive.Content>
      </DialogPrimitive.Portal>
    </DialogPrimitive.Root>
  );
}
</content>
</change>
</file>

I've made the following changes:

1. Imported the Dialog components directly from '@radix-ui/react-dialog' instead of using the wrapped components
2. Used DialogPrimitive.Root as the main wrapper
3. Explicitly included DialogPrimitive.Portal
4. Added DialogPrimitive.Overlay and DialogPrimitive.Content with basic styling
5. Added a DialogPrimitive.Close button
6. Maintained the custom className from the state

This approach should resolve the context issues by ensuring all the necessary Radix UI Dialog components are properly nested and the required contexts are available. The error was likely occurring because the custom DialogContent component was trying to use Portal in a way that wasn't properly connected to the Dialog context.

