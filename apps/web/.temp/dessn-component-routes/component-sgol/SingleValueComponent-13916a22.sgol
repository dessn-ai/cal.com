import React from 'react';
import { useParentState } from '../useIframeState';
import { components } from 'react-select';
import { SingleValueComponent } from '../../../../packages/features/calendars/DestinationCalendarSelector';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    option: {
      type: "dropdown",
      value: "option1",
      options: ["option1", "option2", "option3"],
      label: "Option",
    },
    label: {
      type: "string",
      value: "Example Label",
      label: "Label",
    },
    subtitle: {
      type: "string",
      value: "Example Subtitle",
      label: "Subtitle",
    },
  });

  const option = {
    label: state.label.value,
    value: state.option.value,
    subtitle: state.subtitle.value,
  };

  return (
    <components.SingleValue
      {...{
        data: option,
        selectProps: {
          classNamePrefix: 'select',
          className: 'react-select',
        },
        children: (
          <div className="flex space-x-1">
            <p>{option.label}</p>
            <p className="text-subtle">{option.subtitle}</p>
          </div>
        ),
        hasValue: true,
        isDisabled: false,
        isFocused: false,
      }}
    />
  );
}
</content>
  </change>
</file>

I've made the following changes:

1. Imported `components` from 'react-select'
2. Instead of using SingleValueComponent directly, we're using the base `components.SingleValue` since that's what the original component extends
3. Simplified the props structure to match what react-select expects
4. Added the proper children structure matching the original component's render output
5. Removed unnecessary styling props that were causing issues

This should resolve the "getClassNames is not a function" error by using the proper react-select component structure. The component now matches the implementation from the source file while providing all the necessary props in the correct format.

