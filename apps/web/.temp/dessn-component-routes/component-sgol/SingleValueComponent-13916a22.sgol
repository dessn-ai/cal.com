import React from 'react';
import { useParentState } from '../useIframeState';
import { components } from 'react-select';
import { SingleValueComponent } from '../../../../packages/features/calendars/DestinationCalendarSelector';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    option: {
      type: "dropdown",
      value: "option1",
      options: ["option1", "option2", "option3"],
      label: "Option",
    },
    label: {
      type: "string",
      value: "Example Label",
      label: "Label",
    },
    subtitle: {
      type: "string",
      value: "Example Subtitle",
      label: "Subtitle",
    },
  });

  const option = {
    label: state.label.value,
    value: state.option.value,
    subtitle: state.subtitle.value,
  };

  return (
    <components.SingleValue
      {...{
        children: option.label,
        data: option,
        selectProps: {
          classNamePrefix: 'select',
        },
        className: "",
        cx: (prefix: string, className: string) => `${prefix}__${className}`,
        getStyles: () => ({}),
        getValue: () => [option],
        hasValue: true,
        isDisabled: false,
        isFocused: false,
        isMulti: false,
        options: [option],
        selectOption: () => {},
        theme: {
          spacing: { baseUnit: 4, controlHeight: 38, menuGutter: 8 },
          borderRadius: 4,
          colors: {
            primary: '#000000',
            primary75: '#000000',
            primary50: '#000000',
            primary25: '#000000',
            danger: '#DE350B',
            dangerLight: '#FFBDAD',
            neutral0: '#FFFFFF',
            neutral5: '#F2F2F2',
            neutral10: '#E6E6E6',
            neutral20: '#CCCCCC',
            neutral30: '#B3B3B3',
            neutral40: '#999999',
            neutral50: '#808080',
            neutral60: '#666666',
            neutral70: '#4D4D4D',
            neutral80: '#333333',
            neutral90: '#1A1A1A'
          }
        }
      }}>
      <p>{option.label}</p> <p className="text-subtle">{option.subtitle}</p>
    </components.SingleValue>
  );
}
</content>
  </change>
</file>

The main changes I made are:

1. Imported `components` from 'react-select'
2. Used `components.SingleValue` directly instead of our custom component since it needs the base component's context
3. Provided all the necessary props that react-select's SingleValue component expects
4. Implemented a proper `cx` function that follows react-select's className composition pattern
5. Structured the component to match how it's used in the actual implementation

This should resolve the "getClassNames is not a function" error by providing the proper react-select component structure and all required props.

