    },
  });

  return (
    <OrgBrandingProvider>
      <DataTableProvider>
        <UserListTable
          className={state.className.value}
          payouts={JSON.parse(state.payouts.value)}
          isLoading={state.isLoading.value}
          props={JSON.parse(state.props.value)}
        />
      </DataTableProvider>
    </OrgBrandingProvider>
  );
}

// Ensure the mock is available immediately
(globalThis as any).useOrgBranding = useOrgBranding;
(globalThis as any).OrgBrandingProvider = OrgBrandingProvider;
