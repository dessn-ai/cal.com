    <description>Remove Jest mock and use module override pattern</description>
    <content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { UserListTable } from '../../../../packages/features/users/components/UserTable/UserListTable';
import { DataTableProvider } from '@calcom/features/data-table';

// Create a mock context and hook
const mockOrgBrandingData = {
  theme: null,
  orgSlug: "default-org",
  hideBranding: false,
  organizationName: "Test Organization",
  fullDomain: "test.cal.com",
  logo: "",
  brandColor: "#292929",
  darkBrandColor: "#fafafa",
  isLoading: false,
};

// Override the actual module
const MockOrgBrandingProvider = ({ children }) => {
  return (
    <div data-testid="mock-org-branding-provider">
      {children}
    </div>
  );
};

// Create a wrapper component that provides the mock context
const WithMockOrgBranding = ({ children }) => {
  // Create a context that will override the original
  const OrgBrandingContext = React.createContext(mockOrgBrandingData);
  
  // Override the useOrgBranding hook
  const useOrgBranding = () => React.useContext(OrgBrandingContext);
  
  // Inject the mock hook into the global scope
  if (typeof window !== 'undefined') {
    window.useOrgBranding = useOrgBranding;
  }

  return (
    <OrgBrandingContext.Provider value={mockOrgBrandingData}>
      {children}
    </OrgBrandingContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "",
      label: "Class Name",
    },
    payouts: {
      type: "string",
      value: "{}",
      label: "Payouts",
    },
    isLoading: {
      type: "boolean",
      value: false,
      label: "Is Loading",
    },
    props: {
      type: "string",
      value: "{}",
      label: "Table Props",
    },
  });

  return (
    <WithMockOrgBranding>
      <DataTableProvider>
        <UserListTable
          className={state.className.value}
          payouts={JSON.parse(state.payouts.value)}
          isLoading={state.isLoading.value}
          props={JSON.parse(state.props.value)}
        />
      </DataTableProvider>
    </WithMockOrgBranding>
  );
}
</content>
  </change>
</file>

