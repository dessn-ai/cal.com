<file name="apps/web/.temp/dessn-component-routes/UserListTable-dec9cac0.tsx" type="preview>
import React from 'react';
import { useParentState } from '../useIframeState';
import { UserListTable } from '../../../../packages/features/users/components/UserTable/UserListTable';
import { DataTableProvider } from '@calcom/features/data-table';

const mockOrgBrandingData = {
  orgBranding: {
    theme: null,
    logo: "",
    brandColor: "#292929",
    darkBrandColor: "#fafafa",
    orgSlug: "default-org",
    fullDomain: "http://localhost:3000",
    hideBranding: false,
  },
  isLoading: false,
  organization: {
    name: "Demo Organization",
    slug: "default-org",
  }
};

// Create a component that handles the module interception
const OrgBrandingInterceptor = ({ children }) => {
  React.useEffect(() => {
    // Intercept the module
    const mockModule = {
      useOrgBranding: () => mockOrgBrandingData
    };

    // Add to window for global access
    (window as any).__orgBrandingModule = mockModule;
    (window as any).useOrgBranding = mockModule.useOrgBranding;

    // Try to override the module
    try {
      const originalRequire = (window as any).require;
      if (originalRequire) {
        originalRequire.cache['@calcom/features/ee/organizations/context/provider'] = {
          exports: mockModule
        };
      }
    } catch (e) {
      console.warn('Failed to override module:', e);
    }
  }, []);

  return (
    <div data-testid="org-branding-interceptor">
      {children}
    </div>
  );
};

// Create a component that wraps the table with error handling
const SafeUserListTable = (props) => {
  const [error, setError] = React.useState<Error | null>(null);

  if (error) {
    return (
      <div className="p-4 text-red-500">
        <h3>Error rendering UserListTable:</h3>
        <pre>{error.message}</pre>
      </div>
    );
  }

  return (
    <React.Suspense fallback={<div>Loading...</div>}>
      <UserListTable {...props} />
    </React.Suspense>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "",
      label: "Class Name",
    },
    payouts: {
      type: "string",
      value: "{}",
      label: "Payouts",
    },
    isLoading: {
      type: "boolean",
      value: false,
      label: "Is Loading",
    },
    props: {
      type: "string",
      value: "{}",
      label: "Table Props",
    },
  });

  return (
    <OrgBrandingInterceptor>
      <DataTableProvider>
        <SafeUserListTable
          className={state.className.value}
          payouts={JSON.parse(state.payouts.value)}
          isLoading={state.isLoading.value}
          props={JSON.parse(state.props.value)}
        />
      </DataTableProvider>
    </OrgBrandingInterceptor>
  );
}

// Ensure the mock is available immediately
if (typeof window !== 'undefined') {
  (window as any).useOrgBranding = () => mockOrgBrandingData;
}
</file>

