import React from 'react';
import { useParentState } from '../useIframeState';
import { UserListTable } from '../../../../packages/features/users/components/UserTable/UserListTable';
import { DataTableProvider } from '@calcom/features/data-table';

// Create a wrapper component that provides the mock implementation
const MockedUserListTable = (props) => {
  // Mock the hook implementation directly in the component's scope
  const mockData = {
    orgBranding: {
      theme: null,
      logo: "",
      brandColor: "#292929",
      darkBrandColor: "#fafafa",
      orgSlug: "default-org",
      fullDomain: "http://localhost:3000",
      hideBranding: false,
    },
    isLoading: false,
    organization: {
      name: "Demo Organization",
      slug: "default-org",
    }
  };

  // Override the hook implementation
  React.useEffect(() => {
    const originalModule = require('@calcom/features/ee/organizations/context/provider');
    if (originalModule) {
      originalModule.useOrgBranding = () => mockData;
    }
  }, []);

  return (
    <DataTableProvider>
      <UserListTable {...props} />
    </DataTableProvider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "",
      label: "Class Name",
    },
    payouts: {
      type: "string",
      value: "{}",
      label: "Payouts",
    },
    isLoading: {
      type: "boolean",
      value: false,
      label: "Is Loading",
    },
    props: {
      type: "string",
      value: "{}",
      label: "Table Props",
    },
  });

  try {
    return (
      <MockedUserListTable
        className={state.className.value}
        payouts={JSON.parse(state.payouts.value)}
        isLoading={state.isLoading.value}
        props={JSON.parse(state.props.value)}
      />
    );
  } catch (error) {
    console.error('Error rendering UserListTable:', error);
    return (
      <div className="p-4">
        <p>Error: Failed to render UserListTable component</p>
        <pre>{error.message}</pre>
      </div>
    );
  }
}

// Ensure the mock is available globally
if (typeof window !== 'undefined') {
  const mockData = {
    orgBranding: {
      theme: null,
      logo: "",
      brandColor: "#292929",
      darkBrandColor: "#fafafa",
      orgSlug: "default-org",
      fullDomain: "http://localhost:3000",
      hideBranding: false,
    },
    isLoading: false,
    organization: {
      name: "Demo Organization",
      slug: "default-org",
    }
  };
  
  // @ts-ignore
  window.useOrgBranding = () => mockData;
}
</content>
</change>
</file>

