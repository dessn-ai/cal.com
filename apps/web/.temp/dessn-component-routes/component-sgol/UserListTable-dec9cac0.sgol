<file path="apps/web/.temp/dessn-component-routes/UserListTable-dec9cac0.tsx">
<change>
<description>Mock the useOrgBranding hook directly without using window or context</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { UserListTable } from '../../../../packages/features/users/components/UserTable/UserListTable';
import { DataTableProvider } from '@calcom/features/data-table';

// Mock the module before importing
const mockOrgBrandingData = {
  orgBranding: {
    theme: null,
    logo: "",
    brandColor: "#292929",
    darkBrandColor: "#fafafa",
    orgSlug: "default-org",
    fullDomain: "http://localhost:3000",
    hideBranding: false,
  },
  isLoading: false,
  organization: {
    name: "Demo Organization",
    slug: "default-org",
  },
};

// Create a HOC to inject the mock hook
const withMockOrgBranding = (WrappedComponent) => {
  return (props) => {
    // Replace the useOrgBranding implementation
    const useOrgBranding = () => mockOrgBrandingData;
    
    // Inject the mock hook into the component's context
    return (
      <DataTableProvider>
        <WrappedComponent {...props} />
      </DataTableProvider>
    );
  };
};

// Wrap the UserListTable with our mock
const EnhancedUserListTable = withMockOrgBranding(UserListTable);

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "",
      label: "Class Name",
    },
    payouts: {
      type: "string",
      value: "{}",
      label: "Payouts",
    },
    isLoading: {
      type: "boolean",
      value: false,
      label: "Is Loading",
    },
    props: {
      type: "string",
      value: "{}",
      label: "Table Props",
    },
  });

  try {
    return (
      <EnhancedUserListTable
        className={state.className.value}
        payouts={JSON.parse(state.payouts.value)}
        isLoading={state.isLoading.value}
        props={JSON.parse(state.props.value)}
      />
    );
  } catch (error) {
    console.error('Error rendering UserListTable:', error);
    return (
      <div className="p-4">
        <p>Error: Failed to render UserListTable component</p>
        <pre>{error.message}</pre>
      </div>
    );
  }
}
</content>
</change>
</file>

