import React from 'react';
import { useParentState } from '../useIframeState';
import { UserListTable } from '../../../../packages/features/users/components/UserTable/UserListTable';
import { DataTableProvider } from '@calcom/features/data-table';

// Create a mock context
const OrgBrandingContext = React.createContext(null);

// Create the actual provider that the component is expecting
const OrgBrandingProvider = ({ children }) => {
  const value = {
    orgBranding: {
      theme: null,
      logo: "",
      brandColor: "#292929",
      darkBrandColor: "#fafafa",
      orgSlug: "default-org",
      fullDomain: "http://localhost:3000",
      hideBranding: false,
    },
    isLoading: false,
    organization: {
      name: "Demo Organization",
      slug: "default-org",
    }
  };

  return (
    <OrgBrandingContext.Provider value={value}>
      {children}
    </OrgBrandingContext.Provider>
  );
};

// Create the hook that matches the original implementation
const useOrgBranding = () => {
  const context = React.useContext(OrgBrandingContext);
  if (!context) {
    throw new Error("useOrgBranding must be used within an OrgBrandingProvider");
  }
  return context;
};

// Override the imports that the UserListTable is expecting
import('@calcom/features/ee/organizations/context/provider').then(module => {
  module.OrgBrandingProvider = OrgBrandingProvider;
  module.useOrgBranding = useOrgBranding;
}).catch(console.error);

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "",
      label: "Class Name",
    },
    payouts: {
      type: "string",
      value: "{}",
      label: "Payouts",
    },
    isLoading: {
      type: "boolean",
      value: false,
      label: "Is Loading",
    },
    props: {
      type: "string",
      value: "{}",
      label: "Table Props",
    },
  });

  return (
    <OrgBrandingProvider>
      <DataTableProvider>
        <UserListTable
          className={state.className.value}
          payouts={JSON.parse(state.payouts.value)}
          isLoading={state.isLoading.value}
          props={JSON.parse(state.props.value)}
        />
      </DataTableProvider>
    </OrgBrandingProvider>
  );
}

// Ensure the mock is available immediately
(globalThis as any).useOrgBranding = useOrgBranding;
(globalThis as any).OrgBrandingProvider = OrgBrandingProvider;
</file>

