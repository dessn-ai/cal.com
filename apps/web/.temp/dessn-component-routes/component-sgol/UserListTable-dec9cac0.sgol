import React from 'react';
import { useParentState } from '../useIframeState';
import { UserListTable } from '../../../../packages/features/users/components/UserTable/UserListTable';
import { DataTableProvider } from '@calcom/features/data-table';

// Create a mock context for organization branding
const OrgBrandingContext = React.createContext({
  theme: null,
  orgSlug: "default-org",
  hideBranding: false,
  organizationName: "Test Organization",
  fullDomain: "test.cal.com",
  logo: "",
  brandColor: "#292929",
  darkBrandColor: "#fafafa",
  isLoading: false,
});

// Mock the useOrgBranding hook
jest.mock("@calcom/features/ee/organizations/context/provider", () => ({
  useOrgBranding: () => React.useContext(OrgBrandingContext),
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "",
      label: "Class Name",
    },
    payouts: {
      type: "string",
      value: "{}",
      label: "Payouts",
    },
    isLoading: {
      type: "boolean",
      value: false,
      label: "Is Loading",
    },
    props: {
      type: "string",
      value: "{}",
      label: "Table Props",
    },
  });

  return (
    <OrgBrandingContext.Provider
      value={{
        theme: null,
        orgSlug: "default-org",
        hideBranding: false,
        organizationName: "Test Organization",
        fullDomain: "test.cal.com",
        logo: "",
        brandColor: "#292929",
        darkBrandColor: "#fafafa",
        isLoading: false,
      }}
    >
      <DataTableProvider>
        <UserListTable
          className={state.className.value}
          payouts={JSON.parse(state.payouts.value)}
          isLoading={state.isLoading.value}
          props={JSON.parse(state.props.value)}
        />
      </DataTableProvider>
    </OrgBrandingContext.Provider>
  );
}
</content>
  </change>
</file>

