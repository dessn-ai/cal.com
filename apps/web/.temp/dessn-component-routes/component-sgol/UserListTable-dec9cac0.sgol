<description>Create a mock OrgBrandingProvider context and wrap the component</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { UserListTable } from '../../../../packages/features/users/components/UserTable/UserListTable';
import { DataTableProvider } from '@calcom/features/data-table';

// Create a mock context for organization branding
const MockOrgContext = React.createContext({
  orgBranding: {
    theme: null,
    logo: "",
    brandColor: "#292929",
    darkBrandColor: "#fafafa",
    orgSlug: "default-org",
    fullDomain: "http://localhost:3000",
    hideBranding: false,
  },
  isLoading: false,
  organization: {
    name: "Demo Organization",
    slug: "default-org",
  },
});

// Mock provider component
const MockOrgProvider = ({ children }) => {
  return (
    <MockOrgContext.Provider
      value={{
        orgBranding: {
          theme: null,
          logo: "",
          brandColor: "#292929",
          darkBrandColor: "#fafafa",
          orgSlug: "default-org",
          fullDomain: "http://localhost:3000",
          hideBranding: false,
        },
        isLoading: false,
        organization: {
          name: "Demo Organization",
          slug: "default-org",
        },
      }}>
      {children}
    </MockOrgContext.Provider>
  );
};

// Mock the useOrgBranding hook
const useOrgBranding = () => React.useContext(MockOrgContext);

// Override the actual module
jest.mock("@calcom/features/ee/organizations/context/provider", () => ({
  useOrgBranding,
  OrgBrandingProvider: MockOrgProvider,
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "",
      label: "Class Name",
    },
    payouts: {
      type: "string",
      value: "{}",
      label: "Payouts",
    },
    isLoading: {
      type: "boolean",
      value: false,
      label: "Is Loading",
    },
    props: {
      type: "string",
      value: "{}",
      label: "Table Props",
    },
  });

  return (
    <MockOrgProvider>
      <DataTableProvider>
        <UserListTable
          className={state.className.value}
          payouts={JSON.parse(state.payouts.value)}
          isLoading={state.isLoading.value}
          props={JSON.parse(state.props.value)}
        />
      </DataTableProvider>
    </MockOrgProvider>
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Created a mock context (`MockOrgContext`) with all the necessary organization branding values
2. Created a mock provider component (`MockOrgProvider`) that provides the mock context
3. Created a mock `useOrgBranding` hook that uses the mock context
