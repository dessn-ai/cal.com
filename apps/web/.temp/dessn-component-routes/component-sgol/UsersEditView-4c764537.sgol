  import.meta.hot?.accept(['@calcom/lib/i18n'], (modules) => {
    if (modules) {
      modules[0].locales = locales;
      modules[0].localeOptions = localeOptions;
      modules[0].defaultLocaleOption = defaultLocaleOption;
    }
  });
} catch (e) {
  console.warn('Hot module replacement not available');
}

const ErrorBoundary = ({ children }) => {
  const [hasError, setHasError] = React.useState(false);

  React.useEffect(() => {
    const handleError = (error) => {
      console.error('Caught error:', error);
      setHasError(true);
    };

    window.addEventListener('error', handleError);
    return () => window.removeEventListener('error', handleError);
  }, []);

  if (hasError) {
    return <div>Something went wrong. Please try again.</div>;
  }

  return children;
};

