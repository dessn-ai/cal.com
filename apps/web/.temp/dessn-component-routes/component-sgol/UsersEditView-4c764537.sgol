import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../../../packages/features/ee/users/pages/users-edit-view';
import { useForm, FormProvider } from 'react-hook-form';
import i18next from 'i18next';
import { I18nextProvider, initReactI18next } from 'react-i18next';

// Mock the i18n configuration
const i18nConfig = {
  locales: ['en', 'fr', 'de', 'es', 'pt', 'it', 'ja', 'ko', 'zh', 'ar', 'hi'],
  defaultLocale: 'en'
};

// Initialize i18next with more comprehensive configuration
i18next
  .use(initReactI18next)
  .init({
    resources: {
      en: {
        translation: {
          // Add common translations that might be needed
          common: {
            save: 'Save',
            cancel: 'Cancel',
            edit: 'Edit',
            delete: 'Delete',
            confirm: 'Confirm',
            submit: 'Submit'
          }
        }
      }
    },
    lng: "en",
    fallbackLng: "en",
    interpolation: {
      escapeValue: false
    },
    supportedLngs: i18nConfig.locales,
    defaultNS: 'translation',
    fallbackNS: 'common'
  });

// Export these for any components that might need them
export const locales = i18nConfig.locales;
export const localeOptions = locales.map((locale) => ({
  value: locale,
  label: new Intl.DisplayNames(locale, { type: "language" }).of(locale) || locale,
}));

export const defaultLocaleOption = localeOptions.find(
  (locale) => locale.value === i18nConfig.defaultLocale
);

