<description>Add necessary providers and mock dependencies</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../components/apps/installation/EventTypeConferencingAppSettings';
import { FormProvider, useForm } from 'react-hook-form';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { I18nextProvider } from 'react-i18next';
import i18next from 'i18next';

// Mock the SchedulingType enum
const SchedulingType = {
  ROUND_ROBIN: "ROUND_ROBIN",
  COLLECTIVE: "COLLECTIVE",
  MANAGED: "MANAGED"
} as const;

// Initialize i18next
i18next.init({
  lng: 'en',
  resources: {
    en: {
      translation: {
        location: 'Location',
        default: 'Default',
        members_default_location: 'Members Default Location'
      }
    }
  }
});

// Create a client
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
    },
  },
});

export default function ComponentPreview() {
  const formMethods = useForm();
  
  const [state, setState] = useParentState({
    eventType: {
      type: "object",
      value: {
        id: 1,
        title: "Sample Event",
        description: "This is a sample event description",
        teamId: null,
        length: 60,
        recurringEvent: null,
        seatsPerTimeSlot: null,
        team: null,
        URL: "https://example.com/event",
        schedulingType: SchedulingType.ROUND_ROBIN,
        slug: "sample-event",
        metadata: {},
        position: 0,
        destinationCalendar: null,
        selected: false,
        locations: [],
        bookingFields: [],
      },
      label: "Event Type",
    },
    slug: {
      type: "string",
      value: "sample-app",
      label: "Slug",
    },
  });

  return (
    <I18nextProvider i18n={i18next}>
      <QueryClientProvider client={queryClient}>
        <FormProvider {...formMethods}>
          <ImportedComponent
            eventType={state.eventType.value}
            slug={state.slug.value}
          />
        </FormProvider>
      </QueryClientProvider>
    </I18nextProvider>
  );
}
</content>
</change>
</file>

I've made several important changes:

1. Changed `SchedulingType` from an enum to a const object to match how it's used in the component
2. Added necessary providers that the component needs:
   - FormProvider from react-hook-form
   - QueryClientProvider from @tanstack/react-query
   - I18nextProvider for translations
3. Added basic i18next initialization with required translations
4. Added form methods using useForm hook

This should resolve the SchedulingType error and provide the necessary context for the component to render properly. The component should now have access to all the required providers and context it needs to function.

