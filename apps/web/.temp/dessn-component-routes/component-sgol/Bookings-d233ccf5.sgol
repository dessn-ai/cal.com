  return (
    <trpc.Provider client={trpcClient} queryClient={queryClient}>
      <QueryClientProvider client={queryClient}>
        <DataTableProvider>
          <Bookings status={state.status.value as any} />
        </DataTableProvider>
      </QueryClientProvider>
    </trpc.Provider>
  );
}
</content>
