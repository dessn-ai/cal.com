<content>
import React from "react";
import { useParentState } from "../useIframeState";
import { CreateANewLicenseKeyForm } from "../../../../packages/features/ee/deployment/licensekey/CreateLicenseKeyForm";
import { SessionProvider } from "next-auth/react";
import type { Session } from "next-auth";

export default function ComponentPreview() {
  const [state] = useParentState({
    mockSession: {
      type: "boolean",
      value: true,
      label: "Mock Admin Session",
    },
  });

  const mockSession: Session = {
    expires: "2024-12-31T23:59:59.999Z",
    user: {
      id: "testuser",
      name: "Test User",
      email: "test@example.com",
      role: state.mockSession.value ? "ADMIN" : "USER",
      username: "testuser",
      emailVerified: new Date().toISOString(),
    }
  };

  return (
    <div className="m-4">
      <SessionProvider session={mockSession}>
        <CreateANewLicenseKeyForm />
      </SessionProvider>
    </div>
  );
}
</content>
</change>
</file>

Changes made:
1. Added proper typing for Session from next-auth
2. Restructured the mockSession object to match the exact structure expected by next-auth:
   - Moved user object to the top level of the session
   - Removed the nested data structure
   - Changed emailVerified to be an ISO string date
3. Added proper type annotation for mockSession
4. Removed the status property as it's not part of the Session type

This should resolve the error because:
1. The session structure now matches what next-auth expects
2. The user object with role is directly accessible at session.user.role
3. All properties are properly typed and structured

The error was occurring because the component was trying to access the role property through a different path than what we were providing. This new structure should match what the CreateANewLicenseKeyForm component expects.

