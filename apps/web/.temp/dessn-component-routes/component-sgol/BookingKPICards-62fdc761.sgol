        },
      ],
    },
  ],
  isLoading: false,
  error: null,
};

// Mock the hooks
jest.mock('../../../../packages/features/insights/hooks/useInsightsOrgTeams', () => ({
  useInsightsOrgTeams: () => mockOrgTeamsData
}));

// Create mock InsightsContext
const InsightsContext = React.createContext({
  dateRange: {
    startDate: new Date(),
    endDate: new Date(),
  },
  setDateRange: () => {},
  selectedTeamId: 1,
  setSelectedTeamId: () => {},
  selectedUserId: 1,
  setSelectedUserId: () => {},
  isAll: false,
  setIsAll: () => {},
  memberUserId: 1,
  setMemberUserId: () => {},
  eventTypeId: 1,
  setEventTypeId: () => {},
});

// Mock InsightsProvider component
const MockInsightsProvider = ({ children }: { children: React.ReactNode }) => {
  const contextValue = {
    dateRange: {
      startDate: new Date(),
      endDate: new Date(new Date().setMonth(new Date().getMonth() + 1)),
    },
    setDateRange: () => {},
    selectedTeamId: 1,
    setSelectedTeamId: () => {},
    selectedUserId: 1,
    setSelectedUserId: () => {},
    isAll: false,
    setIsAll: () => {},
    memberUserId: 1,
    setMemberUserId: () => {},
    eventTypeId: 1,
    setEventTypeId: () => {},
  };

  return (
    <InsightsContext.Provider value={contextValue}>
      {children}
    </InsightsContext.Provider>
  );
};

// Create a wrapper component that provides all necessary context and mocks
const MockWrapper = ({ children }: { children: React.ReactNode }) => {
  // Create a mock implementation of useInsightsOrgTeams
  const useInsightsOrgTeams = () => mockOrgTeamsData;

  // Attach the mock to the window object so it's globally available
  (window as any).useInsightsOrgTeams = useInsightsOrgTeams;

  return (
    <MockInsightsProvider>
      {children}
    </MockInsightsProvider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    startDate: {
      type: "string",
      value: new Date().toISOString(),
      label: "Start Date",
    },
    endDate: {
      type: "string",
      value: new Date(new Date().setMonth(new Date().getMonth() + 1)).toISOString(),
      label: "End Date",
    },
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
    userId: {
      type: "number",
      value: 1,
      label: "User ID",
    },
    isAll: {
      type: "boolean",
      value: false,
      label: "Is All",
    },
    memberUserId: {
      type: "number",
      value: 1,
      label: "Member User ID",
    },
    eventTypeId: {
      type: "number",
      value: 1,
      label: "Event Type ID",
    },
  });

  // Override the useInsightsOrgTeams hook
  React.useEffect(() => {
    const originalModule = require('../../../../packages/features/insights/hooks/useInsightsOrgTeams');
    if (originalModule) {
      originalModule.useInsightsOrgTeams = () => mockOrgTeamsData;
    }
  }, []);

  return (
    <MockWrapper>
      <BookingKPICards />
    </MockWrapper>
  );
}
</content>
