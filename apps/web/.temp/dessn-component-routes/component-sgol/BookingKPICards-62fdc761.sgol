import React from 'react';
import { useParentState } from '../useIframeState';
import { BookingKPICards } from '../../../../packages/features/insights/components/BookingKPICards';

// Create mock InsightsProvider context
const InsightsContext = React.createContext({
  dateRange: {
    startDate: new Date(),
    endDate: new Date(),
  },
  setDateRange: () => {},
  selectedTeamId: 1,
  setSelectedTeamId: () => {},
  selectedUserId: 1,
  setSelectedUserId: () => {},
  isAll: false,
  setIsAll: () => {},
  memberUserId: 1,
  setMemberUserId: () => {},
  eventTypeId: 1,
  setEventTypeId: () => {},
});

// Mock InsightsProvider component
const MockInsightsProvider = ({ children }: { children: React.ReactNode }) => {
  const contextValue = {
    dateRange: {
      startDate: new Date(),
      endDate: new Date(new Date().setMonth(new Date().getMonth() + 1)),
    },
    setDateRange: () => {},
    selectedTeamId: 1,
    setSelectedTeamId: () => {},
    selectedUserId: 1,
    setSelectedUserId: () => {},
    isAll: false,
    setIsAll: () => {},
    memberUserId: 1,
    setMemberUserId: () => {},
    eventTypeId: 1,
    setEventTypeId: () => {},
  };

  return (
    <InsightsContext.Provider value={contextValue}>
      {children}
    </InsightsContext.Provider>
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    startDate: {
      type: "string",
      value: new Date().toISOString(),
      label: "Start Date",
    },
    endDate: {
      type: "string",
      value: new Date(new Date().setMonth(new Date().getMonth() + 1)).toISOString(),
      label: "End Date",
    },
    teamId: {
      type: "number",
      value: 1,
      label: "Team ID",
    },
    userId: {
      type: "number",
      value: 1,
      label: "User ID",
    },
    isAll: {
      type: "boolean",
      value: false,
      label: "Is All",
    },
    memberUserId: {
      type: "number",
      value: 1,
      label: "Member User ID",
    },
    eventTypeId: {
      type: "number",
      value: 1,
      label: "Event Type ID",
    },
  });

  return (
    <MockInsightsProvider>
      <BookingKPICards />
    </MockInsightsProvider>
  );
}
