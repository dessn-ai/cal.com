<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../app/layout';
import { I18nextProvider } from 'react-i18next';
import i18next from 'i18next';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { SessionProvider } from 'next-auth/react';
import { TooltipProvider } from '@radix-ui/react-tooltip';

// Mock next-i18next configuration
jest.mock('@/config/next-i18next.config.js', () => ({
  i18n: {
    defaultLocale: 'en',
    locales: ['en'],
  },
}));

// Initialize i18next with minimal configuration
const i18n = i18next.createInstance({
  lng: 'en',
  fallbackLng: 'en',
  resources: {
    en: {
      translation: {}
    }
  },
  interpolation: {
    escapeValue: false
  }
});

i18n.init();

// Create a client
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    children: {
      type: "string",
      value: "<div>Sample child content</div>",
      label: "Children",
    },
  });

  return (
    <SessionProvider session={null}>
      <I18nextProvider i18n={i18n}>
        <QueryClientProvider client={queryClient}>
          <TooltipProvider>
            <ImportedComponent>
              {React.createElement('div', { dangerouslySetInnerHTML: { __html: state.children.value } })}
            </ImportedComponent>
          </TooltipProvider>
        </QueryClientProvider>
      </I18nextProvider>
    </SessionProvider>
  );
}
</content>
</change>
</file>

The changes I made:

1. Added mock for `next-i18next.config.js` using jest.mock
2. Added all the providers that appear in the error stack:
   - SessionProvider from next-auth
   - QueryClientProvider from react-query
   - TooltipProvider from radix-ui
3. Configured a QueryClient instance with default options
4. Wrapped the component with all necessary providers in the correct order

This should provide all the necessary context and configuration that the layout component needs. The providers are added in the same order as they appear in the error stack to maintain the correct context hierarchy.

If the error persists, we might need to:
1. Mock the actual layout component
2. Or create a mock version of the i18n configuration file directly
3. Or try to intercept the import of the i18n configuration

Let me know if you need to try any of these alternative approaches.

