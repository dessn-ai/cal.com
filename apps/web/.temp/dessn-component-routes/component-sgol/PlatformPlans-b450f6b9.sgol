import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../modules/settings/platform/plans/platform-plans-view';
import * as hooks from '@components/settings/platform/hooks/useGetUserAttributes';

// Override the real hook with our mock implementation
const mockUseGetUserAttributes = hooks.useGetUserAttributes;
hooks.useGetUserAttributes = function() {
  const [state] = useParentState({
    isUserLoading: {
      type: "boolean",
      value: false,
      label: "Is User Loading",
    },
    isUserBillingDataLoading: {
      type: "boolean",
      value: false,
      label: "Is User Billing Data Loading",
    },
    isPlatformUser: {
      type: "boolean",
      value: true,
      label: "Is Platform User",
    },
    isPaidUser: {
      type: "boolean",
      value: true,
      label: "Is Paid User",
    },
    userBillingData: {
      type: "string",
      value: JSON.stringify({ plan: "PRO" }),
      label: "User Billing Data",
    },
    userOrgId: {
      type: "string",
      value: "org-123",
      label: "User Org ID",
    },
  });

  return {
    isUserLoading: state.isUserLoading.value,
    isUserBillingDataLoading: state.isUserBillingDataLoading.value,
    isPlatformUser: state.isPlatformUser.value,
    isPaidUser: state.isPaidUser.value,
    userBillingData: JSON.parse(state.userBillingData.value),
    userOrgId: state.userOrgId.value,
  };
};

export default function ComponentPreview() {
  return <ImportedComponent />;
}
    </content>
  </change>
</file>

The changes I made:
1. Removed all Jest-specific code (`jest.mock` and `jest.Mock`)
2. Implemented a direct mock by overriding the actual hook
3. Moved the state management directly into the mock implementation
4. Simplified the ComponentPreview to just render the ImportedComponent

This approach should work better in a preview environment where Jest is not available. The mock functionality remains the same, but it's implemented in a way that doesn't require Jest's mocking infrastructure.

