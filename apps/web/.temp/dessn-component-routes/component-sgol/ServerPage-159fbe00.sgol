<description>Implement proper dynamic import with error handling and simplified provider structure</description>
<content>
import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';
import dynamic from 'next/dynamic';
import { ErrorBoundary } from 'react-error-boundary';

// Dynamically import the component with no SSR
const DynamicComponent = dynamic(
  () => import('../../app/(use-page-wrapper)/apps/[slug]/setup/page').catch(() => {
    // Return a fallback component if import fails
    return () => <div>Failed to load component</div>;
  }),
  { 
    ssr: false,
    loading: () => <div>Loading...</div>
  }
);

function ErrorFallback({ error }: { error: Error }) {
  return (
    <div role="alert">
      <p>Something went wrong:</p>
      <pre>{error.message}</pre>
    </div>
  );
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    params: {
      type: "string",
      value: JSON.stringify({ slug: "example-app" }),
      label: "Params",
    },
    searchParams: {
      type: "string",
      value: JSON.stringify({ query: "test" }),
      label: "Search Params",
    },
  });

  const params = JSON.parse(state.params.value);
  const searchParams = JSON.parse(state.searchParams.value);

  return (
    <ErrorBoundary FallbackComponent={ErrorFallback}>
      <Suspense fallback={<div>Loading...</div>}>
        <DynamicComponent params={params} searchParams={searchParams} />
      </Suspense>
    </ErrorBoundary>
  );
}
</content>
</change>
</file>

I've made several important changes to handle the dynamic import issue:

1. Removed all the providers temporarily since they might be causing issues and are likely already provided by the parent Wrapper component (as seen in the stack trace)
2. Added proper dynamic import using Next.js's `dynamic` function with error handling
3. Disabled SSR for the dynamic component to ensure it only loads on the client side
4. Added a proper ErrorBoundary component to catch and display any rendering errors
5. Implemented a fallback UI for both loading and error states
6. Added error catching for the dynamic import itself

The changes focus on:
- Proper dynamic loading with fallbacks
- Error handling at multiple levels
- Simplified component structure
- Removing potentially conflicting provider duplicates

This approach should be more resilient because:
1. It handles the dynamic import more gracefully
2. It provides proper error boundaries
3. It avoids provider conflicts with the parent Wrapper
4. It includes fallback UI for all possible states

If you still encounter issues, we might need to:
1. Check the actual import path
2. Verify if the component being imported is actually available
3. Check if there are any build/bundling issues
