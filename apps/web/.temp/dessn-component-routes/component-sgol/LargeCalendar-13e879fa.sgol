import React from 'react';
import { useParentState } from '../useIframeState';
import { LargeCalendar } from '../../../../packages/features/troubleshooter/components/LargeCalendar';
import { useTroubleshooterStore } from '../../../../packages/features/troubleshooter/store';
import dayjs from '@calcom/dayjs';

// Create a wrapper component that initializes the store
const TroubleshooterStoreProvider = ({ children }: { children: React.ReactNode }) => {
  const setMonth = useTroubleshooterStore((state) => state.setMonth);
  const setEvent = useTroubleshooterStore((state) => state.setEvent);

  React.useEffect(() => {
    // Initialize with current month
    setMonth(dayjs().format('YYYY-MM'));
    // Initialize with mock event data
    setEvent({
      id: 1,
      slug: 'mock-event',
      duration: 30
    });
  }, [setMonth, setEvent]);

  return <>{children}</>;
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    extraDays: {
      type: "number",
      value: 7,
      label: "Extra Days",
    },
  });

  return (
    <TroubleshooterStoreProvider>
      <div>
        <LargeCalendar extraDays={state.extraDays.value} />
      </div>
    </TroubleshooterStoreProvider>
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Created a `TroubleshooterStoreProvider` component that initializes the store with required data
2. The provider initializes the store with:
   - Current month
   - A mock event (since the calendar needs event data)
3. Wrapped the `LargeCalendar` with this provider
4. Added necessary imports

This should resolve the error because now:
1. We're properly initializing the store with required data
2. The calendar component will have access to all the store values it needs
3. We're using a proper provider pattern while still leveraging Zustand's store

The calendar should now render properly with the initialized store data. Let me know if you encounter any other issues!

