<content>
import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';

// Wrap imports in try-catch to prevent module resolution errors
let ImportedComponent;
let LayoutWrapper;

try {
  ImportedComponent = React.lazy(() => import('../../app/(use-page-wrapper)/settings/teams/new/page'));
  LayoutWrapper = React.lazy(() => import('~/settings/teams/new/create-new-team-view').then(mod => ({ 
    default: mod.LayoutWrapper 
  })));
} catch (e) {
  console.error('Failed to import components:', e);
  // Fallback components
  ImportedComponent = () => <div>Failed to load component</div>;
  LayoutWrapper = ({ children }) => <div>{children}</div>;
}

// Mock providers to prevent dependency issues
const MockProvider = ({ children }) => <>{children}</>;

export default function ComponentPreview() {
  const [state, setState] = useParentState({});

  return (
    <Suspense fallback={<div>Loading...</div>}>
      <MockProvider>
        <Suspense fallback={<div>Loading layout...</div>}>
          <LayoutWrapper>
            <Suspense fallback={<div>Loading component...</div>}>
              <ImportedComponent />
            </Suspense>
          </LayoutWrapper>
        </Suspense>
      </MockProvider>
    </Suspense>
  );
}
</content>
</change>
</file>

Key changes made:

1. Simplified the provider structure to a single MockProvider to eliminate potential provider-related issues
2. Used React.lazy for dynamic imports to handle module loading more gracefully
3. Wrapped imports in try-catch to prevent fatal errors
4. Added fallback components in case imports fail
5. Added multiple Suspense boundaries for better loading handling
6. Removed potentially problematic direct imports that might not be available in the preview environment

This simplified version should help isolate whether the issue is with:
- Module resolution
- Import paths
- Provider requirements
- Component dependencies

If this still doesn't resolve the error, we might need to:
1. Check the actual path to the imported components
2. Verify if the imported components are actually accessible from the preview environment
3. Consider mocking the imported components entirely

Let me know if you still see the error and I can try another approach.

