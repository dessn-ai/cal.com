      <div className="space-y-4">
        <div className="flex items-center space-x-4">
          <img 
            src={props.profile.image} 
            alt={props.profile.name}
            className="w-16 h-16 rounded-full"
          />
          <div>
            <h2 className="text-xl font-semibold">{props.profile.name}</h2>
