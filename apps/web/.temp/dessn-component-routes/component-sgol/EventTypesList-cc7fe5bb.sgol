import React from 'react';
import { useParentState } from '../useIframeState';
import { EventTypesList } from '../../../../packages/features/users/components/UserTable/BulkActions/EventTypesList';

const mockTable = {
  selectedRows: [],
  getSelectedRowModel: {
    flatRows: []
  },
  toggleAllRowsSelected: false
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    table: {
      type: "object",
      value: mockTable,
      label: "Table",
    },
    orgTeams: {
      type: "object",
      value: [],
      label: "Organization Teams",
    },
  });

  return (
    <div className="p-6">
      <EventTypesList
        table={{
          getSelectedRowModel: () => ({ flatRows: [] }),
          toggleAllRowsSelected: () => {},
        } as any}
        orgTeams={[]}
      />
    </div>
  );
}
</content>
</change>
</file>

I've made the following changes:

1. Removed the getter/setter approach which wasn't working
2. Created a simpler mock structure
3. Provided the table prop directly in the JSX instead of through state to avoid serialization issues
4. Added proper function implementations for `getSelectedRowModel` and `toggleAllRowsSelected`
5. Wrapped the component in a div with padding for better visibility
6. Simplified the orgTeams prop to be a direct empty array
7. Used type assertion to satisfy TypeScript while keeping the mock simple

This approach should work better because:
1. We're no longer trying to serialize functions through state
2. The mock functions are created fresh in the render
3. The component gets exactly what it expects - functions it can call

The error should now be resolved since we're providing actual functions for the table methods that the component needs.

