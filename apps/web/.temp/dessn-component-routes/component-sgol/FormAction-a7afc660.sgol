// Mock the useOrgBranding hook before any imports
window.__mockOrgBranding = {
  useOrgBranding: () => ({
    isLoading: false,
    organization: {
      id: 1,
      slug: "preview-org",
      name: "Preview Organization",
      logoUrl: null,
      brandColor: "#292929",
      darkBrandColor: "#fafafa",
      theme: null,
    },
  }),
};

// Override the module
const originalRequire = window.require;
window.require = function(path) {
  if (path.includes('organizations/context/provider')) {
    return window.__mockOrgBranding;
  }
  return originalRequire.apply(this, arguments);
};

