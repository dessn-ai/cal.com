const EmbedDialogContext = React.createContext({
  isEmbedDialogOpen: false,
  setIsEmbedDialogOpen: () => {},
  embedType: null,
  setEmbedType: () => {},
});

const EmbedDialogProvider = ({ children }) => {
  return (
    <EmbedDialogContext.Provider 
      value={{
        isEmbedDialogOpen: false,
        setIsEmbedDialogOpen: () => {},
        embedType: null,
        setEmbedType: () => {},
