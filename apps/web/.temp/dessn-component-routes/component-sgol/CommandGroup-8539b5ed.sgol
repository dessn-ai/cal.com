import React from 'react';
import { useParentState } from '../useIframeState';
import { Command, CommandGroup, CommandItem } from '../../../../packages/ui/components/command';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    className: {
      type: "string",
      value: "custom-class",
      label: "Class Name",
    },
    children: {
      type: "string",
      value: "Command Group Content",
      label: "Children",
    },
  });

  return (
    <Command className="w-full">
      <Command.List>
        <CommandGroup heading="Basic Example" className={state.className.value}>
          <CommandItem>
            {state.children.value}
          </CommandItem>
        </CommandGroup>
      </Command.List>
    </Command>
  );
}
    </content>
  </change>
</file>

The changes made:
1. Added CommandItem to the imports
2. Changed Command.Item to CommandItem (the correct way to use it)
3. Added a heading prop to CommandGroup which is typically required
4. Added w-full class to Command to ensure proper width
5. Fixed the component hierarchy to match the expected structure:
   - Command (root)
   - Command.List (list container)
   - CommandGroup (group container)
   - CommandItem (individual item)

The error was occurring because we were trying to use Command.Item as a nested property, but it should be imported as CommandItem. This matches the actual implementation in the command/index.tsx file where these components are exported individually.

All components are now properly imported and structured according to the CMDK pattern used in the Cal.com UI components.

