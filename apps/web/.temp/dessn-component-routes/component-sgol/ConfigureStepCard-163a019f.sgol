import React from 'react';
import { useParentState } from '../useIframeState';
import { ConfigureStepCard } from '../../components/apps/installation/ConfigureStepCard';
import { FormProvider, useForm } from 'react-hook-form';

// Mock types that would normally come from Prisma
type AppCategories = "calendar" | "video" | "messaging";

// Mock the event type structure
type TEventTypesForm = {
  eventTypeGroups: {
    id: number;
    slug: string;
    image?: string;
    eventTypes: any[];
  }[];
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    slug: {
      type: "string",
      value: "example-slug",
      label: "Slug",
    },
    userName: {
      type: "string",
      value: "John Doe",
      label: "User Name",
    },
    categories: {
      type: "dropdown",
      value: "calendar",
      options: ["calendar", "video", "messaging"],
      label: "Categories",
    },
    credentialId: {
      type: "number",
      value: 1,
      label: "Credential ID",
    },
    loading: {
      type: "boolean",
      value: false,
      label: "Loading",
    },
    isConferencing: {
      type: "boolean",
      value: false,
      label: "Is Conferencing",
    },
  });

  const formPortalRef = React.useRef<HTMLDivElement>(null);
  
  // Initialize form context
  const methods = useForm<TEventTypesForm>({
    defaultValues: {
      eventTypeGroups: []
    }
  });

  return (
    <FormProvider {...methods}>
      <div ref={formPortalRef} />
      <ConfigureStepCard
        slug={state.slug.value}
        userName={state.userName.value}
        categories={[state.categories.value as AppCategories]}
        credentialId={state.credentialId.value}
        loading={state.loading.value}
        isConferencing={state.isConferencing.value}
        formPortalRef={formPortalRef}
        eventTypeGroups={[]}
        setConfigureStep={() => {}}
        handleSetUpLater={() => {}}
      />
    </FormProvider>
  );
}
</content>
</change>
</file>

