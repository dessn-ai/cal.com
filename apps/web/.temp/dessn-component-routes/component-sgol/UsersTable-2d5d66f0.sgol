import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../modules/settings/admin/components/UsersTable';

// Mock the SMSLockState enum
enum SMSLockState {
  LOCKED = "LOCKED",
  REVIEW_NEEDED = "REVIEW_NEEDED",
  UNLOCKED = "UNLOCKED"
}

// Mock the trpc hook
const mockTRPC = {
  viewer: {
    admin: {
      getSMSLockStateTeamsUsers: {
        useQuery: () => ({
          data: {
            users: {
              locked: [
                {
                  id: 1,
                  username: "john_doe",
                  name: "John Doe",
                  email: "john@example.com",
                  smsLockState: SMSLockState.LOCKED,
                  avatarUrl: null
                }
              ],
              reviewNeeded: [
                {
                  id: 2,
                  username: "jane_doe",
                  name: "Jane Doe",
                  email: "jane@example.com",
                  smsLockState: SMSLockState.REVIEW_NEEDED,
                  avatarUrl: null
                }
              ]
            },
            teams: {
              locked: [
                {
                  id: 1,
                  name: "Team A",
                  smsLockState: SMSLockState.LOCKED,
                  slug: "team-a",
                  logoUrl: null
                }
              ],
              reviewNeeded: [
                {
                  id: 2,
                  name: "Team B",
                  smsLockState: SMSLockState.REVIEW_NEEDED,
                  slug: "team-b",
                  logoUrl: null
                }
              ]
            }
          }
        })
      }
    }
  }
};

// Mock the trpc context
jest.mock("@calcom/trpc/react", () => ({
