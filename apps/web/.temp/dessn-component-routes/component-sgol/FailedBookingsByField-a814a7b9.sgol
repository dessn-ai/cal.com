// Mock DataTableProvider
const DataTableProvider = ({ children }) => {
  const contextValue = {
    data: [],
    isLoading: false,
    tableContainerRef: { current: null },
    setData: () => {},
    isSuccess: true,
    page: 0,
    sorting: [],
    setSorting: () => {},
    pageSize: 10,
    pageCount: 1,
    setPageSize: () => {},
