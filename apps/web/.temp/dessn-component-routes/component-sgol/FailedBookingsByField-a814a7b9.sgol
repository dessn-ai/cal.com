import { createContext, useContext } from 'react';

interface DataTableContextType {
  filterValue: string;
  setFilterValue: (value: string) => void;
  [key: string]: any;
}

const DataTableContext = createContext<DataTableContextType | null>(null);

export const useDataTable = () => {
  return {
    filterValue: "",
    setFilterValue: () => {},
    data: [],
    isLoading: false,
    tableContainerRef: { current: null },
    setData: () => {},
    filter: "",
    setFilter: () => {},
    selectedIds: [],
    setSelectedIds: () => {},
    page: 1,
    setPage: () => {},
    pageSize: 10,
    setPageSize: () => {},
    sortBy: "",
    setSortBy: () => {},
    sortDirection: "asc",
    setSortDirection: () => {},
    columns: [],
    setColumns: () => {},
    selectedRows: [],
    setSelectedRows: () => {},
    totalRecords: 0,
  };
};

export const useFilterValue = () => {
  const table = useDataTable();
  return [table.filterValue, table.setFilterValue] as const;
};
</content>
</change>
</file>

